// Действия с закрытым ключом организации: подпись произвольных данных КЭП подписанта и вход в ГИС МТ.
// Модуль серверный БЕЗ вызова сервера: с клиента его не вызвать, поэтому подпись данных и токен ГИС МТ
// отсюда получает только серверный код (ЭДО_Сервер, ЭДО_Сторожа), который сам проверяет права на действие.
// В ЭДО_Сервер (модуль с вызовом сервера) этим функциям экспортными быть нельзя: их звали бы с клиента.

#Область ПрограммныйИнтерфейс

// Подпись двоичных данных КЭП подписанта (отсоединённая CMS) в СЕРВЕРНОМ контексте.
// Требует контейнер в реестре учётки службы кластера + сертификат в её личном хранилище.
// Возврат: ДвоичныеДанные подписи либо Неопределено (нет сертификата/ошибка крипто).
Функция ПодписатьДанные(Данные, Знач Организация = Неопределено) Экспорт
	Попытка
		Сертификат = СертификатПодписанта(Организация);
		Если Сертификат = Неопределено Тогда
			// без записи в ЖР причина неподписанного документа терялась.
			ЗаписьЖурналаРегистрации("ЭДО.Подпись", УровеньЖурналаРегистрации.Ошибка, , Организация,
				"Сертификат подписанта не найден (учетная запись ЭДО организации, хранилище службы кластера)");
			Возврат Неопределено;
		КонецЕсли;
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80); // ГОСТ-2012-256, как в обработке провайдера
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = "";
		Возврат МенеджерКриптографии.Подписать(Данные, Сертификат);
	Исключение
		// криптография падает молча - пишем причину.
		ЗаписьЖурналаРегистрации("ЭДО.Подпись", УровеньЖурналаРегистрации.Ошибка, , Организация,
			"Подпись не выполнена: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Сертификат подписанта из личного хранилища учётки, под которой идёт код
// (на сервере - учётка службы кластера). Неопределено, если не найден/крипто недоступно.
Функция СертификатПодписанта(Знач Организация = Неопределено) Экспорт
	Отпечаток = ЭДО_Сервер.ОтпечатокПодписанта(Организация);
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80);
		Хранилище = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Возврат Хранилище.НайтиПоОтпечатку(Base64Значение(Отпечаток));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "СертификатПодписанта: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Токен ГИС МТ организации. Вход - присоединенной подписью КЭП организации (той же, что для Платформы)
// по случайным данным ЧЗ, с ИНН: ключ бухгалтера с МЧД годится нескольким организациям, и без ИНН
// ЧЗ отвечает «Невозможно однозначно определить под какой организацией выполняется авторизация».
// Токен живет около 10 часов; кешируется в общих настройках на 8 часов, чтобы не подписывать на каждый вызов.
Функция ТокенГИСМТ(Знач Организация = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Запись = ЭДО_Сервер.УчетнаяЗаписьЭДО();
		Если Запись = Неопределено Тогда
			ВызватьИсключение "ГИС МТ: нет учетной записи ЭДО";
		КонецЕсли;
		Организация = Запись.Организация;
	КонецЕсли;
	ИНН = СокрЛП(Организация.ИНН);
	КлючКеша = "ТокенГИСМТ_" + ИНН;
	УстановитьПривилегированныйРежим(Истина);
	Кеш = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", КлючКеша, , "");
	Если ТипЗнч(Кеш) = Тип("Структура") И Кеш.Свойство("До") И Кеш.До > ТекущаяУниверсальнаяДата() Тогда
		Возврат Кеш.Токен;
	КонецЕсли;

	Соединение = Новый HTTPСоединение("markirovka.crpt.ru", 443, , , , 90, Новый ЗащищенноеСоединениеOpenSSL());
	ЗапросКлюча = Новый HTTPЗапрос("/api/v3/true-api/auth/key");
	ЗапросКлюча.Заголовки.Вставить("Accept", "application/json");
	Ключ = ЭДО_Сервер.ПрочитатьОтветJSON(Соединение.Получить(ЗапросКлюча).ПолучитьТелоКакСтроку("UTF-8"));
	ДанныеДляПодписи = ПолучитьДвоичныеДанныеИзСтроки(Ключ.Получить("data"), "UTF-8", Ложь);
	Обработка = Обработки.ЭДО_ПлатформаЭДО.Создать();
	ОтказПодписи = Ложь;
	ОписаниеПодписи = "";
	ПодписьCMS = Обработка.ПрисоединитьПодпись(ПодписатьДанные(ДанныеДляПодписи, Организация), ДанныеДляПодписи,
		ОтказПодписи, ОписаниеПодписи);
	Если ОтказПодписи Тогда
		ВызватьИсключение "ГИС МТ: подпись для входа не создана: " + ОписаниеПодписи;
	КонецЕсли;
	Подпись64 = СтрЗаменить(СтрЗаменить(Base64Строка(ПодписьCMS), Символы.ПС, ""), Символы.ВК, "");
	ЗапросВхода = Новый HTTPЗапрос("/api/v3/true-api/auth/simpleSignIn");
	ЗапросВхода.Заголовки.Вставить("Content-Type", "application/json");
	ЗапросВхода.Заголовки.Вставить("Accept", "application/json");
	ЗапросВхода.УстановитьТелоИзСтроки(ТекстJSON(Новый Структура("uuid, data, inn",
		Ключ.Получить("uuid"), Подпись64, ИНН)), КодировкаТекста.UTF8);
	ТекстВхода = Соединение.ОтправитьДляОбработки(ЗапросВхода).ПолучитьТелоКакСтроку("UTF-8");
	Вход = ЭДО_Сервер.ПрочитатьОтветJSON(ТекстВхода);
	Токен = ?(ТипЗнч(Вход) = Тип("Соответствие"), Вход.Получить("token"), Неопределено);
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение "ГИС МТ: вход не выполнен: " + Лев(ТекстВхода, 300);
	КонецЕсли;
	ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", КлючКеша,
		Новый Структура("Токен, До", Токен, ТекущаяУниверсальнаяДата() + 8 * 3600), , "");
	Возврат Токен;

КонецФункции

// Сохраненный токен ГИС МТ организации больше не годится (401) - следующий ТокенГИСМТ войдет заново.
Процедура СброситьТокенГИСМТ(Знач Организация) Экспорт
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Запись = ЭДО_Сервер.УчетнаяЗаписьЭДО();
		Если Запись = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Организация = Запись.Организация;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Удалить("ОФД_ЭДО_НастройкиОбработки", "ТокенГИСМТ_" + СокрЛП(Организация.ИНН), "");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстJSON(Знач Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

#КонецОбласти
