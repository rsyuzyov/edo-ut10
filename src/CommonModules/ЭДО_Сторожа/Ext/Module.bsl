
// Сторожа ЭДО: наблюдение за тем, чего из самой отправки не видно.
// Каждый сторож судится по строке-своду в журнале регистрации, а не по коду возврата.

// Сторож "доставлено, но не принято": УПД, по которым контрагент ничего не сделал, -
// карточка у оператора живет дольше порога, а титула покупателя (ACCEPTED) нет.
// Порог считается от создания карточки у оператора, а не от даты накладной: документ мог
// пролежать в очереди. Каналы без обратной связи (2LT, 2VO) молчат по своей природе:
// их не перечисляем, а считаем одной строкой.
Функция ВыполнитьСторожНеПринятых(Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьСторожНеПринятых(УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		ПорогДней   = 14;
		ГлубинаДней = 45;   // окно обхода: все, что старше, разбирать уже поздно, а обход дорожает
		ПоказатьМакс = 40;  // потолок списка в логе, чтобы одна авария не залила его целиком

		Финалы = Новый Соответствие;   // статусы, после которых ждать нечего
		Финалы.Вставить("ACCEPTED", Истина);
		Финалы.Вставить("REJECTED", Истина);
		Финалы.Вставить("CANCELLED", Истина);
		Финалы.Вставить("SENDING_FAILED", Истина);
		Финалы.Вставить("SENDING", Истина);
		Финалы.Вставить("NEW", Истина);

		МолчащиеКаналы = Новый Соответствие;   // каналы без обратной связи - считаем, но не перечисляем
		МолчащиеКаналы.Вставить("2LT", Истина);
		МолчащиеКаналы.Вставить("2VO", Истина);

		ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
		Токен = ЭДО_Сервер.ТекущийТокен(Организация);
		ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
		НашГид = ЭДО_Сервер.ГидОрганизации(Организация);
		Соед = ЭДО_Сервер.СоединениеСОператором(60);
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");

		Строки = Новый Массив;
		ПоКаналам = Новый Соответствие;
		Молчащих = 0;
		Всего = 0;
		СуммаВисит = 0;
		Ошибки = "";
		Финиш = НачалоДня(ТекущаяУниверсальнаяДата()) - ПорогДней * 86400;

		Для Сдвиг = 0 По ГлубинаДней - ПорогДней Цикл
			День = Финиш - Сдвиг * 86400;
			ОтДата = Формат(День, "ДФ=yyyy-MM-dd");
			ВозрастДней = ПорогДней + Сдвиг;
			ИсточникДня = "";   // страницы дня - одним источником (ПолучитьСписокОператора)
			Для Страница = 0 По 9 Цикл
				// Токен Keycloak живет 15 минут и перевыпускается по времени, а не по числу запросов.
				Если ТекущаяУниверсальнаяДатаВМиллисекундах() - ТокенПолучен > 600000 Тогда
					ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
					Токен = ЭДО_Сервер.ТекущийТокен(Организация);
					ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
					Заголовки.Вставить("Authorization", "Bearer " + Токен);
				КонецЕсли;
				Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?created_from=" + ОтДата + "T00:00:00.000Z"
					+ "&created_till=" + ОтДата + "T23:59:59.000Z&sender_id=" + НашГид
					+ "&page=" + Страница + "&page_size=100";
				Карточки = Неопределено;
				Для НомерПопытки = 1 По 3 Цикл
					Попытка
						Ответ = ЭДО_Сервер.ПолучитьСписокОператора(Соед, Путь, Заголовки, Организация, , ИсточникДня);   // цепочки, /documents - резерв
					Исключение
						ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ВыполнитьСторожНеПринятых: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
						Продолжить;   // сеть моргнула - пробуем еще раз
					КонецПопытки;
					Если Ответ.КодСостояния = 401 Тогда
						ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
						Токен = ЭДО_Сервер.ТекущийТокен(Организация);
						ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
						Заголовки.Вставить("Authorization", "Bearer " + Токен);
						Продолжить;
					КонецЕсли;
					Если Ответ.КодСостояния <> 200 Тогда
						Ошибки = Ошибки + ОтДата + " стр." + Страница + ": HTTP " + Ответ.КодСостояния + "; ";
						Прервать;
					КонецЕсли;
					Чтение = Новый ЧтениеJSON;
					Чтение.УстановитьСтроку(Ответ.Тело);
					Карточки = ПрочитатьJSON(Чтение, Ложь);
					Чтение.Закрыть();
					Прервать;
				КонецЦикла;
				Если Карточки = Неопределено Тогда
					Прервать;
				КонецЕсли;
				Для Каждого Карточка Из Карточки Цикл
					Если Строка(Карточка.type) <> "ON_NSCHFDOPPR" Тогда
						Продолжить;
					КонецЕсли;
					Если Финалы.Получить(Строка(Карточка.status)) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Всего = Всего + 1;
					// свои карточки (наш ИНН и наш же ящик) отсекаем в источнике, иначе они всплывают
					// в каждом отчете как проблемные
					Если ЭДО_Сервер.АдресЭДОНаш(Строка(Карточка.recipient.id)) Тогда
						Продолжить;
					КонецЕсли;
					Канал = Лев(Строка(Карточка.recipient.id), 3);
					Если МолчащиеКаналы.Получить(Канал) <> Неопределено Тогда
						Молчащих = Молчащих + 1;
						Продолжить;
					КонецЕсли;
					Счётчик = ПоКаналам.Получить(Канал);
					ПоКаналам.Вставить(Канал, ?(Счётчик = Неопределено, 1, Счётчик + 1));
					Номер = "";
					Сумма = 0;
					Покупатель = "";
					Инв = ЭДО_Сервер.РеквизитыКарточкиОператора(Карточка);   // extra вместо invoice
					Если Инв <> Неопределено Тогда
						Если Инв.Свойство("num") Тогда
							Номер = СокрЛП(Строка(Инв.num));
						КонецЕсли;
						Если Инв.Свойство("sum") Тогда
							Сумма = Число(Инв.sum);
						КонецЕсли;
						Если Инв.Свойство("buyer") И Инв.buyer <> Неопределено Тогда
							Пок = Инв.buyer;
							Если Пок.Свойство("name") И Пок.name <> Неопределено Тогда
								Имя = Пок.name;
								Если ТипЗнч(Имя) = Тип("Строка") Тогда
									Покупатель = СокрЛП(Имя);
								Иначе
									// ИП: имя приходит разобранным на части
									Части = Новый Массив;
									Если Имя.Свойство("last") Тогда Части.Добавить(Строка(Имя.last)); КонецЕсли;
									Если Имя.Свойство("first") Тогда Части.Добавить(Строка(Имя.first)); КонецЕсли;
									Если Имя.Свойство("middle") Тогда Части.Добавить(Строка(Имя.middle)); КонецЕсли;
									Покупатель = СокрЛП(СтрСоединить(Части, " "));
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					СуммаВисит = СуммаВисит + Сумма;
					Строки.Добавить(Формат(ВозрастДней, "ЧН=0; ЧГ=0") + " дн. | " + Номер + " | "
						+ Лев(Покупатель, 38) + " | " + Формат(Сумма, "ЧДЦ=2; ЧГ=0") + " | " + Канал
						+ " | " + Строка(Карточка.status));
				КонецЦикла;
				Если Карточки.Количество() < 100 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Свод = "";
		Для Каждого КЗ Из ПоКаналам Цикл
			Свод = Свод + ?(Свод = "", "", ", ") + КЗ.Ключ + ": " + КЗ.Значение;
		КонецЦикла;
		Лог = Новый Массив;
		Лог.Добавить("ЭДО, приёмка: без титула покупателя дольше " + ПорогДней + " дн. — "
			+ Строки.Количество() + " док на " + Формат(СуммаВисит, "ЧДЦ=2; ЧГ=0") + " руб"
			+ ?(Свод = "", "", " (" + Свод + ")")
			+ "; каналы без обратной связи (2LT/2VO) пропущено: " + Молчащих
			+ ?(Ошибки = "", "", "; ОШИБКИ ОБХОДА: " + Ошибки));
		Показано = 0;
		Для Каждого С Из Строки Цикл
			Если Показано >= ПоказатьМакс Тогда
				Лог.Добавить("    … и ещё " + (Строки.Количество() - Показано) + " — полный список в журнале регистрации");
				Прервать;
			КонецЕсли;
			Лог.Добавить("    " + С);
			Показано = Показано + 1;
		КонецЦикла;
		Текст = СтрСоединить(Лог, Символы.ПС);

		ЗаписьЖурналаРегистрации("ЭДО.КонтрольПриёмки",
			?(Строки.Количество() > 0, УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Информация),
			, , Лев(Текст, 5000));

		Результат = Текст;
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожНеПринятых");
	Возврат Результат;

КонецФункции

// Сторож паузы: контрагент, который за окно не подписал ни одного документа и у которого
// есть документ, висящий дольше порога, ставится на паузу - отправка ему прекращается.
// Второе условие обязательно: без него под правило попадает всякий, кто просто не успел
// подписать. Пауза снимается сама, как только за окно появилась подпись.
// В счет висящих идут только документы, ушедшие на действующий адрес контрагента:
// отправленное на прежний ящик он не видел.
// СухойПрогон - посчитать и записать в журнал то же самое, но пауз не ставить и не снимать
// (приемка правок в бою в день выкатки). Регламент зовет функцию без параметров.
Функция ВыполнитьСторожПаузы(Знач СухойПрогон = Ложь, Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьСторожПаузы(СухойПрогон, УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		// Пауза ставится сразу, без списка на разбор: контрагент, которому ЭДО нужно, обратится
		// сам, и пауза снимается за минуту.
		СтавитьПаузу = НЕ СухойПрогон;
		ПорогДней    = 14;     // возраст висящего документа, после которого молчание систематическое
		// Окно широкое: за его горизонтом подпись не видна, и давно подписавший выглядел бы молчуном.
		ОкноДней     = 90;     // окно, в котором ищем подписи и висящие документы

		ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
		Токен = ЭДО_Сервер.ТекущийТокен(Организация);
		ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
		НашГид = ЭДО_Сервер.ГидОрганизации(Организация);
		Соед = ЭДО_Сервер.СоединениеСОператором(60);
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");

		// каналы без обратной связи: там молчание - свойство канала, а не поведение контрагента
		МолчащиеКаналы = Новый Соответствие;
		МолчащиеКаналы.Вставить("2LT", Истина);
		МолчащиеКаналы.Вставить("2VO", Истина);
		// статусы, после которых ждать подписи нечего
		Финалы = Новый Соответствие;
		Финалы.Вставить("REJECTED", Истина);
		Финалы.Вставить("CANCELLED", Истина);
		Финалы.Вставить("SENDING_FAILED", Истина);
		Финалы.Вставить("SENDING", Истина);
		Финалы.Вставить("NEW", Истина);

		// ИНН -> карточки контрагента в базе (их может быть несколько на один ИНН - норма для точек).
		// Строится ДО обхода оператора: действующие адреса нужны уже при подсчете просроченных.
		СвИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента");
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СвИд", СвИд);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	З.Объект                КАК Контрагент,
		|	З.Объект.Наименование   КАК Имя,
		|	З.Объект.ИНН            КАК ИНН,
		|	З.Значение              КАК Адрес
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК З
		|ГДЕ
		|	З.Свойство = &СвИд
		|	И НЕ З.Объект.ИНН = """"";
		ПоАдресу = Новый Соответствие;      // ИНН -> Массив карточек
		АдресаПоИНН = Новый Соответствие;   // ИНН -> Соответствие действующих адресов
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ИННКлюч = СокрЛП(Выборка.ИНН);
			Список = ПоАдресу.Получить(ИННКлюч);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				ПоАдресу.Вставить(ИННКлюч, Список);
				АдресаПоИНН.Вставить(ИННКлюч, Новый Соответствие);
			КонецЕсли;
			Список.Добавить(Новый Структура("Контрагент, Имя", Выборка.Контрагент, СокрЛП(Выборка.Имя)));
			Адрес = ВРег(СокрЛП(Строка(Выборка.Адрес)));
			Если ЗначениеЗаполнено(Адрес) Тогда
				АдресаПоИНН.Получить(ИННКлюч).Вставить(Адрес, Истина);
			КонецЕсли;
		КонецЦикла;

		Отправлено   = Новый Соответствие;
		Принято      = Новый Соответствие;
		Просроченные = Новый Соответствие;
		Суммы        = Новый Соответствие;
		ОтброшеноЧужойАдрес = 0;
		Ошибки = "";
		Финиш = НачалоДня(ТекущаяУниверсальнаяДата());

		Для Сдвиг = 1 По ОкноДней Цикл
			День = Финиш - Сдвиг * 86400;
			ОтДата = Формат(День, "ДФ=yyyy-MM-dd");
			ИсточникДня = "";   // страницы дня - одним источником (ПолучитьСписокОператора)
			Для Страница = 0 По 9 Цикл
				// Токен Keycloak живет 15 минут и перевыпускается по времени, а не по числу запросов.
				Если ТекущаяУниверсальнаяДатаВМиллисекундах() - ТокенПолучен > 600000 Тогда
					ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
					Токен = ЭДО_Сервер.ТекущийТокен(Организация);
					ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
					Заголовки.Вставить("Authorization", "Bearer " + Токен);
				КонецЕсли;
				Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?created_from=" + ОтДата + "T00:00:00.000Z"
					+ "&created_till=" + ОтДата + "T23:59:59.000Z&sender_id=" + НашГид
					+ "&page=" + Страница + "&page_size=100";
				Карточки = Неопределено;
				Для НомерПопытки = 1 По 3 Цикл
					Попытка
						Ответ = ЭДО_Сервер.ПолучитьСписокОператора(Соед, Путь, Заголовки, Организация, , ИсточникДня);   // цепочки, /documents - резерв
					Исключение
						ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ВыполнитьСторожПаузы: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
						Продолжить;   // сеть моргнула - пробуем еще раз
					КонецПопытки;
					Если Ответ.КодСостояния = 401 Тогда
						ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
						Токен = ЭДО_Сервер.ТекущийТокен(Организация);
						ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
						Заголовки.Вставить("Authorization", "Bearer " + Токен);
						Продолжить;
					КонецЕсли;
					Если Ответ.КодСостояния <> 200 Тогда
						Ошибки = Ошибки + ОтДата + " стр." + Страница + ": HTTP " + Ответ.КодСостояния + "; ";
						Прервать;
					КонецЕсли;
					Чтение = Новый ЧтениеJSON;
					Чтение.УстановитьСтроку(Ответ.Тело);
					Карточки = ПрочитатьJSON(Чтение, Ложь);
					Чтение.Закрыть();
					Прервать;
				КонецЦикла;
				Если Карточки = Неопределено Тогда
					Прервать;
				КонецЕсли;
				Для Каждого Карточка Из Карточки Цикл
					Если Строка(Карточка.type) <> "ON_NSCHFDOPPR" Тогда
						Продолжить;
					КонецЕсли;
					АдресПолучателя = СокрЛП(Строка(Карточка.recipient.id));
					Получатель = АдресПолучателя;
					// свои карточки отсекаем в источнике, а не в отчете
					Если ЭДО_Сервер.АдресЭДОНаш(Получатель) Тогда
						Продолжить;
					КонецЕсли;
					// Считаем по ИНН покупателя, а не по адресу получателя: контрагент, сменивший оператора,
					// по старому адресу выглядит молчащим, хотя у нового исправно подписывает; по адресу
					// его карточка к тому же может не находиться вовсе.
					Ключ = "";
					РеквизитыКарт = ЭДО_Сервер.РеквизитыКарточкиОператора(Карточка);   // extra вместо invoice
					Если РеквизитыКарт <> Неопределено
						И РеквизитыКарт.Свойство("buyer") И РеквизитыКарт.buyer <> Неопределено
						И РеквизитыКарт.buyer.Свойство("inn") Тогда
						Ключ = СокрЛП(Строка(РеквизитыКарт.buyer.inn));
					КонецЕсли;
					Если НЕ ЗначениеЗаполнено(Ключ) Тогда
						Продолжить;   // без ИНН покупателя судить не о ком
					КонецЕсли;
					Получатель = Ключ;
					Статус = Строка(Карточка.status);
					// Канал без обратной связи молчит по своему устройству: такие карточки не идут в счет
					// висящих, но подпись в них засчитывается наравне с остальными.
					Молчащий = (МолчащиеКаналы.Получить(Лев(Строка(Карточка.recipient.id), 3)) <> Неопределено);
					Если НЕ Молчащий Тогда
						Счёт = Отправлено.Получить(Получатель);
						Отправлено.Вставить(Получатель, ?(Счёт = Неопределено, 1, Счёт + 1));
					КонецЕсли;
					Сумма = 0;
					Если РеквизитыКарт <> Неопределено И РеквизитыКарт.Свойство("sum") Тогда
						Сумма = Число(РеквизитыКарт.sum);
					КонецЕсли;
					Если НЕ Молчащий Тогда
						НакопСумма = Суммы.Получить(Получатель);
						Суммы.Вставить(Получатель, ?(НакопСумма = Неопределено, Сумма, НакопСумма + Сумма));
					КонецЕсли;
					Если Статус = "ACCEPTED" Тогда
						СчётП = Принято.Получить(Получатель);
						Принято.Вставить(Получатель, ?(СчётП = Неопределено, 1, СчётП + 1));
						Продолжить;
					КонецЕсли;
					Если Финалы.Получить(Статус) <> Неопределено ИЛИ Молчащий Тогда
						Продолжить;
					КонецЕсли;
					Если Сдвиг >= ПорогДней Тогда
						// Документ, ушедший на адрес, которым контрагент больше не пользуется, молчанием
						// не считается: он его не видел. Адрес неизвестен (карточки нет или свойство пустое) -
						// судим как раньше.
						ДействующиеАдреса = АдресаПоИНН.Получить(Получатель);
						АдресДействующий = (ДействующиеАдреса = Неопределено
							ИЛИ ДействующиеАдреса.Количество() = 0
							ИЛИ ДействующиеАдреса.Получить(ВРег(АдресПолучателя)) <> Неопределено);
						Если АдресДействующий Тогда
							СчётС = Просроченные.Получить(Получатель);
							Просроченные.Вставить(Получатель, ?(СчётС = Неопределено, 1, СчётС + 1));
						Иначе
							ОтброшеноЧужойАдрес = ОтброшеноЧужойАдрес + 1;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Если Карточки.Количество() < 100 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Кандидаты = Новый Массив;
		НаПаузе = Новый Массив;
		КандидатыНаСнятие = Новый Массив;
		ВсегоДок = 0;
		ВсегоСумма = 0;
		Поставлено = 0;
		СнятоВсего = 0;
		Для Каждого КЗ Из Отправлено Цикл
			Список = ПоАдресу.Получить(СокрЛП(КЗ.Ключ));
			Карта = ?(Список = Неопределено ИЛИ Список.Количество() = 0, Неопределено, Список[0]);
			Имя = ?(Карта = Неопределено, "ИНН " + КЗ.Ключ, Карта.Имя);
			Пауза = ?(Карта = Неопределено, "", ЭДО_Сервер.ПричинаПаузыКонтрагента(Карта.Контрагент));
			ЕстьПодписи = (Принято.Получить(КЗ.Ключ) <> Неопределено);
			Если ЗначениеЗаполнено(Пауза) Тогда
				// Появилась подпись за окно - паузу снимаем сами, на всех карточках этого ИНН.
				Если ЕстьПодписи Тогда
					Снято = 0;
					Если Список <> Неопределено И СтавитьПаузу Тогда
						Для Каждого КарточкаКА Из Список Цикл
							ЭДО_Сервер.ВозобновитьОтправкуКонтрагенту(КарточкаКА.Контрагент);
							Снято = Снято + 1;
						КонецЦикла;
					КонецЕсли;
					СнятоВсего = СнятоВсего + Снято;
					КандидатыНаСнятие.Добавить(Лев(Имя, 40) + " | подписал "
						+ Принято.Получить(КЗ.Ключ) + " док за месяц — пауза снята с " + Снято + " карточек");
				Иначе
					НаПаузе.Добавить(Лев(Имя, 40) + " | " + Пауза);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если ЕстьПодписи Тогда
				Продолжить;
			КонецЕсли;
			Стар = Просроченные.Получить(КЗ.Ключ);
			Если Стар = Неопределено Тогда
				Продолжить;   // подписей нет, но и просроченных тоже - просто еще не успел
			КонецЕсли;
			ВсегоДок = ВсегоДок + КЗ.Значение;
			ВсегоСумма = ВсегоСумма + Суммы.Получить(КЗ.Ключ);
			Кандидаты.Добавить(Лев(Имя, 40) + " | " + КЗ.Значение + " док за месяц, из них старше "
				+ ПорогДней + " дн.: " + Стар + " | "
				+ Формат(Суммы.Получить(КЗ.Ключ), "ЧДЦ=2; ЧГ=0") + " руб | ИНН " + КЗ.Ключ
				+ ?(Список = Неопределено, " | КАРТОЧКА НЕ НАЙДЕНА", " | карточек: " + Список.Количество()));
			Если СтавитьПаузу И Список <> Неопределено Тогда
				// Свойство "причина" - строка 50 символов, поэтому формулировка короткая.
				// Карточек на один ИНН бывает много: пауза ставится на все, иначе документ выпишут
				// на соседнюю и он уйдет мимо правила.
				Для Каждого КарточкаКА Из Список Цикл
					ЭДО_Сервер.ПриостановитьОтправкуКонтрагенту(КарточкаКА.Контрагент,
						"нет подписей " + ОкноДней + " дн., " + Стар + " старше " + ПорогДней + " дн.");
					Поставлено = Поставлено + 1;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

		Лог = Новый Массив;
		Лог.Добавить("ЭДО, пауза: под правило подпадает " + Кандидаты.Количество() + " контрагентов ("
			+ ВсегоДок + " док, " + Формат(ВсегоСумма, "ЧДЦ=2; ЧГ=0") + " руб)"
			+ ?(СтавитьПаузу, "; ПОСТАВЛЕНО НА ПАУЗУ: " + Поставлено, "; сухой прогон, пометки не ставились")
			+ "; уже на паузе: " + НаПаузе.Количество()
			+ ?(ОтброшеноЧужойАдрес = 0, "",
				"; не в счёт (ушло на прежний адрес контрагента): " + ОтброшеноЧужойАдрес)
			+ ?(КандидатыНаСнятие.Количество() = 0, "",
				"; ПОЯВИЛИСЬ ПОДПИСИ у " + КандидатыНаСнятие.Количество()
				+ " — пауза снята с " + СнятоВсего + " карточек")
			+ ?(Ошибки = "", "", "; ОШИБКИ ОБХОДА: " + Ошибки));
		Для Каждого С Из Кандидаты Цикл
			Лог.Добавить("    " + С);
		КонецЦикла;
		Для Каждого С Из КандидатыНаСнятие Цикл
			Лог.Добавить("    СНЯТО: " + С);
		КонецЦикла;
		Текст = СтрСоединить(Лог, Символы.ПС);
		ЗаписьЖурналаРегистрации("ЭДО.ПаузаОтправки",
			?(Кандидаты.Количество() > 0, УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Информация),
			, , Лев(Текст, 5000));
		Результат = Текст;
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожПаузы");
	Возврат Результат;

КонецФункции

// Обход ГИС МТ ("Честный ЗНАК") по нашим исходящим УПД. Отвечает на два вопроса,
// которых из ЭДО не видно:
// 1) какие документы ЧЗ отвергла и с какой формулировкой (commonErrors из /doc/{имя}/info);
// 2) какие подписаны покупателем, но до ЧЗ не доехали.
// В ЧЗ документ попадает только после подписи покупателя (статус ACCEPTED): пока он
// SENT/DELIVERED, отсутствие в ЧЗ - норма.
// Первая строка результата - сводка для журнала, дальше построчно отказы и "пропавшие".
Функция ВыполнитьСторожГИСМТ(Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьСторожГИСМТ(УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		ГлубинаСверки = 7;   // дней назад по дате накладной для поиска "подписан, но не доехал"
		ГлубинаСписка = 7;   // дней назад обходим doc/list ГИС МТ
		// Окно списка не должно быть уже окна сверки: документ, подписанный позже, попадает
		// в ЧЗ своим днем и при узком окне объявляется пропавшим.
		ЛимитСписка = "1000";// строкой: Строка(1000) дает "1 000" с разделителем групп, и URL ломается
		// doc/list отвечает на это ошибкой, и обход молча дает "наших исходящих 0". Пагинации
		// у метода нет: при меньшем лимите суточный поток не влезает, и лишнее печатается
		// как "не доехал в ЧЗ".
		ЛагЧасов = 2;        // ЧЗ получает документ через минуту-другую после подписи покупателя,
		// а не после отправки; двух часов на обработку хватает с запасом.
		ПоказатьМакс = 40;   // потолок списка в логе, чтобы одна авария не залила его целиком

		// -- 1. Аутентификация в ГИС МТ: та же КЭП, что для Платформы, подпись ПРИСОЕДИНЕННАЯ ---
		// общий вход ЭДО_Сервер.ТокенГИСМТ - с ИНН организации (ключ бухгалтера с МЧД годится
		// нескольким организациям, и без ИНН ЧЗ вход отклоняет) и с кешем токена.
		СоедГ = Новый HTTPСоединение("markirovka.crpt.ru", 443, , , , 90, Новый ЗащищенноеСоединениеOpenSSL());
		ТокенГ = ЭДО_Сервер.ТокенГИСМТ(Организация);

		// -- 2. Обход doc/list по суткам и товарным группам ---
		// pg обязателен, один документ приходит в нескольких группах; пагинации у метода нет,
		// поэтому берем максимальный limit и отдельно следим за упором в него.
		Группы = СтрРазделить("conserve,milk,water,grocery,softdrinks,vegetableoil", ",");
		СтатусыГИС = Новый Соответствие;   // номер накладной -> статус (CHECKED_OK приоритетнее)
		ИменаФайлов = Новый Соответствие;  // номер накладной -> имя файла ЭДО для /info
		ПолученоЧЗ = Новый Соответствие;   // номер накладной -> когда ЧЗ приняла этот экземпляр
		СчОК = 0;
		СчНеОК = 0;
		СчВРаботе = 0;
		СрезНеполон = "";                  // сутки/группы, где выдача уперлась в ЛимитСписка
		Сегодня = НачалоДня(ТекущаяДата());
		Для Сдвиг = 1 По ГлубинаСписка Цикл
			День = Сегодня - Сдвиг * 86400;
			ОтДаты = Формат(День, "ДФ=yyyy-MM-dd") + "T00:00:00.000Z";
			ДоДаты = Формат(День, "ДФ=yyyy-MM-dd") + "T23:59:59.000Z";
			Для Каждого Группа Из Группы Цикл
				ЗапСписок = Новый HTTPЗапрос("/api/v4/true-api/doc/list?limit=" + ЛимитСписка + "&pg=" + Группа + "&dateFrom=" + ОтДаты + "&dateTo=" + ДоДаты);
				ЗапСписок.Заголовки.Вставить("Authorization", "Bearer " + ТокенГ);
				ЗапСписок.Заголовки.Вставить("Accept", "application/json");
				Попытка
					ЧСписок = Новый ЧтениеJSON;
					ЧСписок.УстановитьСтроку(СоедГ.Получить(ЗапСписок).ПолучитьТелоКакСтроку("UTF-8"));
					Ответ = ПрочитатьJSON(ЧСписок, Ложь);
					ЧСписок.Закрыть();
					// упор в потолок выдачи = срез за эти сутки неполон, и "пропавшие" ниже станут враньем
					Если Ответ.results.Количество() >= Число(ЛимитСписка) Тогда
						СрезНеполон = СрезНеполон + ?(СрезНеполон = "", "", ", ") + Формат(День, "ДФ=dd.MM") + "/" + Группа;
					КонецЕсли;
					Для Каждого Элемент Из Ответ.results Цикл
						Если Элемент.input Тогда
							Продолжить;
						КонецЕсли;
						Прежний = СтатусыГИС.Получить(Элемент.invoiceNumber);
						Если Прежний = Неопределено ИЛИ Элемент.status = "CHECKED_OK" Тогда
							СтатусыГИС.Вставить(Элемент.invoiceNumber, Элемент.status);
							ИменаФайлов.Вставить(Элемент.invoiceNumber, Элемент.number);
							МеткаЧЗ = Строка(Элемент.receivedAt);
							Если СтрДлина(МеткаЧЗ) >= 19 Тогда
								ПолученоЧЗ.Вставить(Элемент.invoiceNumber, Дата(Число(Сред(МеткаЧЗ, 1, 4)), Число(Сред(МеткаЧЗ, 6, 2)), Число(Сред(МеткаЧЗ, 9, 2)),
									Число(Сред(МеткаЧЗ, 12, 2)), Число(Сред(МеткаЧЗ, 15, 2)), Число(Сред(МеткаЧЗ, 18, 2))));
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				Исключение
					ТекстСбоя = "Ответ ГИС МТ не разобран: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
					// Недоступный журнал не должен прерывать обход остальных страниц.
					Попытка
						ЗаписьЖурналаРегистрации("ЭДО.СторожГИСМТ", УровеньЖурналаРегистрации.Предупреждение, , , ТекстСбоя);
					Исключение
						// Перехват обоснован: отказ самой записи в журнал записать некуда.
						Продолжить;
					КонецПопытки;
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
		Отказы = Новый Массив;
		Для Каждого Пара Из СтатусыГИС Цикл
			Если Пара.Значение = "CHECKED_OK" Тогда
				СчОК = СчОК + 1;
			ИначеЕсли Пара.Значение = "IN_PROGRESS" Тогда
				СчВРаботе = СчВРаботе + 1;
			Иначе
				СчНеОК = СчНеОК + 1;
				Отказы.Добавить(Пара.Ключ);
			КонецЕсли;
		КонецЦикла;

		// -- 3. Причины отказов: только в /info, поле commonErrors (в списке errors всегда null) ---
		СтрокиОтказов = Новый Массив;
		ТекстыОтказов = Новый Соответствие;
		Для Каждого НомерН Из Отказы Цикл
			Попытка
				ЗапИнфо = Новый HTTPЗапрос("/api/v4/true-api/doc/" + ИменаФайлов.Получить(НомерН) + "/info");
				ЗапИнфо.Заголовки.Вставить("Authorization", "Bearer " + ТокенГ);
				ЗапИнфо.Заголовки.Вставить("Accept", "application/json");
				ЧИнфо = Новый ЧтениеJSON;
				ЧИнфо.УстановитьСтроку(СоедГ.Получить(ЗапИнфо).ПолучитьТелоКакСтроку("UTF-8"));
				Инфо = ПрочитатьJSON(ЧИнфо, Ложь);
				ЧИнфо.Закрыть();
				Карточка = ?(ТипЗнч(Инфо) = Тип("Массив") И Инфо.Количество() > 0, Инфо[0], Инфо);
				Текст = "";
				Если Карточка.Свойство("commonErrors") И Карточка["commonErrors"] <> Неопределено Тогда
					Показано = 0;
					Для Каждого Ошибка Из Карточка["commonErrors"] Цикл
						Показано = Показано + 1;
						Если Показано > 2 Тогда
							Текст = Текст + " (…ещё)";
							Прервать;
						КонецЕсли;
						Текст = Текст + ?(Текст = "", "", "; ") + Строка(Ошибка["errorCode"]) + " " + Лев(Строка(Ошибка["errorMessage"]), 120);
					КонецЦикла;
				КонецЕсли;
				ТекстыОтказов.Вставить(НомерН, ?(Текст = "", "(причина не указана)", Текст));
			Исключение
				ТекстыОтказов.Вставить(НомерН, "причину получить не удалось: " + Лев(ОписаниеОшибки(), 100));
			КонецПопытки;
		КонецЦикла;

		// -- 4. Тихий исход: подписан покупателем, но в ЧЗ его нет ---
		// Признак "подписан" берем у Платформы (status = ACCEPTED); маркировку - по ТЧ ШтрихкодыУпаковок.
		Пропавшие = Новый Массив;
		СверкаСделана = Ложь;
		Попытка
			СвойствоИД = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
			ЗапросНаши = Новый Запрос;
			ЗапросНаши.Текст =
				"ВЫБРАТЬ РАЗЛИЧНЫЕ Р.Номер КАК Номер, Р.Дата КАК Дата
				|ИЗ Документ.РеализацияТоваровУслуг КАК Р
				|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК ШУ
				|		ПО ШУ.Ссылка = Р.Ссылка
				|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ИД
				|		ПО ИД.Объект = Р.Ссылка И ИД.Свойство = &СвойствоИД
				|ГДЕ Р.Проведен И Р.Дата МЕЖДУ &ОтДаты И &ДоДаты
				|	И (&ВсеОрганизации ИЛИ Р.Организация.ИНН = &ИННОрганизации)";
				ЗапросНаши.УстановитьПараметр("СвойствоИД", СвойствоИД);
			ЗапросНаши.УстановитьПараметр("ОтДаты", Сегодня - ГлубинаСверки * 86400);
			ЗапросНаши.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
			ЗапросНаши.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
			ЗапросНаши.УстановитьПараметр("ДоДаты", КонецДня(Сегодня - 86400));
			НашиМаркированные = Новый Соответствие;
			Для Каждого СтрокаТЗ Из ЗапросНаши.Выполнить().Выгрузить() Цикл
				НашиМаркированные.Вставить(СтрокаТЗ.Номер, СтрокаТЗ.Дата);
			КонецЦикла;

			ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
			ТокенП = ЭДО_Сервер.ТекущийТокен(Организация);
			ЗаголовкиП = Новый Соответствие;
			ЗаголовкиП.Вставить("Authorization", "Bearer " + ТокенП);
			ЗаголовкиП.Вставить("accept", "application/json;charset=UTF-8");
			СоедП = ЭДО_Сервер.СоединениеСОператором(120);   // обход суток терпит длинный ответ
			НашGid = ЭДО_Сервер.ГидОрганизации(Организация);
			Подписанные = Новый Соответствие;
			ПоследняяОтправка = Новый Соответствие;   // время создания последнего экземпляра
			ПодписанВ = Новый Соответствие;           // время подписи покупателем (modified у ACCEPTED)
			// с нуля, а НЕ с единицы: переотправка могла быть сегодня, и без текущих суток
			// фильтр по лагу доставки не увидит свежий экземпляр и объявит документ пропавшим.
			Для Сдвиг = 0 По ГлубинаСверки Цикл
				День = Сегодня - Сдвиг * 86400;
				ОтМетка = Формат(День, "ДФ=yyyy-MM-dd") + "T00:00:00.000Z";
				ДоМетка = Формат(День, "ДФ=yyyy-MM-dd") + "T23:59:59.999Z";
				ИсточникДня = "";   // страницы дня - одним источником (ПолучитьСписокОператора)
				Для Страница = 0 По 9 Цикл
					Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?sender_id=" + НашGid
						+ "&created_from=" + ОтМетка + "&created_till=" + ДоМетка
						+ "&page=" + Страница + "&page_size=100";
					ОтветП = ЭДО_Сервер.ПолучитьСписокОператора(СоедП, Путь, ЗаголовкиП, Организация, , ИсточникДня);   // цепочки, /documents - резерв
					Если ОтветП.КодСостояния <> 200 Тогда
						Прервать;
					КонецЕсли;
					ЧП = Новый ЧтениеJSON;
					ЧП.УстановитьСтроку(ОтветП.Тело);
					МассивП = ПрочитатьJSON(ЧП, Ложь);
					ЧП.Закрыть();
					Если ТипЗнч(МассивП) <> Тип("Массив") ИЛИ МассивП.Количество() = 0 Тогда
						Прервать;
					КонецЕсли;
					Для Каждого Запись Из МассивП Цикл
						Счет = ЭДО_Сервер.РеквизитыКарточкиОператора(Запись);   // extra вместо invoice
						Если Счет = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						Если НЕ Счет.Свойство("num") Тогда
							Продолжить;
						КонецЕсли;
						НомерСчета = Строка(Счет["num"]);
						// Судим по последнему экземпляру: у переотправленного документа старый экземпляр
						// остается ACCEPTED, и свежий неподписанный выглядел бы "подписанным и потерянным".
						// created - ISO-8601 в UTC, "ГГГГ-ММ-ДДTчч:мм:сс.ffffffZ".
						Метка = Строка(Запись.created);
						Если СтрДлина(Метка) < 19 Тогда
							Продолжить;
						КонецЕсли;
						Создан = Дата(Число(Сред(Метка, 1, 4)), Число(Сред(Метка, 6, 2)), Число(Сред(Метка, 9, 2)),
							Число(Сред(Метка, 12, 2)), Число(Сред(Метка, 15, 2)), Число(Сред(Метка, 18, 2)));
						Прежняя = ПоследняяОтправка.Получить(НомерСчета);
						Если Прежняя = Неопределено ИЛИ Прежняя < Создан Тогда
							ПоследняяОтправка.Вставить(НомерСчета, Создан);
							ЭтоПодписан = (Строка(Запись.status) = "ACCEPTED");
							Подписанные.Вставить(НомерСчета, ?(ЭтоПодписан, 1, 0));
							МеткаИзм = Строка(Запись.modified);
							Если ЭтоПодписан И СтрДлина(МеткаИзм) >= 19 Тогда
								ПодписанВ.Вставить(НомерСчета, Дата(Число(Сред(МеткаИзм, 1, 4)), Число(Сред(МеткаИзм, 6, 2)), Число(Сред(МеткаИзм, 9, 2)),
									Число(Сред(МеткаИзм, 12, 2)), Число(Сред(МеткаИзм, 15, 2)), Число(Сред(МеткаИзм, 18, 2))));
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					Если МассивП.Количество() < 100 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Для Каждого Пара Из НашиМаркированные Цикл
				Если Подписанные.Получить(Пара.Ключ) <> 1 Тогда
					Продолжить;   // последний экземпляр покупателем еще не подписан - в ЧЗ его быть и не должно
				КонецЕсли;
				Если СтатусыГИС.Получить(Пара.Ключ) = "CHECKED_OK" Тогда
					Продолжить;
				КонецЕсли;
				Если СтатусыГИС.Получить(Пара.Ключ) = "IN_PROGRESS" Тогда
					Продолжить;
				КонецЕсли;
				Подписан = ПодписанВ.Получить(Пара.Ключ);
				Если Подписан <> Неопределено И Подписан > ТекущаяУниверсальнаяДата() - ЛагЧасов * 3600 Тогда
					Продолжить;   // подписан только что - ЧЗ еще не успела разобрать
				КонецЕсли;
				Пропавшие.Добавить(Пара.Ключ + " (" + Формат(Пара.Значение, "ДФ=dd.MM") + ")");
			КонецЦикла;
			СверкаСделана = Истина;
		Исключение
			СтрокиОтказов.Добавить("Сверка «подписан, но нет в ЧЗ» не отработала: " + Лев(ОписаниеОшибки(), 140));
		КонецПопытки;

		// Отказ, после которого документ уже переотправлен, - не работа, а история: иначе он висит
		// в логе все ГлубинаСписка суток и приучает лог не читать.
		Актуальных = 0;
		СтрокиАктуальных = Новый Массив;
		СтрокиПерекрытых = Новый Массив;
		Для Каждого ПараОтказа Из ТекстыОтказов Цикл
			Отправлен = ПоследняяОтправка.Получить(ПараОтказа.Ключ);
			Принят = ПолученоЧЗ.Получить(ПараОтказа.Ключ);
			Перекрыт = (Отправлен <> Неопределено И Принят <> Неопределено И Отправлен > Принят);
			Если Перекрыт Тогда
				СтрокиПерекрытых.Добавить("отказ перекрыт переотправкой: " + ПараОтказа.Ключ);
			Иначе
				Актуальных = Актуальных + 1;
				СтрокиАктуальных.Добавить("ОТКАЗ ЧЗ " + ПараОтказа.Ключ + " -> " + ПараОтказа.Значение);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекстСтроки Из СтрокиАктуальных Цикл
			СтрокиОтказов.Добавить(ТекстСтроки);
		КонецЦикла;
		Для Каждого ТекстСтроки Из СтрокиПерекрытых Цикл
			СтрокиОтказов.Добавить(ТекстСтроки);
		КонецЦикла;

		Сводка = "ГИС МТ, обход за " + ГлубинаСписка + " дн.: наших исходящих " + СтатусыГИС.Количество()
			+ ", CHECKED_OK " + СчОК + ", отвергнуто " + СчНеОК + " (требуют работы " + Актуальных + ")"
			+ ", в обработке " + СчВРаботе;
		Если СверкаСделана Тогда
			Сводка = Сводка + "; подписаны покупателем, но нет в ЧЗ за " + ГлубинаСверки + " дн.: " + Пропавшие.Количество();
		КонецЕсли;
		Если СрезНеполон <> "" Тогда
			Сводка = Сводка + "; ⚠️ срез ЧЗ неполон (упор в limit " + ЛимитСписка + "): " + СрезНеполон
				+ " — список пропавших ниже считать недостоверным";
		КонецЕсли;
		Итог = Новый Массив;
		Итог.Добавить(Сводка);
		Для Каждого ТекстОтказа Из СтрокиОтказов Цикл
			Итог.Добавить(ТекстОтказа);
		КонецЦикла;
		Напечатано = 0;
		Для Каждого ТекстПропажи Из Пропавшие Цикл
			Напечатано = Напечатано + 1;
			Если Напечатано > ПоказатьМакс Тогда
				Итог.Добавить("… ещё " + (Пропавшие.Количество() - ПоказатьМакс) + " не показаны");
				Прервать;
			КонецЕсли;
			Итог.Добавить("НЕ ДОЕХАЛ В ЧЗ " + ТекстПропажи);
		КонецЦикла;
		Результат = СтрСоединить(Итог, Символы.ПС);
	Исключение
		Результат = "ОШИБКА обхода ГИС МТ: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожГИСМТ");
	Возврат Результат;

КонецФункции

// Сторож брошенных отметок отправки: документы, занятые прогоном и не доехавшие до конца.
// Отметка 1 ("взят в отправку") ставится до обращения к оператору, 10 - когда связь
// оборвалась до получения идентификатора; с обеими документ выпадает из работы навсегда.
// Снимать отметку вслепую нельзя: карточка у оператора могла уже создаться, и документ уйдет
// вторым экземпляром. Поэтому каждая отметка сверяется с оператором: карточка есть -
// записываем ее id, карточки нет - снимаем отметку, документ вернется в очередь.
// Работает только под замком прогона; замок занят - сторож уходит до следующего запуска.
Функция ВыполнитьСторожБрошенныхОтметок() Экспорт

	Попытка
		Если НЕ ЭДО_Сервер.ЗанятьПрогонОтправки() Тогда
			Результат = "ЭДО, брошенные отметки: идёт отправка, разбор отложен до следующего запуска";
			ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, Ложь, "ЭДО.Регламент.СторожБрошенных");
			Возврат Результат;
		КонецЕсли;

		Попытка
			Результат = РазобратьБрошенныеОтметки();
		Исключение
			Результат = "ОШИБКА: " + ОписаниеОшибки();
		КонецПопытки;
		ЭДО_Сервер.ОсвободитьПрогонОтправки();
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожБрошенных");
	Возврат Результат;

КонецФункции

// Разбор отметок под уже захваченным замком.
Функция РазобратьБрошенныеОтметки()

	СвойствоСтатус = ЭДО_Сервер.СвойствоОбъектов("ЭДО_КодСостояния");
	СвойствоИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая() Тогда
		Возврат "ЭДО, брошенные отметки: свойство состояния не заведено, разбирать нечего";
	КонецЕсли;

	// Берем только отметки БЕЗ идентификатора: с идентификатором документ у оператора
	// заведомо создан, и его судьбой занимается сверка статусов, а не этот сторож.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Сост.Объект КАК Объект,
		|	Сост.Значение КАК Код
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Сост
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Идент
		|	ПО Идент.Объект = Сост.Объект И Идент.Свойство = &СвойствоИд
		|ГДЕ Сост.Свойство = &СвойствоСтатус
		|	И (Сост.Значение = &Занят ИЛИ Сост.Значение = &Обрыв)
		|	И (Идент.Объект ЕСТЬ NULL ИЛИ Идент.Значение = """")");
	Запрос.УстановитьПараметр("СвойствоСтатус", СвойствоСтатус);
	Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
	Запрос.УстановитьПараметр("Занят", 1);
	Запрос.УстановитьПараметр("Обрыв", 10);
	Выборка = Запрос.Выполнить().Выбрать();

	Всего = 0;
	Снято = 0;
	Закреплено = 0;
	НеОпрошено = 0;
	Примеры = Новый Массив;
	// Потолок на прогон: каждая отметка - это запрос (а то и несколько) к оператору,
	// и разбор сотен документов подряд занял бы замок на десятки минут.
	Предел = 100;

	Пока Выборка.Следующий() Цикл
		Всего = Всего + 1;
		Если Всего > Предел Тогда
			Прервать;
		КонецЕсли;

		Ссылка = Выборка.Объект;
		Опрос = ЭДО_Сервер.ЖивойЭкземплярУОператора(Ссылка);

		Если НЕ Опрос.Опрошено Тогда
			// Ничего не трогаем: неизвестность - не основание ни снять, ни закрепить.
			НеОпрошено = НеОпрошено + 1;
			Продолжить;
		КонецЕсли;

		Если Опрос.Найден Тогда
			// Документ у оператора есть - база просто не успела записать идентификатор.
			ЭДО_Сервер.ЗаписатьСтатусЭДО(Ссылка, 40, Опрос.Ид);
			Закреплено = Закреплено + 1;
			Если Примеры.Количество() < 5 Тогда
				Примеры.Добавить(СокрЛП(Строка(Ссылка)) + " → карточка " + Опрос.Ид + " " + Опрос.Статус);
			КонецЕсли;
		Иначе
			// Карточки нет - документ до оператора не доехал, возвращаем в очередь. Снимается и
			// статус 10; считаем только подтвержденное снятие.
			Если ЭДО_Сервер.ОсвободитьПрерваннуюОтправку(Ссылка) Тогда
				Снято = Снято + 1;
				Если Примеры.Количество() < 5 Тогда
					Примеры.Добавить(СокрЛП(Строка(Ссылка)) + " → отметка снята, вернётся в очередь");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// код 20 - создан у оператора, подпись не дошла. Черновик NEW старше
	// ВозрастБрошенногоЧерновика - снять код и идентификатор, документ уйдет обычным ходом;
	// карточка уже не NEW (подпись все-таки дошла) - закрепить код 40.
	Черновики = РазобратьНеподписанныеЧерновики(СвойствоСтатус, СвойствоИд, Примеры);

	Текст = "ЭДО, брошенные отметки: найдено " + Всего
		+ ", возвращено в очередь " + Снято
		+ ", закреплено по карточке оператора " + Закреплено
		+ ?(НеОпрошено > 0, ", НЕ ОПРОШЕНО " + НеОпрошено, "")
		+ ?(Всего > Предел, " (разобрано " + Предел + ", остаток — следующим прогоном)", "")
		+ Черновики;
	Если Примеры.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Примеры, Символы.ПС);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// разбор кода 20. Возврат - дополнение к итоговой строке сторожа.
Функция РазобратьНеподписанныеЧерновики(Знач СвойствоСтатус, Знач СвойствоИд, Примеры)

	Если СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Состояние.Объект КАК Объект,
		|	ВЫРАЗИТЬ(Идентификатор.Значение КАК СТРОКА(50)) КАК Ид
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Состояние
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Идентификатор
		|	ПО Идентификатор.Объект = Состояние.Объект И Идентификатор.Свойство = &СвойствоИд
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Читаемый
		|	ПО Читаемый.Объект = Состояние.Объект И Читаемый.Свойство = &СвойствоЧитаемый
		|ГДЕ Состояние.Свойство = &СвойствоСтатус
		|	И Состояние.Значение = &Код20
		|	И ЕСТЬNULL(ВЫРАЗИТЬ(Читаемый.Значение КАК СТРОКА(100)), """") <> &ЧерновикУдален
		|УПОРЯДОЧИТЬ ПО
		|	Ид");
	Запрос.УстановитьПараметр("СвойствоСтатус", СвойствоСтатус);
	Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
	Запрос.УстановитьПараметр("Код20", 20);
	// удаленный у оператора черновик оставлен человеку - повторно его не
	// опрашиваем и не пишем в ЖР каждый прогон; человек переотправит или снимет документ, и колонка сменится.
	СвойствоЧитаемый = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
	Запрос.УстановитьПараметр("СвойствоЧитаемый", ?(СвойствоЧитаемый = Неопределено,
		ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвойствоЧитаемый));
	Запрос.УстановитьПараметр("ЧерновикУдален", ЭДО_Сервер.ТекстЧерновикУдаленУОператора());
	Строки = Запрос.Выполнить().Выгрузить();

	// Обход по кругу: начинаем после идентификатора, на котором остановился прошлый прогон, - иначе одни
	// и те же строки (свежие, неопрошенные) каждый раз занимали бы весь предел.
	Начало = 0;
	Последний = СокрЛП(Строка(ЭДО_Сервер.НастройкаЭДО("Код20_ОбходПосле")));
	Если ЗначениеЗаполнено(Последний) Тогда
		Для Индекс = 0 По Строки.Количество() - 1 Цикл
			Если СокрЛП(Строки[Индекс].Ид) > Последний Тогда
				Начало = Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Всего = Строки.Количество();
	Возвращено = 0;
	Закреплено = 0;
	Свежих = 0;
	НеОпрошено = 0;
	Пропущено = 0;
	Сменились = 0;   // за время запроса документ переотправлен или снят
	Человеку = 0;
	Запросов = 0;
	Предел = 50;   // запросов к оператору за прогон
	ПоследнийИд = "";
	Для Шаг = 0 По Всего - 1 Цикл
		Если Запросов >= Предел Тогда
			Прервать;
		КонецЕсли;
		Черновик = Строки[(Начало + Шаг) % Всего];
		Ссылка = Черновик.Объект;
		Ид = СокрЛП(Черновик.Ид);
		ПоследнийИд = Ид;
		// Значение свойства может ссылаться на удаленный объект («Объект не найден») - такие пропускаем:
		// ни организации, ни документа для повторной отправки у них нет.
		Если НЕ ЗначениеЗаполнено(Ид) ИЛИ НЕ ЗначениеЗаполнено(Ссылка)
			ИЛИ Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Запросов = Запросов + 1;
		// Перехват обоснован: сбой по одному документу (связь, нет учетной записи организации) не должен
		// останавливать разбор остальных каждый прогон; документ и причина - в ЖР, следующий прогон повторит.
		Попытка
			Карточка = ЭДО_Сервер.КарточкаОператораПоИд(Ид, ЭДО_Сервер.ОрганизацияДокумента(Ссылка));
		Исключение
			НеОпрошено = НеОпрошено + 1;
			ЗаписьЖурналаРегистрации("ЭДО.Регламент.СторожБрошенных", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
				"Код 20 не разобран: карточка " + Ид + " - " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если НЕ Карточка.Опрошено Тогда
			НеОпрошено = НеОпрошено + 1;
			ЗаписьЖурналаРегистрации("ЭДО.Регламент.СторожБрошенных", УровеньЖурналаРегистрации.Предупреждение, , Ссылка,
				"Код 20 не разобран: карточка " + Ид + " - оператор ответил HTTP " + Карточка.Код);
			Продолжить;
		КонецЕсли;
		// Снова в очередь - только черновик NEW и технически не отправленный (SENDING_FAILED). Любой другой
		// статус значит, что подпись дошла: документ в работе, аннулирован или отклонен покупателем - закрепляем
		// код 40, сверка покажет фактическое состояние, переотправку решает человек.
		СтатусКарточки = ВРег(Карточка.Статус);
		// Удаленный черновик в очередь не возвращаем: его мог удалить человек, чтобы документ не ушел.
		// Код 20 и идентификатор остаются - очередь такой документ не берет.
		Если Карточка.Найдена И СтатусКарточки = "DELETED" Тогда
			// пока читали карточку, документ могли переотправить - текст
			// пишется под блокировкой и только если документ все еще связан с этим экземпляром.
			Если НЕ ЭДО_Сервер.ОставитьУдаленныйЧерновикЧеловеку(Ссылка, Ид) Тогда
				Сменились = Сменились + 1;
				Продолжить;
			КонецЕсли;
			Человеку = Человеку + 1;
			ЗаписьЖурналаРегистрации("ЭДО.Регламент.СторожБрошенных", УровеньЖурналаРегистрации.Предупреждение, , Ссылка,
				"Код 20: черновик " + Ид + " удален у оператора - в очередь не возвращен, решает человек");
			Если Примеры.Количество() < 8 Тогда
				Примеры.Добавить(СокрЛП(Строка(Ссылка)) + " - черновик " + Ид + " удален у оператора, оставлен человеку");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Карточка.Найдена И СтатусКарточки <> "NEW" И СтатусКарточки <> "SENDING_FAILED" Тогда
			// под блокировкой и только если документ все еще связан с этим
			// экземпляром - иначе его успели переотправить, связь с новым экземпляром не трогаем.
			Если НЕ ЭДО_Сервер.ЗакрепитьНеподписанныйЧерновик(Ссылка, Ид) Тогда
				Сменились = Сменились + 1;
				Продолжить;
			КонецЕсли;
			Закреплено = Закреплено + 1;
			Если Примеры.Количество() < 8 Тогда
				Примеры.Добавить(СокрЛП(Строка(Ссылка)) + " - код 20 закреплен как 40, карточка " + Ид + " " + Карточка.Статус);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Карточка.Найдена И ВРег(Карточка.Статус) = "NEW" И ЗначениеЗаполнено(Карточка.Создана)
			И ТекущаяУниверсальнаяДата() - Карточка.Создана < ЭДО_Сервер.ВозрастБрошенногоЧерновика() Тогда
			Свежих = Свежих + 1;   // возможно, отправка еще идет
			Продолжить;
		КонецЕсли;
		// Дважды снятый черновик третий раз не снимаем: подпись стабильно не принимается - нужен человек.
		Если ЭДО_Сервер.ЧерновикОсвобождалсяРаз(Ссылка) >= 2 Тогда
			Человеку = Человеку + 1;
			ЭДО_Сервер.ЗаписатьЧитаемыйСтатус(Ссылка, ЭДО_Сервер.ТекстНеПодписанПовторно());
			ЗаписьЖурналаРегистрации("ЭДО.Регламент.СторожБрошенных", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
				"Код 20: черновик " + Ид + " не подписан и после двух повторов - документ оставлен человеку");
			Продолжить;
		КонецЕсли;
		Если ЭДО_Сервер.ОсвободитьНеподписанныйЧерновик(Ссылка, Ид) Тогда
			Возвращено = Возвращено + 1;
			Если Примеры.Количество() < 8 Тогда
				Примеры.Добавить(СокрЛП(Строка(Ссылка)) + " - брошенный черновик " + Ид + " снят, вернётся в очередь");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(ПоследнийИд) Тогда
		ЭДО_Сервер.ЗапомнитьПозициюОбходаКода20(ПоследнийИд);
	КонецЕсли;

	Если Всего = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "; неподписанные черновики (код 20): " + Всего + ", возвращено в очередь " + Возвращено
		+ ", закреплено " + Закреплено + ?(Свежих > 0, ", моложе часа " + Свежих, "")
		+ ?(Человеку > 0, ", ОСТАВЛЕНО ЧЕЛОВЕКУ " + Человеку, "")
		+ ?(НеОпрошено > 0, ", НЕ ОПРОШЕНО " + НеОпрошено, "")
		+ ?(Пропущено > 0, ", без документа в базе " + Пропущено, "")
		+ ?(Сменились > 0, ", изменились за время запроса " + Сменились, "")
		+ ?(Запросов >= Предел, " (остаток - следующим прогоном)", "");

КонецФункции

// Сторож расхождений: документ правят после отправки, и у контрагента остается старый.
// Сверяются сумма документа и ИНН покупателя: с какими он ушел против того, что в базе сейчас.
// Гейт готовности этот класс не ловит: на момент отправки документ был готов.
// Сторож не чинит сам: переотправка без разбора дает контрагенту дубль, решение
// "переотправить или аннулировать" принимает человек по списку.

// Сверить отпечаток отправки с текущим состоянием документа.
// ТолькоПроверка - посчитать и записать свод в журнал, но свойства не трогать.
// Единственный способ принять правку сторожа, не меняя данные в бою.
Функция ВыполнитьСторожРасхождений(Знач ТолькоПроверка = Ложь) Экспорт

	Попытка
		Результат = СверитьОтпечаткиОтправки(ТолькоПроверка);
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.СторожРасхождений");
	Возврат Результат;

КонецФункции

// Разбор: сверить и проставить признак расхождения.
Функция СверитьОтпечаткиОтправки(Знач ТолькоПроверка)

	СвойствоОтпечаток = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ОтпечатокОтправки");
	СвойствоРасхождение = ЭДО_Сервер.СвойствоОбъектов("ЭДО_РасхождениеСОтправленным");
	Если СвойствоОтпечаток = Неопределено ИЛИ СвойствоОтпечаток.Пустая()
		ИЛИ СвойствоРасхождение = Неопределено ИЛИ СвойствоРасхождение.Пустая() Тогда
		Возврат "ЭДО, расхождения: свойств отпечатка нет в базе, сверять нечем";
	КонецЕсли;

	// Окно намеренно ограничено: документ годовой давности правят редко, а сверка всей
	// истории каждый час - лишняя нагрузка на ровном месте.
	ОкноДней = ЭДО_Сервер.НастройкаЭДО("ОкноСверкиРасхожденийДней");
	Если НЕ ЗначениеЗаполнено(ОкноДней) Тогда
		ОкноДней = 45;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СвОтпечаток", СвойствоОтпечаток);
	Запрос.УстановитьПараметр("СвРасхождение", СвойствоРасхождение);
	Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяДата()) - Число(ОкноДней) * 86400);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РТУ.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(Отп.Значение КАК СТРОКА(50)) КАК Отпечаток,
	|	ВЫРАЗИТЬ(Расх.Значение КАК СТРОКА(50)) КАК Расхождение
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РТУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Отп
	|		ПО Отп.Объект = РТУ.Ссылка
	|			И Отп.Свойство = &СвОтпечаток
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Расх
	|		ПО Расх.Объект = РТУ.Ссылка
	|			И Расх.Свойство = &СвРасхождение
	|ГДЕ
	|	РТУ.Дата >= &Граница
	|	И РТУ.Проведен";
	Выборка = Запрос.Выполнить().Выбрать();

	Ссылки = Новый Массив;
	Хранимое = Новый Соответствие;
	Прежнее = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Отпечаток) Тогда
			Продолжить;
		КонецЕсли;
		Ссылки.Добавить(Выборка.Ссылка);
		Хранимое.Вставить(Выборка.Ссылка, Выборка.Отпечаток);
		Прежнее.Вставить(Выборка.Ссылка, ?(Выборка.Расхождение = NULL, "", СокрЛП(Строка(Выборка.Расхождение))));
	КонецЦикла;

	Если Ссылки.Количество() = 0 Тогда
		Возврат "ЭДО, расхождения: отправленных документов с отпечатком за " + ОкноДней + " дн. нет";
	КонецЕсли;

	Текущие = ЭДО_Сервер.ОтпечаткиДокументов(Ссылки);

	Разошлось = 0;
	СменаПокупателя = 0;
	Поставлено = 0;
	Снято = 0;
	Примеры = Новый Массив;

	Для Каждого Ссылка Из Ссылки Цикл
		Было = ЭДО_Сервер.РазобратьОтпечаток(Хранимое.Получить(Ссылка));
		Стало = ЭДО_Сервер.РазобратьОтпечаток(Текущие.Получить(Ссылка));
		Если НЕ Было.Разобран ИЛИ НЕ Стало.Разобран Тогда
			Продолжить;
		КонецЕсли;

		// Хеш состава не заводим (см. ОтпечатокДокумента): пересорт "позицию заменили, сумма
		// та же" эта сверка не увидит - осознанная цена.
		СуммаРазошлась = (Макс(Было.Сумма, Стало.Сумма) - Мин(Было.Сумма, Стало.Сумма)) > 0.01;
		ПокупательСменился = Было.ЕстьИНН И Стало.ЕстьИНН И ВРег(Было.ИНН) <> ВРег(Стало.ИНН);

		Если СуммаРазошлась ИЛИ ПокупательСменился Тогда
			Разошлось = Разошлось + 1;
			Если ПокупательСменился Тогда
				СменаПокупателя = СменаПокупателя + 1;
			КонецЕсли;
			Текст = ТекстРасхожденияСОтправленным(Было, Стало, СуммаРазошлась, ПокупательСменился);
			Если Прежнее.Получить(Ссылка) <> Текст Тогда
				Если НЕ ТолькоПроверка Тогда
					ЭДО_Сервер.ЗаписатьСвойствоОбъекта(Ссылка, СвойствоРасхождение, Текст);
				КонецЕсли;
				Поставлено = Поставлено + 1;
			КонецЕсли;
			Если Примеры.Количество() < 5 Тогда
				Примеры.Добавить(СокрЛП(Строка(Ссылка)) + ": " + Текст);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Прежнее.Получить(Ссылка)) Тогда
			// Документ переотправили либо вернули к прежнему виду - признак снимаем сами,
			// иначе он остается навсегда и перестает что-либо значить.
			Если НЕ ТолькоПроверка Тогда
				ЭДО_Сервер.ЗаписатьСвойствоОбъекта(Ссылка, СвойствоРасхождение, "");
			КонецЕсли;
			Снято = Снято + 1;
		КонецЕсли;
	КонецЦикла;

	Текст = "ЭДО, расхождения" + ?(ТолькоПроверка, " (сухой прогон)", "") + ": проверено "
		+ Ссылки.Количество() + " за " + ОкноДней + " дн., расходится " + Разошлось
		+ " (из них сменен покупатель " + СменаПокупателя + ")"
		+ ", помечено " + Поставлено + ", снято " + Снято;
	Если Примеры.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Примеры, Символы.ПС);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Текст признака расхождения. Значение свойства ограничено 50 символами, поэтому при смене
// покупателя сумма упоминается одним словом: документ все равно уходит новому покупателю заново.
Функция ТекстРасхожденияСОтправленным(Знач Было, Знач Стало, Знач СуммаРазошлась, Знач ПокупательСменился)

	Если НЕ ПокупательСменился Тогда
		Возврат "сумма " + Формат(Было.Сумма, "ЧДЦ=2; ЧГ=0; ЧРД=.") + " -> "
			+ Формат(Стало.Сумма, "ЧДЦ=2; ЧГ=0; ЧРД=.");
	КонецЕсли;

	Текст = ПрефиксСменыПокупателя() + " " + ?(ЗначениеЗаполнено(Было.ИНН), Было.ИНН, "пусто")
		+ " -> " + ?(ЗначениеЗаполнено(Стало.ИНН), Стало.ИНН, "пусто");
	Если СуммаРазошлась Тогда
		Текст = Текст + ", сумма";
	КонецЕсли;

	Возврат Лев(Текст, 50);

КонецФункции

// Начало текста признака, по которому смену покупателя отличают от расхождения суммы.
Функция ПрефиксСменыПокупателя() Экспорт

	Возврат "ИНН покупателя";

КонецФункции

// Сторож входящих запросов на аннулирование (ПОА от контрагентов).
// Сторож показывает запрос: на документ ставится свойство ЭДО_ЗапросАннулирования с датой
// и причиной. Сам он принимает запрос, только когда аннулируемый экземпляр уже не отражает
// документ базы: по документу отправлен другой экземпляр либо сумма документа изменилась
// после отправки. Остальное решает человек.
// Копии подтверждения наших аннулирований приходят тем же типом CANCELLATION в статусе SENT,
// их отличает хвост _acceptance в имени файла.

// ТолькоПроверка - посчитать и записать свод в журнал, свойства не трогать.
Функция ВыполнитьСторожЗапросовАннулирования(Знач ТолькоПроверка = Ложь, Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьСторожЗапросовАннулирования(ТолькоПроверка, УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		Результат = РазобратьПредложенияАннулирования(ТолькоПроверка, Организация);
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	// В перечне - причины контрагентов («тех ошибка»): по ним сбоем прогон не считается.
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, ЭДО_Регламенты.ЕстьОшибкаВСводе(Результат),
		"ЭДО.Регламент.СторожЗапросовАннулирования");
	Возврат Результат;

КонецФункции

// Входящие запросы на аннулирование за окно, с привязкой к нашим документам.
// Возврат: Массив структур (ИдПОА, Статус, Создан, Отправитель, Подписант, Причина, ИдНашего, Номер, ДатаДок, Ссылка).
Функция ВходящиеПредложенияАннулирования(Знач ОкноДней = 62, Знач Организация = Неопределено) Экспорт

	Предложения = Новый Массив;

	ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
	Соед = ЭДО_Сервер.СоединениеСОператором(30);
	Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/";
	НашГид = ЭДО_Сервер.ГидОрганизации(Организация);

	// сначала по цепочкам (см. ОткрытыеПОАПоЦепочкам), ниже - прежний путь через /documents.
	ПоЦепочкам = ПредложенияКонтрагентовПоЦепочкам(Соед, Заголовки, Организация, НашГид, ОкноДней);
	Если ПоЦепочкам <> Неопределено Тогда
		ПривязатьКДокументамБазы(ПоЦепочкам, Организация);
		Возврат ПоЦепочкам;
	КонецЕсли;

	// Метод отдает не больше 31 дня за запрос, окно режем кусками с конца.
	Граница = НачалоДня(ТекущаяУниверсальнаяДата()) + 86400;
	Начало = Граница - ОкноДней * 86400;
	Пока Граница > Начало Цикл
		ОтДаты = Макс(Начало, Граница - 31 * 86400);
		Для Страница = 0 По 9 Цикл
			Карточки = КарточкиОператора(Соед, Заголовки, Организация, Путь + "documents?recipient_id=" + НашГид
				+ "&type=CANCELLATION&created_from=" + ДатаДляОператора(ОтДаты)
				+ "&created_till=" + ДатаДляОператора(Граница)
				+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=100");
			Для Каждого Карточка Из Карточки Цикл
				Если ВРег(Прав(Строка(Карточка["fileId"]), 11)) = "_ACCEPTANCE" Тогда
					Продолжить;
				КонецЕсли;
				Предложения.Добавить(ОписаниеЗапросаАннулирования(Карточка));
			КонецЦикла;
			Если Карточки.Количество() < 100 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Граница = ОтДаты;
	КонецЦикла;

	// Наш документ называет только имя файла внутри ПОА, поэтому для открытых запросов
	// читаем содержимое и ищем карточку в переписке с этим контрагентом около даты файла.
	Кэш = Новый Соответствие;
	Для Каждого Предложение Из Предложения Цикл
		Если Предложение.Статус <> "SENT" Тогда
			Продолжить;
		КонецЕсли;
		ИмяФайла = ИмяАннулируемогоФайла(Соед, Заголовки, Организация, Путь + "documents/" + Предложение.ИдПОА + "/content");
		ДатаФайла = ДатаИзИмениФайла(ИмяФайла);
		Если НЕ ЗначениеЗаполнено(ДатаФайла) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Предложение.Отправитель + Формат(ДатаФайла, "ДФ=yyyyMMdd");
		Переписка = Кэш.Получить(Ключ);
		Если Переписка = Неопределено Тогда
			Переписка = КарточкиОператора(Соед, Заголовки, Организация, Путь + "documents?sender_id=" + НашГид
				+ "&recipient_id=" + Предложение.Отправитель
				+ "&created_from=" + ДатаДляОператора(ДатаФайла - 86400)
				+ "&created_till=" + ДатаДляОператора(ДатаФайла + 2 * 86400)
				+ "&page=0&page_size=100");
			Кэш.Вставить(Ключ, Переписка);
		КонецЕсли;
		Для Каждого Наш Из Переписка Цикл
			Если СтрНайти(ИмяФайла, Строка(Наш["fileId"])) = 1 Тогда
				Предложение.ИдНашего = ЭДО_Регламенты.ИдентификаторСтрокой(Наш["id"]);
				Счет = ЭДО_Сервер.РеквизитыКарточкиОператора(Наш);   // extra вместо invoice
				Если Счет <> Неопределено Тогда
					Предложение.Номер = СокрЛП(Строка(Счет.Получить("num")));
					Предложение.ДатаДок = ДатаИзДДММГГГГ(Строка(Счет.Получить("date")));
					Если ТипЗнч(Счет.Получить("sum")) = Тип("Число") Тогда
						Предложение.СуммаНашего = Счет.Получить("sum");
					КонецЕсли;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		// Отказ универсальным сообщением статус ПОА не меняет: он остается SENT, а ответ
		// ложится в цепочку внутрь ПОА. Без этой проверки отклоненный запрос висел бы вечно.
		Если ЗначениеЗаполнено(Предложение.ИдНашего) Тогда
			Цепочка = КарточкиОператора(Соед, Заголовки, Организация, Путь + "document-flows?id=" + Предложение.ИдНашего);
			Если МыОтветилиНаПредложение(Цепочка, Предложение.ИдПОА) Тогда
				Предложение.Статус = "REJECTED";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ПривязатьКДокументамБазы(Предложения, Организация);
	Возврат Предложения;

КонецФункции

Функция РазобратьПредложенияАннулирования(Знач ТолькоПроверка, Знач Организация = Неопределено)

	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ЗапросАннулирования");
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат "ЭДО, запросы аннулирования: ОШИБКА - нет свойства ЭДО_ЗапросАннулирования,"
			+ " нужен вызов ЭДО_Сервер.ОбеспечитьСвойстваОбъектов()";
	КонецЕсли;

	ОкноДней = 62;
	Предложения = ВходящиеПредложенияАннулирования(ОкноДней, Организация);

	Открытые = Новый Соответствие;
	Ждут = 0;
	НеНайдено = 0;
	Примеры = Новый Массив;
	Для Каждого Предложение Из Предложения Цикл
		Если Предложение.Статус <> "SENT" Тогда
			Продолжить;
		КонецЕсли;
		Ждут = Ждут + 1;
		Если Предложение.Ссылка = Неопределено Тогда
			НеНайдено = НеНайдено + 1;
		Иначе
			Текст = Лев(Формат(Предложение.Создан, "ДФ=dd.MM") + " " + СокрЛП(СтрЗаменить(Предложение.Причина, Символы.ПС, " ")), 50);
			Открытые.Вставить(Предложение.Ссылка, Текст);
		КонецЕсли;
		Если Примеры.Количество() < 20 Тогда
			Примеры.Добавить(Формат(Предложение.Создан, "ДФ=dd.MM.yyyy") + " " + ?(ЗначениеЗаполнено(Предложение.Номер), Предложение.Номер, "ид " + Предложение.ИдПОА)
				+ " - " + Предложение.Подписант + " - " + Лев(СтрЗаменить(Предложение.Причина, Символы.ПС, " "), 100));
		КонецЕсли;
	КонецЦикла;

	// Прежние пометки: снимаем там, где запрос уже закрыт или ушел за окно.
	ЗапросБазы = Новый Запрос(
		"ВЫБРАТЬ Объект КАК Объект, ВЫРАЗИТЬ(Значение КАК СТРОКА(50)) КАК Значение
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Свойство = &Свойство И ВЫРАЗИТЬ(Значение КАК СТРОКА(50)) <> """"");
	ЗапросБазы.УстановитьПараметр("Свойство", Свойство);
	Прежние = Новый Соответствие;
	Для Каждого Запись Из ЗапросБазы.Выполнить().Выгрузить() Цикл
		Прежние.Вставить(Запись.Объект, СокрЛП(Запись.Значение));
	КонецЦикла;

	Принято = 0;
	Если НЕ ТолькоПроверка Тогда
		Для Каждого Предложение Из Предложения Цикл
			Если Предложение.Статус <> "SENT" ИЛИ Предложение.Ссылка = Неопределено
				ИЛИ НЕ ЗначениеЗаполнено(Предложение.ИдНашего) Тогда
				Продолжить;
			КонецЕсли;
			Основание = ОснованиеАвтоприемаАннулирования(Предложение);
			Если НЕ ЗначениеЗаполнено(Основание) Тогда
				Продолжить;
			КонецЕсли;
			Ответ = ЭДО_Сервер.ПринятьПредложениеАннулирования(Предложение.ИдПОА, Организация);
			Если Ответ.Успех Тогда
				Принято = Принято + 1;
				Открытые.Удалить(Предложение.Ссылка);
				ЭДО_Сервер.ЗаписьЖР("ЭДО.АннулированиеПринято", "Информация", Предложение.Ссылка.Метаданные(),
					Предложение.Ссылка, "Запрос контрагента на аннулирование экземпляра " + Предложение.ИдНашего
					+ " принят автоматически: " + Основание);
			Иначе
				Примеры.Добавить("ОШИБКА: не удалось принять " + Предложение.ИдПОА + ": " + Ответ.Текст);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Поставлено = 0;
	Снято = 0;
	Для Каждого КЗ Из Открытые Цикл
		Если Прежние.Получить(КЗ.Ключ) <> КЗ.Значение Тогда
			Если НЕ ТолькоПроверка Тогда
				ЭДО_Сервер.ЗаписатьСвойствоОбъекта(КЗ.Ключ, Свойство, КЗ.Значение);
			КонецЕсли;
			Поставлено = Поставлено + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Прежние Цикл
		Если Открытые.Получить(КЗ.Ключ) = Неопределено Тогда
			Если НЕ ТолькоПроверка Тогда
				ЭДО_Сервер.ЗаписатьСвойствоОбъекта(КЗ.Ключ, Свойство, "");
			КонецЕсли;
			Снято = Снято + 1;
		КонецЕсли;
	КонецЦикла;

	Текст = "ЭДО, запросы аннулирования" + ?(ТолькоПроверка, " (сухой прогон)", "") + ": за " + ОкноДней
		+ " дн. от контрагентов " + Предложения.Количество() + ", ждут нашего ответа " + Ждут
		+ ", из них документ не найден в базе " + НеНайдено + ", принято автоматически " + Принято
		+ ", помечено " + Поставлено + ", снято " + Снято;
	// Перечень - с отступом: так ЕстьОшибкаВСводе отличает его от итоговой строки.
	Если Примеры.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "  " + СтрСоединить(Примеры, Символы.ПС + "  ");
	КонецЕсли;
	Возврат Текст;

КонецФункции

// согласие на аннулирование ВХОДЯЩИХ документов от доверенных контрагентов.
// Доверенный - контрагент с флагом ЭДО_АвтоматическоеПринятиеУПД (пока те же,
// что у автоприемки УПД). Запрос принимается без человека, только если все сразу:
// - статус SENT, отправитель запроса - доверенный (ИНН из идентификатора участника);
// - аннулируется документ, который этот же отправитель прислал этой нашей организации: в имени
//   аннулируемого файла (ON_<тип>_<получатель>_<отправитель>_<дата>_...) получатель - наш ящик,
//   отправитель - ящик автора запроса;
// - карточка этого документа нашлась у оператора, и по ней в базе НЕ создано поступление
//   (иначе решает человек: что делать с поступлением - решение учета).
// Остальные запросы ждут человека, как раньше. ТолькоПроверка - посчитать, ничего не подписывая.
// Возврат: Строка - свод для журнала.
Функция ВыполнитьСогласиеНаАннулированиеВходящих(Знач ТолькоПроверка = Ложь) Экспорт

	Доверенные = ЭДО_Сервер.ИННКонтрагентовСАвтоматическимПринятием("ЭДО_АвтоматическоеПринятиеУПД");
	Счетчики = Новый Структура("Ждут, Принято, Человеку, Ошибок", 0, 0, 0, 0);
	Строки = Новый Массив;
	Пройдены = Новый Соответствие;
	Для Каждого Запись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
		Организация = Запись.Организация;
		Если НЕ ЗначениеЗаполнено(Организация) ИЛИ Пройдены.Получить(Организация) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Пройдены.Вставить(Организация, Истина);
		Попытка
			СогласиеНаАннулированиеВходящихОрганизации(Организация, Доверенные, ТолькоПроверка, Счетчики, Строки);
		Исключение
			Счетчики.Ошибок = Счетчики.Ошибок + 1;
			Строки.Добавить(Строка(Организация) + ": ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Текст = "ЭДО, согласие на аннулирование входящих" + ?(ТолькоПроверка, " (сухой прогон)", "")
		+ ": доверенных ИНН " + Доверенные.Количество() + ", запросов ждут ответа " + Счетчики.Ждут
		+ ", принято " + Счетчики.Принято + ", оставлено человеку " + Счетчики.Человеку
		+ ", ошибок " + Счетчики.Ошибок;
	Если Строки.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Текст, Счетчики.Ошибок > 0, "ЭДО.Регламент.СогласиеНаАннулированиеВходящих");
	Возврат Текст;

КонецФункции

Процедура СогласиеНаАннулированиеВходящихОрганизации(Знач Организация, Знач Доверенные, Знач ТолькоПроверка,
	Счетчики, Строки)

	Предложения = ВходящиеПредложенияАннулирования(31, Организация);
	ЭДО_Сервер.ОбеспечитьТокен(Ложь, Организация);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
	Соед = ЭДО_Сервер.СоединениеСОператором(30);
	Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/";
	НашГид = ВРег(СокрЛП(ЭДО_Сервер.ГидОрганизации(Организация)));

	Для Каждого Предложение Из Предложения Цикл
		// Запросы по НАШИМ исходящим (ИдНашего найден) - дело сторожа запросов аннулирования, не этого.
		Если Предложение.Статус <> "SENT" ИЛИ ЗначениеЗаполнено(Предложение.ИдНашего) Тогда
			Продолжить;
		КонецЕсли;
		Счетчики.Ждут = Счетчики.Ждут + 1;
		Отправитель = ВРег(СокрЛП(Предложение.Отправитель));
		Описание = Строка(Организация) + ", запрос " + Предложение.ИдПОА + " от " + Отправитель;
		ЧастиОтправителя = СтрРазделить(Отправитель, "-");
		ИНН = ?(ЧастиОтправителя.Количество() > 1, ЧастиОтправителя[1], "");
		Если Доверенные.Получить(ИНН) = Неопределено Тогда
			Счетчики.Человеку = Счетчики.Человеку + 1;
			Продолжить;   // недоверенный - молча человеку, это штатно
		КонецЕсли;

		// по цепочкам аннулируемый документ - сама входящая цепочка этого отправителя нам
		// (ПредложенияКонтрагентовПоЦепочкам): ни имя файла, ни поиск карточки не нужны (у неформализованных имя - GUID).
		ИдВходящего = Предложение.ИдВходящего;
		Если НЕ ЗначениеЗаполнено(ИдВходящего) Тогда
			ИмяФайла = ИмяАннулируемогоФайла(Соед, Заголовки, Организация, Путь + "documents/" + Предложение.ИдПОА + "/content");
			ЧастиИмени = СтрРазделить(ВРег(ИмяФайла), "_");
			Если ЧастиИмени.Количество() < 6 ИЛИ ЧастиИмени[2] <> НашГид ИЛИ ЧастиИмени[3] <> Отправитель Тогда
				Счетчики.Человеку = Счетчики.Человеку + 1;
				Строки.Добавить(Описание + ": человеку - аннулируется не документ этого отправителя нам (" + Лев(ИмяФайла, 120) + ")");
				Продолжить;
			КонецЕсли;
			ДатаФайла = ДатаИзИмениФайла(ИмяФайла);
			// Документов от поставщика может быть много - листаем выдачу (потолок оператора - 10 страниц по 100).
			Если ЗначениеЗаполнено(ДатаФайла) Тогда
				Для Страница = 0 По 9 Цикл
					Карточки = КарточкиОператора(Соед, Заголовки, Организация, Путь + "documents?recipient_id=" + НашГид
						+ "&sender_id=" + Отправитель
						+ "&created_from=" + ДатаДляОператора(ДатаФайла - 86400)
						+ "&created_till=" + ДатаДляОператора(ДатаФайла + 2 * 86400)
						+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=100");
					Для Каждого Карточка Из Карточки Цикл
						Если СтрНайти(ВРег(ИмяФайла), ВРег(Строка(Карточка["fileId"]))) = 1 Тогда
							ИдВходящего = ЭДО_Регламенты.ИдентификаторСтрокой(Карточка["id"]);
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если ЗначениеЗаполнено(ИдВходящего) ИЛИ Карточки.Количество() < 100 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ИдВходящего) Тогда
			Счетчики.Человеку = Счетчики.Человеку + 1;
			Строки.Добавить(Описание + ": человеку - карточка аннулируемого документа не найдена у оператора");
			Продолжить;
		КонецЕсли;
		// Решение - через отметку на входящем (ЭДО_Сервер.ЗахватитьВходящийДляАннулирования):
		// под коротким замком связи входящих проверяется «поступления нет» и ставится отметка этой попытки;
		// СоздатьДокументПоXML под тем же замком видит отметку и не пишет поступление. Сеть - вне замка.
		// Наш отказ (DP_UNISOOBSCH REJECTION, DP_UVUTOCH) статус ПОА не меняет - цепочка читается перед подписью.
		// Отметка снимается только при достоверном «согласия нет»; пустая цепочка или неизвестный исход подписи
		// оставляют ее (создание ждет), следующий прогон после МинутПопыткиАннулирования повторит.
		Итог = "";
		Если ТолькоПроверка Тогда
			Идентификаторы = Новый Массив;
			Идентификаторы.Добавить(ИдВходящего);
			Поступление = ЭДО_Сервер.ДокументыПоВходящим(Идентификаторы).Получить(ИдВходящего);
			Захват = Новый Структура("Захвачен, ИдПопытки, Причина", Поступление = Неопределено, "",
				?(Поступление = Неопределено, "", "по документу создано " + Строка(Поступление)));
		Иначе
			Захват = ЭДО_Сервер.ЗахватитьВходящийДляАннулирования(ИдВходящего, Предложение.ИдПОА);
		КонецЕсли;

		Если НЕ Захват.Захвачен Тогда
			Итог = "человеку - " + Захват.Причина + " (документ " + ИдВходящего + ")";
		Иначе
			Цепочка = КарточкиОператора(Соед, Заголовки, Организация, Путь + "document-flows?id=" + ИдВходящего);
			Если ТипЗнч(Цепочка) <> Тип("Массив") ИЛИ Цепочка.Количество() = 0 Тогда
				Итог = "человеку - цепочка документа (ид " + ИдВходящего + ") у оператора не прочитана"
					+ ?(ТолькоПроверка, "", ", создание по нему ждет повтора");
			ИначеЕсли МыОтветилиНаПредложение(Цепочка, Предложение.ИдПОА) Тогда
				Итог = "пропущен - на запрос уже ответили отказом или уточнением";
				Если НЕ ТолькоПроверка Тогда
					ЭДО_Сервер.ЗавершитьПопыткуАннулирования(ИдВходящего, Захват.ИдПопытки, Предложение.ИдПОА, Ложь);
				КонецЕсли;
			ИначеЕсли ТолькоПроверка Тогда
				Итог = "было бы принято (документ " + ИдВходящего + ")";
			Иначе
				Попытка
					Ответ = ЭДО_Сервер.ПринятьПредложениеАннулирования(Предложение.ИдПОА, Организация);
					Итог = ?(Ответ.Успех, "принято (документ " + ИдВходящего + ")", "ОШИБКА принятия - " + Ответ.Текст);
				Исключение
					Итог = "ОШИБКА принятия - " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецПопытки;
				Если СтрНачинаетсяС(Итог, "принято") Тогда
					ЭДО_Сервер.ЗавершитьПопыткуАннулирования(ИдВходящего, Захват.ИдПопытки, Предложение.ИдПОА, Истина);
				Иначе
					Итог = Итог + " (исход неизвестен - создание поступления по документу ждет повтора)";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если СтрНачинаетсяС(Итог, "человеку") Тогда
			Счетчики.Человеку = Счетчики.Человеку + 1;
		ИначеЕсли СтрНачинаетсяС(Итог, "пропущен") Тогда
			Счетчики.Ждут = Счетчики.Ждут - 1;   // отклоненный человеком запрос ответа уже не ждет
		ИначеЕсли СтрНачинаетсяС(Итог, "ОШИБКА") Тогда
			Счетчики.Ошибок = Счетчики.Ошибок + 1;
		Иначе
			Счетчики.Принято = Счетчики.Принято + 1;
		КонецЕсли;
		Строки.Добавить(Описание + ": " + Итог);
	КонецЦикла;

КонецПроцедуры

// Почему запрос можно принять без человека. Пустая строка - решать человеку.
Функция ОснованиеАвтоприемаАннулирования(Знач Предложение)

	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если Свойство <> Неопределено И НЕ Свойство.Пустая() Тогда
		ТекущийИд = СокрЛП(Строка(ЭДО_Сервер.ЗначениеСвойстваОбъекта(Предложение.Ссылка, Свойство)));
		Если ЗначениеЗаполнено(ТекущийИд) И ТекущийИд <> СокрЛП(Предложение.ИдНашего) Тогда
			Возврат "по документу уже отправлен другой экземпляр " + ТекущийИд;
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(Предложение.СуммаНашего) = Тип("Число") Тогда
		СуммаДокумента = Неопределено;
		Попытка
			СуммаДокумента = Предложение.Ссылка.СуммаДокумента;
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ОснованиеАвтоприемаАннулирования: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
			СуммаДокумента = Неопределено;
		КонецПопытки;
		Если ТипЗнч(СуммаДокумента) = Тип("Число") И Окр(СуммаДокумента, 2) <> Окр(Предложение.СуммаНашего, 2) Тогда
			Возврат "сумма документа " + Формат(СуммаДокумента, "ЧДЦ=2; ЧН=0")
				+ " отличается от отправленной " + Формат(Предложение.СуммаНашего, "ЧДЦ=2; ЧН=0");
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ОписаниеЗапросаАннулирования(Знач Карточка)

	// ИдВходящего - аннулируемый входящий документ, когда ПОА прочитан по цепочке;
	// через /documents его ищет согласие на аннулирование входящих.
	Предложение = Новый Структура("ИдПОА, Статус, Создан, Отправитель, Подписант, Причина, ИдНашего, Номер, ДатаДок, Ссылка, СуммаНашего, ИдВходящего",
		ЭДО_Регламенты.ИдентификаторСтрокой(Карточка["id"]), Строка(Карточка["status"]), '00010101',
		"", "", "", "", "", '00010101', Неопределено, Неопределено, "");

	Создан = СтрЗаменить(Лев(Строка(Карточка["created"]), 10), "-", "");
	Попытка
		Предложение.Создан = Дата(Создан);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ОписаниеЗапросаАннулирования: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
		Предложение.Создан = '00010101';
	КонецПопытки;

	Отправитель = Карточка.Получить("sender");
	Если ТипЗнч(Отправитель) = Тип("Соответствие") Тогда
		Предложение.Отправитель = Строка(Отправитель.Получить("id"));
	КонецЕсли;
	Подпись = Карточка.Получить("cmsData");
	Если ТипЗнч(Подпись) = Тип("Соответствие") Тогда
		Предложение.Подписант = СтрЗаменить(Строка(Подпись.Получить("commonName")), "\", "");
	КонецЕсли;
	Доп = Карточка.Получить("extra");
	Если ТипЗнч(Доп) = Тип("Соответствие") И Доп.Получить("reason") <> Неопределено Тогда
		Предложение.Причина = Строка(Доп.Получить("reason"));
	КонецЕсли;

	Возврат Предложение;

КонецФункции

// Есть ли внутри ПОА наш ответ: универсальное сообщение с отказом или уведомление об уточнении.
Функция МыОтветилиНаПредложение(Знач Узлы, Знач ИдПОА)

	Если ТипЗнч(Узлы) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Узел Из Узлы Цикл
		Если ТипЗнч(Узел) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Подчиненные = Узел.Получить("slaves");
		Если ЭДО_Регламенты.ИдентификаторСтрокой(Узел.Получить("id")) = ИдПОА Тогда
			Если ТипЗнч(Подчиненные) <> Тип("Массив") Тогда
				Возврат Ложь;
			КонецЕсли;
			Для Каждого Ответ Из Подчиненные Цикл
				ТипОтвета = Строка(Ответ.Получить("type"));
				// ответ, который оператор не доставил, - не ответ: запрос контрагента остается
				// открытым, и без этого отметка снималась, а карточка писала «ждём ответа контрагента».
				Если ОтветНеДоставлен(Ответ) Тогда
					Продолжить;
				КонецЕсли;
				Если ТипОтвета = "DP_UVUTOCH" Тогда
					Возврат Истина;
				КонецЕсли;
				Сведения = Ответ.Получить("universalMessageInfo");
				Если ТипОтвета = "DP_UNISOOBSCH" И ТипЗнч(Сведения) = Тип("Соответствие")
					И Строка(Сведения.Получить("status")) = "REJECTION" Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
			Возврат Ложь;
		КонецЕсли;
		Если МыОтветилиНаПредложение(Подчиненные, ИдПОА) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// узел цепочки в статусе неудачной отправки (SENDING_FAILED).
Функция ОтветНеДоставлен(Знач Узел)
	Статус = ВРег(СокрЛП(Строка(Узел.Получить("newStatus"))));
	Если НЕ ЗначениеЗаполнено(Статус) ИЛИ Статус = "НЕОПРЕДЕЛЕНО" Тогда
		Статус = ВРег(СокрЛП(Строка(Узел.Получить("status"))));
	КонецЕсли;
	Возврат Статус = "SENDING_FAILED";
КонецФункции

// Находим документы базы по идентификатору у оператора.
Процедура ПривязатьКДокументамБазы(Предложения, Знач Организация = Неопределено)

	Иды = Новый Массив;
	Для Каждого Предложение Из Предложения Цикл
		Если ЗначениеЗаполнено(Предложение.ИдНашего) Тогда
			Иды.Добавить(Предложение.ИдНашего);
		КонецЕсли;
	КонецЦикла;
	Если Иды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗапросБазы = Новый Запрос(
		"ВЫБРАТЬ Объект КАК Объект, ВЫРАЗИТЬ(Значение КАК СТРОКА(50)) КАК Ид
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Свойство = &Свойство И ВЫРАЗИТЬ(Значение КАК СТРОКА(50)) В (&Иды)");
	ЗапросБазы.УстановитьПараметр("Свойство", ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента"));
	ЗапросБазы.УстановитьПараметр("Иды", Иды);
	ПоИду = Новый Соответствие;
	Для Каждого Запись Из ЗапросБазы.Выполнить().Выгрузить() Цикл
		ПоИду.Вставить(СокрЛП(Запись.Ид), Запись.Объект);
	КонецЦикла;

	Для Каждого Предложение Из Предложения Цикл
		Если ЗначениеЗаполнено(Предложение.ИдНашего) Тогда
			Предложение.Ссылка = ПоИду.Получить(Предложение.ИдНашего);
		КонецЕсли;
		// После переотправки в базе записан ид новой копии, а контрагент просит аннулировать
		// прежнюю. Тогда ищем документ по номеру и дате из карточки оператора.
		Если Предложение.Ссылка = Неопределено И ЗначениеЗаполнено(Предложение.Номер) И ЗначениеЗаполнено(Предложение.ДатаДок) Тогда
			Предложение.Ссылка = ДокументПоНомеруИДате(Предложение.Номер, Предложение.ДатаДок, Организация);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Реализация или корректировка по номеру и дате. Дата у оператора может уехать на сутки
// из-за UTC, поэтому окно три дня; при нескольких совпадениях не выбираем ничего.
Функция ДокументПоНомеруИДате(Знач Номер, Знач ДатаДок, Знач Организация = Неопределено)

	ЗапросБазы = Новый Запрос(
		"ВЫБРАТЬ Р.Ссылка КАК Ссылка
		|ИЗ Документ.РеализацияТоваровУслуг КАК Р
		|ГДЕ Р.Номер = &Номер И Р.Дата МЕЖДУ &Нач И &Кон И НЕ Р.ПометкаУдаления
		|	И (&ВсеОрганизации ИЛИ Р.Организация.ИНН = &ИННОрганизации)
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ К.Ссылка
		|ИЗ Документ.КорректировкаРеализации КАК К
		|ГДЕ К.Номер = &Номер И К.Дата МЕЖДУ &Нач И &Кон И НЕ К.ПометкаУдаления
		|	И (&ВсеОрганизации ИЛИ К.Организация.ИНН = &ИННОрганизации)");
	ЗапросБазы.УстановитьПараметр("Номер", Номер);
	ЗапросБазы.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
	ЗапросБазы.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
	ЗапросБазы.УстановитьПараметр("Нач", НачалоДня(ДатаДок) - 86400);
	ЗапросБазы.УстановитьПараметр("Кон", КонецДня(ДатаДок) + 86400);
	Найдено = ЗапросБазы.Выполнить().Выгрузить();
	Если Найдено.Количество() = 1 Тогда
		Возврат Найдено[0].Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Дата из строки вида 03.09.2026.
Функция ДатаИзДДММГГГГ(Знач Текст)

	Части = СтрРазделить(СокрЛП(Текст), ".", Ложь);
	Если Части.Количество() <> 3 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ДатаИзДДММГГГГ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// GET к оператору с повтором: метод периодически не отвечает и лечится повтором,
// токен живет 15 минут и на 401 перевыпускается. Возврат: Массив карточек, пустой при отказе.
// Источник - см. ЭДО_Сервер.ПолучитьСписокОператора: для страниц одного окна - одна переменная.
// Запросов - счетчик обращений к оператору (с повторами), если передано число.
Функция КарточкиОператора(Соед, Заголовки, Знач Организация, Знач Адрес, Источник = Неопределено, Запросов = Неопределено)

	Для НомерПопытки = 1 По 3 Цикл
		Если ТипЗнч(Запросов) = Тип("Число") Тогда
			Запросов = Запросов + 1;
		КонецЕсли;
		Попытка
			Ответ = ЭДО_Сервер.ПолучитьСписокОператора(Соед, Адрес, Заголовки, Организация, , Источник);   // цепочки, /documents - резерв
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "КарточкиОператора: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
			Продолжить;
		КонецПопытки;
		Если Ответ.КодСостояния = 401 Тогда
			// токен не обновился - сразу причина, а не повтор со старым
			Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
				ВызватьИсключение "оператор ответил HTTP 401, новый токен Платформы не получен: " + Адрес;
			КонецЕсли;
			Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
			Продолжить;
		КонецЕсли;
		Если Ответ.КодСостояния <> 200 Тогда
			ВызватьИсключение "оператор ответил HTTP " + Ответ.КодСостояния + ": " + Лев(Ответ.Тело, 300);
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.Тело);
		Карточки = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Карточки;
	КонецЦикла;

	ВызватьИсключение "оператор не ответил за три попытки: " + Адрес;

КонецФункции

// Имя файла аннулируемого документа из содержимого ПОА (атрибут ИмяАнФайла).
Функция ИмяАннулируемогоФайла(Соед, Заголовки, Знач Организация, Знач Адрес)

	Для НомерПопытки = 1 По 3 Цикл
		Попытка
			Ответ = Соед.Получить(Новый HTTPЗапрос(Адрес, Заголовки));
		Исключение
			ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ИмяАннулируемогоФайла: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
			Продолжить;
		КонецПопытки;
		Если Ответ.КодСостояния = 401 Тогда
			// токен не обновился - сразу причина, а не повтор со старым
			Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
				ВызватьИсключение "оператор ответил HTTP 401, новый токен Платформы не получен: " + Адрес;
			КонецЕсли;
			Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
			Продолжить;
		КонецЕсли;
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат "";
		КонецЕсли;
		Текст = ПолучитьСтрокуИзДвоичныхДанных(Ответ.ПолучитьТелоКакДвоичныеДанные(), "windows-1251");
		Маркер = "ИмяАнФайла=""";
		Позиция = СтрНайти(Текст, Маркер);
		Если Позиция = 0 Тогда
			Возврат "";
		КонецЕсли;
		Хвост = Сред(Текст, Позиция + СтрДлина(Маркер));
		Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);
	КонецЦикла;

	Возврат "";

КонецФункции

// Дата из имени файла ЭДО: восьмизначная часть вида 20260903.
Функция ДатаИзИмениФайла(Знач ИмяФайла)

	Для Каждого Часть Из СтрРазделить(ИмяФайла, "_") Цикл
		Если СтрДлина(Часть) = 8 И Лев(Часть, 2) = "20" Тогда
			Попытка
				Возврат Дата(Часть);
			Исключение
				ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ДатаИзИмениФайла: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
				Возврат '00010101';
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Возврат '00010101';

КонецФункции

// ПОА по цепочкам, /documents - резерв (чтение оператора -
// через document-flows; сутки 401 на /documents остановили бы и эти регламенты).
// Цепочка со статусом CANCELLATION_REQUESTED - документ, по которому ждет ответа ПОА (наш или контрагента): принятый
// ПОА переводит ее в CANCELLED, и из выдачи она уходит. Сам ПОА - подчиненный DP_PRANNUL цепочки, в его карточке
// id, статус, отправитель, подписант, причина (extra.reason), а аннулируемый документ - сама цепочка. Поэтому
// не нужны ни содержимое ПОА (имя аннулируемого файла), ни поиск карточки в переписке около даты файла.
// Окно цепочек - по дате документа, а ПОА по старому документу приходит позже: цепочки берутся все с
// НачалоЦепочекПОА() кусками по 1095 дней (предел оператора на запрос), ПОА отбираются по своей дате за ОкноДней -
// тот же отбор, что created_from у /documents (при окне цепочек в год свежий ПОА по документу
// старше года пропадал молча).
// Направление - "outgoing" (наши документы) или "incoming" (документы контрагентов нам).
// Возврат: Структура(Прочитано, Карточки - Массив Структур(ПОА, Цепочка) из JSON, Причина, Запросов). Прочитано =
// Ложь - цепочки не ответили или выдача куска длиннее предела оператора (1000): вызывающий идет через /documents,
// причина - в ЖР. Запросов - обращения к оператору с повторами.
Функция ОткрытыеПОАПоЦепочкам(Соед, Заголовки, Знач Организация, Знач НашГид, Знач Направление, Знач ОкноДней)

	Итог = Новый Структура("Прочитано, Карточки, Причина, Запросов", Ложь, Новый Массив, "", 0);
	Граница = НачалоДня(ТекущаяУниверсальнаяДата()) + 86400;
	НачалоПОА = Граница - ОкноДней * 86400;
	Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/document-flows/" + Направление + "?owner_id=" + НашГид
		+ "&status=CANCELLATION_REQUESTED";
	Запросов = 0;
	Взятые = Новый Соответствие;   // id ПОА: цепочка на стыке кусков может прийти дважды
	// Попытка: КарточкиОператора бросает на отказ оператора - тогда резервный путь, причина - в журнал.
	Попытка
		КонецКуска = Граница;
		Пока КонецКуска > НачалоЦепочекПОА() Цикл
			НачалоКуска = Макс(НачалоЦепочекПОА(), КонецКуска - 1095 * 86400);
			КусокПрочитан = Ложь;
			Для Страница = 0 По 19 Цикл   // предел выдачи цепочек: (page + 1) * page_size <= 1000
				Цепочки = КарточкиОператора(Соед, Заголовки, Организация, Путь + "&created_after=" + ДатаДляОператора(НачалоКуска)
					+ "&created_before=" + ДатаДляОператора(КонецКуска) + "&page=" + Формат(Страница, "ЧН=0; ЧГ=0")
					+ "&page_size=50", , Запросов);
				Если ТипЗнч(Цепочки) <> Тип("Массив") Тогда
					ВызватьИсключение "document-flows/" + Направление + " вернул не массив";
				КонецЕсли;
				Для Каждого Цепочка Из Цепочки Цикл
					Подчиненные = ?(ТипЗнч(Цепочка) = Тип("Соответствие"), Цепочка.Получить("slaves"), Неопределено);
					Если ТипЗнч(Подчиненные) <> Тип("Массив") Тогда
						Продолжить;
					КонецЕсли;
					Для Каждого ПОА Из Подчиненные Цикл
						// _ACCEPTANCE - подпись ответа на ПОА, не сам запрос (как у /documents)
						Если ТипЗнч(ПОА) = Тип("Соответствие") И Строка(ПОА.Получить("type")) = "DP_PRANNUL"
							И ВРег(Прав(Строка(ПОА.Получить("fileId")), 11)) <> "_ACCEPTANCE"
							И ДатаИзСтрокиОператора(ПОА.Получить("created")) >= НачалоПОА
							И Взятые.Получить(ЭДО_Регламенты.ИдентификаторСтрокой(ПОА.Получить("id"))) = Неопределено Тогда
							Взятые.Вставить(ЭДО_Регламенты.ИдентификаторСтрокой(ПОА.Получить("id")), Истина);
							Итог.Карточки.Добавить(Новый Структура("ПОА, Цепочка", ПОА, Цепочка));
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
				Если Цепочки.Количество() < 50 Тогда
					КусокПрочитан = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ КусокПрочитан Тогда
				ВызватьИсключение "цепочек с запросом аннулирования больше 1000 с " + Формат(НачалоКуска, "ДФ=dd.MM.yyyy");
			КонецЕсли;
			КонецКуска = НачалоКуска;
		КонецЦикла;
		Итог.Прочитано = Истина;
		Итог.Запросов = Запросов;
		Возврат Итог;
	Исключение
		Итог.Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Итог.Запросов = Запросов;
	ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , ,
		"ОткрытыеПОАПоЦепочкам (" + Направление + "): " + Итог.Причина + " - чтение через /documents");
	Итог.Карточки = Новый Массив;
	Возврат Итог;

КонецФункции

// С какой даты документа искать цепочки с открытым ПОА: с запасом раньше первых документов у оператора.
Функция НачалоЦепочекПОА()
	Возврат '20200101';
КонецФункции

// Дата (без времени, UTC) из строки оператора вида ГГГГ-ММ-ДДTчч:мм:сс.ffffffZ; пусто - пустая дата.
Функция ДатаИзСтрокиОператора(Знач Значение)
	Цифры = СтрЗаменить(Лев(Строка(Значение), 10), "-", "");
	Если СтрДлина(Цифры) <> 8 Тогда
		Возврат '00010101';
	КонецЕсли;
	Возврат Дата(Цифры);
КонецФункции

// Запросы контрагентов на аннулирование по цепочкам: на наш документ (ИдНашего, номер, дата, сумма - из цепочки;
// отказ человека - из нее же, как у /documents) и на их документ нам (ИдВходящего).
// Возврат: Массив - как у ВходящиеПредложенияАннулирования без привязки к базе; Неопределено - цепочки не прочитаны.
Функция ПредложенияКонтрагентовПоЦепочкам(Соед, Заголовки, Знач Организация, Знач НашГид, Знач ОкноДней)

	Предложения = Новый Массив;
	Для Каждого Направление Из СтрРазделить("outgoing,incoming", ",") Цикл
		Открытые = ОткрытыеПОАПоЦепочкам(Соед, Заголовки, Организация, НашГид, Направление, ОкноДней);
		Если НЕ Открытые.Прочитано Тогда
			Возврат Неопределено;
		КонецЕсли;
		Для Каждого Пара Из Открытые.Карточки Цикл
			Предложение = ОписаниеЗапросаАннулирования(Пара.ПОА);
			Если ВРег(Предложение.Отправитель) = ВРег(НашГид) Тогда
				Продолжить;   // наш ПОА - дело сторожа наших аннулирований
			КонецЕсли;
			ИдЦепочки = ЭДО_Регламенты.ИдентификаторСтрокой(Пара.Цепочка.Получить("id"));
			Если Направление = "outgoing" Тогда
				Предложение.ИдНашего = ИдЦепочки;
				Счет = ЭДО_Сервер.РеквизитыКарточкиОператора(Пара.Цепочка);
				Если Счет <> Неопределено Тогда
					Предложение.Номер = СокрЛП(Строка(Счет.Получить("num")));
					Предложение.ДатаДок = ДатаИзДДММГГГГ(Строка(Счет.Получить("date")));
					Если ТипЗнч(Счет.Получить("sum")) = Тип("Число") Тогда
						Предложение.СуммаНашего = Счет.Получить("sum");
					КонецЕсли;
				КонецЕсли;
				// Отказ универсальным сообщением статус ПОА не меняет - см. ВходящиеПредложенияАннулирования.
				Если Предложение.Статус = "SENT" И МыОтветилиНаПредложение(МассивИзЗначения(Пара.Цепочка), Предложение.ИдПОА) Тогда
					Предложение.Статус = "REJECTED";
				КонецЕсли;
			Иначе
				// Входящая цепочка - документ нам; ПОА на нее от ее же отправителя - аннулирование его документа.
				// Иной отправитель - разбор прежним путем (ИдВходящего пуст).
				ОтправительЦепочки = Пара.Цепочка.Получить("sender");
				Если ТипЗнч(ОтправительЦепочки) = Тип("Соответствие")
					И ВРег(Строка(ОтправительЦепочки.Получить("id"))) = ВРег(Предложение.Отправитель) Тогда
					Предложение.ИдВходящего = ИдЦепочки;
				КонецЕсли;
			КонецЕсли;
			Предложения.Добавить(Предложение);
		КонецЦикла;
	КонецЦикла;
	Возврат Предложения;

КонецФункции

// Наши ПОА без согласия контрагента по цепочкам (Итог.Наших, Итог.Запросов - счетчики сторожа).
// Аннулируемый экземпляр - цепочка исходящих; по документу контрагента (входящие) ИдНашего пуст, как у /documents.
// Возврат: Массив - как у НашиПредложенияАннулирования до привязки к базе; Неопределено - цепочки не прочитаны.
Функция НашиПредложенияПоЦепочкам(Соед, Заголовки, Знач Организация, Знач НашГид, Знач ОкноДней, Итог)

	Предложения = Новый Массив;
	// число наших ПОА - в Итог только после обоих направлений: при отказе второго резерв
	// /documents считает те же ПОА заново. Счетчик запросов - сразу.
	Наших = 0;
	Для Каждого Направление Из СтрРазделить("outgoing,incoming", ",") Цикл
		Открытые = ОткрытыеПОАПоЦепочкам(Соед, Заголовки, Организация, НашГид, Направление, ОкноДней);
		Итог.Запросов = Итог.Запросов + Открытые.Запросов;
		Если НЕ Открытые.Прочитано Тогда
			Возврат Неопределено;
		КонецЕсли;
		Для Каждого Пара Из Открытые.Карточки Цикл
			Отправитель = Пара.ПОА.Получить("sender");
			Если ТипЗнч(Отправитель) <> Тип("Соответствие") ИЛИ ВРег(Строка(Отправитель.Получить("id"))) <> ВРег(НашГид) Тогда
				Продолжить;
			КонецЕсли;
			Наших = Наших + 1;
			Если Строка(Пара.ПОА.Получить("status")) <> "SENT" ИЛИ Строка(Пара.ПОА.Получить("newStatus")) <> "SENT" Тогда
				Продолжить;
			КонецЕсли;
			Предложение = ОписаниеНашегоЗапросаАннулирования(Пара.ПОА);
			Если Направление = "outgoing" Тогда
				Предложение.ИдНашего = ЭДО_Регламенты.ИдентификаторСтрокой(Пара.Цепочка.Получить("id"));
				Счет = ЭДО_Сервер.РеквизитыКарточкиОператора(Пара.Цепочка);
				Если Счет <> Неопределено Тогда
					Предложение.Номер = СокрЛП(Строка(Счет.Получить("num")));
					Предложение.ДатаДок = ДатаИзДДММГГГГ(Строка(Счет.Получить("date")));
				КонецЕсли;
			КонецЕсли;
			// Отказ контрагента статус ПОА не меняет - см. ОтметитьОтклоненныеКонтрагентом.
			Если МыОтветилиНаПредложение(МассивИзЗначения(Пара.Цепочка), Предложение.ИдПОА) Тогда
				Предложение.Статус = "REJECTED";
			КонецЕсли;
			Предложения.Добавить(Предложение);
		КонецЦикла;
	КонецЦикла;
	Итог.Наших = Итог.Наших + Наших;
	Возврат Предложения;

КонецФункции

Функция МассивИзЗначения(Знач Значение)
	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;
КонецФункции

Функция ДатаДляОператора(Знач Момент)

	Возврат Формат(Момент, "ДФ=yyyy-MM-dd") + "T" + Формат(Момент, "ДФ=HH:mm:ss") + "Z";

КонецФункции

// Наши запросы на аннулирование, которые контрагент не подтвердил.
// Пока контрагент не подписал наш ПОА, исходный экземпляр у него действует, а у оператора
// ПОА просто висит в SENT. Сторож собирает наши ПОА без ответа и кладет снимок для центра
// управления: по нему бухгалтерия дожимает контрагентов. Сколько дней ждать ответа, решает
// витрина по настройке ДнейБезПодтвержденияПОА, поэтому смена срока не требует прогона.
// Отдельного задания нет: сторож идет следом за сторожем входящих запросов тем же заданием.
// Разбор содержимого ПОА и поиск аннулируемой карточки - те же, что у входящих.

// Сколько дней назад смотреть наши ПОА.
Функция ОкноНашихАннулированийДней()
	Возврат 90;
КонецФункции

Функция ВыполнитьСторожНашихАннулирований() Экспорт

	Строки = Новый Массив;
	ЕстьОшибка = Ложь;

	Организации = Новый Массив;
	Если ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Организации.Добавить(УчетнаяЗапись.Организация);
		КонецЦикла;
	Иначе
		Организации.Добавить(Неопределено);
	КонецЕсли;

	Прежний = СнимокНашихАннулирований();
	Снимок = НовыйСнимокНашихАннулирований();

	Для Каждого Организация Из Организации Цикл
		Префикс = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ");
		Попытка
			Сверка = НашиПредложенияАннулирования(ОкноНашихАннулированийДней(), Организация, Прежний);
			Для Каждого СтрокаСверки Из Сверка.Предложения Цикл
				ЗаполнитьЗначенияСвойств(Снимок.Предложения.Добавить(), СтрокаСверки);
			КонецЦикла;
			Строки.Добавить(Префикс + ОписаниеНашихАннулирований(Сверка));
		Исключение
			ЕстьОшибка = Истина;
			Снимок.Неполно = Истина;
			Строки.Добавить(Префикс + "ЭДО, наши запросы аннулирования: ОШИБКА " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ХранилищеОбщихНастроек.Сохранить(КлючСнимкаНашихАннулирований(), "Снимок", Снимок,
			"наши запросы аннулирования без ответа", "");
	Исключение
		ЕстьОшибка = Истина;
		Строки.Добавить("ЭДО, наши запросы аннулирования: снимок для центра не сохранен - " + ОписаниеОшибки());
	КонецПопытки;

	Результат = СтрСоединить(Строки, Символы.ПС);
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, ЕстьОшибка, "ЭДО.Регламент.СторожНашихАннулирований");
	Возврат Результат;

КонецФункции

// Итог последнего прогона для центра управления.
// Возврат: Неопределено, если сторож еще не запускался, иначе Структура
//   ДатаПрогона, ОкноДней, Неполно - прогон прочитал оператора не целиком;
//   Предложения - ТаблицаЗначений, колонки см. НовыйСнимокНашихАннулирований.
Функция СнимокНашихАннулирований() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Значение = ХранилищеОбщихНастроек.Загрузить(КлючСнимкаНашихАннулирований(), "Снимок", , "");
	Если ТипЗнч(Значение) <> Тип("Структура") ИЛИ НЕ Значение.Свойство("Предложения") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция КлючСнимкаНашихАннулирований()
	Возврат "ЭДО_СторожНашихАннулирований";
КонецФункции

// Пустой снимок наших ПОА. Колонка Статус - SENT (ответа нет) или REJECTED (контрагент
// отклонил, у оператора ПОА остается SENT); Документ - документ базы или Неопределено,
// если аннулируемый экземпляр в базе не найден.
Функция НовыйСнимокНашихАннулирований()

	Предложения = Новый ТаблицаЗначений;
	Предложения.Колонки.Добавить("ИдПОА", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("Создан", Новый ОписаниеТипов("Дата"));
	Предложения.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("Получатель", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("ИдНашего", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Предложения.Колонки.Добавить("ДатаДок", Новый ОписаниеТипов("Дата"));
	Предложения.Колонки.Добавить("Документ");
	Предложения.Колонки.Добавить("Контрагент");
	Предложения.Колонки.Добавить("Организация");

	Возврат Новый Структура("ДатаПрогона, ОкноДней, Неполно, Предложения",
		ТекущаяДатаСеанса(), ОкноНашихАннулированийДней(), Ложь, Предложения);

КонецФункции

// Наши ПОА за окно, на которые контрагент не ответил согласием.
// Прежний - снимок прошлого прогона: у ПОА, уже сопоставленного с карточкой, содержимое
// повторно не читается, иначе каждый прогон стоил бы сотни запросов.
// Возврат: Структура (Наших, Ждут, Отклонено, НетВБазе, Запросов, Предложения - ТаблицаЗначений).
Функция НашиПредложенияАннулирования(Знач ОкноДней, Знач Организация, Знач Прежний)

	Итог = Новый Структура("Наших, Ждут, Отклонено, НетВБазе, Запросов, Предложения",
		0, 0, 0, 0, 0, НовыйСнимокНашихАннулирований().Предложения);

	Сопоставленные = Новый Соответствие;
	Если Прежний <> Неопределено Тогда
		Для Каждого СтрокаПрежнего Из Прежний.Предложения Цикл
			Если ЗначениеЗаполнено(СтрокаПрежнего.ИдНашего) Тогда
				Сопоставленные.Вставить(СтрокаПрежнего.ИдПОА, СтрокаПрежнего);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
		ВызватьИсключение "не удалось получить токен";
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
	Соед = ЭДО_Сервер.СоединениеСОператором(30);
	Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/";
	НашГид = ЭДО_Сервер.ГидОрганизации(Организация);

	// сначала по цепочкам (см. ОткрытыеПОАПоЦепочкам): аннулируемый экземпляр - сама цепочка,
	// отказ контрагента - внутри нее; ниже - прежний путь через /documents.
	Предложения = НашиПредложенияПоЦепочкам(Соед, Заголовки, Организация, НашГид, ОкноДней, Итог);
	Если Предложения <> Неопределено Тогда
		ЗаполнитьСнимокНашихАннулирований(Итог, Предложения, Организация);
		Возврат Итог;
	КонецЕсли;

	// Подтвержденный ПОА у оператора ACCEPTED, у абонентов самой Платформы - SENT с newStatus
	// CANCELLED. SENDING_FAILED до контрагента не дошел, дожимать там некого.
	Предложения = Новый Массив;
	Граница = НачалоДня(ТекущаяУниверсальнаяДата()) + 86400;
	Начало = Граница - ОкноДней * 86400;
	Пока Граница > Начало Цикл
		ОтДаты = Макс(Начало, Граница - 31 * 86400);
		Для Страница = 0 По 9 Цикл
			Карточки = КарточкиОператора(Соед, Заголовки, Организация, Путь + "documents?sender_id=" + НашГид
				+ "&type=CANCELLATION&created_from=" + ДатаДляОператора(ОтДаты)
				+ "&created_till=" + ДатаДляОператора(Граница)
				+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=100");
			Итог.Запросов = Итог.Запросов + 1;
			Для Каждого Карточка Из Карточки Цикл
				Если ВРег(Прав(Строка(Карточка["fileId"]), 11)) = "_ACCEPTANCE" Тогда
					Продолжить;
				КонецЕсли;
				Итог.Наших = Итог.Наших + 1;
				Если Строка(Карточка["status"]) <> "SENT" ИЛИ Строка(Карточка["newStatus"]) <> "SENT" Тогда
					Продолжить;
				КонецЕсли;
				Предложения.Добавить(ОписаниеНашегоЗапросаАннулирования(Карточка));
			КонецЦикла;
			Если Карточки.Количество() < 100 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Граница = ОтДаты;
	КонецЦикла;

	// Аннулируемый экземпляр называет только имя файла внутри ПОА: ищем карточку в переписке
	// с получателем ПОА около даты из имени файла.
	Кэш = Новый Соответствие;
	Для Каждого Предложение Из Предложения Цикл
		СтрокаПрежнего = Сопоставленные.Получить(Предложение.ИдПОА);
		Если СтрокаПрежнего <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Предложение, СтрокаПрежнего, "ИдНашего, Номер, ДатаДок");
			Продолжить;
		КонецЕсли;

		ИмяФайла = ИмяАннулируемогоФайла(Соед, Заголовки, Организация, Путь + "documents/" + Предложение.ИдПОА + "/content");
		Итог.Запросов = Итог.Запросов + 1;
		ДатаФайла = ДатаИзИмениФайла(ИмяФайла);
		Если НЕ ЗначениеЗаполнено(ДатаФайла) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Предложение.Получатель + Формат(ДатаФайла, "ДФ=yyyyMMdd");
		Переписка = Кэш.Получить(Ключ);
		Если Переписка = Неопределено Тогда
			Переписка = КарточкиОператора(Соед, Заголовки, Организация, Путь + "documents?sender_id=" + НашГид
				+ "&recipient_id=" + Предложение.Получатель
				+ "&created_from=" + ДатаДляОператора(ДатаФайла - 86400)
				+ "&created_till=" + ДатаДляОператора(ДатаФайла + 2 * 86400)
				+ "&page=0&page_size=100");
			Итог.Запросов = Итог.Запросов + 1;
			Кэш.Вставить(Ключ, Переписка);
		КонецЕсли;
		Для Каждого Наш Из Переписка Цикл
			Если СтрНайти(ИмяФайла, Строка(Наш["fileId"])) = 1 Тогда
				Предложение.ИдНашего = ЭДО_Регламенты.ИдентификаторСтрокой(Наш["id"]);
				Счет = ЭДО_Сервер.РеквизитыКарточкиОператора(Наш);   // extra вместо invoice
				Если Счет <> Неопределено Тогда
					Предложение.Номер = СокрЛП(Строка(Счет.Получить("num")));
					Предложение.ДатаДок = ДатаИзДДММГГГГ(Строка(Счет.Получить("date")));
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Итог.Запросов = Итог.Запросов + ОтметитьОтклоненныеКонтрагентом(Предложения, Соед, Заголовки, Организация, Путь);
	ЗаполнитьСнимокНашихАннулирований(Итог, Предложения, Организация);
	Возврат Итог;

КонецФункции

// Привязать наши ПОА к документам базы и сложить в Итог.Предложения со счетчиками.
Процедура ЗаполнитьСнимокНашихАннулирований(Итог, Предложения, Знач Организация)

	ПривязатьКДокументамБазы(Предложения, Организация);
	КонтрагентыПоАдресам = КонтрагентыПоАдресуЭДО();

	Для Каждого Предложение Из Предложения Цикл
		НоваяСтрока = Итог.Предложения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Предложение, "ИдПОА, Создан, Статус, Получатель, Причина, ИдНашего, Номер, ДатаДок");
		НоваяСтрока.Документ = Предложение.Ссылка;
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.Контрагент = КонтрагентыПоАдресам.Получить(Предложение.Получатель);
		Если Предложение.Ссылка = Неопределено Тогда
			Итог.НетВБазе = Итог.НетВБазе + 1;
		ИначеЕсли Предложение.Ссылка.Метаданные().Реквизиты.Найти("Контрагент") <> Неопределено Тогда
			НоваяСтрока.Контрагент = Предложение.Ссылка.Контрагент;
		КонецЕсли;
		Если Предложение.Статус = "REJECTED" Тогда
			Итог.Отклонено = Итог.Отклонено + 1;
		Иначе
			Итог.Ждут = Итог.Ждут + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОписаниеНашегоЗапросаАннулирования(Знач Карточка)

	Предложение = Новый Структура("ИдПОА, Статус, Создан, Получатель, Причина, ИдНашего, Номер, ДатаДок, Ссылка",
		ЭДО_Регламенты.ИдентификаторСтрокой(Карточка["id"]), "SENT", '00010101', "", "", "", "", '00010101', Неопределено);

	// Оператор отдает время в UTC, в снимке - местное: с ним сравнивает витрина.
	Создан = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(Строка(Карточка["created"]), 19), "-", ""), "T", ""), ":", "");
	Попытка
		Предложение.Создан = МестноеВремя(Дата(Создан));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ОписаниеНашегоЗапросаАннулирования: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
		Предложение.Создан = '00010101';
	КонецПопытки;

	Получатель = Карточка.Получить("recipient");
	Если ТипЗнч(Получатель) = Тип("Соответствие") Тогда
		Предложение.Получатель = ВРег(СокрЛП(Строка(Получатель.Получить("id"))));
	КонецЕсли;
	Доп = Карточка.Получить("extra");
	Если ТипЗнч(Доп) = Тип("Соответствие") И Доп.Получить("reason") <> Неопределено Тогда
		Предложение.Причина = Строка(Доп.Получить("reason"));
	КонецЕсли;

	Возврат Предложение;

КонецФункции

// Отказ контрагента от нашего ПОА статус не меняет: ответ ложится внутрь ПОА в цепочке
// аннулируемого документа. Цепочки читаем пачками по 50 - больше метод не отдает.
// Возврат: число запросов к оператору.
Функция ОтметитьОтклоненныеКонтрагентом(Предложения, Соед, Заголовки, Знач Организация, Знач Путь)

	Запросов = 0;
	Пачка = Новый Массив;
	Индекс = 0;
	Для Каждого Предложение Из Предложения Цикл
		Индекс = Индекс + 1;
		Если ЗначениеЗаполнено(Предложение.ИдНашего) И Пачка.Найти(Предложение.ИдНашего) = Неопределено Тогда
			Пачка.Добавить(Предложение.ИдНашего);
		КонецЕсли;
		Если (Пачка.Количество() < 50 И Индекс < Предложения.Количество()) ИЛИ Пачка.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Цепочки = КарточкиОператора(Соед, Заголовки, Организация, Путь + "document-flows?id="
			+ СтрСоединить(Пачка, ",") + "&page=0&page_size=50");
		Запросов = Запросов + 1;
		Для Каждого Проверяемое Из Предложения Цикл
			Если Пачка.Найти(Проверяемое.ИдНашего) <> Неопределено
				И МыОтветилиНаПредложение(Цепочки, Проверяемое.ИдПОА) Тогда
				Проверяемое.Статус = "REJECTED";
			КонецЕсли;
		КонецЦикла;
		Пачка = Новый Массив;
	КонецЦикла;

	Возврат Запросов;

КонецФункции

// Соответствие "адрес ЭДО прописными" -> контрагент по свойству ЭДО_АдресКонтрагента.
Функция КонтрагентыПоАдресуЭДО()

	Результат = Новый Соответствие;
	Свойство = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента", Истина);
	Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Объект КАК Объект, ВЫРАЗИТЬ(Значение КАК СТРОКА(100)) КАК Адрес
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов
		|ГДЕ Свойство = &Свойство И Объект ССЫЛКА Справочник.Контрагенты");
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Адрес = ВРег(СокрЛП(Выборка.Адрес));
		Если ЗначениеЗаполнено(Адрес) И Результат.Получить(Адрес) = Неопределено Тогда
			Результат.Вставить(Адрес, Выборка.Объект);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОписаниеНашихАннулирований(Знач Сверка)

	Текст = "ЭДО, наши запросы аннулирования: за " + ОкноНашихАннулированийДней() + " дн. наших ПОА "
		+ Сверка.Наших + ", без ответа " + Сверка.Ждут + ", отклонено контрагентом " + Сверка.Отклонено
		+ ", документ не найден в базе " + Сверка.НетВБазе + ", запросов к оператору " + Сверка.Запросов;

	Примеры = Новый Массив;
	Для Каждого СтрокаСверки Из Сверка.Предложения Цикл
		Если Примеры.Количество() >= 20 Тогда
			Прервать;
		КонецЕсли;
		Примеры.Добавить(Формат(СтрокаСверки.Создан, "ДФ=dd.MM.yyyy") + " "
			+ ?(ЗначениеЗаполнено(СтрокаСверки.Номер), СтрокаСверки.Номер, "ПОА " + СтрокаСверки.ИдПОА)
			+ " - " + Строка(СтрокаСверки.Контрагент) + ?(СтрокаСверки.Статус = "REJECTED", " - ОТКЛОНЕН", "")
			+ " - " + Лев(СтрЗаменить(СтрокаСверки.Причина, Символы.ПС, " "), 80));
	КонецЦикла;
	Если Примеры.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Примеры, Символы.ПС);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Аннулирование лишних экземпляров документа.
// У документа, отправленного несколько раз, у контрагента должен действовать один экземпляр -
// тот, чей ид записан в документе (ЭДО_ИдентификаторДокумента). По остальным действующим
// экземплярам регламент шлет предложение об аннулировании (ПОА) с причиной "дубль отправки".
// Только документы старше 7 дней: оперативную работу не трогаем.
// Экземпляры ищутся у оператора по текущему адресу контрагента: ушедший на прежний адрес не виден.
// Документ, у которого записанный экземпляр не среди действующих, не трогаем - это разбор для человека.

// Сколько ПОА регламент готов отправить за прогон. Больше - признак ошибки отбора, а не
// реальных дублей: не отправляем ничего и пишем ошибку в журнал.
Функция ПотолокАннулированийЗаПрогон()
	Возврат 20;
КонецФункции

// ТолькоПроверка - найти лишние экземпляры и записать свод в журнал, ПОА не отправлять.
Функция ВыполнитьАннулированиеЛишнихЭкземпляров(Знач ТолькоПроверка = Ложь, Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьАннулированиеЛишнихЭкземпляров(ТолькоПроверка, УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	// Регламент работает под своим пользователем: право изменять документы у него может не быть, а
	// ПредложитьАннулирование без привилегированного режима отказала бы всему прогону.
	// модуль с вызовом сервера - привилегии только в регламентном
	// задании (клиент свой сеанс им не сделает). Прямой вызов идет с проверкой прав в ПредложитьАннулирование.
	ФоновоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если ФоновоеЗадание <> Неопределено И ФоновоеЗадание.РегламентноеЗадание <> Неопределено Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		Результат = АннулироватьЛишниеЭкземпляры(ТолькоПроверка, Организация);
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.АннулированиеЛишнихЭкземпляров");
	Возврат Результат;

КонецФункции

Функция АннулироватьЛишниеЭкземпляры(Знач ТолькоПроверка, Знач Организация = Неопределено)

	Заголовок = "ЭДО, лишние экземпляры" + ?(ТолькоПроверка, " (сухой прогон)", "");
	СвойствоИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая() Тогда
		Возврат Заголовок + ": ОШИБКА - нет свойства ЭДО_ИдентификаторДокумента";
	КонецЕсли;

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	ЗапросБазы = Новый Запрос(
		"ВЫБРАТЬ Р.Ссылка КАК Ссылка, ВЫРАЗИТЬ(З.Значение КАК СТРОКА(50)) КАК Ид
		|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК З
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Р
		|	ПО З.Объект = Р.Ссылка
		|ГДЕ З.Свойство = &Свойство
		|	И ВЫРАЗИТЬ(З.Значение КАК СТРОКА(50)) <> """"
		|	И Р.Дата МЕЖДУ &Начало И &Конец
		|	И НЕ Р.ПометкаУдаления
		|	И (&ВсеОрганизации ИЛИ Р.Организация.ИНН = &ИННОрганизации)");
	ЗапросБазы.УстановитьПараметр("Свойство", СвойствоИд);
	ЗапросБазы.УстановитьПараметр("Начало", Сегодня - 14 * 86400);
	ЗапросБазы.УстановитьПараметр("Конец", Сегодня - 7 * 86400 - 1);
	ЗапросБазы.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
	ЗапросБазы.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
	ОтправленныеДокументы = ЗапросБазы.Выполнить().Выгрузить();

	Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
		Возврат Заголовок + ": ОШИБКА - не удалось получить токен";
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
	Соединение = ЭДО_Сервер.СоединениеСОператором(5);
	НашГид = ЭДО_Сервер.ГидОрганизации(Организация);

	Предложенные = ПредложенныеАннулирования();
	Кандидаты = Новый Массив;
	НеОпрошено = 0;
	БезАдреса = 0;
	ТекущийНеДействует = 0;
	УжеПредложено = 0;
	Черновики = 0;
	Примеры = Новый Массив;
	Для Каждого СтрокаДокумента Из ОтправленныеДокументы Цикл
		ГидПолучателя = ЭДО_Сервер.ИдентификаторУчастникаЭДО(СтрокаДокумента.Ссылка.Контрагент);
		Если НЕ ЗначениеЗаполнено(ГидПолучателя) Тогда
			БезАдреса = БезАдреса + 1;
			Продолжить;
		КонецЕсли;
		Опрос = ЭДО_Сервер.КарточкиДокументаУОператора(Соединение, Заголовки, НашГид, ГидПолучателя,
			СокрЛП(СтрокаДокумента.Ссылка.Номер), СтрокаДокумента.Ссылка.Дата);
		Если НЕ Опрос.Опрошено Тогда
			НеОпрошено = НеОпрошено + 1;
			Продолжить;
		КонецЕсли;

		ТекущийИд = СокрЛП(СтрокаДокумента.Ид);
		Лишние = Новый Массив;
		ТекущийДействует = Ложь;
		Для Каждого Карточка Из Опрос.Карточки Цикл
			Если НЕ Карточка.Живая Тогда
				Продолжить;
			ИначеЕсли НЕ КарточкаУшлаКонтрагенту(Карточка.Статус) Тогда
				Черновики = Черновики + 1;
				Продолжить;
			ИначеЕсли Карточка.Ид = ТекущийИд Тогда
				ТекущийДействует = Истина;
			Иначе
				Лишние.Добавить(Карточка.Ид);
			КонецЕсли;
		КонецЦикла;
		Если Лишние.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ТекущийДействует Тогда
			ТекущийНеДействует = ТекущийНеДействует + 1;
			Если Примеры.Количество() < 20 Тогда
				Примеры.Добавить(СокрЛП(СтрокаДокумента.Ссылка.Номер) + ": записанный экземпляр " + ТекущийИд
					+ " не действует, действуют " + СтрСоединить(Лишние, ", ") + " - пропущен");
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Для Каждого ИдЛишнего Из Лишние Цикл
			Если Предложенные.Получить(ИдЛишнего) <> Неопределено Тогда
				УжеПредложено = УжеПредложено + 1;
				Продолжить;
			КонецЕсли;
			Кандидаты.Добавить(Новый Структура("Ссылка, ИдЛишнего, ТекущийИд", СтрокаДокумента.Ссылка, ИдЛишнего, ТекущийИд));
		КонецЦикла;
	КонецЦикла;

	Отправлено = 0;
	Ошибки = 0;
	Если Кандидаты.Количество() > ПотолокАннулированийЗаПрогон() Тогда
		Примеры.Вставить(0, "ОШИБКА - лишних экземпляров " + Кандидаты.Количество() + ", больше потолка "
			+ ПотолокАннулированийЗаПрогон() + ": ничего не отправлено, нужен разбор");
	Иначе
		Для Каждого Кандидат Из Кандидаты Цикл
			Описание = СокрЛП(Кандидат.Ссылка.Номер) + " экземпляр " + Кандидат.ИдЛишнего
				+ " (действует " + Кандидат.ТекущийИд + ")";
			Если ТолькоПроверка Тогда
				Если Примеры.Количество() < 20 Тогда
					Примеры.Добавить(Описание);
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Ответ = ЭДО_Сервер.ПредложитьАннулирование(Кандидат.ИдЛишнего, ЭДО_Сервер.ПричинаАннулированияДубля(), Кандидат.Ссылка);
			Если Ответ.Успех Тогда
				Отправлено = Отправлено + 1;
				Предложенные.Вставить(Кандидат.ИдЛишнего, ТекущаяДатаСеанса());
				ЭДО_Сервер.ЗаписьЖР("ЭДО.АннулированиеПредложено", "Информация", Кандидат.Ссылка.Метаданные(),
					Кандидат.Ссылка, "Лишний экземпляр " + Кандидат.ИдЛишнего + " (действует " + Кандидат.ТекущийИд
					+ "): " + Ответ.Текст);
			Иначе
				Ошибки = Ошибки + 1;
				Примеры.Добавить("ОШИБКА " + Описание + ": " + Ответ.Текст);
			КонецЕсли;
		КонецЦикла;
		Если Отправлено > 0 Тогда
			СохранитьПредложенныеАннулирования(Предложенные);
		КонецЕсли;
	КонецЕсли;

	Текст = Заголовок + ": документов " + ОтправленныеДокументы.Количество() + " (" + Формат(Сегодня - 14 * 86400, "ДФ=dd.MM")
		+ "-" + Формат(Сегодня - 7 * 86400 - 1, "ДФ=dd.MM") + "), не опрошено " + НеОпрошено
		+ ", без адреса " + БезАдреса + ", записанный экземпляр не действует " + ТекущийНеДействует
		+ ", неотправленных черновиков " + Черновики
		+ ", лишних " + Кандидаты.Количество() + ", уже предлагали " + УжеПредложено
		+ ", отправлено ПОА " + Отправлено + ", ошибок " + Ошибки;
	Если Примеры.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Примеры, Символы.ПС);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Дошел ли экземпляр до контрагента. Черновик (NEW) и экземпляр, ждущий подписи или оплаты
// (AWAIT_...), контрагент не получал: аннулировать там нечего.
Функция КарточкаУшлаКонтрагенту(Знач Статус)

	Статус = ВРег(СокрЛП(Статус));
	Возврат Статус <> "NEW" И Лев(Статус, 6) <> "AWAIT_";

КонецФункции

// Экземпляры, по которым регламент уже отправил ПОА: Соответствие "ид экземпляра" -> дата.
// Нужно, чтобы после отказа контрагента не слать ему то же предложение каждый день.
Функция ПредложенныеАннулирования()

	УстановитьПривилегированныйРежим(Истина);
	Значение = ХранилищеОбщихНастроек.Загрузить("ЭДО_АннулированиеЛишних", "Предложенные", , "");
	Предложенные = Новый Соответствие;
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Граница = ТекущаяДатаСеанса() - 90 * 86400;
		Для Каждого КЗ Из Значение Цикл
			Если КЗ.Значение > Граница Тогда
				Предложенные.Вставить(КЗ.Ключ, КЗ.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Предложенные;

КонецФункции

Процедура СохранитьПредложенныеАннулирования(Знач Предложенные)

	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("ЭДО_АннулированиеЛишних", "Предложенные", Предложенные, , "");

КонецПроцедуры

// Сторож адреса получателя: документ ушел не туда, куда контрагенту надо слать сегодня.
// Документ помнит адрес, на который его отправили, карточка контрагента - адрес, куда слать
// сейчас. Расходятся они молча: у оператора документ честно SENT, ошибки нет.
// Расхождение - только SENT и DELIVERED. ACCEPTED в прежнем ящике трогать нельзя (контрагент
// подписал), REJECTED и SENDING_FAILED - другие классы, их ведут свои механизмы.
// Заодно сторож перечисляет контрагентов с живой связью, у которых нет адреса: адреса ЭДО
// (при отгрузках за окно) или почтового адреса, без которого оператор бракует УПД.
// Сторож только сообщает: ничего не переотправляет и адреса не меняет.

// Сколько дней назад смотреть карточки оператора.
Функция ОкноСторожаАдресовДней()
	Возврат 45;
КонецФункции

// Сколько строк списка писать в журнал: запись журнала режется на 5000 символов.
Функция СтрокСпискаАдресов()
	Возврат 25;
КонецФункции

Функция ВыполнитьСторожАдресовПолучателя() Экспорт

	Строки = Новый Массив;
	ЕстьОшибка = Ложь;

	Организации = Новый Массив;
	Если ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Организации.Добавить(УчетнаяЗапись.Организация);
		КонецЦикла;
	Иначе
		Организации.Добавить(Неопределено);
	КонецЕсли;

	Снимок = НовыйСнимокСторожаАдресов();

	Для Каждого Организация Из Организации Цикл
		Префикс = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ");
		Попытка
			Сверка = РасхожденияАдресовПолучателя(ОкноСторожаАдресовДней(), Организация);
			Строки.Добавить(Префикс + ОписаниеСверкиАдресов(Сверка));
			ДобавитьСверкуВСнимок(Снимок, Сверка);
			Если Сверка.НеполныхДней > 0 ИЛИ Сверка.ПереполненоДней > 0 Тогда
				Снимок.Неполно = Истина;
			КонецЕсли;
			Если Сверка.НеполныхДней > 0 Тогда
				ЕстьОшибка = Истина;
			КонецЕсли;
		Исключение
			ЕстьОшибка = Истина;
			Снимок.Неполно = Истина;
			Строки.Добавить(Префикс + "ЭДО, адрес получателя: ОШИБКА " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Попытка
		Карточки = КарточкиСЖивойСвязьюБезАдреса(ОкноСторожаАдресовДней(), Организации);
		Строки.Добавить(ОписаниеКарточекБезАдреса(Карточки));
		Снимок.БезАдреса = Карточки;
	Исключение
		ЕстьОшибка = Истина;
		Строки.Добавить("ЭДО, живая связь без адреса: ОШИБКА " + ОписаниеОшибки());
	КонецПопытки;

	// Снимок читает центр управления. Его сбой не должен терять запись журнала.
	Попытка
		СохранитьСнимокСторожаАдресов(Снимок);
	Исключение
		ЕстьОшибка = Истина;
		Строки.Добавить("ЭДО, адрес получателя: снимок для центра не сохранен - " + ОписаниеОшибки());
	КонецПопытки;

	Результат = СтрСоединить(Строки, Символы.ПС);
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, ЕстьОшибка, "ЭДО.Регламент.СторожАдресовПолучателя");
	Возврат Результат;

КонецФункции

// Итог последнего прогона сторожа адреса получателя для центра управления.
// Возврат: Неопределено, если сторож еще не запускался, иначе Структура
//   ДатаПрогона, ОкноДней, Неполно - прогон прочитал оператора не целиком;
//   Расхождения - ТаблицаЗначений (Документ, Контрагент, Ид, Статус, ОтправленоНа, ТекущийАдрес, Сумма, Причина, ПорядокПричины);
//   БезАдреса - ТаблицаЗначений (Контрагент, Связь, ЕстьАдресЭДО, ЕстьАдресКИ);
//   НеВСчет - сколько расхождений не показано (см. РасхожденияАдресовПолучателя). В старых снимках полей причины нет.
Функция СнимокСторожаАдресов() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Значение = ХранилищеОбщихНастроек.Загрузить(КлючСнимкаСторожаАдресов(), "Снимок", , "");
	Если ТипЗнч(Значение) <> Тип("Структура") ИЛИ НЕ Значение.Свойство("Расхождения") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция КлючСнимкаСторожаАдресов()
	Возврат "ЭДО_СторожАдресовПолучателя";
КонецФункции

Функция НовыйСнимокСторожаАдресов()

	Расхождения = Новый ТаблицаЗначений;
	Расхождения.Колонки.Добавить("Документ");
	Расхождения.Колонки.Добавить("Контрагент");
	Расхождения.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ОтправленоНа", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ТекущийАдрес", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Расхождения.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ПорядокПричины", Новый ОписаниеТипов("Число"));

	БезАдреса = Новый ТаблицаЗначений;
	БезАдреса.Колонки.Добавить("Контрагент");
	БезАдреса.Колонки.Добавить("Связь", Новый ОписаниеТипов("Строка"));
	БезАдреса.Колонки.Добавить("ЕстьАдресЭДО", Новый ОписаниеТипов("Булево"));
	БезАдреса.Колонки.Добавить("ЕстьАдресКИ", Новый ОписаниеТипов("Булево"));

	Возврат Новый Структура("ДатаПрогона, ОкноДней, Неполно, Расхождения, БезАдреса, НеВСчет",
		ТекущаяДатаСеанса(), ОкноСторожаАдресовДней(), Ложь, Расхождения, БезАдреса, 0);

КонецФункции

Процедура ДобавитьСверкуВСнимок(Снимок, Знач Сверка)

	Для Каждого СтрокаСверки Из Сверка.Расхождения Цикл
		ЗаполнитьЗначенияСвойств(Снимок.Расхождения.Добавить(), СтрокаСверки);
	КонецЦикла;
	Для Каждого КЗ Из Сверка.НеВСчет Цикл
		Снимок.НеВСчет = Снимок.НеВСчет + КЗ.Значение;
	КонецЦикла;

КонецПроцедуры

Процедура СохранитьСнимокСторожаАдресов(Знач Снимок)

	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить(КлючСнимкаСторожаАдресов(), "Снимок", Снимок,
		"итог сторожа адреса получателя", "");

КонецПроцедуры

// Отправленные документы, чья действующая карточка у оператора ушла не на текущий адрес контрагента.
// Карточки обходятся по суткам: интервал шире суток с постраничным обходом теряет часть карточек.
// С документом базы карточка сопоставляется по ЭДО_ИдентификаторДокумента, поэтому прежние
// экземпляры переотправленного документа в сверку не попадают.
// Не в счет, делать по ним нечего: документ удален или не проведен в базе, у оператора уже
// запрошено аннулирование, контрагент подписал другой экземпляр, организации запрещена отправка.
// Возврат: Структура
//   Расхождения - ТаблицаЗначений (Документ, Контрагент, Ид, Статус, ОтправленоНа, ТекущийАдрес, Сумма, Документов, Причина);
//   Отправленных, Сверено, НетВБазе, НеполныхДней, ПереполненоДней, Запросов, Ошибки, ОкноДней - счетчики;
//   НеВСчет - Структура (Удален, АннулированиеЗапрошено, ПодписанДругой, БезРазрешения).
Функция РасхожденияАдресовПолучателя(Знач ОкноДней = 45, Знач Организация = Неопределено) Экспорт

	Итог = Новый Структура("Отправленных, Сверено, НетВБазе, НеполныхДней, ПереполненоДней, Запросов, Ошибки, ОкноДней, Расхождения, НеВСчет",
		0, 0, 0, 0, 0, 0, "", ОкноДней, Неопределено,
		Новый Структура("Удален, АннулированиеЗапрошено, ПодписанДругой, БезРазрешения", 0, 0, 0, 0));

	Расхождения = Новый ТаблицаЗначений;
	Расхождения.Колонки.Добавить("Документ");
	Расхождения.Колонки.Добавить("Контрагент");
	Расхождения.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ОтправленоНа", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ТекущийАдрес", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Расхождения.Колонки.Добавить("Документов", Новый ОписаниеТипов("Число"));
	Расхождения.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));
	Расхождения.Колонки.Добавить("ПорядокПричины", Новый ОписаниеТипов("Число"));
	Расхождения.Колонки.Добавить("НаПаузе", Новый ОписаниеТипов("Булево"));
	Итог.Расхождения = Расхождения;

	СвойствоИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента", Истина);
	СвойствоАдреса = ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента", Истина);
	СвойствоПаузы = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ОтправкаПриостановлена");
	РазрешенныеОрганизации = ЭДО_Сервер.ОрганизацииСРазрешеннойОтправкой();

	Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
		ВызватьИсключение "не удалось получить токен";
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept", "application/json;charset=UTF-8");
	Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
	Соединение = ЭДО_Сервер.СоединениеСОператором(30);
	Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?sender_id=" + ЭДО_Сервер.ГидОрганизации(Организация);

	// Ид карточки -> Структура(Получатель, Статус, НовыйСтатус, Сумма, НомерДокумента): только отправленные и доставленные.
	Отправленные = Новый Соответствие;
	Подписанные = Новый Соответствие;
	РазмерСтраницы = 100;
	Финиш = НачалоДня(ТекущаяУниверсальнаяДата());
	Интервалы = Новый Массив;
	День = Финиш - (ОкноДней - 1) * 86400;
	Пока День <= Финиш Цикл
		Интервалы.Добавить(Новый Структура("Начало, Конец", День, День + 86399));
		День = День + 86400;
	КонецЦикла;

	// Оператор отвечает HTTP 400 на page=10, поэтому из интервала видно не больше 1000 карточек.
	// Упершийся в потолок интервал делится пополам и обходится заново: повтор безопасен,
	// карточки складываются по ид. Потолок числа интервалов - на случай аварии выдачи.
	ПотолокИнтервалов = ОкноДней * 32;
	Индекс = 0;
	Пока Индекс < Интервалы.Количество() Цикл
		Интервал = Интервалы[Индекс];
		Индекс = Индекс + 1;
		Попытка
			ИсточникИнтервала = "";   // страницы интервала - одним источником
			Для Страница = 0 По 9 Цикл
				Карточки = КарточкиОператора(Соединение, Заголовки, Организация, Путь
					+ "&created_from=" + ДатаДляОператора(Интервал.Начало)
					+ "&created_till=" + ДатаДляОператора(Интервал.Конец)
					+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=" + Формат(РазмерСтраницы, "ЧГ=0"),
					ИсточникИнтервала);
				Итог.Запросов = Итог.Запросов + 1;
				Для Каждого Карточка Из Карточки Цикл
					ДобавитьОтправленнуюКарточку(Отправленные, Подписанные, Карточка);
				КонецЦикла;
				Если Карточки.Количество() < РазмерСтраницы Тогда
					Прервать;
				КонецЕсли;
				Если Страница < 9 Тогда
					Продолжить;
				КонецЕсли;
				Середина = Интервал.Начало + Цел((Интервал.Конец - Интервал.Начало) / 2);
				Если Интервалы.Количество() + 2 > ПотолокИнтервалов ИЛИ Середина <= Интервал.Начало Тогда
					Итог.ПереполненоДней = Итог.ПереполненоДней + 1;
				Иначе
					Интервалы.Добавить(Новый Структура("Начало, Конец", Интервал.Начало, Середина));
					Интервалы.Добавить(Новый Структура("Начало, Конец", Середина + 1, Интервал.Конец));
				КонецЕсли;
			КонецЦикла;
		Исключение
			Итог.НеполныхДней = Итог.НеполныхДней + 1;
			Если НЕ ЗначениеЗаполнено(Итог.Ошибки) Тогда
				Итог.Ошибки = Формат(Интервал.Начало, "ДФ=dd.MM HH:mm") + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	Итог.Отправленных = Отправленные.Количество();
	Если Отправленные.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	Иды = Новый Массив;
	Для Каждого КЗ Из Отправленные Цикл
		Иды.Добавить(КЗ.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЗначениеИд.Значение КАК СТРОКА(50)) КАК Ид,
	|	ЗначениеИд.Объект КАК ДокументБазы,
	|	ВЫБОР
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.РеализацияТоваровУслуг).Контрагент
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.КорректировкаРеализации
	|			ТОГДА ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.КорректировкаРеализации).Контрагент
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.АктСверкиВзаиморасчетов
	|			ТОГДА ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.АктСверкиВзаиморасчетов).Контрагент
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.РеализацияТоваровУслуг).Организация
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.КорректировкаРеализации
	|			ТОГДА ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.КорректировкаРеализации).Организация
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.АктСверкиВзаиморасчетов
	|			ТОГДА ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.АктСверкиВзаиморасчетов).Организация
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ТОГДА НЕ ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.РеализацияТоваровУслуг).Проведен
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.КорректировкаРеализации
	|			ТОГДА НЕ ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.КорректировкаРеализации).Проведен
	|		КОГДА ЗначениеИд.Объект ССЫЛКА Документ.АктСверкиВзаиморасчетов
	|			ТОГДА ВЫРАЗИТЬ(ЗначениеИд.Объект КАК Документ.АктСверкиВзаиморасчетов).ПометкаУдаления
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Удален
	|ПОМЕСТИТЬ ДокументыСИд
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначениеИд
	|ГДЕ
	|	ЗначениеИд.Свойство = &СвойствоИд
	|	И ВЫРАЗИТЬ(ЗначениеИд.Значение КАК СТРОКА(50)) В (&Иды)
	|;
	|ВЫБРАТЬ
	|	Док.Ид КАК Ид,
	|	Док.ДокументБазы КАК ДокументБазы,
	|	Док.Контрагент КАК Контрагент,
	|	Док.Организация КАК Организация,
	|	Док.Удален КАК Удален,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Адрес.Значение КАК СТРОКА(50)), """") КАК ТекущийАдрес,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК БУЛЕВО), ЛОЖЬ) = ИСТИНА
	|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Пауза.Значение КАК СТРОКА(50)), """") В (""Да"", ""Истина"", ""1"") КАК НаПаузе
	|ИЗ
	|	ДокументыСИд КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Адрес
	|		ПО Адрес.Объект = Док.Контрагент
	|			И Адрес.Свойство = &СвойствоАдреса
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Пауза
	|		ПО Пауза.Объект = Док.Контрагент
	|			И Пауза.Свойство = &СвойствоПаузы";
	Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
	Запрос.УстановитьПараметр("СвойствоАдреса", СвойствоАдреса);
	Запрос.УстановитьПараметр("СвойствоПаузы", СвойствоПаузы);
	Запрос.УстановитьПараметр("Иды", Иды);
	Выборка = Запрос.Выполнить().Выбрать();

	Найдено = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Ид = СокрЛП(Выборка.Ид);
		Отправленная = Отправленные.Получить(Ид);
		Если Отправленная = Неопределено ИЛИ Найдено.Получить(Ид) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Найдено.Вставить(Ид, Истина);
		Итог.Сверено = Итог.Сверено + 1;

		ТекущийАдрес = ВРег(СокрЛП(Выборка.ТекущийАдрес));
		Если ТекущийАдрес = Отправленная.Получатель Тогда
			Продолжить;
		КонецЕсли;

		Если Выборка.Удален Тогда
			Итог.НеВСчет.Удален = Итог.НеВСчет.Удален + 1;
			Продолжить;
		ИначеЕсли Отправленная.НовыйСтатус = "CANCELLATION_REQUESTED" ИЛИ Отправленная.НовыйСтатус = "CANCELLED" Тогда
			Итог.НеВСчет.АннулированиеЗапрошено = Итог.НеВСчет.АннулированиеЗапрошено + 1;
			Продолжить;
		ИначеЕсли ЗначениеЗаполнено(Отправленная.НомерДокумента)
			И Подписанные.Получить(Отправленная.НомерДокумента) <> Неопределено Тогда
			Итог.НеВСчет.ПодписанДругой = Итог.НеВСчет.ПодписанДругой + 1;
			Продолжить;
		ИначеЕсли РазрешенныеОрганизации.Количество() > 0 И ЗначениеЗаполнено(Выборка.Организация)
			И РазрешенныеОрганизации.Найти(Выборка.Организация) = Неопределено Тогда
			Итог.НеВСчет.БезРазрешения = Итог.НеВСчет.БезРазрешения + 1;
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Расхождения.Добавить();
		НоваяСтрока.Документ = Выборка.ДокументБазы;
		НоваяСтрока.Контрагент = Выборка.Контрагент;
		НоваяСтрока.Ид = Ид;
		НоваяСтрока.Статус = Отправленная.Статус;
		НоваяСтрока.ОтправленоНа = Отправленная.Получатель;
		НоваяСтрока.ТекущийАдрес = ТекущийАдрес;
		НоваяСтрока.Сумма = Отправленная.Сумма;
		НоваяСтрока.Документов = 1;
		НоваяСтрока.НаПаузе = Выборка.НаПаузе;
	КонецЦикла;

	Итог.НетВБазе = Отправленные.Количество() - Итог.Сверено;

	ЗаполнитьПричиныРасхождений(Расхождения, Соединение, Заголовки, Организация);
	Возврат Итог;

КонецФункции

// Причина расхождения - по связи с текущим адресом контрагента: от нее зависит, можно ли переотправить.
Процедура ЗаполнитьПричиныРасхождений(Расхождения, Соединение, Заголовки, Знач Организация)

	Адреса = Новый Массив;
	Для Каждого СтрокаРасхождения Из Расхождения Цикл
		Если ЗначениеЗаполнено(СтрокаРасхождения.ТекущийАдрес) И Адреса.Найти(СтрокаРасхождения.ТекущийАдрес) = Неопределено Тогда
			Адреса.Добавить(СтрокаРасхождения.ТекущийАдрес);
		КонецЕсли;
	КонецЦикла;

	Обход = Неопределено;
	Если Адреса.Количество() > 0 Тогда
		Обход = ЭДО_Сервер.СтатусыСвязейПолно(Соединение, Заголовки, ЭДО_Сервер.ГидОрганизации(Организация), Адреса);
	КонецЕсли;

	Для Каждого СтрокаРасхождения Из Расхождения Цикл
		Порядок = ПорядокПричиныРасхождения(СтрокаРасхождения.ТекущийАдрес, Обход);
		СтрокаРасхождения.ПорядокПричины = Порядок;
		СтрокаРасхождения.Причина = ПричиныРасхожденийАдресов()[Порядок - 1]
			+ ?(СтрокаРасхождения.НаПаузе, "; контрагент на паузе", "");
	КонецЦикла;

КонецПроцедуры

// Тексты причин в порядке разбора: сначала то, что можно сделать сразу.
Функция ПричиныРасхожденийАдресов() Экспорт

	Причины = Новый Массив;
	Причины.Добавить("Можно переотправить: связь с текущим адресом есть");
	Причины.Добавить("Ждем роуминг: контрагент не принял приглашение");
	Причины.Добавить("Связь с текущим адресом разорвана");
	Причины.Добавить("Нет связи с текущим адресом");
	Причины.Добавить("У контрагента нет адреса ЭДО");
	Причины.Добавить("Статус связи не получен");
	Возврат Причины;

КонецФункции

// Номер причины в ПричиныРасхожденийАдресов(), начиная с 1.
Функция ПорядокПричиныРасхождения(Знач ТекущийАдрес, Знач Обход)

	Если НЕ ЗначениеЗаполнено(ТекущийАдрес) Тогда
		Возврат 5;
	КонецЕсли;

	Состояние = ?(Обход = Неопределено, Неопределено, ЭДО_Сервер.СостояниеСвязи(Обход.Связи, ТекущийАдрес));
	Если Состояние = Неопределено Тогда
		// Для пары абонентов самой Платформы (2VO) оператор связей не отдает: связь прямая.
		Если Лев(ТекущийАдрес, 3) = "2VO" Тогда
			Возврат 1;
		ИначеЕсли Обход = Неопределено ИЛИ Обход.Неудач > 0 Тогда
			Возврат 6;
		КонецЕсли;
		Возврат 4;
	КонецЕсли;

	Если Состояние.Статус = "ESTABLISHED" Тогда
		Возврат 1;
	ИначеЕсли Состояние.Статус = "AWAIT_APPROVAL" Тогда
		Возврат 2;
	ИначеЕсли Состояние.Статус = "BROKEN" Тогда
		Возврат 3;
	КонецЕсли;
	Возврат 4;

КонецФункции

// Подписанные - номера документов, у которых есть принятый контрагентом экземпляр.
Процедура ДобавитьОтправленнуюКарточку(Отправленные, Подписанные, Знач Карточка)

	Если ТипЗнч(Карточка) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Сумма = 0;
	НомерДокумента = "";
	Счет = ЭДО_Сервер.РеквизитыКарточкиОператора(Карточка);   // extra вместо invoice
	Если ТипЗнч(Счет) = Тип("Соответствие") Тогда
		Если ТипЗнч(Счет.Получить("sum")) = Тип("Число") Тогда
			Сумма = Счет.Получить("sum");
		КонецЕсли;
		НомерДокумента = КлючНомераДокумента(Счет.Получить("num"), Счет.Получить("date"));
	КонецЕсли;

	Статус = ВРег(СокрЛП(Строка(Карточка.Получить("status"))));
	Если Статус = "ACCEPTED" И ЗначениеЗаполнено(НомерДокумента) Тогда
		Подписанные.Вставить(НомерДокумента, Истина);
		Возврат;
	КонецЕсли;
	Если Статус <> "SENT" И Статус <> "DELIVERED" Тогда
		Возврат;
	КонецЕсли;
	Получатель = Карточка.Получить("recipient");
	Если ТипЗнч(Получатель) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Отправленные.Вставить(ЭДО_Регламенты.ИдентификаторСтрокой(Карточка.Получить("id")),
		Новый Структура("Получатель, Статус, НовыйСтатус, Сумма, НомерДокумента",
			ВРег(СокрЛП(Строка(Получатель.Получить("id")))), Статус,
			ВРег(СокрЛП(Строка(Карточка.Получить("newStatus")))), Сумма, НомерДокумента));

КонецПроцедуры

// Номер и дата документа из карточки оператора: так опознаются экземпляры одного документа.
Функция КлючНомераДокумента(Знач НомерДокумента, Знач ДатаДокумента)

	НомерДокумента = ВРег(СокрЛП(Строка(НомерДокумента)));
	Если НЕ ЗначениеЗаполнено(НомерДокумента) Тогда
		Возврат "";
	КонецЕсли;
	Возврат НомерДокумента + "|" + СокрЛП(Строка(ДатаДокумента));

КонецФункции

Функция ОписаниеСверкиАдресов(Знач Сверка)

	Расхождения = Сверка.Расхождения;
	СуммаВсего = Расхождения.Итог("Сумма");
	БезАдреса = Расхождения.НайтиСтроки(Новый Структура("ТекущийАдрес", "")).Количество();

	Текст = "ЭДО, адрес получателя: за " + Формат(Сверка.ОкноДней, "ЧН=0; ЧГ=0") + " дн. у оператора отправлено и доставлено "
		+ Формат(Сверка.Отправленных, "ЧН=0; ЧГ=0")
		+ ", сверено с базой " + Формат(Сверка.Сверено, "ЧН=0; ЧГ=0") + ", нет в базе " + Формат(Сверка.НетВБазе, "ЧН=0; ЧГ=0")
		+ ", ушли не на текущий адрес " + Формат(Расхождения.Количество(), "ЧН=0; ЧГ=0")
		+ " на " + Формат(СуммаВсего, "ЧДЦ=2; ЧН=0; ЧГ=0; ЧРД=.") + " руб."
		+ ?(БезАдреса > 0, ", из них у контрагента адреса нет вовсе " + Формат(БезАдреса, "ЧГ=0"), "")
		+ ", запросов " + Формат(Сверка.Запросов, "ЧН=0; ЧГ=0");
	Если Сверка.ПереполненоДней > 0 Тогда
		Текст = Текст + Символы.ПС + "НЕПОЛНО: интервалов, где карточек больше 1000 и делить дальше нельзя, - " + Формат(Сверка.ПереполненоДней, "ЧГ=0");
	КонецЕсли;
	Если Сверка.НеполныхДней > 0 Тогда
		Текст = Текст + Символы.ПС + "ОШИБКА: не прочитано интервалов " + Формат(Сверка.НеполныхДней, "ЧГ=0") + ", первая - " + Сверка.Ошибки;
	КонецЕсли;
	НеВСчет = Сверка.НеВСчет;
	Текст = Текст + Символы.ПС + "Не в счет: удалены или не проведены в базе " + Формат(НеВСчет.Удален, "ЧН=0; ЧГ=0")
		+ ", аннулирование уже запрошено " + Формат(НеВСчет.АннулированиеЗапрошено, "ЧН=0; ЧГ=0")
		+ ", подписан другой экземпляр " + Формат(НеВСчет.ПодписанДругой, "ЧН=0; ЧГ=0")
		+ ", организации запрещена отправка " + Формат(НеВСчет.БезРазрешения, "ЧН=0; ЧГ=0");
	Если Расхождения.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	ПоПричинам = Расхождения.Скопировать(, "ПорядокПричины, Сумма, Документов");
	ПоПричинам.Свернуть("ПорядокПричины", "Сумма, Документов");
	ПоПричинам.Сортировать("ПорядокПричины");
	Причины = ПричиныРасхожденийАдресов();
	Для Каждого Группа Из ПоПричинам Цикл
		Текст = Текст + Символы.ПС + Причины[Группа.ПорядокПричины - 1] + ": " + Формат(Группа.Документов, "ЧГ=0")
			+ " док. на " + Формат(Группа.Сумма, "ЧДЦ=2; ЧН=0; ЧГ=0; ЧРД=.");
	КонецЦикла;

	Группы = Расхождения.Скопировать(, "Контрагент, ОтправленоНа, ТекущийАдрес, Сумма, Документов");
	Группы.Свернуть("Контрагент, ОтправленоНа, ТекущийАдрес", "Сумма, Документов");
	Группы.Сортировать("Сумма Убыв");
	Счетчик = 0;
	Для Каждого Группа Из Группы Цикл
		Счетчик = Счетчик + 1;
		Если Счетчик > СтрокСпискаАдресов() Тогда
			Текст = Текст + Символы.ПС + "... и еще групп " + Формат(Группы.Количество() - СтрокСпискаАдресов(), "ЧГ=0");
			Прервать;
		КонецЕсли;
		Текст = Текст + Символы.ПС + СокрЛП(Строка(Группа.Контрагент)) + ": " + Формат(Группа.Документов, "ЧГ=0")
			+ " док. на " + Формат(Группа.Сумма, "ЧДЦ=2; ЧН=0; ЧГ=0; ЧРД=.") + ", ушли на " + Группа.ОтправленоНа
			+ ", сейчас " + ?(ЗначениеЗаполнено(Группа.ТекущийАдрес), Группа.ТекущийАдрес, "адреса нет");
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Контрагенты с живой связью (ESTABLISHED, DIRECT), у которых нет адреса: адреса ЭДО при
// отгрузках за окно либо почтового адреса по той же цепочке, что и гейт отправки
// (карточка, затем карточка-тезка по ИНН).
// Организации - Массив организаций учетных записей ЭДО (Неопределено - единственная запись).
// Возврат: ТаблицаЗначений (Контрагент, Связь, ЕстьАдресЭДО, ЕстьАдресКИ, ИНН).
Функция КарточкиСЖивойСвязьюБезАдреса(Знач ОкноДней = 45, Знач Организации = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = ЭДО_Сервер.ТекстТаблицАдресаПокупателя() + "
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Реализация.Контрагент КАК Контрагент
	|ПОМЕСТИТЬ СОтгрузками
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Дата >= &Граница
	|	И Реализация.Проведен
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|ВЫБРАТЬ
	|	Карточка.Ссылка КАК Контрагент,
	|	ВЫРАЗИТЬ(Связь.Значение КАК СТРОКА(50)) КАК Связь,
	|	НЕ АдресЭДО.Объект ЕСТЬ NULL КАК ЕстьАдресЭДО,
	|	НЕ (САдресом.Контрагент ЕСТЬ NULL И ИННСАдресом.ИНН ЕСТЬ NULL) КАК ЕстьАдресКИ,
	|	Карточка.ИНН КАК ИНН
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК Связь
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Карточка
	|		ПО Связь.Объект = Карточка.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК АдресЭДО
	|		ПО АдресЭДО.Объект = Карточка.Ссылка
	|			И АдресЭДО.Свойство = &СвойствоАдреса
	|			И ВЫРАЗИТЬ(АдресЭДО.Значение КАК СТРОКА(50)) <> """"
	|		ЛЕВОЕ СОЕДИНЕНИЕ КарточкиСАдресом КАК САдресом
	|		ПО САдресом.Контрагент = Карточка.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИННСАдресом КАК ИННСАдресом
	|		ПО ИННСАдресом.ИНН = Карточка.ИНН
	|			И НЕ Карточка.ИНН = """"
	|		ЛЕВОЕ СОЕДИНЕНИЕ СОтгрузками КАК СОтгрузками
	|		ПО СОтгрузками.Контрагент = Карточка.Ссылка
	|ГДЕ
	|	Связь.Свойство = &СвойствоСвязи
	|	И ВЫРАЗИТЬ(Связь.Значение КАК СТРОКА(50)) В (&ЖивыеСвязи)
	|	И НЕ Карточка.ПометкаУдаления
	|	И (АдресЭДО.Объект ЕСТЬ NULL
	|				И НЕ СОтгрузками.Контрагент ЕСТЬ NULL
	|			ИЛИ САдресом.Контрагент ЕСТЬ NULL
	|				И ИННСАдресом.ИНН ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Карточка.Наименование";
	ЭДО_Сервер.УстановитьПараметрыАдресаПокупателя(Запрос);
	ЖивыеСвязи = Новый Массив;
	ЖивыеСвязи.Добавить("ESTABLISHED");
	ЖивыеСвязи.Добавить("DIRECT");
	Запрос.УстановитьПараметр("ЖивыеСвязи", ЖивыеСвязи);
	// свое свойство статуса связи у основной учетной записи.
	СвойствоСвязи = ЭДО_Сервер.СвойствоСтатусаСвязиОрганизации();
	Если СвойствоСвязи = Неопределено ИЛИ СвойствоСвязи.Пустая() Тогда
		ВызватьИсключение "ЭДО: не заведено свойство статуса связи основной учетной записи";
	КонецЕсли;
	Запрос.УстановитьПараметр("СвойствоСвязи", СвойствоСвязи);
	Запрос.УстановитьПараметр("СвойствоАдреса", ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента", Истина));
	Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяДатаСеанса()) - ОкноДней * 86400);

	Карточки = Запрос.Выполнить().Выгрузить();
	ОтброситьСвязиСнятогоАдреса(Карточки, ?(Организации = Неопределено, Новый Массив(1), Организации));
	Возврат Карточки;

КонецФункции

// Снимая адрес без замены (ЭДО Лайт), регламент связей оставляет в карточке статус связи этого адреса.
// Живой связь без адреса ЭДО считается, только если у контрагента есть подтвержденный адрес,
// годный для автовыбора. Неполный опрос оператора ничего не отбрасывает.
Процедура ОтброситьСвязиСнятогоАдреса(Карточки, Знач Организации)

	Проверяемые = Карточки.НайтиСтроки(Новый Структура("ЕстьАдресЭДО", Ложь));
	Если Проверяемые.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Реестр = ЭДО_Сервер.ЗагрузитьРеестрАдресов();
	Адреса = Новый Массив;
	Для Каждого Карточка Из Проверяемые Цикл
		Запись = Реестр[СокрЛП(Карточка.ИНН)];
		Если Запись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Адрес Из Запись.Адреса Цикл
			Если НЕ ЭДО_Сервер.АдресЭДОВнеАвтовыбора(Адрес) И Адреса.Найти(Адрес) = Неопределено Тогда
				Адреса.Добавить(Адрес);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Живые = Новый Соответствие;
	Если Адреса.Количество() > 0 Тогда
		Для Каждого Организация Из Организации Цикл
			Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
				Возврат;
			КонецЕсли;
			Заголовки = Новый Соответствие;
			Заголовки.Вставить("accept", "application/json;charset=UTF-8");
			Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
			Обход = ЭДО_Сервер.СтатусыСвязейПолно(ЭДО_Сервер.СоединениеСОператором(30), Заголовки,
				ЭДО_Сервер.ГидОрганизации(Организация), Адреса);
			Если Обход.Неудач > 0 Тогда
				Возврат;
			КонецЕсли;
			Для Каждого Адрес Из Адреса Цикл
				Состояние = ЭДО_Сервер.СостояниеСвязи(Обход.Связи, Адрес);
				Если Состояние <> Неопределено И Состояние.Статус = "ESTABLISHED" Тогда
					Живые.Вставить(Адрес, Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Карточка Из Проверяемые Цикл
		Запись = Реестр[СокрЛП(Карточка.ИНН)];
		Если Запись = Неопределено ИЛИ Запись.Адреса.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЕстьЖивой = Ложь;
		Для Каждого Адрес Из Запись.Адреса Цикл
			Если Живые[Адрес] <> Неопределено Тогда
				ЕстьЖивой = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЕстьЖивой Тогда
			Карточки.Удалить(Карточка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОписаниеКарточекБезАдреса(Знач Карточки)

	БезАдресаЭДО = Карточки.НайтиСтроки(Новый Структура("ЕстьАдресЭДО", Ложь)).Количество();
	БезАдресаКИ = Карточки.НайтиСтроки(Новый Структура("ЕстьАдресКИ", Ложь)).Количество();
	Текст = "ЭДО, живая связь без адреса: контрагентов " + Формат(Карточки.Количество(), "ЧН=0; ЧГ=0")
		+ ", без адреса ЭДО при отгрузках за окно " + Формат(БезАдресаЭДО, "ЧН=0; ЧГ=0")
		+ ", без почтового адреса (и у тезок по ИНН) " + Формат(БезАдресаКИ, "ЧН=0; ЧГ=0");

	Счетчик = 0;
	Для Каждого Карточка Из Карточки Цикл
		Счетчик = Счетчик + 1;
		Если Счетчик > СтрокСпискаАдресов() Тогда
			Текст = Текст + Символы.ПС + "... и еще " + Формат(Карточки.Количество() - СтрокСпискаАдресов(), "ЧГ=0");
			Прервать;
		КонецЕсли;
		НетАдресов = Новый Массив;
		Если НЕ Карточка.ЕстьАдресЭДО Тогда
			НетАдресов.Добавить("адреса ЭДО");
		КонецЕсли;
		Если НЕ Карточка.ЕстьАдресКИ Тогда
			НетАдресов.Добавить("почтового адреса");
		КонецЕсли;
		Текст = Текст + Символы.ПС + СокрЛП(Строка(Карточка.Контрагент)) + " (" + Карточка.Связь + "): нет "
			+ СтрСоединить(НетАдресов, " и ");
	КонецЦикла;

	Возврат Текст;

КонецФункции
