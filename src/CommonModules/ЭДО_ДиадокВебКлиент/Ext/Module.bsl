// Клиент веб-кабинета Диадока: вход по логину и паролю через auth.kontur.ru и работа
// с внутренним WebAPI кабинета. Куки сессии передаются строкой между вызовами.
//
// Вход двухшаговый: пароль может потребовать одноразовый код (СМС или приложение).
// Первый вызов возвращает ТребуетсяКод = Истина и частичный токен, второй принимает код.

Функция ВойтиВКабинет(Знач Логин, Знач Пароль) Экспорт

	Результат = Новый Структура("Успех, ТребуетсяКод, ЧастичныйТокен, Пользователь, Телефон, Куки, Текст, Способ",
		Ложь, Ложь, "", "", "", "", "", "sms");
	Попытка
		Соединение = Новый HTTPСоединение("auth.kontur.ru", 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL());
		Куки = Новый Соответствие;
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/"));
		КукиИзОтвета(Ответ, Куки);
		ЧастичныйТокен = "";
		Результат = ШагПароля(Соединение, Логин, Пароль, Куки, ЧастичныйТокен);
	Исключение
		Результат.Текст = "Ошибка входа: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция ПодтвердитьКод(Знач Код, Знач ЧастичныйТокен, Знач Пользователь, Знач Телефон, Знач КукиСтрокой) Экспорт

	Результат = Новый Структура("Успех, ТребуетсяКод, ЧастичныйТокен, Пользователь, Телефон, Куки, Текст, Способ",
		Ложь, Ложь, ЧастичныйТокен, Пользователь, Телефон, КукиСтрокой, "", Способ);
	Попытка
		Соединение = Новый HTTPСоединение("auth.kontur.ru", 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL());
		Куки = КукиИзСтроки(КукиСтрокой);
		Csrf = Куки.Получить("AntiForgery");
		Если Способ = "totp" Тогда
			Данные = Новый Структура("Code, PartialFactorToken, Remember, UserId", Код, ЧастичныйТокен, Истина, Пользователь);
			Ответ = ЗапросJSON(Соединение, "POST", "/api/authentication/totp/auth-by-code", Данные, Куки, Csrf);
		Иначе
			Данные = Новый Структура("UserId, ApproveCode, Remember, RememberSecondFactor, PhoneConfirmationType, partialFactorToken",
				Пользователь, Код, Истина, Истина, "Sms", ЧастичныйТокен);
			Ответ = ЗапросJSON(Соединение, "POST", "/api/authentication/phone/approve-by-userid", Данные, Куки, Csrf);
		КонецЕсли;
		КукиИзОтвета(Ответ, Куки);
		Результат.Куки = КукиВСтроку(Куки);
		Разбор = РазобратьОтвет(Ответ);
		ЗаполнитьПоРазбору(Результат, Разбор);
		Если Результат.Успех Тогда
			ЗавершитьСессиюКабинета(Результат);
		КонецЕсли;
	Исключение
		Результат.Текст = "Ошибка подтверждения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ШагПароля(Соединение, Знач Логин, Знач Пароль, Куки, Знач ЧастичныйТокен)

	Результат = Новый Структура("Успех, ТребуетсяКод, ЧастичныйТокен, Пользователь, Телефон, Куки, Текст, Способ",
		Ложь, Ложь, "", "", "", "", "", "sms");
	Csrf = Куки.Получить("AntiForgery");
	Если НЕ ЗначениеЗаполнено(Csrf) Тогда
		Результат.Текст = "Страница входа не выдала AntiForgery: вход в кабинет недоступен.";
		Возврат Результат;
	КонецЕсли;
	Данные = Новый Структура("Login, Password, Remember, PartialFactorToken", Логин, Пароль, Истина,
		?(ЗначениеЗаполнено(ЧастичныйТокен), ЧастичныйТокен, Неопределено));
	Ответ = ЗапросJSON(Соединение, "POST", "/api/authentication/password/auth-by-password", Данные, Куки, Csrf);
	КукиИзОтвета(Ответ, Куки);
	Результат.Куки = КукиВСтроку(Куки);
	Разбор = РазобратьОтвет(Ответ);
	ЗаполнитьПоРазбору(Результат, Разбор);
	Если Результат.Успех Тогда
		ЗавершитьСессиюКабинета(Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ЗаполнитьПоРазбору(Результат, Разбор)

	КодОтвета = ЗначениеЗаписи(Разбор, "code");
	Ошибка = ЗначениеЗаписи(Разбор, "errorStatus");
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Сообщения = ЗначениеЗаписи(Разбор, "errorMessages");
		Текст = "";
		Если ТипЗнч(Сообщения) = Тип("Массив") Тогда
			Текст = СтрСоединить(Сообщения, "; ");
		Иначе
			Текст = Строка(Сообщения);
		КонецЕсли;
		Результат.Текст = "Вход не выполнен: " + ?(ЗначениеЗаполнено(Текст), Текст, Ошибка);
		Возврат;
	КонецЕсли;
	Детали = ЗначениеЗаписи(Разбор, "details");
	Если Детали <> Неопределено Тогда
		Результат.ЧастичныйТокен = ЗначениеЗаписи(Детали, "PartialFactorToken");
		Результат.Пользователь = ЗначениеЗаписи(Детали, "UserId");
		Результат.Телефон = ЗначениеЗаписи(Детали, "SafePhoneValue");
	КонецЕсли;
	Если СтрНайти(ВРег(КодОтвета), "TOTP") > 0 Тогда
		Результат.Способ = "totp";
	Иначе
		Результат.Способ = "sms";
	КонецЕсли;
	Если СтрНайти(ВРег(КодОтвета), "APPROVE") > 0 ИЛИ СтрНайти(ВРег(КодОтвета), "SECONDFACTOR") > 0
		ИЛИ (ЗначениеЗаполнено(Результат.ЧастичныйТокен) И НЕ ЗначениеЗаполнено(КодОтвета)) Тогда
		Результат.ТребуетсяКод = Истина;
		Результат.Текст = "Кабинет требует код подтверждения"
			+ ?(ЗначениеЗаполнено(Результат.Телефон), " (телефон " + Результат.Телефон + ")", "") + ".";
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КодОтвета) ИЛИ ВРег(КодОтвета) = "OK" ИЛИ ВРег(КодОтвета) = "SUCCESS" Тогда
		Результат.Успех = Истина;
		Результат.Текст = "Вход в кабинет выполнен.";
	Иначе
		Результат.Текст = "Вход не выполнен: " + КодОтвета;
	КонецЕсли;

КонецПроцедуры

// После входа auth.kontur.ru открываем кабинет, чтобы получить его сессионные куки.
Процедура ЗавершитьСессиюКабинета(Результат)

	Соединение = Новый HTTPСоединение("diadok.kontur.ru", 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL());
	Куки = КукиИзСтроки(Результат.Куки);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Cookie", КукиВСтроку(Куки));
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/", Заголовки));
	КукиИзОтвета(Ответ, Куки);
	Результат.Куки = КукиВСтроку(Куки);

КонецПроцедуры

Функция ЗапросJSON(Соединение, Знач Метод, Знач Путь, Данные, Куки, Знач Csrf)

	Тело = "";
	Если Данные <> Неопределено Тогда
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Данные);
		Тело = Запись.Закрыть();
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json");
	Если ЗначениеЗаполнено(Csrf) Тогда
		Заголовки.Вставить("X-CSRF-Token", Csrf);
	КонецЕсли;
	КукиСтрокой = КукиВСтроку(Куки);
	Если ЗначениеЗаполнено(КукиСтрокой) Тогда
		Заголовки.Вставить("Cookie", КукиСтрокой);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Если Метод = "POST" Тогда
		Запрос.УстановитьТелоИзСтроки(Тело, "UTF-8");
	КонецЕсли;
	Если Метод = "POST" Тогда
		Возврат Соединение.Записать(Запрос);
	КонецЕсли;
	Возврат Соединение.Получить(Запрос);

КонецФункции

Функция РазобратьОтвет(Ответ)

	Текст = Ответ.ПолучитьТелоКакСтроку();
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Попытка
		Разбор = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Разбор = Новый Соответствие;
	КонецПопытки;
	Чтение.Закрыть();
	Если ТипЗнч(Разбор) <> Тип("Соответствие") Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Возврат Разбор;

КонецФункции

Процедура КукиИзОтвета(Ответ, Куки)

	Текст = Ответ.Заголовки.Получить("Set-Cookie");
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Часть Из СтрРазделить(Текст, ",") Цикл
		Пара = СокрЛП(СтрРазделить(Часть, ";")[0]);
		Поз = СтрНайти(Пара, "=");
		Если Поз <= 1 Тогда
			Продолжить;
		КонецЕсли;
		Имя = СокрЛП(Лев(Пара, Поз - 1));
		Если ВРег(Имя) = "EXPIRES" ИЛИ ВРег(Имя) = "PATH" ИЛИ ВРег(Имя) = "DOMAIN"
			ИЛИ ВРег(Имя) = "MAX-AGE" ИЛИ ВРег(Имя) = "SECURE" ИЛИ ВРег(Имя) = "HTTPONLY"
			ИЛИ ВРег(Имя) = "SAMESITE" Тогда
			Продолжить;
		КонецЕсли;
		Куки.Вставить(Имя, Сред(Пара, Поз + 1));
	КонецЦикла;

КонецПроцедуры

Функция КукиВСтроку(Куки)

	Части = Новый Массив;
	Для Каждого КлючЗначение Из Куки Цикл
		Части.Добавить(КлючЗначение.Ключ + "=" + КлючЗначение.Значение);
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

Функция КукиИзСтроки(Знач Строкой)

	Куки = Новый Соответствие;
	Для Каждого Часть Из СтрРазделить(Строкой, ";") Цикл
		Пара = СокрЛП(Часть);
		Поз = СтрНайти(Пара, "=");
		Если Поз > 1 Тогда
			Куки.Вставить(Лев(Пара, Поз - 1), Сред(Пара, Поз + 1));
		КонецЕсли;
	КонецЦикла;
	Возврат Куки;

КонецФункции

Функция ЗначениеЗаписи(Запись, Знач Имя, Знач ПоУмолчанию = "")

	Значение = ПоУмолчанию;
	Если ТипЗнч(Запись) = Тип("Структура") Тогда
		Запись.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Запись) = Тип("Соответствие") Тогда
		Значение = Запись.Получить(Имя);
	КонецЕсли;
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);

КонецФункции

#КонецОбласти
