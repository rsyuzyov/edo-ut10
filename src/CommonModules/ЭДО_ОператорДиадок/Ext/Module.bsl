// Входящие документы оператора Контур.Диадок по его публичному HTTP API (JSON). Набор функций - как у
// ЭДО_ОператорСБИС: ящик - Структура (Оператор, Организация, Представление, Логин, Пароль) из ЭДО_Сервер.
// Вход по логину и паролю пользователя Диадока и ключу разработчика API из общих настроек
// (КлючРазработчикаДиадок); токен живет между вызовами в ХранилищеОбщихНастроек.
// Ид входящего - EntityId документа: ключ «diadoc:<EntityId>» влезает в свойство связи Строка(50),
// а пара MessageId и EntityId - нет. MessageId запоминается при получении списка (ЭДО_СообщенияДиадока)
// и берется оттуда для остальных вызовов API: найти документ по одному EntityId API не умеет.

#Область ПрограммныйИнтерфейс

// Входящие УПД и УКД за период по ящикам Диадока.
// Ящики - Массив Структура (Оператор, Организация, Представление, Логин, Пароль).
// Состояния - Массив, в него по каждому ящику: Структура (Оператор, Организация, Ошибка, Документов).
// Ошибка ящика не обрывает обход остальных.
// Возврат: Массив Структура (Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Статус, Функция,
// Организация, Документ, ЭтоУКД, Вид, Версия, ГидПродавца, ДатаПолучения).
Функция ВходящиеЗаПериод(Знач Ящики, Знач Начало, Знач Конец, Знач НомерДокумента, Состояния) Экспорт

	Итог = Новый Массив;
	Видимые = Новый Соответствие;   // Ид документа и организация -> Истина: один логин бывает у нескольких ящиков
	ПамятьДиадока = ЗагрузитьПамятьДиадока();

	Для Каждого Ящик Из Ящики Цикл
		Состояние = Новый Структура("Оператор, Организация, Ошибка, Документов", Ящик.Оператор, Ящик.Организация, "", 0);
		БылоСтрок = Итог.Количество();
		// Перехват обоснован: недоступный ящик одной организации не должен оставлять без списка остальные.
		Попытка
			ДобавитьВходящиеЯщика(Итог, Ящик, Начало, Конец, НомерДокумента, Видимые, ПамятьДиадока);
		Исключение
			Состояние.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Состояние.Документов = Итог.Количество() - БылоСтрок;
		Состояния.Добавить(Состояние);
	КонецЦикла;

	ЗаписатьПамятьДиадока(ПамятьДиадока);
	Возврат Итог;

КонецФункции

// XML титула продавца входящего документа. Ошибка оператора - исключение.
Функция СодержимоеВходящего(Знач Ид, Знач Ящик) Экспорт

	АдресДокумента = АдресДокумента(Ящик, Ид);
	Ответ = ВыполнитьЗапрос(Ящик, ПутьСодержимого(АдресДокумента));
	Если Ответ.Код <> 200 ИЛИ Ответ.Данные.Размер() = 0 Тогда
		ВызватьИсключение "Диадок: XML входящего документа не получен - " + ОписаниеОтвета(Ответ);
	КонецЕсли;
	Возврат Ответ.Данные;

КонецФункции

// XML титула продавца с общим сроком - для сумм списка входящих, которых ждет форма.
// Срок - момент в миллисекундах (ТекущаяУниверсальнаяДатаВМиллисекундах).
// Неопределено - срок вышел или оператор не ответил: суммы придут при следующем обновлении.
Функция СодержимоеВходящегоДоСрока(Знач Ид, Знач Ящик, Знач Срок) Экспорт

	// Перехват обоснован: суммы - подсказка к списку; сбой оператора не должен ронять список, причина - в ЖР.
	Попытка
		ОстатокСек = ОстатокСрокаСек(Срок);
		Если ОстатокСек < 1 Тогда
			Возврат Неопределено;
		КонецЕсли;
		АдресДокумента = АдресДокумента(Ящик, Ид, ОстатокСек);
		ОстатокСек = ОстатокСрокаСек(Срок);
		Если ОстатокСек < 1 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Ответ = ВыполнитьЗапрос(Ящик, ПутьСодержимого(АдресДокумента), ОстатокСек);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Диадок: сумма входящего " + Ид + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

	Если Ответ.Код <> 200 ИЛИ Ответ.Данные.Размер() = 0 Тогда
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Диадок: сумма входящего " + Ид + ": " + ОписаниеОтвета(Ответ));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ответ.Данные;

КонецФункции

// Статус входящего у оператора сейчас - код в тех же значениях, что у Платформы (SENT, ACCEPTED, CANCELLED...),
// неизвестное состояние - как его называет Диадок. Ошибка оператора - исключение.
Функция СтатусВходящего(Знач Ид, Знач Ящик) Экспорт

	АдресДокумента = АдресДокумента(Ящик, Ид);
	Путь = "/V3/GetDocument?boxId=" + ДляАдреса(АдресДокумента.ИдЯщика) + "&messageId=" + ДляАдреса(АдресДокумента.ИдСообщения)
		+ "&entityId=" + ДляАдреса(АдресДокумента.ИдДокумента);
	ДокументДиадока = ДанныеJSON(ВыполнитьЗапрос(Ящик, Путь), "документ " + Ид);
	Возврат СтатусДокумента(ДокументДиадока);

КонецФункции

// Печатная форма входящего у оператора: PDF, который Диадок формирует по запросу (GeneratePrintForm).
// Пока форма не готова, Диадок отвечает пустым телом и Retry-After - повторяем в пределах общего срока.
// Возврат: Структура (Успех, Данные - ДвоичныеДанные, Текст, Расширение, Пояснение, Протокол).
Функция ПечатнаяФормаВходящего(Знач Ид, Знач Ящик) Экспорт

	Итог = Новый Структура("Успех, Данные, Текст, Расширение, Пояснение, Протокол",
		Ложь, Неопределено, "", "pdf", "", Неопределено);
	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + СрокПечатнойФормыСек() * 1000;

	// Перехват обоснован: сбой оператора или настройки - для пользователя это сообщение в карточке, подробно - в ЖР.
	Попытка
		АдресДокумента = АдресДокумента(Ящик, Ид);
		Путь = "/GeneratePrintForm?boxId=" + ДляАдреса(АдресДокумента.ИдЯщика) + "&messageId="
			+ ДляАдреса(АдресДокумента.ИдСообщения) + "&documentId=" + ДляАдреса(АдресДокумента.ИдДокумента);
		Ответ = ВыполнитьЗапрос(Ящик, Путь);
		Пока Ответ.Код = 200 И Ответ.Данные.Размер() = 0 Цикл
			Ждать = Мин(Макс(Ответ.ПовторЧерезСек, 1), Цел((Срок - ТекущаяУниверсальнаяДатаВМиллисекундах()) / 1000));
			Если Ждать < 1 Тогда
				Прервать;
			КонецЕсли;
			ПодождатьСекунд(Ждать);
			Ответ = ВыполнитьЗапрос(Ящик, Путь);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Диадок: печатная форма входящего " + Ид + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Итог.Текст = "Загрузка печатной формы не удалась: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ".";
		Возврат Итог;
	КонецПопытки;

	Если Ответ.Код = 200 И Ответ.Данные.Размер() = 0 Тогда
		Итог.Текст = "Диадок еще готовит печатную форму. Попробуйте через минуту.";
		Возврат Итог;
	ИначеЕсли Ответ.Код <> 200 Тогда
		Итог.Текст = "Загрузка печатной формы не удалась: " + ОписаниеОтвета(Ответ) + ".";
		Возврат Итог;
	КонецЕсли;
	Итог.Успех = Истина;
	Итог.Данные = Ответ.Данные;
	Возврат Итог;

КонецФункции

// Проверка ящика из настроек: вход заново (без сохраненного токена), ящик организации и число входящих УПД
// и УКД за 30 дней. Возврат: Строка для пользователя. Ошибка входа или списка - исключение.
Функция ПроверкаЯщика(Знач Ящик) Экспорт

	ЗабытьСессию(Ящик);
	Войти(Ящик);
	ЯщикДиадока = ЯщикОрганизации(Ящик);
	Входящие = Новый Массив;
	Конец = ТекущаяДатаСеанса();
	ПамятьДиадока = ЗагрузитьПамятьДиадока();
	ДобавитьВходящиеЯщика(Входящие, Ящик, НачалоДня(Конец) - 29 * 86400, Конец, "", Новый Соответствие, ПамятьДиадока);
	ЗаписатьПамятьДиадока(ПамятьДиадока);
	Возврат "Вход в Диадок под «" + Ящик.Логин + "» выполнен, ящик «" + ЯщикДиадока.Название
		+ "». Входящих УПД и УКД за 30 дней: " + Формат(Входящие.Количество(), "ЧН=0; ЧГ=0") + ".";

КонецФункции

// Пауза для печатной формы вне фонового задания: задание ждет само себя, вызвавший ждет задание.
Процедура ВыдержатьПаузуВФоне(Знач Секунд) Экспорт

	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если ТекущееЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Перехват обоснован: ожидание себя всегда кончается исключением по таймауту - это и есть конец паузы.
	Попытка
		ТекущееЗадание.ОжидатьЗавершения(Секунд);
	Исключение
		Возврат;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СписокВходящих

Процедура ДобавитьВходящиеЯщика(Итог, Знач Ящик, Знач Начало, Знач Конец, Знач НомерДокумента, Видимые, ПамятьДиадока)

	ЯщикДиадока = ЯщикОрганизации(Ящик);
	ПоискНомера = ВРег(СокрЛП(НомерДокумента));

	Для Каждого Категория Из КатегорииВходящих() Цикл
		ПослеКлюча = "";
		Для НомерСтраницы = 0 По ПределСтраниц() - 1 Цикл
			Путь = "/V3/GetDocuments?boxId=" + ДляАдреса(ЯщикДиадока.ИдЯщика) + "&filterCategory=" + ДляАдреса(Категория)
				+ "&fromDocumentDate=" + Формат(Начало, "ДФ=dd.MM.yyyy") + "&toDocumentDate=" + Формат(Конец, "ДФ=dd.MM.yyyy")
				+ "&count=" + Формат(РазмерСтраницы(), "ЧГ=0");
			Если ЗначениеЗаполнено(ПослеКлюча) Тогда
				Путь = Путь + "&afterIndexKey=" + ДляАдреса(ПослеКлюча);
			КонецЕсли;
			Ответ = ВыполнитьЗапрос(Ящик, Путь);
			// Тип исправлений Диадок может не знать - их отсутствие не должно лишать списка самих УПД и УКД.
			Если Ответ.Код = 400 И СтрНайти(Категория, "Revision") > 0 Тогда
				ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
					"Диадок: категория " + Категория + " не принята: " + ОписаниеОтвета(Ответ));
				Прервать;
			КонецЕсли;
			СписокДокументов = ДанныеJSON(Ответ, "список входящих");

			ДокументыСписка = СписокДокументов.Получить("Documents");
			Если ТипЗнч(ДокументыСписка) = Тип("Массив") Тогда
				Для Каждого ДокументДиадока Из ДокументыСписка Цикл
					Если ТипЗнч(ДокументДиадока) <> Тип("Соответствие") Тогда
						Продолжить;
					КонецЕсли;
					ПослеКлюча = ЗначениеСтрокой(ДокументДиадока.Получить("IndexKey"));
					Входящий = ВходящийИзДокумента(ДокументДиадока, Ящик, ЯщикДиадока, ПамятьДиадока);
					КлючВидимого = Входящий.Ид + "|" + XMLСтрока(Входящий.Организация);
					Если НЕ ЗначениеЗаполнено(Входящий.Ид) ИЛИ Видимые.Получить(КлючВидимого) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Если ЗначениеЗаполнено(ПоискНомера) И СтрНайти(ВРег(Входящий.Номер), ПоискНомера) = 0 Тогда
						Продолжить;
					КонецЕсли;
					Видимые.Вставить(КлючВидимого, Истина);
					Итог.Добавить(Входящий);
				КонецЦикла;
			КонецЕсли;

			Если СписокДокументов.Получить("HasMoreResults") <> Истина ИЛИ НЕ ЗначениеЗаполнено(ПослеКлюча) Тогда
				Прервать;
			КонецЕсли;
			Если НомерСтраницы = ПределСтраниц() - 1 Тогда
				ВызватьИсключение Строка(Ящик.Организация) + ": Диадок отдал больше "
					+ Формат(ПределСтраниц() * РазмерСтраницы(), "ЧГ=0") + " документов «" + Категория
					+ "» за период - список неполный, сузьте период";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Строка входящего из документа списка Диадока; MessageId документа запоминается в памяти модуля.
Функция ВходящийИзДокумента(Знач ДокументДиадока, Знач Ящик, Знач ЯщикДиадока, ПамятьДиадока)

	ИдДокумента = НРег(ЗначениеСтрокой(ДокументДиадока.Получить("EntityId")));
	ИдСообщения = НРег(ЗначениеСтрокой(ДокументДиадока.Получить("MessageId")));
	ЗапомнитьСообщение(ПамятьДиадока, ИдДокумента, ИдСообщения);

	ЭтоУКД = СтрНачинаетсяС(ЗначениеСтрокой(ДокументДиадока.Получить("TypeNamedId")), "UniversalCorrectionDocument");
	ФункцияДокумента = ВРег(ЗначениеСтрокой(ДокументДиадока.Получить("Function")));
	ДатаДокумента = ДатаИзСтроки(ЗначениеСтрокой(ДокументДиадока.Получить("DocumentDate")));
	ДатаПолучения = ДатаИзТиков(ДокументДиадока.Получить("CreationTimestampTicks"));
	ИдЯщикаПродавца = ЗначениеСтрокой(ДокументДиадока.Получить("CounteragentBoxId"));
	Продавец = КонтрагентДиадока(Ящик, ЯщикДиадока.ИдЯщика, ИдЯщикаПродавца, ПамятьДиадока);

	Входящий = Новый Структура("Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Статус, Функция, Организация, Документ",
		ИдДокумента,
		ЗначениеСтрокой(ДокументДиадока.Получить("DocumentNumber")),
		ДатаДокумента,
		Продавец.ИНН,
		Продавец.Название,
		ЯщикДиадока.ИНН,
		СтатусДокумента(ДокументДиадока),
		ФункцияДокумента,
		Ящик.Организация,
		Неопределено);
	Входящий.Вставить("ЭтоУКД", ЭтоУКД);
	Входящий.Вставить("Вид", ЭДО_Сервер.ВидВходящегоДокумента(ФункцияДокумента, ЭтоУКД));
	Входящий.Вставить("Версия", ВерсияФормата(ЗначениеСтрокой(ДокументДиадока.Получить("Version"))));
	Входящий.Вставить("ГидПродавца", "");
	Входящий.Вставить("ДатаПолучения", ?(ЗначениеЗаполнено(ДатаПолучения), ДатаПолучения, ДатаДокумента));
	Возврат Входящий;

КонецФункции

// Категории списка GetDocuments: входящие УПД и УКД и их исправления.
Функция КатегорииВходящих()
	Возврат СтрРазделить("UniversalTransferDocument.Inbound,UniversalCorrectionDocument.Inbound,"
		+ "UniversalTransferDocumentRevision.Inbound,UniversalCorrectionDocumentRevision.Inbound", ",");
КонецФункции

// Статус документа в кодах Платформы - их понимают список, карточка и проверка «живой ли документ».
// Неизвестное состояние - значение Диадока как есть.
Функция СтатусДокумента(Знач ДокументДиадока)

	Если ДокументДиадока.Получить("IsDeleted") = Истина Тогда
		Возврат "DELETED";
	КонецЕсли;

	СтатусАннулирования = ЗначениеСтрокой(ДокументДиадока.Получить("RevocationStatus"));
	Если СтатусАннулирования = "RevocationAccepted" Тогда
		Возврат "CANCELLED";
	ИначеЕсли СтатусАннулирования = "RevocationIsRequestedByMe" ИЛИ СтатусАннулирования = "RequestsMyRevocation" Тогда
		Возврат "CANCELLATION_REQUESTED";
	КонецЕсли;

	СтатусОтвета = ЗначениеСтрокой(ДокументДиадока.Получить("RecipientResponseStatus"));
	Если СтатусОтвета = "WaitingForRecipientSignature" Тогда
		Возврат "SENT";   // ждет нашей подписи
	ИначеЕсли СтатусОтвета = "RecipientSignatureRequestRejected" Тогда
		Возврат "REJECTED";
	ИначеЕсли СтатусОтвета = "WithRecipientSignature" ИЛИ СтатусОтвета = "WithRecipientPartiallySignature"
		ИЛИ СтатусОтвета = "RecipientResponseStatusNotAcceptable" Тогда
		Возврат "ACCEPTED";   // NotAcceptable - ответ покупателя не предусмотрен (счет-фактура), документооборот завершен
	КонецЕсли;
	Возврат СтатусОтвета;

КонецФункции

// Версия формата из Version Диадока (например utd970_05_03_01 - 5.03); не разобралась - как есть.
Функция ВерсияФормата(Знач ВерсияДиадока)

	ЧастиВерсии = СтрРазделить(ВерсияДиадока, "_");
	Если ЧастиВерсии.Количество() >= 3 И СтрДлина(ЧастиВерсии[1]) = 2 И СтрДлина(ЧастиВерсии[2]) = 2
		И СостоитИзЦифр(ЧастиВерсии[1] + ЧастиВерсии[2]) Тогда
		Возврат Формат(Число(ЧастиВерсии[1]), "ЧГ=0") + "." + ЧастиВерсии[2];
	КонецЕсли;
	Возврат ВерсияДиадока;

КонецФункции

Функция РазмерСтраницы()
	Возврат 100;
КонецФункции

Функция ПределСтраниц()
	Возврат 40;
КонецФункции

#КонецОбласти

#Область ЯщикиИКонтрагенты

// Ящик Диадока организации ящика настроек: по ИНН, при нескольких - по КПП. Запоминается вместе с токеном.
// Возврат: Структура (ИдЯщика, ИНН, Название).
Функция ЯщикОрганизации(Знач Ящик, Знач ТаймаутСек = 0)

	ИНН = СокрЛП(Ящик.Организация.ИНН);
	КПП = СокрЛП(Ящик.Организация.КПП);
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		ВызватьИсключение Строка(Ящик.Организация) + ": не заполнен ИНН - Диадок не найдет ее ящик";
	КонецЕсли;
	КлючЯщика = ИНН + "|" + КПП;
	Сессия = СохраненнаяСессия(Ящик);
	Если Сессия <> Неопределено И Сессия.Ящики.Получить(КлючЯщика) <> Неопределено Тогда
		Возврат Сессия.Ящики.Получить(КлючЯщика);
	КонецЕсли;

	Организации = ДанныеJSON(ВыполнитьЗапрос(Ящик, "/GetMyOrganizations?autoRegister=false", ТаймаутСек),
		"список организаций").Получить("Organizations");
	Подходящие = Новый Массив;
	Если ТипЗнч(Организации) = Тип("Массив") Тогда
		Для Каждого ОрганизацияДиадока Из Организации Цикл
			Если ТипЗнч(ОрганизацияДиадока) = Тип("Соответствие") И ЗначениеСтрокой(ОрганизацияДиадока.Получить("Inn")) = ИНН Тогда
				Подходящие.Добавить(ОрганизацияДиадока);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Подходящие.Количество() > 1 И ЗначениеЗаполнено(КПП) Тогда
		ПоКПП = Новый Массив;
		Для Каждого ОрганизацияДиадока Из Подходящие Цикл
			Если ЗначениеСтрокой(ОрганизацияДиадока.Получить("Kpp")) = КПП Тогда
				ПоКПП.Добавить(ОрганизацияДиадока);
			КонецЕсли;
		КонецЦикла;
		Подходящие = ПоКПП;
	КонецЕсли;

	Если Подходящие.Количество() = 0 Тогда
		ВызватьИсключение "Диадок: у пользователя «" + Ящик.Логин + "» нет доступа к организации с ИНН " + ИНН;
	ИначеЕсли Подходящие.Количество() > 1 Тогда
		ВызватьИсключение "Диадок: у пользователя «" + Ящик.Логин + "» несколько организаций с ИНН " + ИНН
			+ " - укажите КПП организации в базе";
	КонецЕсли;
	ЯщикиОрганизации = Подходящие[0].Получить("Boxes");
	ИдЯщика = "";
	Если ТипЗнч(ЯщикиОрганизации) = Тип("Массив") И ЯщикиОрганизации.Количество() > 0
		И ТипЗнч(ЯщикиОрганизации[0]) = Тип("Соответствие") Тогда
		ИдЯщика = ЗначениеСтрокой(ЯщикиОрганизации[0].Получить("BoxId"));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ИдЯщика) Тогда
		ВызватьИсключение "Диадок: у организации с ИНН " + ИНН + " нет ящика";
	КонецЕсли;

	ЯщикДиадока = Новый Структура("ИдЯщика, ИНН, Название", ИдЯщика, ИНН, НазваниеОрганизации(Подходящие[0]));
	Сессия = СохраненнаяСессия(Ящик);
	Если Сессия <> Неопределено Тогда
		Сессия.Ящики.Вставить(КлючЯщика, ЯщикДиадока);
		ЗапомнитьСессию(Ящик, Сессия);
	КонецЕсли;
	Возврат ЯщикДиадока;

КонецФункции

// ИНН и название продавца по его ящику: в документе списка их нет. Сбой - пустые значения, строка списка остается.
// Возврат: Структура (ИНН, Название).
Функция КонтрагентДиадока(Знач Ящик, Знач ИдНашегоЯщика, Знач ИдЯщикаКонтрагента, ПамятьДиадока)

	Итог = Новый Структура("ИНН, Название", "", "");
	Если НЕ ЗначениеЗаполнено(ИдЯщикаКонтрагента) Тогда
		Возврат Итог;
	КонецЕсли;
	Известный = ПамятьДиадока.Контрагенты.Получить(НРег(ИдЯщикаКонтрагента));
	Если Известный <> Неопределено И Известный.Когда >= ТекущаяДатаСеанса() - ДнейЖизниКонтрагента() * 86400 Тогда
		ЗаполнитьЗначенияСвойств(Итог, Известный);
		Возврат Итог;
	КонецЕсли;

	// Перехват обоснован: без названия продавца строка остается в списке и привязывается по номеру.
	Попытка
		// V3 принимает ид ящиков только GUID-ом: «<32 hex>@diadoc.ru» дает HTTP 400
		// «Could not find or parse query param».
		Путь = "/V3/GetCounteragent?myBoxId=" + ДляАдреса(ГуидЯщика(ИдНашегоЯщика))
			+ "&counteragentBoxId=" + ДляАдреса(ГуидЯщика(ИдЯщикаКонтрагента));
		Сведения = ДанныеJSON(ВыполнитьЗапрос(Ящик, Путь), "контрагент").Получить("Organization");
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Диадок: контрагент " + ИдЯщикаКонтрагента + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;

	Если ТипЗнч(Сведения) = Тип("Соответствие") Тогда
		Итог.ИНН = ЗначениеСтрокой(Сведения.Получить("Inn"));
		Итог.Название = НазваниеОрганизации(Сведения);
		ПамятьДиадока.Контрагенты.Вставить(НРег(ИдЯщикаКонтрагента),
			Новый Структура("ИНН, Название, Когда", Итог.ИНН, Итог.Название, ТекущаяДатаСеанса()));
		ПамятьДиадока.Изменен = Истина;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Ид ящика GUID-ом: «<32 шестнадцатеричных цифры>@diadoc.ru» -> «8-4-4-4-12» через дефисы.
// Уже GUID или иной вид - как есть.
Функция ГуидЯщика(Знач ИдЯщика)
	ИдЯщика = НРег(СокрЛП(ИдЯщика));
	Поз = СтрНайти(ИдЯщика, "@");
	Шестнадцатеричный = ?(Поз > 0, Лев(ИдЯщика, Поз - 1), ИдЯщика);
	Если СтрДлина(Шестнадцатеричный) <> 32 ИЛИ СтрНайти(Шестнадцатеричный, "-") > 0 Тогда
		Возврат ИдЯщика;
	КонецЕсли;
	Возврат Сред(Шестнадцатеричный, 1, 8) + "-" + Сред(Шестнадцатеричный, 9, 4) + "-"
		+ Сред(Шестнадцатеричный, 13, 4) + "-" + Сред(Шестнадцатеричный, 17, 4) + "-" + Сред(Шестнадцатеричный, 21, 12);
КонецФункции

Функция НазваниеОрганизации(Знач ОрганизацияДиадока)
	ПолноеНазвание = ЗначениеСтрокой(ОрганизацияДиадока.Получить("FullName"));
	Возврат ?(ЗначениеЗаполнено(ПолноеНазвание), ПолноеНазвание, ЗначениеСтрокой(ОрганизацияДиадока.Получить("ShortName")));
КонецФункции

// Ящик, сообщение и документ для вызовов API по ид входящего. MessageId - из памяти модуля, заполненной списком.
// Возврат: Структура (ИдЯщика, ИдСообщения, ИдДокумента).
Функция АдресДокумента(Знач Ящик, Знач Ид, Знач ТаймаутСек = 0)

	ИдДокумента = НРег(СокрЛП(Ид));
	ПамятьДиадока = ЗагрузитьПамятьДиадока();
	ЗаписьСообщения = ПамятьДиадока.Сообщения.Получить(ИдДокумента);
	Если ЗаписьСообщения = Неопределено Тогда
		ВызватьИсключение "Диадок: документ " + ИдДокумента + " не найден среди полученных списком - обновите"
			+ " «Входящие» за период документа";
	КонецЕсли;
	Возврат Новый Структура("ИдЯщика, ИдСообщения, ИдДокумента", ЯщикОрганизации(Ящик, ТаймаутСек).ИдЯщика,
		ЗаписьСообщения.ИдСообщения, ИдДокумента);

КонецФункции

Функция ПутьСодержимого(Знач АдресДокумента)
	Возврат "/V4/GetEntityContent?boxId=" + ДляАдреса(АдресДокумента.ИдЯщика) + "&messageId=" + ДляАдреса(АдресДокумента.ИдСообщения)
		+ "&entityId=" + ДляАдреса(АдресДокумента.ИдДокумента);
КонецФункции

#КонецОбласти

#Область ПамятьДиадока

// MessageId документов и сведения о контрагентах: ХранилищеОбщихНастроек под пустым пользователем, как кэш входящих.
// Записи, которые список не видел дольше срока жизни, отбрасываются - память не растет без предела.
// Возврат: Структура (Сообщения - Соответствие EntityId -> Структура (ИдСообщения, Когда),
// Контрагенты - Соответствие BoxId -> Структура (ИНН, Название, Когда), Изменен).
Функция ЗагрузитьПамятьДиадока()

	ПамятьДиадока = Новый Структура("Сообщения, Контрагенты, Изменен", Новый Соответствие, Новый Соответствие, Ложь);
	УстановитьПривилегированныйРежим(Истина);
	Сохраненный = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаПамяти(), "Записи", , "");
	Если ТипЗнч(Сохраненный) <> Тип("Структура") Тогда
		Возврат ПамятьДиадока;
	КонецЕсли;

	ГраницаСообщений = ТекущаяДатаСеанса() - ДнейЖизниСообщения() * 86400;
	ГраницаКонтрагентов = ТекущаяДатаСеанса() - ДнейЖизниКонтрагента() * 86400;
	Для Каждого ИмяРаздела Из СтрРазделить("Сообщения,Контрагенты", ",") Цикл
		Раздел = Неопределено;
		Если НЕ Сохраненный.Свойство(ИмяРаздела, Раздел) ИЛИ ТипЗнч(Раздел) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Граница = ?(ИмяРаздела = "Сообщения", ГраницаСообщений, ГраницаКонтрагентов);
		Для Каждого ЭлементРаздела Из Раздел Цикл
			Когда = Неопределено;
			Если ТипЗнч(ЭлементРаздела.Значение) = Тип("Структура") И ЭлементРаздела.Значение.Свойство("Когда", Когда)
				И ТипЗнч(Когда) = Тип("Дата") И Когда >= Граница Тогда
				ПамятьДиадока[ИмяРаздела].Вставить(ЭлементРаздела.Ключ, ЭлементРаздела.Значение);
			Иначе
				ПамятьДиадока.Изменен = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат ПамятьДиадока;

КонецФункции

Процедура ЗаписатьПамятьДиадока(Знач ПамятьДиадока)

	Если НЕ ПамятьДиадока.Изменен Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаПамяти(), "Записи",
		Новый Структура("Сообщения, Контрагенты", ПамятьДиадока.Сообщения, ПамятьДиадока.Контрагенты),
		"сообщения и контрагенты входящих Диадока", "");

КонецПроцедуры

// Отметка «видели в списке» обновляется раз в неделю: иначе память переписывалась бы каждым обновлением списка.
Процедура ЗапомнитьСообщение(ПамятьДиадока, Знач ИдДокумента, Знач ИдСообщения)

	Если НЕ ЗначениеЗаполнено(ИдДокумента) ИЛИ НЕ ЗначениеЗаполнено(ИдСообщения) Тогда
		Возврат;
	КонецЕсли;
	Известное = ПамятьДиадока.Сообщения.Получить(ИдДокумента);
	Если Известное <> Неопределено И Известное.ИдСообщения = ИдСообщения
		И Известное.Когда >= ТекущаяДатаСеанса() - 7 * 86400 Тогда
		Возврат;
	КонецЕсли;
	ПамятьДиадока.Сообщения.Вставить(ИдДокумента, Новый Структура("ИдСообщения, Когда", ИдСообщения, ТекущаяДатаСеанса()));
	ПамятьДиадока.Изменен = Истина;

КонецПроцедуры

Функция КлючОбъектаПамяти()
	Возврат "ЭДО_СообщенияДиадока";
КонецФункции

Функция ДнейЖизниСообщения()
	Возврат 400;
КонецФункции

Функция ДнейЖизниКонтрагента()
	Возврат 30;
КонецФункции

#КонецОбласти

#Область ВызовыAPI

// GET к API с токеном ящика. Токен, который Диадок не принял (HTTP 401), перевыпускаем один раз.
// Возврат: Структура (Код, Данные - ДвоичныеДанные, ПовторЧерезСек). HTTP 429 - исключение.
Функция ВыполнитьЗапрос(Знач Ящик, Знач Путь, Знач ТаймаутСек = 0)

	Сессия = СохраненнаяСессия(Ящик);
	Токен = ?(Сессия = Неопределено, Войти(Ящик, ТаймаутСек), Сессия.Токен);
	Ответ = ОтправитьЗапрос("GET", Путь, ЗаголовокАвторизации(Токен), Неопределено, ТаймаутСек);
	Если Ответ.Код = 401 Тогда
		ЗабытьСессию(Ящик);
		Ответ = ОтправитьЗапрос("GET", Путь, ЗаголовокАвторизации(Войти(Ящик, ТаймаутСек)), Неопределено, ТаймаутСек);
	КонецЕсли;
	ПроверитьЛимитЗапросов(Ответ);
	Возврат Ответ;

КонецФункции

// Вход по логину и паролю ящика; токен запоминается. Пароль и ключ не попадают ни в URL, ни в текст ошибки.
Функция Войти(Знач Ящик, Знач ТаймаутСек = 0)

	КлючРазработчика();
	Если НЕ ЗначениеЗаполнено(Ящик.Логин) ИЛИ НЕ ЗначениеЗаполнено(Ящик.Пароль) Тогда
		ВызватьИсключение "Диадок: у ящика «" + Ящик.Представление + "» не задан логин или пароль";
	КонецЕсли;

	ЗаписьТела = Новый ЗаписьJSON;
	ЗаписьТела.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьТела, Новый Структура("login, password", Ящик.Логин, Ящик.Пароль));
	Ответ = ОтправитьЗапрос("POST", "/V3/Authenticate?type=password", ЗаголовокАвторизации(""), ЗаписьТела.Закрыть(),
		ТаймаутСек);
	ПроверитьЛимитЗапросов(Ответ);

	ТекстОтвета = СокрЛП(ПолучитьСтрокуИзДвоичныхДанных(Ответ.Данные, КодировкаТекста.UTF8));
	Если Ответ.Код <> 200 Тогда
		ТекстВРег = ВРег(ТекстОтвета);
		Если СтрНайти(ТекстВРег, "PASSWORD") > 0 ИЛИ СтрНайти(ТекстВРег, "LOGIN") > 0 Тогда
			ВызватьИсключение "Диадок: вход под «" + Ящик.Логин + "» не выполнен - неверный логин или пароль";
		ИначеЕсли Ответ.Код = 401 Тогда
			ВызватьИсключение "Диадок: ключ разработчика API не принят (HTTP 401) - проверьте общую настройку ЭДО «"
				+ ПредставлениеНастройкиКлюча() + "»";
		КонецЕсли;
		ВызватьИсключение "Диадок: вход под «" + Ящик.Логин + "» не выполнен - HTTP " + Ответ.Код + " "
			+ Лев(ТекстОтвета, 200);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекстОтвета) ИЛИ СтрНайти(ТекстОтвета, " ") > 0 Тогда
		ВызватьИсключение "Диадок: вход под «" + Ящик.Логин + "» не выполнен - нет токена в ответе";
	КонецЕсли;

	ЗапомнитьСессию(Ящик, Новый Структура("Токен, Ящики", ТекстОтвета, Новый Соответствие));
	Возврат ТекстОтвета;

КонецФункции

// Возврат: Структура (Код, Данные - ДвоичныеДанные, ПовторЧерезСек).
Функция ОтправитьЗапрос(Знач HTTPМетод, Знач Путь, Знач Авторизация, Знач ТелоJSON, Знач ТаймаутСек)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", Авторизация);
	Заголовки.Вставить("Accept", "application/json");
	Если ТелоJSON <> Неопределено Тогда
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Если ТелоJSON <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Таймаут = ?(ТаймаутСек > 0, ТаймаутСек, ЭДО_Сервер.НастройкаЭДО("ТаймаутHTTPСек"));
	Соединение = Новый HTTPСоединение(ХостAPI(), 443, , , , Таймаут, Новый ЗащищенноеСоединениеOpenSSL());
	Ответ = Соединение.ВызватьHTTPМетод(HTTPМетод, Запрос);

	ПовторЧерезСек = 0;
	ТекстПовтора = СокрЛП(Строка(ЗначениеЗаголовка(Ответ, "Retry-After")));
	Если ЗначениеЗаполнено(ТекстПовтора) И СостоитИзЦифр(ТекстПовтора) Тогда
		ПовторЧерезСек = Число(ТекстПовтора);
	КонецЕсли;
	Данные = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Возврат Новый Структура("Код, Данные, ПовторЧерезСек", Ответ.КодСостояния,
		?(Данные = Неопределено, ПолучитьДвоичныеДанныеИзСтроки(""), Данные), ПовторЧерезСек);

КонецФункции

// Разобранный JSON ответа. Не 200 или не JSON - исключение с кодом и текстом Диадока.
Функция ДанныеJSON(Знач Ответ, Знач ЧтоЗапрошено)

	Если Ответ.Код <> 200 Тогда
		ВызватьИсключение "Диадок: " + ЧтоЗапрошено + " - " + ОписаниеОтвета(Ответ);
	КонецЕсли;
	ТекстОтвета = ПолучитьСтрокуИзДвоичныхДанных(Ответ.Данные, КодировкаТекста.UTF8);
	Если Лев(СокрЛП(ТекстОтвета), 1) <> "{" Тогда
		ВызватьИсключение "Диадок: " + ЧтоЗапрошено + " - ответ не JSON";
	КонецЕсли;
	Возврат ЭДО_Сервер.ПрочитатьОтветJSON(ТекстОтвета);

КонецФункции

Процедура ПроверитьЛимитЗапросов(Знач Ответ)

	Если Ответ.Код = 429 Тогда
		ВызватьИсключение "Диадок: превышен лимит запросов (HTTP 429)"
			+ ?(Ответ.ПовторЧерезСек > 0, ", повторите через " + Формат(Ответ.ПовторЧерезСек, "ЧГ=0") + " с", ", повторите позже");
	КонецЕсли;

КонецПроцедуры

Функция ОписаниеОтвета(Знач Ответ)
	ТекстОтвета = СокрЛП(ПолучитьСтрокуИзДвоичныхДанных(Ответ.Данные, КодировкаТекста.UTF8));
	Возврат "HTTP " + Ответ.Код + ?(ЗначениеЗаполнено(ТекстОтвета), " " + Лев(ТекстОтвета, 200), "");
КонецФункции

Функция ЗаголовокАвторизации(Знач Токен)
	ТекстЗаголовка = "DiadocAuth ddauth_api_client_id=" + КлючРазработчика();
	Возврат ТекстЗаголовка + ?(ЗначениеЗаполнено(Токен), ",ddauth_token=" + Токен, "");
КонецФункции

// Ключ продукта у Контура - общая настройка ЭДО, в коде его нет. Не задан - исключение для ящика.
Функция КлючРазработчика()

	Ключ = СокрЛП(ЭДО_Сервер.НастройкаЭДО("КлючРазработчикаДиадок"));
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		ВызватьИсключение "Диадок: не задан ключ разработчика API - заполните общую настройку ЭДО «"
			+ ПредставлениеНастройкиКлюча() + "»";
	КонецЕсли;
	Возврат Ключ;

КонецФункции

Функция ПредставлениеНастройкиКлюча()
	Описание = ЭДО_Сервер.ОписаниеНастроекЭДО().Найти("КлючРазработчикаДиадок", "Имя");
	Возврат ?(Описание = Неопределено, "КлючРазработчикаДиадок", Описание.Представление);
КонецФункции

// Заголовок ответа без учета регистра имени.
Функция ЗначениеЗаголовка(Знач Ответ, Знач ИмяЗаголовка)

	Для Каждого ЭлементЗаголовка Из Ответ.Заголовки Цикл
		Если НРег(ЭлементЗаголовка.Ключ) = НРег(ИмяЗаголовка) Тогда
			Возврат ЭлементЗаголовка.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ХостAPI()
	Возврат "diadoc-api.kontur.ru";
КонецФункции

Функция ДляАдреса(Знач Значение)
	Возврат КодироватьСтроку(СокрЛП(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

#Область Сессии

// Сессия - Структура (Токен, Ящики - Соответствие ИНН|КПП -> ящик Диадока) под пустым пользователем:
// список обновляют разные пользователи и регламент. Нет сессии - Неопределено.
Функция СохраненнаяСессия(Знач Ящик)

	УстановитьПривилегированныйРежим(Истина);
	Сессия = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаСессий(), КлючСессии(Ящик), , "");
	Если ТипЗнч(Сессия) <> Тип("Структура") ИЛИ НЕ Сессия.Свойство("Токен") ИЛИ НЕ Сессия.Свойство("Ящики")
		ИЛИ НЕ ЗначениеЗаполнено(Сессия.Токен) ИЛИ ТипЗнч(Сессия.Ящики) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Сессия;

КонецФункции

Процедура ЗапомнитьСессию(Знач Ящик, Знач Сессия)
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаСессий(), КлючСессии(Ящик), Сессия, , "");
КонецПроцедуры

Процедура ЗабытьСессию(Знач Ящик)
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Удалить(КлючОбъектаСессий(), КлючСессии(Ящик), "");
КонецПроцедуры

Функция КлючОбъектаСессий()
	Возврат "ЭДО_СессииОператоров";
КонецФункции

Функция КлючСессии(Знач Ящик)
	Возврат "diadoc:" + НРег(СокрЛП(Ящик.Логин));
КонецФункции

#КонецОбласти

#Область Прочее

Функция ЗначениеСтрокой(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

Функция СостоитИзЦифр(Знач ПроверяемыйТекст)

	Если НЕ ЗначениеЗаполнено(ПроверяемыйТекст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(ПроверяемыйТекст) Цикл
		Если СтрНайти("0123456789", Сред(ПроверяемыйТекст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Дата из строки Диадока «14.11.2026». Не разобралась - пустая дата.
Функция ДатаИзСтроки(Знач ТекстДаты)

	ЧастиСтрокиДаты = СтрРазделить(Лев(СокрЛП(ТекстДаты), 10), ".");
	Если ЧастиСтрокиДаты.Количество() <> 3
		ИЛИ НЕ СостоитИзЦифр(ЧастиСтрокиДаты[0] + ЧастиСтрокиДаты[1] + ЧастиСтрокиДаты[2]) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	// Перехват обоснован: невозможная дата у оператора (31.02) - дата строки пустая, строка списка остается.
	Попытка
		Возврат Дата(Число(ЧастиСтрокиДаты[2]), Число(ЧастиСтрокиДаты[1]), Число(ЧастиСтрокиДаты[0]));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

// Местное время сеанса из тиков .NET (100 нс с 01.01.0001, UTC). Нет значения - пустая дата.
Функция ДатаИзТиков(Знач Тики)

	ТекстТиков = ЗначениеСтрокой(Тики);
	Если НЕ СостоитИзЦифр(ТекстТиков) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат МестноеВремя(Дата(1, 1, 1) + Цел(Число(ТекстТиков) / 10000000), ЧасовойПоясСеанса());

КонецФункции

Функция ОстатокСрокаСек(Знач Срок)
	Возврат Мин(5, Цел((Срок - ТекущаяУниверсальнаяДатаВМиллисекундах()) / 1000));
КонецФункции

Функция СрокПечатнойФормыСек()
	Возврат 20;
КонецФункции

// Пауза без нагрузки на процессор: в фоновом задании - ожидание себя, иначе - ожидание фонового задания паузы.
Процедура ПодождатьСекунд(Знач Секунд)

	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	// Перехват обоснован: ожидание кончается исключением по таймауту - это и есть конец паузы.
	Попытка
		Если ТекущееЗадание <> Неопределено Тогда
			ТекущееЗадание.ОжидатьЗавершения(Секунд);
		Иначе
			ПараметрыПаузы = Новый Массив;
			ПараметрыПаузы.Добавить(Секунд);
			ЗаданиеПаузы = ФоновыеЗадания.Выполнить("ЭДО_ОператорДиадок.ВыдержатьПаузуВФоне", ПараметрыПаузы, ,
				"ЭДО: пауза Диадока");
			ЗаданиеПаузы.ОжидатьЗавершения(Секунд + 5);
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
