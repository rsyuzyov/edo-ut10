// Входящие документы оператора СБИС (Saby) по его публичному API JSON-RPC. Набор функций - как у
// ЭДО_ОператорПлатформа, но вместо организации передается ящик: Структура (Оператор, Организация, Представление,
// Логин, Пароль) из ЭДО_Сервер. Вход по логину и паролю, сессия X-SBISSessionID живет между вызовами
// в ХранилищеОбщихНастроек и перевыпускается, когда оператор ее не принял.
// В список идут только документы с формализованным файлом УПД или УКД (ON_NSCHFDOPPR, ON_NKORSCHFDOPPR):
// тип списка СБИС сам по себе этого не гарантирует - в КоррВх приходят и письма со счетами.

#Область ПрограммныйИнтерфейс

// Входящие УПД и УКД за период по ящикам СБИС.
// Ящики - Массив Структура (Оператор, Организация, Представление, Логин, Пароль).
// Состояния - Массив, в него по каждому ящику: Структура (Оператор, Организация, Ошибка, Документов).
// Ошибка ящика не обрывает обход остальных.
// Возврат: Массив Структура (Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Статус, Функция,
// Организация, Документ, ЭтоУКД, Вид, Версия, ГидПродавца, ДатаПолучения).
Функция ВходящиеЗаПериод(Знач Ящики, Знач Начало, Знач Конец, Знач НомерДокумента, Состояния) Экспорт

	Итог = Новый Массив;
	Видимые = Новый Соответствие;   // Ид документа и организация -> Истина: один логин бывает у нескольких ящиков

	Для Каждого Ящик Из Ящики Цикл
		Состояние = Новый Структура("Оператор, Организация, Ошибка, Документов", Ящик.Оператор, Ящик.Организация, "", 0);
		БылоСтрок = Итог.Количество();
		// Перехват обоснован: недоступный ящик одной организации не должен оставлять без списка остальные.
		Попытка
			ДобавитьВходящиеЯщика(Итог, Ящик, Начало, Конец, НомерДокумента, Видимые);
		Исключение
			Состояние.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Состояние.Документов = Итог.Количество() - БылоСтрок;
		Состояния.Добавить(Состояние);
	КонецЦикла;

	Возврат Итог;

КонецФункции

// XML титула продавца входящего документа. Ошибка оператора - исключение.
Функция СодержимоеВходящего(Знач Ид, Знач Ящик) Экспорт

	КарточкаДокумента = ПрочитатьДокумент(Ящик, Ид);
	Вложение = ФормализованноеВложение(КарточкаДокумента.Получить("Вложение"));
	Если Вложение = Неопределено Тогда
		ВызватьИсключение "СБИС: у документа " + Ид + " нет формализованного файла УПД или УКД";
	КонецЕсли;
	Ответ = СкачатьФайл(Ящик, СсылкаНаФайлВложения(Вложение));
	Если Ответ.Код <> 200 ИЛИ Ответ.Данные = Неопределено ИЛИ Ответ.Данные.Размер() = 0 Тогда
		ВызватьИсключение "СБИС: XML входящего документа не получен, HTTP " + Ответ.Код;
	КонецЕсли;
	Возврат Ответ.Данные;

КонецФункции

// XML титула продавца с общим сроком - для сумм списка входящих, которых ждет форма.
// Срок - момент в миллисекундах (ТекущаяУниверсальнаяДатаВМиллисекундах).
// Неопределено - срок вышел или оператор не ответил: суммы придут при следующем обновлении.
Функция СодержимоеВходящегоДоСрока(Знач Ид, Знач Ящик, Знач Срок) Экспорт

	// Перехват обоснован: суммы - подсказка к списку; сбой оператора не должен ронять список, причина - в ЖР.
	Попытка
		ОстатокСек = ОстатокСрокаСек(Срок);
		Если ОстатокСек < 1 Тогда
			Возврат Неопределено;
		КонецЕсли;
		КарточкаДокумента = ПрочитатьДокумент(Ящик, Ид, ОстатокСек);
		Вложение = ФормализованноеВложение(КарточкаДокумента.Получить("Вложение"));
		ОстатокСек = ОстатокСрокаСек(Срок);
		Если Вложение = Неопределено ИЛИ ОстатокСек < 1 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Ответ = СкачатьФайл(Ящик, СсылкаНаФайлВложения(Вложение), ОстатокСек);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"СБИС: сумма входящего " + Ид + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

	Если Ответ.Код <> 200 ИЛИ Ответ.Данные = Неопределено ИЛИ Ответ.Данные.Размер() = 0 Тогда
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"СБИС: сумма входящего " + Ид + ": HTTP " + Ответ.Код);
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ответ.Данные;

КонецФункции

// Статус входящего у оператора сейчас - код в тех же значениях, что у Платформы (SENT, ACCEPTED, CANCELLED...),
// неизвестное состояние - его название у СБИС. Ошибка оператора - исключение.
Функция СтатусВходящего(Знач Ид, Знач Ящик) Экспорт
	Возврат СтатусДокумента(ПрочитатьДокумент(Ящик, Ид));
КонецФункции

// Печатная форма входящего у оператора: PDF документа со штампами ЭП (поле СсылкаНаPDF).
// Возврат: Структура (Успех, Данные - ДвоичныеДанные, Текст, Расширение, Пояснение, Протокол).
Функция ПечатнаяФормаВходящего(Знач Ид, Знач Ящик) Экспорт

	Итог = Новый Структура("Успех, Данные, Текст, Расширение, Пояснение, Протокол",
		Ложь, Неопределено, "", "pdf", "", Неопределено);
	// Перехват обоснован: оператор не отвечает - для пользователя это штатное сообщение в карточке, подробно - в ЖР.
	Попытка
		КарточкаДокумента = ПрочитатьДокумент(Ящик, Ид);
		СсылкаНаPDF = СокрЛП(Строка(КарточкаДокумента.Получить("СсылкаНаPDF")));
		Если НЕ ЗначениеЗаполнено(СсылкаНаPDF) Тогда
			Итог.Текст = "СБИС не отдал печатную форму этого документа.";
			Возврат Итог;
		КонецЕсли;
		Ответ = СкачатьФайл(Ящик, СсылкаНаPDF);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"СБИС: печатная форма входящего " + Ид + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Итог.Текст = "Загрузка печатной формы не удалась: СБИС не ответил ("
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "). Попробуйте позже.";
		Возврат Итог;
	КонецПопытки;

	Если Ответ.Код <> 200 ИЛИ Ответ.Данные = Неопределено ИЛИ Ответ.Данные.Размер() = 0 Тогда
		Итог.Текст = "Загрузка печатной формы не удалась: СБИС ответил HTTP " + Ответ.Код + ".";
		Возврат Итог;
	КонецЕсли;
	Итог.Успех = Истина;
	Итог.Данные = Ответ.Данные;
	Возврат Итог;

КонецФункции

// Проверка ящика из настроек: вход заново (без сохраненной сессии) и число входящих УПД за 30 дней.
// Возврат: Строка для пользователя. Ошибка входа или списка - исключение.
Функция ПроверкаЯщика(Знач Ящик) Экспорт

	ЗабытьСессию(Ящик);
	Войти(Ящик);
	Входящие = Новый Массив;
	Конец = ТекущаяДатаСеанса();
	ДобавитьВходящиеЯщика(Входящие, Ящик, НачалоДня(Конец) - 29 * 86400, Конец, "", Новый Соответствие);
	Возврат "Вход в СБИС под «" + Ящик.Логин + "» выполнен. Входящих УПД и УКД за 30 дней: "
		+ Формат(Входящие.Количество(), "ЧН=0; ЧГ=0") + ".";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СписокВходящих

Процедура ДобавитьВходящиеЯщика(Итог, Знач Ящик, Знач Начало, Знач Конец, Знач НомерДокумента, Видимые)

	НашаОрганизация = ОтборНашейОрганизации(Ящик.Организация);
	ПоискНомера = ВРег(СокрЛП(НомерДокумента));

	// ДокОтгрВх - входящие УПД и счета-фактуры, КоррВх - корректировки.
	Для Каждого ТипСписка Из СтрРазделить("ДокОтгрВх,КоррВх", ",") Цикл
		Для НомерСтраницы = 0 По ПределСтраниц() - 1 Цикл
			Фильтр = Новый Структура;
			Фильтр.Вставить("Тип", ТипСписка);
			Фильтр.Вставить("ДатаС", Формат(Начало, "ДФ=dd.MM.yyyy"));
			Фильтр.Вставить("ДатаПо", Формат(Конец, "ДФ=dd.MM.yyyy"));
			Фильтр.Вставить("НашаОрганизация", НашаОрганизация);
			Фильтр.Вставить("Навигация", Новый Структура("РазмерСтраницы, Страница",
				Формат(РазмерСтраницы(), "ЧН=0; ЧГ=0"), Формат(НомерСтраницы, "ЧН=0; ЧГ=0")));
			РезультатСписка = ВызватьМетод(Ящик, "СБИС.СписокДокументов", Новый Структура("Фильтр", Фильтр));
			Если ТипЗнч(РезультатСписка) <> Тип("Соответствие") Тогда
				ВызватьИсключение "СБИС: неверный ответ на список входящих";
			КонецЕсли;

			ДокументыСписка = РезультатСписка.Получить("Документ");
			Если ТипЗнч(ДокументыСписка) = Тип("Массив") Тогда
				Для Каждого ДокументСБИС Из ДокументыСписка Цикл
					Входящий = ВходящийИзДокумента(ДокументСБИС, Ящик);
					Если Входящий = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					КлючВидимого = Входящий.Ид + "|" + XMLСтрока(Входящий.Организация);
					Если Видимые.Получить(КлючВидимого) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Если ЗначениеЗаполнено(ПоискНомера) И СтрНайти(ВРег(Входящий.Номер), ПоискНомера) = 0 Тогда
						Продолжить;
					КонецЕсли;
					Видимые.Вставить(КлючВидимого, Истина);
					Итог.Добавить(Входящий);
				КонецЦикла;
			КонецЕсли;

			Если НЕ ЕстьЕщеСтраницы(РезультатСписка) Тогда
				Прервать;
			КонецЕсли;
			Если НомерСтраницы = ПределСтраниц() - 1 Тогда
				ВызватьИсключение Строка(Ящик.Организация) + ": СБИС отдал больше "
					+ Формат(ПределСтраниц() * РазмерСтраницы(), "ЧГ=0") + " документов «" + ТипСписка
					+ "» за период - список неполный, сузьте период";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Строка входящего из документа списка СБИС. Неопределено - у документа нет формализованного УПД или УКД.
Функция ВходящийИзДокумента(Знач ДокументСБИС, Знач Ящик)

	Если ТипЗнч(ДокументСБИС) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вложение = ФормализованноеВложение(ДокументСБИС.Получить("Вложение"));
	Если Вложение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЭтоУКД = СтрНачинаетсяС(ВРег(ИмяФайлаВложения(Вложение)), "ON_NKORSCHFDOPPR");
	ТипВложения = СокрЛП(Строка(Вложение.Получить("Тип")));
	ФункцияДокумента = ФункцияПоТипуВложения(ТипВложения, ЭтоУКД);
	Контрагент = ДокументСБИС.Получить("Контрагент");
	ДатаДокумента = ДатаВремяИзСтроки(СокрЛП(Строка(ДокументСБИС.Получить("Дата"))));
	ДатаПолучения = ДатаВремяИзСтроки(СокрЛП(Строка(ДокументСБИС.Получить("ДатаВремяСоздания"))));

	Входящий = Новый Структура("Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Статус, Функция, Организация, Документ",
		СокрЛП(Строка(ДокументСБИС.Получить("Идентификатор"))),
		СокрЛП(Строка(ДокументСБИС.Получить("Номер"))),
		ДатаДокумента,
		ИННСтороны(Контрагент),
		НазваниеСтороны(Контрагент),
		ИННСтороны(ДокументСБИС.Получить("НашаОрганизация")),
		СтатусДокумента(ДокументСБИС),
		ФункцияДокумента,
		Ящик.Организация,
		Неопределено);
	Входящий.Вставить("ЭтоУКД", ЭтоУКД);
	Входящий.Вставить("Вид", ЭДО_Сервер.ВидВходящегоДокумента(ФункцияДокумента, ЭтоУКД));
	Входящий.Вставить("Версия", СокрЛП(Строка(Вложение.Получить("ВерсияФормата"))));
	Входящий.Вставить("ГидПродавца", "");
	Входящий.Вставить("ДатаПолучения", ?(ЗначениеЗаполнено(ДатаПолучения), ДатаПолучения, ДатаДокумента));
	Возврат Входящий;

КонецФункции

// Вложение с формализованным файлом УПД или УКД. Служебные (извещения, подтверждения) не берутся.
// Возврат: Соответствие вложения или Неопределено.
Функция ФормализованноеВложение(Знач Вложения)

	Если ТипЗнч(Вложения) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Вложение Из Вложения Цикл
		Если ТипЗнч(Вложение) <> Тип("Соответствие")
			ИЛИ ВРег(СокрЛП(Строка(Вложение.Получить("Служебный")))) = "ДА" Тогда
			Продолжить;
		КонецЕсли;
		ИмяФайла = ВРег(ИмяФайлаВложения(Вложение));
		Если (СтрНачинаетсяС(ИмяФайла, "ON_NSCHFDOPPR") ИЛИ СтрНачинаетсяС(ИмяФайла, "ON_NKORSCHFDOPPR"))
			И ЗначениеЗаполнено(СсылкаНаФайлВложения(Вложение)) Тогда
			Возврат Вложение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ИмяФайлаВложения(Знач Вложение)
	ФайлВложения = Вложение.Получить("Файл");
	Возврат ?(ТипЗнч(ФайлВложения) = Тип("Соответствие"), СокрЛП(Строка(ФайлВложения.Получить("Имя"))), "");
КонецФункции

Функция СсылкаНаФайлВложения(Знач Вложение)
	ФайлВложения = Вложение.Получить("Файл");
	Возврат ?(ТипЗнч(ФайлВложения) = Тип("Соответствие"), СокрЛП(Строка(ФайлВложения.Получить("Ссылка"))), "");
КонецФункции

// Функция документа (СЧФ, СЧФДОП, ДОП) по типу вложения СБИС; у УКД тип не разбирается - вид дает признак УКД.
Функция ФункцияПоТипуВложения(Знач ТипВложения, Знач ЭтоУКД)

	ТипВРег = ВРег(ТипВложения);
	Если ЭтоУКД Тогда
		Возврат "";
	ИначеЕсли СтрНайти(ТипВРег, "СЧФДОП") > 0 Тогда
		Возврат "СЧФДОП";
	ИначеЕсли СтрНайти(ТипВРег, "ДОП") > 0 Тогда
		Возврат "ДОП";
	ИначеЕсли СтрНайти(ТипВРег, "СЧФКТР") > 0 Тогда
		Возврат "СЧФ";
	КонецЕсли;
	Возврат "";

КонецФункции

// Статус документа в кодах Платформы - их понимают список, карточка и проверка «живой ли документ».
// Неизвестное состояние - название у СБИС как есть.
Функция СтатусДокумента(Знач ДокументСБИС)

	Если ВРег(СокрЛП(Строка(ДокументСБИС.Получить("Удален")))) = "ДА" Тогда
		Возврат "DELETED";
	КонецЕсли;
	Состояние = ДокументСБИС.Получить("Состояние");
	Если ТипЗнч(Состояние) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	КодСостояния = СокрЛП(Строка(Состояние.Получить("Код")));
	НазваниеСостояния = СокрЛП(Строка(Состояние.Получить("Название")));
	НазваниеНРег = НРег(НазваниеСостояния);

	Если КодСостояния = "10" Тогда
		Возврат "SENT";   // «В обработке» - ждет нашей подписи
	ИначеЕсли КодСостояния = "7" Тогда
		Возврат "ACCEPTED";   // «Выполнение завершено успешно»
	ИначеЕсли СтрНайти(НазваниеНРег, "аннулир") > 0 Тогда
		ЗапросАннулирования = СтрНайти(НазваниеНРег, "запрос") > 0 ИЛИ СтрНайти(НазваниеНРег, "предлож") > 0;
		Возврат ?(ЗапросАннулирования, "CANCELLATION_REQUESTED", "CANCELLED");
	ИначеЕсли СтрНайти(НазваниеНРег, "отклон") > 0 ИЛИ СтрНайти(НазваниеНРег, "отказ") > 0 Тогда
		Возврат "REJECTED";
	ИначеЕсли СтрНайти(НазваниеНРег, "удален") > 0 Тогда
		Возврат "DELETED";
	КонецЕсли;
	Возврат НазваниеСостояния;

КонецФункции

// Отбор «НашаОрганизация» списка: ИП и физлицо - СвФЛ, юрлицо - СвЮЛ, по ИНН.
Функция ОтборНашейОрганизации(Знач Организация)

	ИНН = СокрЛП(Организация.ИНН);
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		ВызватьИсключение Строка(Организация) + ": не заполнен ИНН - СБИС не найдет ее входящие";
	КонецЕсли;
	Сведения = Новый Структура("ИНН", ИНН);
	Возврат ?(СтрДлина(ИНН) = 12, Новый Структура("СвФЛ", Сведения), Новый Структура("СвЮЛ", Сведения));

КонецФункции

Функция ИННСтороны(Знач Сторона)

	Если ТипЗнч(Сторона) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого ИмяСведений Из СтрРазделить("СвЮЛ,СвФЛ", ",") Цикл
		Сведения = Сторона.Получить(ИмяСведений);
		Если ТипЗнч(Сведения) = Тип("Соответствие") И ЗначениеЗаполнено(Сведения.Получить("ИНН")) Тогда
			Возврат СокрЛП(Строка(Сведения.Получить("ИНН")));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция НазваниеСтороны(Знач Сторона)

	Если ТипЗнч(Сторона) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	СведенияЮЛ = Сторона.Получить("СвЮЛ");
	Если ТипЗнч(СведенияЮЛ) = Тип("Соответствие") И ЗначениеЗаполнено(СведенияЮЛ.Получить("Название")) Тогда
		Возврат СокрЛП(Строка(СведенияЮЛ.Получить("Название")));
	КонецЕсли;
	СведенияФЛ = Сторона.Получить("СвФЛ");
	Если ТипЗнч(СведенияФЛ) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Если ЗначениеЗаполнено(СведенияФЛ.Получить("Название")) Тогда
		Возврат СокрЛП(Строка(СведенияФЛ.Получить("Название")));
	КонецЕсли;
	ЧастиИмени = Новый Массив;
	Для Каждого ИмяЧасти Из СтрРазделить("Фамилия,Имя,Отчество", ",") Цикл
		ЧастьИмени = СокрЛП(Строка(СведенияФЛ.Получить(ИмяЧасти)));
		Если ЗначениеЗаполнено(ЧастьИмени) Тогда
			ЧастиИмени.Добавить(ЧастьИмени);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(ЧастиИмени, " ");

КонецФункции

Функция ЕстьЕщеСтраницы(Знач РезультатСписка)
	Навигация = РезультатСписка.Получить("Навигация");
	Возврат ТипЗнч(Навигация) = Тип("Соответствие") И ВРег(СокрЛП(Строка(Навигация.Получить("ЕстьЕще")))) = "ДА";
КонецФункции

Функция РазмерСтраницы()
	Возврат 50;
КонецФункции

Функция ПределСтраниц()
	Возврат 40;
КонецФункции

// Дата из строки СБИС: «14.11.2026» или «14.11.2026 10.25.31». Не разобралась - пустая дата.
Функция ДатаВремяИзСтроки(Знач Текст)

	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		ОчереднойСимвол = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", ОчереднойСимвол) > 0 Тогда
			Цифры = Цифры + ОчереднойСимвол;
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Цифры) <> 8 И СтрДлина(Цифры) <> 14 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Цифры = Лев(Цифры + "000000", 14);

	// Перехват обоснован: невозможная дата у оператора (31.02) - дата строки пустая, строка списка остается.
	Попытка
		Возврат Дата(Сред(Цифры, 5, 4) + Сред(Цифры, 3, 2) + Лев(Цифры, 2) + Сред(Цифры, 9, 6));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

Функция ОстатокСрокаСек(Знач Срок)
	Возврат Мин(5, Цел((Срок - ТекущаяУниверсальнаяДатаВМиллисекундах()) / 1000));
КонецФункции

#КонецОбласти

#Область ВызовыAPI

Функция ПрочитатьДокумент(Знач Ящик, Знач Ид, Знач ТаймаутСек = 0)

	Параметры = Новый Структура("Документ", Новый Структура("Идентификатор", СокрЛП(Ид)));
	КарточкаДокумента = ВызватьМетод(Ящик, "СБИС.ПрочитатьДокумент", Параметры, ТаймаутСек);
	Если ТипЗнч(КарточкаДокумента) <> Тип("Соответствие") Тогда
		ВызватьИсключение "СБИС: документ " + Ид + " не прочитан";
	КонецЕсли;
	Возврат КарточкаДокумента;

КонецФункции

// Вызов метода API с сессией ящика. Сессию, которую оператор не принял (HTTP 401, 403), перевыпускаем один раз.
// Возврат: поле result ответа. Ошибка оператора - исключение с его текстом.
Функция ВызватьМетод(Знач Ящик, Знач Метод, Знач Параметры, Знач ТаймаутСек = 0)

	Сессия = СохраненнаяСессия(Ящик);
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Сессия = Войти(Ящик, ТаймаутСек);
	КонецЕсли;
	Ответ = ЗапросJSONRPC(ПутьAPI(), Метод, Параметры, Сессия, ТаймаутСек);
	Если Ответ.Код = 401 ИЛИ Ответ.Код = 403 Тогда
		ЗабытьСессию(Ящик);
		Сессия = Войти(Ящик, ТаймаутСек);
		Ответ = ЗапросJSONRPC(ПутьAPI(), Метод, Параметры, Сессия, ТаймаутСек);
	КонецЕсли;
	Возврат РезультатОтвета(Метод, Ответ);

КонецФункции

// Вход по логину и паролю ящика; сессия запоминается. Пароль не попадает ни в URL, ни в текст ошибки.
Функция Войти(Знач Ящик, Знач ТаймаутСек = 0)

	Если НЕ ЗначениеЗаполнено(Ящик.Логин) ИЛИ НЕ ЗначениеЗаполнено(Ящик.Пароль) Тогда
		ВызватьИсключение "СБИС: у ящика «" + Ящик.Представление + "» не задан логин или пароль";
	КонецЕсли;
	Параметры = Новый Структура("Параметр", Новый Структура("Логин, Пароль", Ящик.Логин, Ящик.Пароль));
	Ответ = ЗапросJSONRPC(ПутьВхода(), "СБИС.Аутентифицировать", Параметры, "", ТаймаутСек);
	Сессия = РезультатОтвета("вход под «" + Ящик.Логин + "»", Ответ);
	Если ТипЗнч(Сессия) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(Сессия) Тогда
		ВызватьИсключение "СБИС: вход под «" + Ящик.Логин + "» не выполнен - нет идентификатора сессии в ответе";
	КонецЕсли;
	ЗапомнитьСессию(Ящик, Сессия);
	Возврат Сессия;

КонецФункции

// Возврат: Структура (Код, Текст, Данные - разобранный JSON или Неопределено).
Функция ЗапросJSONRPC(Знач Путь, Знач Метод, Знач Параметры, Знач Сессия, Знач ТаймаутСек)

	ТелоЗапроса = Новый Структура("jsonrpc, method, params, id", "2.0", Метод, Параметры, 0);
	ЗаписьТела = Новый ЗаписьJSON;
	ЗаписьТела.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьТела, ТелоЗапроса);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json-rpc; charset=utf-8");
	Если ЗначениеЗаполнено(Сессия) Тогда
		Заголовки.Вставить("X-SBISSessionID", Сессия);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(ЗаписьТела.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Ответ = Соединение(ХостAPI(), ТаймаутСек).ОтправитьДляОбработки(Запрос);

	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	ДанныеОтвета = Неопределено;
	Если Лев(СокрЛП(ТекстОтвета), 1) = "{" Тогда
		ДанныеОтвета = ЭДО_Сервер.ПрочитатьОтветJSON(ТекстОтвета);
	КонецЕсли;
	Возврат Новый Структура("Код, Текст, Данные", Ответ.КодСостояния, ТекстОтвета, ДанныеОтвета);

КонецФункции

Функция РезультатОтвета(Знач Метод, Знач Ответ)

	Если ТипЗнч(Ответ.Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "СБИС: " + Метод + " - HTTP " + Ответ.Код + " " + Лев(СокрЛП(Ответ.Текст), 200);
	КонецЕсли;
	ОшибкаОператора = Ответ.Данные.Получить("error");
	Если ОшибкаОператора <> Неопределено Тогда
		ВызватьИсключение "СБИС: " + Метод + " - " + ТекстОшибкиОператора(ОшибкаОператора);
	КонецЕсли;
	Если Ответ.Код <> 200 Тогда
		ВызватьИсключение "СБИС: " + Метод + " - HTTP " + Ответ.Код;
	КонецЕсли;
	Возврат Ответ.Данные.Получить("result");

КонецФункции

Функция ТекстОшибкиОператора(Знач ОшибкаОператора)

	Если ТипЗнч(ОшибкаОператора) <> Тип("Соответствие") Тогда
		Возврат Лев(СокрЛП(Строка(ОшибкаОператора)), 300);
	КонецЕсли;
	Подробности = СокрЛП(Строка(ОшибкаОператора.Получить("details")));
	Сообщение = СокрЛП(Строка(ОшибкаОператора.Получить("message")));
	Возврат Лев(?(ЗначениеЗаполнено(Подробности), Подробности, Сообщение), 300);

КонецФункции

// Скачивание файла по ссылке из ответа API - только https на домены оператора: с запросом уходит сессия.
// Возврат: Структура (Код, Данные).
Функция СкачатьФайл(Знач Ящик, Знач Ссылка, Знач ТаймаутСек = 0)

	Адрес = РазобратьСсылку(Ссылка);
	Сессия = СохраненнаяСессия(Ящик);
	Если НЕ ЗначениеЗаполнено(Сессия) Тогда
		Сессия = Войти(Ящик, ТаймаутСек);
	КонецЕсли;
	Ответ = ЗапросФайла(Адрес, Сессия, ТаймаутСек);
	Если Ответ.КодСостояния = 401 ИЛИ Ответ.КодСостояния = 403 Тогда
		ЗабытьСессию(Ящик);
		Ответ = ЗапросФайла(Адрес, Войти(Ящик, ТаймаутСек), ТаймаутСек);
	КонецЕсли;
	Возврат Новый Структура("Код, Данные", Ответ.КодСостояния, Ответ.ПолучитьТелоКакДвоичныеДанные());

КонецФункции

Функция ЗапросФайла(Знач Адрес, Знач Сессия, Знач ТаймаутСек)

	Заголовки = Новый Соответствие;
	Если ЗначениеЗаполнено(Сессия) Тогда
		Заголовки.Вставить("X-SBISSessionID", Сессия);
	КонецЕсли;
	Возврат Соединение(Адрес.Хост, ТаймаутСек).Получить(Новый HTTPЗапрос(Адрес.Путь, Заголовки));

КонецФункции

// Хост и путь из абсолютной ссылки; ссылка не https или не на домен оператора - исключение.
Функция РазобратьСсылку(Знач Ссылка)

	Ссылка = СокрЛП(Ссылка);
	Префикс = "https://";
	Если НРег(Лев(Ссылка, СтрДлина(Префикс))) <> Префикс Тогда
		ВызватьИсключение "СБИС: ссылка на файл не https - файл не скачивается";
	КонецЕсли;
	БезПрефикса = Сред(Ссылка, СтрДлина(Префикс) + 1);
	ПозицияПути = СтрНайти(БезПрефикса, "/");
	Хост = НРег(?(ПозицияПути = 0, БезПрефикса, Лев(БезПрефикса, ПозицияПути - 1)));
	Путь = ?(ПозицияПути = 0, "/", Сред(БезПрефикса, ПозицияПути));
	ДоменОператора = СтрЗаканчиваетсяНа(Хост, ".sbis.ru") ИЛИ Хост = "sbis.ru"
		ИЛИ СтрЗаканчиваетсяНа(Хост, ".saby.ru") ИЛИ Хост = "saby.ru";
	Если НЕ ДоменОператора ИЛИ СтрНайти(Хост, "@") > 0 ИЛИ СтрНайти(Хост, ":") > 0 Тогда
		ВызватьИсключение "СБИС: ссылка на файл ведет не на домен оператора (" + Хост + ") - файл не скачивается";
	КонецЕсли;
	Возврат Новый Структура("Хост, Путь", Хост, Путь);

КонецФункции

Функция Соединение(Знач Хост, Знач ТаймаутСек)
	Таймаут = ?(ТаймаутСек > 0, ТаймаутСек, ЭДО_Сервер.НастройкаЭДО("ТаймаутHTTPСек"));
	Возврат Новый HTTPСоединение(Хост, 443, , , , Таймаут, Новый ЗащищенноеСоединениеOpenSSL());
КонецФункции

Функция ХостAPI()
	Возврат "online.sbis.ru";
КонецФункции

Функция ПутьAPI()
	Возврат "/service/?srv=1";
КонецФункции

Функция ПутьВхода()
	Возврат "/auth/service/";
КонецФункции

#КонецОбласти

#Область Сессии

// Сессии лежат под пустым пользователем: список обновляют разные пользователи и регламент.
Функция СохраненнаяСессия(Знач Ящик)

	УстановитьПривилегированныйРежим(Истина);
	Сессия = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаСессий(), КлючСессии(Ящик), , "");
	Возврат ?(ТипЗнч(Сессия) = Тип("Строка"), Сессия, "");

КонецФункции

Процедура ЗапомнитьСессию(Знач Ящик, Знач Сессия)
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаСессий(), КлючСессии(Ящик), Сессия, , "");
КонецПроцедуры

Процедура ЗабытьСессию(Знач Ящик)
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Удалить(КлючОбъектаСессий(), КлючСессии(Ящик), "");
КонецПроцедуры

Функция КлючОбъектаСессий()
	Возврат "ЭДО_СессииОператоров";
КонецФункции

Функция КлючСессии(Знач Ящик)
	Возврат "sbis:" + НРег(СокрЛП(Ящик.Логин));
КонецФункции

#КонецОбласти

