// Входящие УПД и УКД, выгруженные из веб-кабинета Диадока внешним скриптом diadoc-web-export.
// Набор функций - как у ЭДО_ОператорСБИС, но сети нет: провайдер читает каталог спула
// (index.json + XML), который наполняет headless Chrome на стороне сервера выгрузки.
//
// Ящик для этого оператора: Логин = идентификатор ящика Диадока (GUID из адреса кабинета),
// Пароль не используется. Организация - обычная ссылка на справочник Организации.
// Каталог спула - настройка ЭДО КаталогСпулаДиадокВеб (по умолчанию C:\edo\diadoc-web).

#Область ПрограммныйИнтерфейс

// Входящие УПД и УКД за период по ящикам веб-выгрузки.
// Ящики - Массив Структура (Оператор, Организация, Представление, Логин, Пароль).
// Состояния - Массив, в него по каждому ящику: Структура (Оператор, Организация, Ошибка, Документов).
// Ошибка ящика не обрывает обход остальных.
// Возврат: Массив Структура (Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Статус, Функция,
// Организация, Документ, ЭтоУКД, Вид, Версия, ГидПродавца, ДатаПолучения).
Функция ВходящиеЗаПериод(Знач Ящики, Знач Начало, Знач Конец, Знач НомерДокумента, Состояния) Экспорт

	Итог = Новый Массив;
	Видимые = Новый Соответствие;

	Для Каждого Ящик Из Ящики Цикл
		Состояние = Новый Структура("Оператор, Организация, Ошибка, Документов", Ящик.Оператор, Ящик.Организация, "", 0);
		БылоСтрок = Итог.Количество();
		// Перехват обоснован: пустой или недоступный спул одного ящика не должен убирать остальные.
		Попытка
			ДобавитьВходящиеЯщика(Итог, Ящик, Начало, Конец, НомерДокумента, Видимые);
		Исключение
			Состояние.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Состояние.Документов = Итог.Количество() - БылоСтрок;
		Состояния.Добавить(Состояние);
	КонецЦикла;

	Возврат Итог;

КонецФункции

// XML титула продавца входящего документа из спула. Ошибка - исключение.
Функция СодержимоеВходящего(Знач Ид, Знач Ящик) Экспорт

	Запись = НайтиЗапись(Ид, Ящик.Логин);
	Если Запись = Неопределено Тогда
		ВызватьИсключение "Диадок (веб): входящий " + Ид + " не найден в спуле";
	КонецЕсли;
	Путь = ПутьСпула(ЗначениеЗаписи(Запись, "xmlPath"));
	Если НЕ ФайлСуществуетПоПути(Путь) Тогда
		ВызватьИсключение "Диадок (веб): файл входящего " + Ид + " не найден: " + Путь;
	КонецЕсли;
	Возврат Новый ДвоичныеДанные(Путь);

КонецФункции

// То же с общим сроком - для сумм списка входящих, которых ждет форма.
// Спул локальный, поэтому срок не сокращает чтение; ошибка - в ЖР, список не падает.
Функция СодержимоеВходящегоДоСрока(Знач Ид, Знач Ящик, Знач Срок) Экспорт

	// Перехват обоснован: суммы - подсказка к списку; сбой чтения спула не должен ронять список.
	Попытка
		Возврат СодержимоеВходящего(Ид, Ящик);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Диадок (веб): сумма входящего " + Ид + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Статус входящего из спула в кодах Платформы, неизвестное состояние - его текст.
Функция СтатусВходящего(Знач Ид, Знач Ящик) Экспорт

	Запись = НайтиЗапись(Ид, Ящик.Логин);
	Если Запись = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтатусПоТексту(ЗначениеЗаписи(Запись, "status"));

КонецФункции

// Печатная форма в веб-выгрузке не сохраняется: после загрузки документа ее строит 1С.
Функция ПечатнаяФормаВходящего(Знач Ид, Знач Ящик) Экспорт

	Возврат Новый Структура("Успех, Данные, Текст, Расширение, Пояснение, Протокол",
		Ложь, Неопределено,
		"Печатная форма из веб-выгрузки не сохраняется. Загрузите документ в 1С и напечатайте его оттуда.",
		"pdf", "", Неопределено);

КонецФункции

// Проверка ящика из настроек: есть ли спул и сколько в нем документов этого ящика.
// Возврат: Строка для пользователя. Нет index.json - исключение.
Функция ПроверкаЯщика(Знач Ящик) Экспорт

	Каталог = КаталогСпула();
	Если НЕ ФайлСуществуетПоПути(ПутьСпула("index.json")) Тогда
		ВызватьИсключение "Диадок (веб): нет index.json в " + Каталог
			+ ". Проверьте, что выгрузка из веб-кабинета запускается.";
	КонецЕсли;

	Найдено = 0;
	Для Каждого Запись Из ПрочитатьИндекс() Цикл
		Если ЗначениеЗаписи(Запись, "boxId") = Ящик.Логин Тогда
			Найдено = Найдено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат "Спул " + Каталог + ": документов по ящику " + Ящик.Логин + " - "
		+ Формат(Найдено, "ЧН=0; ЧГ=0") + ".";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьВходящиеЯщика(Итог, Знач Ящик, Знач Начало, Знач Конец, Знач НомерДокумента, Видимые)

	НачалоПериода = НачалоДня(Начало);
	КонецПериода = КонецДня(Конец);
	ПоискНомера = ВРег(СокрЛП(НомерДокумента));

	Для Каждого Запись Из ПрочитатьИндекс() Цикл
		Если ЗначениеЗаписи(Запись, "boxId") <> Ящик.Логин Тогда
			Продолжить;
		КонецЕсли;

		// Окно списка - по дате документа: дата сообщения в Диадоке хранится по Гринвичу,
		// и сравнение с местными датами формы дало бы сдвиг на часовой пояс.
		ДатаДокумента = ДатаИзISO(ЗначениеЗаписи(Запись, "documentDateIso"));
		Если ДатаДокумента = Дата(1, 1, 1) Тогда
			ДатаДокумента = ДатаИзТекста(ЗначениеЗаписи(Запись, "documentDate"));
		КонецЕсли;
		Если ДатаДокумента < НачалоПериода ИЛИ ДатаДокумента > КонецПериода Тогда
			Продолжить;
		КонецЕсли;

		Номер = СокрЛП(ЗначениеЗаписи(Запись, "number"));
		Если ЗначениеЗаполнено(ПоискНомера) И СтрНайти(ВРег(Номер), ПоискНомера) = 0 Тогда
			Продолжить;
		КонецЕсли;

		Ид = СокрЛП(ЗначениеЗаписи(Запись, "shortId"));
		Если НЕ ЗначениеЗаполнено(Ид) Тогда
			Ид = СокрЛП(ЗначениеЗаписи(Запись, "fileId"));
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Ид) Тогда
			Продолжить;
		КонецЕсли;
		КлючВидимого = Ид + "|" + XMLСтрока(Ящик.Организация);
		Если Видимые.Получить(КлючВидимого) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЭтоУКД = (ЗначениеЗаписи(Запись, "isCorrection", Ложь) = Истина);
		ФункцияДокумента = ЗначениеЗаписи(Запись, "functionCode");
		ДатаПолучения = ДатаИзВремени(ЗначениеЗаписи(Запись, "messageDate"));
		Если ДатаПолучения = Дата(1, 1, 1) Тогда
			ДатаПолучения = ДатаДокумента;
		КонецЕсли;

		Входящий = Новый Структура("Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Статус, Функция, Организация, Документ",
			Ид, Номер, ДатаДокумента, ЗначениеЗаписи(Запись, "senderInn"), ЗначениеЗаписи(Запись, "senderName"),
			ЗначениеЗаписи(Запись, "buyerInn"), СтатусПоТексту(ЗначениеЗаписи(Запись, "status")),
			ФункцияДокумента, Ящик.Организация, Неопределено);
		Входящий.Вставить("ЭтоУКД", ЭтоУКД);
		Входящий.Вставить("Вид", ЭДО_Сервер.ВидВходящегоДокумента(ФункцияДокумента, ЭтоУКД));
		Входящий.Вставить("Версия", "5.03");
		Входящий.Вставить("ГидПродавца", "");
		Входящий.Вставить("ДатаПолучения", ДатаПолучения);

		Видимые.Вставить(КлючВидимого, Истина);
		Итог.Добавить(Входящий);
	КонецЦикла;

КонецПроцедуры

Функция НайтиЗапись(Знач Ид, Знач ИдентификаторЯщика)

	Для Каждого Запись Из ПрочитатьИндекс() Цикл
		Если ЗначениеЗаписи(Запись, "boxId") <> ИдентификаторЯщика Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаписи(Запись, "shortId") = Ид ИЛИ ЗначениеЗаписи(Запись, "fileId") = Ид Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ПрочитатьИндекс()

	Путь = ПутьСпула("index.json");
	Если НЕ ФайлСуществуетПоПути(Путь) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Попытка
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение "Диадок (веб): не удалось прочитать " + Путь + ": "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Чтение.Закрыть();

	Возврат ?(ТипЗнч(Данные) = Тип("Массив"), Данные, Новый Массив);

КонецФункции

Функция ЗначениеЗаписи(Знач Запись, Знач Имя, Знач ПоУмолчанию = "")

	Значение = ПоУмолчанию;
	Если ТипЗнч(Запись) = Тип("Структура") Тогда
		Запись.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Запись) = Тип("Соответствие") Тогда
		Значение = Запись.Получить(Имя);
	КонецЕсли;
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);

КонецФункции

Функция ФайлСуществуетПоПути(Знач Путь)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует();

КонецФункции

Функция КаталогСпула() Экспорт

	Каталог = СокрЛП(ЭДО_Сервер.НастройкаЭДО("КаталогСпулаДиадокВеб"));
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Каталог = "C:\edo\diadoc-web";
	КонецЕсли;
	Возврат Каталог;

КонецФункции

Функция ПутьСпула(Знач ОтносительныйПуть)

	Каталог = КаталогСпула();
	Разделитель = ?(Прав(Каталог, 1) = "\" ИЛИ Прав(Каталог, 1) = "/", "", "\");
	Возврат Каталог + Разделитель + СтрЗаменить(ОтносительныйПуть, "/", "\");

КонецФункции

Функция ДатаИзISO(Знач Текст)

	Текст = СокрЛП(Текст);
	Если СтрДлина(Текст) < 10 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Лев(Текст, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

Функция ДатаИзТекста(Знач Текст)

	Части = СтрРазделить(СокрЛП(Текст), ".");
	Если Части.Количество() <> 3 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

Функция ДатаИзВремени(Знач Текст)

	Текст = СокрЛП(Текст);
	Если СтрДлина(Текст) < 19 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		ДатаДокумента = Дата(Число(Лев(Текст, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)));
		Секунды = Число(Сред(Текст, 12, 2)) * 3600 + Число(Сред(Текст, 15, 2)) * 60 + Число(Сред(Текст, 18, 2));
		Возврат ДатаДокумента + Секунды / 86400;
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

Функция СтатусПоТексту(Знач Текст)

	Нормализованный = НРег(СокрЛП(Текст));
	Если СтрНайти(Нормализованный, "требуется подпись") > 0 Тогда
		Возврат "SENT";
	ИначеЕсли СтрНайти(Нормализованный, "аннулир") > 0 Тогда
		Возврат "CANCELLED";
	ИначеЕсли СтрНайти(Нормализованный, "отказ") > 0 ИЛИ СтрНайти(Нормализованный, "отклон") > 0 Тогда
		Возврат "REJECTED";
	ИначеЕсли СтрНайти(Нормализованный, "подписан") > 0 ИЛИ СтрНайти(Нормализованный, "завершен") > 0 Тогда
		Возврат "ACCEPTED";
	Иначе
		Возврат Текст;
	КонецЕсли;

КонецФункции

#КонецОбласти
