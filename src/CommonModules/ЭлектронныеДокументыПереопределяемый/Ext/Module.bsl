////////////////////////////////////////////////////////////////////////////////
// Перехват точки БЭД, которая заполняет колонку "Состояние ЭДО" в списках документов.
//
// Зачем: колонка в списках ("Акты сверки взаиморасчетов", "Реализация товаров и услуг")
// типовая и до нас всегда пустая - типовой контур ЭДО у нас не работает. Пользователь
// видит пустой столбец и идёт спрашивать состояние. Пишем в него то же самое, что
// показывает колонка "ЭДО" в обработке заявок: свойство ЭДО_Состояние.
//
// Счета-фактуры отдаём типовому механизму: у них своя пара колонок "действий сторон",
// к "Платформе ЭДО" отношения не имеющая.
////////////////////////////////////////////////////////////////////////////////

// Оформление строк списка: колонка "Состояние ЭДО" по нашим данным.
&Вместо("ЭДО_ФормаСпискаДокумента_ПриПолученииДанных")
Процедура ЭДО_ЭДО_ФормаСпискаДокумента_ПриПолученииДанных(Элемент, ОформленияСтрок, мИспользоватьОбменЭД, ЭтоСчетФактура = Ложь)

	Ссылки = Новый Массив;
	Для Каждого ОформлениеСтроки Из ОформленияСтрок Цикл
		ДанныеСтроки = ОформлениеСтроки.ДанныеСтроки;
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЭДО_НашДокумент(ДанныеСтроки.Ссылка) Тогда
			Ссылки.Добавить(ДанныеСтроки.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Если ЭтоСчетФактура ИЛИ Ссылки.Количество() = 0 Тогда
		ПродолжитьВызов(Элемент, ОформленияСтрок, мИспользоватьОбменЭД, ЭтоСчетФактура);
		Возврат;
	КонецЕсли;

	// Колонка есть не в каждой форме списка, и её может не быть у переопределённой формы.
	// Отсутствие колонки - не повод ронять прорисовку списка.
	Колонка = Неопределено;
	Попытка
		Колонка = Элемент.Колонки.Найти("СостояниеЭД");
	Исключение
		Колонка = Неопределено;
	КонецПопытки;
	Если Колонка = Неопределено ИЛИ НЕ Колонка.Видимость Тогда
		Возврат;
	КонецЕсли;

	Состояния = ЭДО_Сервер.СостоянияЭДОПоДокументам(Ссылки);
	Для Каждого ОформлениеСтроки Из ОформленияСтрок Цикл
		ДанныеСтроки = ОформлениеСтроки.ДанныеСтроки;
		Если ДанныеСтроки = Неопределено ИЛИ НЕ ЭДО_НашДокумент(ДанныеСтроки.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		Текст = Состояния[ДанныеСтроки.Ссылка];
		ОформлениеСтроки.Ячейки.СостояниеЭД.УстановитьТекст(?(Текст = Неопределено, "", Текст));
	КонецЦикла;

КонецПроцедуры

// Обслуживает ли наш контур этот документ.
// Дубль ЭДО_Клиент.НашКонтурЭДО намеренный: этот модуль компилируется и на СЕРВЕРЕ,
// а ЭДО_Клиент - только клиентский, обращение к нему сломало бы серверную компиляцию.
Функция ЭДО_НашДокумент(Знач Ссылка)
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипДокумента = ТипЗнч(Ссылка);
	Возврат ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.АктСверкиВзаиморасчетов");
КонецФункции

// Надпись ТекстСостоянияЭД в обычной форме документа может быть скрыта в самой форме:
// типовой код управляет только ее гиперссылкой. Показываем надпись, когда текст есть.
&После("ИзменитьСвойстваЭлементовФормы")
Процедура ЭДО_ИзменитьСвойстваЭлементовФормы(Форма, СтруктураПараметров)

	Если НЕ СтруктураПараметров.Свойство("ТекстСостоянияЭДО")
		ИЛИ НЕ ЗначениеЗаполнено(СтруктураПараметров.ТекстСостоянияЭДО) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если ТипЗнч(Форма) = Тип("УправляемаяФорма") Тогда
			Элемент = Форма.Элементы.Найти("ТекстСостоянияЭД");
		Иначе
			Элемент = Форма.ЭлементыФормы.Найти("ТекстСостоянияЭД");
		КонецЕсли;
		Если Элемент <> Неопределено Тогда
			Элемент.Видимость = Истина;
		КонецЕсли;
	Исключение
		// у формы нет такой надписи или она другого вида - показывать нечего
		Возврат;
	КонецПопытки;

КонецПроцедуры
