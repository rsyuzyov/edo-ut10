// Регламенты ЭДО внутри расширения: код регламента живет вместе с ядром и едет одной выкаткой.
// Задачи планировщика с файлами на хосте расходились с репозиторием молча.

// Разводка регламентов по ключу - единственное место, где ключ превращается в вызов.
// Носители расписания (перехват типового задания ядра, задание из профиля базы) - тонкие
// обертки над ней: новый регламент добавляется только сюда и в КлючиРегламентов().
// Явные сравнения, а не вызов по имени через Вычислить(): там опечатка в имени метода
// падала бы только в работе и только у сработавшего ключа.
// Возврат: Истина - ключ наш и регламент выполнен; Ложь - ключ чужой, носитель обязан
// отдать вызов типовому поведению (ПродолжитьВызов).
Функция ВыполнитьРегламентПоКлючу(Знач КодНастройки) Экспорт

	Ключ = НормализованныйКлюч(КодНастройки);   // одна нормализация с ключом сторожа

	// сторож зависших регламентов - первым делом, до обращений наружу.
	Если КлючиРегламентовВРег().Получить(Ключ) <> Неопределено Тогда
		ПроверитьЗависшиеРегламенты();
	КонецЕсли;

	Если Ключ = ВРег("ЭДО_ОтправкаОчереди") Тогда
		ОтправитьОчередь();
	ИначеЕсли Ключ = ВРег("ЭДО_СверкаСтатусов") Тогда
		ИтогСверки = ВыполнитьСверкуСтатусов();
		// сверка без окна (поздние подпись и отказ за глубиной синхронизации) - в задании
		// ЭДО_ТочечнаяСверка раз в 15 минут; здесь ее больше нет: два задания с одним указателем ленты затирали бы
		// друг другу хвост неполученных.
		// «статусы ЧЧ:ММ» в строке «Обмен» - и с признаком ошибки: бывало, сверка шла по
		// расписанию, а оператор с ночи отвечал 401, и строка выглядела как нормальная работа.
		// «ОШИБК» - полная сверка пишет «ОШИБКИ». Успешный обмен
		// отмечают сами сверки по ответу оператора HTTP 200.
		// Статус документа со словом «Ошибка» в перечне свода - не сбой сверки (ЕстьОшибкаВСводе).
		СверкаСОшибкой = ЕстьОшибкаВСводе(ИтогСверки);
		ЗапомнитьИтогОбмена("ПоследняяСверкаСтатусов", Новый Структура("Конец, Ошибка", ТекущаяДатаСеанса(), СверкаСОшибкой));
	ИначеЕсли Ключ = ВРег("ЭДО_ТочечнаяСверка") Тогда
		// без окна - все нефинальные документы; по ленте спрашиваются только изменившиеся
		// (полную сверку можно ставить реже, и поздняя подпись по документу старше 7 дней не ждет ее).
		ВыполнитьТочечнуюСверку(0);
	ИначеЕсли Ключ = ВРег("ЭДО_ОбновлениеСвязей") Тогда
		ВыполнитьОбновлениеСвязей();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожНеПринятых") Тогда
		ЭДО_Сторожа.ВыполнитьСторожНеПринятых();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожПаузы") Тогда
		ЭДО_Сторожа.ВыполнитьСторожПаузы();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожГИСМТ") Тогда
		ЭДО_Сторожа.ВыполнитьСторожГИСМТ();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожБрошенных") Тогда
		ЭДО_Сторожа.ВыполнитьСторожБрошенныхОтметок();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожРасхождений") Тогда
		ЭДО_Сторожа.ВыполнитьСторожРасхождений();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожЗапросовАннулирования") Тогда
		ЭДО_Сторожа.ВыполнитьСторожЗапросовАннулирования();
		// Следом - наши ПОА без ответа контрагента для центра управления, тем же заданием.
		ЭДО_Сторожа.ВыполнитьСторожНашихАннулирований();
	ИначеЕсли Ключ = ВРег("ЭДО_СторожАдресовПолучателя") Тогда
		ЭДО_Сторожа.ВыполнитьСторожАдресовПолучателя();
	ИначеЕсли Ключ = ВРег("ЭДО_СогласиеНаАннулированиеВходящих") Тогда
		ЭДО_Сторожа.ВыполнитьСогласиеНаАннулированиеВходящих();
	ИначеЕсли Ключ = ВРег("ЭДО_АвтоматическоеПринятиеУПД") Тогда
		// итог приемки - для строки «Обмен» (в базе без отправки по расписанию это и есть обмен).
		Свод = ЭДО_Сервер.ВыполнитьАвтоматическоеПринятиеУПД();
		ЗапомнитьИтогОбмена("ПоследнийПрогонПриемки", Новый Структура("Конец, Свод, Ошибка", ТекущаяДатаСеанса(),
			Лев(СтрПолучитьСтроку(Свод, 1), 300), СтрНайти(ВРег(Свод), "ОШИБК") > 0));
		// успешный обмен отмечает сама приемка по ответу оператора: прогон без обращения
		// к оператору (настройка выключена, ждать нечего) связь не подтверждает.
	ИначеЕсли Ключ = ВРег("ЭДО_СторожЗависаний") Тогда
		// только сторож (выполнен выше) - без внешних обращений, поэтому сам не виснет
		// и снимает зависания, даже если зависли все рабочие регламенты.
		Возврат Истина;
	ИначеЕсли Ключ = ВРег("ЭДО_ПриглашенияНовымКонтрагентам") Тогда
		ВыполнитьПриглашенияНовымКонтрагентам();
	ИначеЕсли Ключ = ВРег("ЭДО_АннулированиеЛишнихЭкземпляров") Тогда
		ЭДО_Сторожа.ВыполнитьАннулированиеЛишнихЭкземпляров();
	ИначеЕсли Ключ = ВРег("ЭДО_АннулированиеЛишнихЭкземпляровПроверка") Тогда
		ЭДО_Сторожа.ВыполнитьАннулированиеЛишнихЭкземпляров(Истина);
	Иначе
		Возврат Ложь;   // чужой ключ - носитель отдает вызов типовому поведению
	КонецЕсли;

	Возврат Истина;

КонецФункции

// какие документы изменились у оператора с прошлого прогона - по ленте v4/document-changes
// (рекомендация поддержки Платформы: лента вместо опроса каждой карточки). Лента общая на ящик: берутся
// изменения, где наша организация отправитель или получатель; изменение подчиненного документа (титул покупателя,
// ПОА, квитанция) - это изменение его мастера. Смещение (номер последнего изменения) хранится отдельно по
// организации и окну сверки: «с окном» и «без окна» - разные прогоны, и общий указатель съел бы чужие изменения.
// Первый прогон берет текущий конец ленты (v3 за последний час) и сверяет все. Лента не ответила или изменений
// больше 20 000 - сверяются все. Смещение записывает вызывающий - после сверки без ошибок (ЗапомнитьСмещениеЛенты).
// Возврат: Структура(Изменения - Соответствие id -> Истина или Неопределено (сверять все), НовоеСмещение, КлючСмещения, Описание).
Функция ИзмененныеПоЛенте(Знач Организация, Знач ОкноДней, Соед, Заголовки, Знач Гид)

	Итог = Новый Структура("Изменения, НовоеСмещение, КлючСмещения, Описание", Неопределено, Неопределено, "", "");
	Хвост = Новый Массив;   // спрошенные прошлым прогоном, но не полученные - спросить снова
	НужнаПолная = Ложь;     // хвост прошлого прогона не уместился - в этот раз сверяются все
	Если НЕ ЗначениеЗаполнено(Гид) Тогда
		Итог.Описание = "лента: нет идентификатора организации у оператора - сверены все";
		Возврат Итог;
	КонецЕсли;
	Итог.КлючСмещения = "ЭДО_ЛентаИзменений_" + ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН))
		+ "_" + Формат(ОкноДней, "ЧН=0; ЧГ=0");
	УстановитьПривилегированныйРежим(Истина);   // общие настройки под пользователем "" - чужой слот
	Смещение = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", Итог.КлючСмещения, , "");
	Если ТипЗнч(Смещение) = Тип("Структура") Тогда   // Структура(Смещение, Хвост) - см. ЗапомнитьСмещениеЛенты
		Если Смещение.Свойство("Хвост") И ТипЗнч(Смещение.Хвост) = Тип("Массив") Тогда
			Хвост = Смещение.Хвост;
		КонецЕсли;
		НужнаПолная = Смещение.Свойство("Полная") И Смещение.Полная = Истина;
		Смещение = ?(Смещение.Свойство("Смещение"), Смещение.Смещение, Неопределено);
	КонецЕсли;
	ПутьЛенты = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/";
	НашГид = ВРег(СокрЛП(Гид));

	// Попытка: таймаут ленты приходит исключением - тогда сверяются все, как без ленты; причина - в свод и журнал.
	Попытка
		Если ТипЗнч(Смещение) <> Тип("Число") ИЛИ Смещение <= 0 Тогда
			// Лента v4 отдает события от старых к новым, а id растут: конец ищем делением пополам.
			Конец = 0;
			Граница = 100000000000;
			Для НомерШага = 1 По 60 Цикл
				Если Граница - Конец <= 1 Тогда
					Прервать;
				КонецЕсли;

				Середина = Цел((Конец + Граница) / 2);
				Ответ = Соед.Получить(Новый HTTPЗапрос(ПутьЛенты + "v4/document-changes?offset="
					+ Формат(Середина, "ЧГ=0") + "&limit=10", Заголовки));
				Порция = ?(Ответ.КодСостояния = 200, ПрочитатьОтветЛенты(Ответ), Неопределено);
				Если ТипЗнч(Порция) <> Тип("Массив") Тогда
					Итог.Описание = "лента: конец не получен (HTTP " + Ответ.КодСостояния + ") - сверены все";
					Возврат Итог;
				КонецЕсли;

				Если Порция.Количество() > 0 Тогда
					Конец = Порция[Порция.ВГраница()].id;
				Иначе
					Граница = Середина;
				КонецЕсли;
			КонецЦикла;

			Если Конец > 0 Тогда
				Итог.НовоеСмещение = Конец;
				Итог.Описание = "лента: первый прогон, начало с изменения " + Формат(Конец, "ЧГ=0") + " - сверены все";
			Иначе
				Итог.Описание = "лента: событий нет - сверены все";
			КонецЕсли;
			Возврат Итог;
		КонецЕсли;

		Изменения = Новый Соответствие;
		Для Каждого Ид Из Хвост Цикл
			Изменения.Вставить(Ид, Истина);
		КонецЦикла;
		Последнее = Смещение;
		ПрочитаноИзменений = 0;
		Для Порция = 1 По 20 Цикл
			Ответ = Соед.Получить(Новый HTTPЗапрос(ПутьЛенты + "v4/document-changes?offset=" + Формат(Последнее, "ЧГ=0")
				+ "&limit=1000", Заголовки));
			Порция1000 = ?(Ответ.КодСостояния = 200, ПрочитатьОтветЛенты(Ответ), Неопределено);
			Если ТипЗнч(Порция1000) <> Тип("Массив") Тогда
				Итог.Описание = "лента не прочитана (HTTP " + Ответ.КодСостояния + ") - сверены все";
				Возврат Итог;
			КонецЕсли;
			Для Каждого Изменение Из Порция1000 Цикл
				ПрочитаноИзменений = ПрочитаноИзменений + 1;
				Последнее = Макс(Последнее, Изменение.id);
				Документ = Неопределено;
				Если НЕ Изменение.Свойство("document", Документ) ИЛИ ТипЗнч(Документ) <> Тип("Структура") Тогда
					Продолжить;
				КонецЕсли;
				Отправитель = "";
				Получатель = "";
				Документ.Свойство("sender", Отправитель);
				Документ.Свойство("recipient", Получатель);
				Если ВРег(Строка(Отправитель)) <> НашГид И ВРег(Строка(Получатель)) <> НашГид Тогда
					Продолжить;
				КонецЕсли;
				Изменения.Вставить(ИдентификаторСтрокой(Документ.id), Истина);
				Мастер = Неопределено;
				Если Документ.Свойство("masterId", Мастер) И ЗначениеЗаполнено(Мастер) Тогда
					Изменения.Вставить(ИдентификаторСтрокой(Мастер), Истина);
				КонецЕсли;
			КонецЦикла;
			Если Порция1000.Количество() < 1000 Тогда
				Итог.Изменения = ?(НужнаПолная, Неопределено, Изменения);
				Итог.НовоеСмещение = Последнее;
				Итог.Описание = "по ленте: изменений " + Формат(ПрочитаноИзменений, "ЧН=0; ЧГ=0")
					+ ", документов организации " + Формат(Изменения.Количество(), "ЧН=0; ЧГ=0")
					+ ?(НужнаПолная, "; прошлый прогон оставил больше 1000 неполученных - сверены все", "");
				Возврат Итог;
			КонецЕсли;
		КонецЦикла;
		Итог.НовоеСмещение = Последнее;   // отставание больше 20 000: указатель двигаем, в этот раз сверяем все
		Итог.Описание = "лента: больше 20 000 изменений за раз - сверены все";
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , ,
			"ИзмененныеПоЛенте: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Итог.Изменения = Неопределено;
		Итог.НовоеСмещение = Неопределено;
		Итог.Описание = "лента не ответила: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " - сверены все";
	КонецПопытки;
	Возврат Итог;

КонецФункции

Функция ПрочитатьОтветЛенты(Ответ)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	Данные = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

// Сдвинуть указатель ленты после сверки без ошибок (см. ИзмененныеПоЛенте).
// Хвост - id, которые спросили, но карточки не получили: следующий прогон спросит их снова,
// пока документ не станет финальным и не выпадет из сверки. Больше 1000 - хвост не хранится, а следующий прогон
// сверяет все (признак Полная): обрезанный хвост молча потерял бы документы.
Процедура ЗапомнитьСмещениеЛенты(Знач Лента, Знач Хвост)
	Если ЗначениеЗаполнено(Лента.КлючСмещения) И ТипЗнч(Лента.НовоеСмещение) = Тип("Число") Тогда
		Полная = (Хвост.Количество() > 1000);
		ЗапомнитьИтогОбмена(Лента.КлючСмещения, Новый Структура("Смещение, Хвост, Полная", Лента.НовоеСмещение,
			?(Полная, Новый Массив, Хвост), Полная));
	КонецЕсли;
КонецПроцедуры

// префиксы операторов, куда отправка не проходит по внешней причине (настройка расширения
// «НерабочиеПрефиксыЭДО»): повтор таким получателям бесполезен, в очередь их не возвращаем.
Функция НерабочиеПрефиксыЭДО()
	НерабочиеПрефиксы = Новый Массив;
	Для Каждого Кусок Из СтрРазделить(ЭДО_Сервер.НастройкаЭДО("НерабочиеПрефиксыЭДО"), ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Кусок)) Тогда
			НерабочиеПрефиксы.Добавить(ВРег(СокрЛП(Кусок)));
		КонецЕсли;
	КонецЦикла;
	Возврат НерабочиеПрефиксы;
КонецФункции

// Отказ старше - в очередь не возвращаем, нужен разбор человеком.
Функция ПорогСвежестиОтказаДней()
	Возврат 3;
КонецФункции

// вернуть в очередь реализацию, последний экземпляр которой оператор не отправил
// (SENDING_FAILED), а живого экземпляра нет. Вынесено из блока 5 полной сверки: то же решение принимает
// точечная сверка по ленте, как только увидит падение. У контрагента документа нет - дубля быть не может;
// возвращаем, только если повтор имеет смысл: получатель не на нерабочем префиксе (там повтор падает вечно),
// отказ свежий (авария лечится за день-два), экземпляр падал не больше раза (иначе причина системная).
// Экземпляр - Структура(Ид, Создан, Получатель, Падений). Снимаются отметка отправки (ЭДО_КодСостояния = 40)
// и идентификатор оператора: очередь берет только документы без идентификатора. Снимаются вместе, в транзакции
// под исключительной блокировкой свойств документа и только при прежней паре (40, Экземпляр.Ид): полная и
// точечная сверки - разные регламенты, и пока одна решала по упавшему экземпляру A, другая могла уже вернуть
// документ, а очередь - отправить экземпляр B; снятие по A стерло бы связь с B.
// Адрес контрагента сменили после падения (ЭДО Лайт заменили на рабочий ящик) - закрытый канал, давность и число
// падений относятся к прежнему адресу, повтор на новый имеет смысл.
// Возврат: "сброшен" (с пометкой «, адрес сменён: …», если сменили); "" - канал закрыт (молча, это не проблема
// документа); "занят" - пара уже другая; иначе - текст «не возвращён (…)».
Функция ВернутьУпавшийВОчередь(Знач Ссылка, Знач Экземпляр, Знач НерабочиеПрефиксы, Знач ПорогСвежестиДней,
	Знач СвойствоОтправки, Знач СвойствоИдПлатформы)

	ДатаОтказа = '00010101';
	Попытка
		ДатаОтказа = Дата(Сред(Экземпляр.Создан, 1, 4) + Сред(Экземпляр.Создан, 6, 2) + Сред(Экземпляр.Создан, 9, 2));
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ВернутьУпавшийВОчередь: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
		ДатаОтказа = '00010101'; // дата не разобрана - экземпляр не считается свежим
	КонецПопытки;
	Свежий = ЗначениеЗаполнено(ДатаОтказа)
		И (НачалоДня(ТекущаяУниверсальнаяДата()) - ДатаОтказа) <= ПорогСвежестиДней * 86400;
	ТекущийАдрес = ВРег(СокрЛП(ЭДО_Сервер.ИдентификаторУчастникаЭДО(Ссылка.Контрагент)));
	АдресСменился = ЗначениеЗаполнено(ТекущийАдрес) И ЗначениеЗаполнено(Экземпляр.Получатель)
		И ТекущийАдрес <> ВРег(СокрЛП(Экземпляр.Получатель));
	Для Каждого Преф Из НерабочиеПрефиксы Цикл
		Если СтрНачинаетсяС(ВРег(Экземпляр.Получатель), Преф) И НЕ АдресСменился Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Если (НЕ Свежий ИЛИ Экземпляр.Падений > 1) И НЕ АдресСменился Тогда
		Возврат "не возвращён (" + ?(Свежий, "падал " + Экземпляр.Падений + " раза", "застарелый отказ") + ")";
	КонецЕсли;
	ЕстьСвойствоИд = (СвойствоИдПлатформы <> Неопределено И НЕ СвойствоИдПлатформы.Пустая());
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		ЭлементБлокировки.УстановитьЗначение("Объект", Ссылка);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Отметка = СокрЛП(Строка(ЭДО_Сервер.ЗначениеСвойстваОбъекта(Ссылка, СвойствоОтправки)));
		ИдВБазе = ?(ЕстьСвойствоИд, СокрЛП(Строка(ЭДО_Сервер.ЗначениеСвойстваОбъекта(Ссылка, СвойствоИдПлатформы))), "");
		ПараПрежняя = (Отметка = "40")
			И (НЕ ЕстьСвойствоИд ИЛИ ИдВБазе = СокрЛП(Строка(Экземпляр.Ид)));
		Если ПараПрежняя Тогда
			НаборОтпр = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
			НаборОтпр.Отбор.Объект.Установить(Ссылка);
			НаборОтпр.Отбор.Свойство.Установить(СвойствоОтправки);
			НаборОтпр.Записать();   // пустой набор = снятие отметки
			Если ЕстьСвойствоИд Тогда
				НаборИд = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
				НаборИд.Отбор.Объект.Установить(Ссылка);
				НаборИд.Отбор.Свойство.Установить(СвойствоИдПлатформы);
				НаборИд.Записать();
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если НЕ ПараПрежняя Тогда
		Возврат "занят";
	КонецЕсли;
	Возврат "сброшен" + ?(АдресСменился, ", адрес сменён: " + Экземпляр.Получатель + " -> " + ТекущийАдрес, "");

КонецФункции

// все экземпляры документа у оператора - поиском по номеру среди исходящих и черновиков
// (document-flows/outgoing и /drafts с doc_num), номер и дата сверяются по extra. Для решения о возврате
// упавшего вне полной сверки: нужен весь набор экземпляров, а не только текущий.
// Возврат: Структура(Прочитано, ЕстьЖивой, Падений, Последний - Структура(Ид, Создан, Статус, Получатель) или Неопределено).
// Запросов - счетчик вызывающего: каждый HTTP-вызов поиска, включая неуспешный. Причина - почему набор не прочитан.
Функция ЭкземплярыПоНомеру(Соед, Заголовки, Знач Гид, Знач Номер, Знач ДатаДок, Запросов)

	Итог = Новый Структура("Прочитано, ЕстьЖивой, Падений, Последний, Причина", Ложь, Ложь, 0, Неопределено, "");
	Если НЕ ЗначениеЗаполнено(Гид) ИЛИ СтрДлина(Номер) < 2 Тогда
		Возврат Итог;
	КонецЕсли;
	ДатаТекстом = Формат(ДатаДок, "ДФ=dd.MM.yyyy");
	Окно = "&doc_num=" + КодироватьСтроку(Номер, СпособКодированияСтроки.КодировкаURL)
		+ "&created_after=" + Формат(НачалоДня(ДатаДок) - 86400, "ДФ=yyyy-MM-ddTHH:mm:ss.000Z")
		+ "&created_before=" + Формат(ТекущаяУниверсальнаяДата() + 86400, "ДФ=yyyy-MM-ddTHH:mm:ss.000Z");
	Для Каждого Список Из СтрРазделить("outgoing,drafts", ",") Цикл
		Для Страница = 0 По 19 Цикл
			Запросов = Запросов + 1;
			Ответ = Соед.Получить(Новый HTTPЗапрос(ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/document-flows/"
				+ Список + "?owner_id=" + Гид + Окно + "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=50", Заголовки));
			Если Ответ.КодСостояния <> 200 Тогда
				Итог.Причина = Список + ": HTTP " + Ответ.КодСостояния;
				Возврат Итог;   // Прочитано = Ложь - решать по неполному набору нельзя
			КонецЕсли;
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
			Карточки = ПрочитатьJSON(Чтение, Ложь);
			Чтение.Закрыть();
			Если ТипЗнч(Карточки) <> Тип("Массив") Тогда
				Итог.Причина = Список + ": неожиданный ответ";
				Возврат Итог;
			КонецЕсли;
			Для Каждого Карточка Из Карточки Цикл
				Счет = ЭДО_Сервер.РеквизитыКарточкиОператора(Карточка);
				Если Счет = Неопределено
					ИЛИ НЕ Счет.Свойство("num") ИЛИ СокрЛП(Строка(Счет.num)) <> Номер
					ИЛИ НЕ Счет.Свойство("date") ИЛИ СокрЛП(Строка(Счет.date)) <> ДатаТекстом Тогда
					Продолжить;
				КонецЕсли;
				Статус = ЭДО_Сервер.СтатусКарточкиОператора(Карточка);
				Создан = Строка(ЭДО_Сервер.ПолеКарточкиОператора(Карточка, "created"));
				Получатель = "";
				Если Карточка.Свойство("recipient") И ТипЗнч(Карточка.recipient) = Тип("Структура") И Карточка.recipient.Свойство("id") Тогда
					Получатель = Строка(Карточка.recipient.id);
				КонецЕсли;
				Если ЭкземплярЖивой(Статус) Тогда
					Итог.ЕстьЖивой = Истина;
				КонецЕсли;
				Если Статус = "SENDING_FAILED" Тогда
					Итог.Падений = Итог.Падений + 1;
				КонецЕсли;
				Если Итог.Последний = Неопределено
					ИЛИ ЭкземплярАктуальнее(Статус, Создан, Итог.Последний.Статус, Итог.Последний.Создан) Тогда
					Итог.Последний = Новый Структура("Ид, Создан, Статус, Получатель",
						ИдентификаторСтрокой(Карточка.id), Создан, Статус, Получатель);
				КонецЕсли;
			КонецЦикла;
			Если Карточки.Количество() < 50 Тогда
				Прервать;
			КонецЕсли;
			Если Страница = 19 Тогда
				Итог.Причина = Список + ": больше 1000 экземпляров";
				Возврат Итог;   // набор не полный, не решаем
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Итог.Прочитано = Истина;
	Возврат Итог;

КонецФункции

// карточки по идентификаторам через v4/documents/{id} - по одному id за запрос (пачку id
// принимает только /documents; document-flows второй id молча отбрасывает, «1,2» - HTTP 400). Запасной путь
// точечной сверки, пока список /documents отвечает 401 (прецедент: список - 401, document-flows - 200).
// Возврат - массив карточек того же вида, что у /documents; Ответили - сколько запросов вернули 200, Запросов -
// счетчик фактически отправленных запросов. Токен (Заголовки, ТокенПолучен) обновляется здесь же: по времени,
// как в полной сверке, и разово на 401 - поштучный обход дольше жизни токена.
Функция КарточкиПоИдЧерезЦепочки(Соед, Заголовки, Знач Гид, Знач Идентификаторы, Знач Организация, ТокенПолучен,
	Ошибки, Ответили, Запросов)

	Карточки = Новый Массив;
	Сбоев = 0;
	Для Каждого Ид Из Идентификаторы Цикл
		Если Ответили = 0 И Сбоев >= 5 Тогда
			Ошибки = Ошибки + "document-flows не отвечает, пачка прервана; ";
			Прервать;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - ТокенПолучен > 600000 Тогда
			Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
				ВызватьИсключение "Не удалось обновить токен Платформы";
			КонецЕсли;
			Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
			ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КонецЕсли;
		Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v4/documents/" + Ид;   // v4 - одна карточка, и черновик
		Ответ = Неопределено;
		Для НомерПопытки = 1 По 2 Цикл
			Запросов = Запросов + 1;
			Попытка
				Ответ = Соед.Получить(Новый HTTPЗапрос(Путь, Заголовки));
			Исключение
				// таймаут прилетает исключением - экземпляр возьмет следующий прогон, ошибка уходит в свод и журнал
				Ошибки = Ошибки + Ид + " не отвечен: " + Лев(ОписаниеОшибки(), 80) + "; ";
				Ответ = Неопределено;
				Прервать;
			КонецПопытки;
			Если Ответ.КодСостояния = 401 И НомерПопытки = 1 Тогда
				Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
					ВызватьИсключение "Не удалось обновить токен Платформы";
				КонецЕсли;
				Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
				ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЦикла;
		Если Ответ = Неопределено Тогда
			Сбоев = Сбоев + 1;
			Продолжить;
		КонецЕсли;
		Если Ответ.КодСостояния <> 200 Тогда
			Ошибки = Ошибки + Ид + ": HTTP " + Ответ.КодСостояния + "; ";
			Сбоев = Сбоев + 1;
			Продолжить;
		КонецЕсли;
		Ответили = Ответили + 1;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		МассивОтвета = ПрочитатьJSON(Чтение, Ложь);
		Чтение.Закрыть();
		Если ТипЗнч(МассивОтвета) = Тип("Структура") Тогда   // v4 отдает карточку объектом
			Карточка = МассивОтвета;
			МассивОтвета = Новый Массив;
			МассивОтвета.Добавить(Карточка);
		КонецЕсли;
		Если ТипЗнч(МассивОтвета) = Тип("Массив") Тогда
			Для Каждого Карточка Из МассивОтвета Цикл
				Карточки.Добавить(Карточка);
			КонецЦикла;
		Иначе
			Ошибки = Ошибки + Ид + ": неожиданный ответ оператора; ";   // указатель ленты не сдвигать
		КонецЕсли;
	КонецЦикла;
	Возврат Карточки;

КонецФункции

// Ключ прогона отправки очереди. Платформа не передает в обработчик поле "Ключ" экземпляра,
// поэтому у экземпляра задания обязан быть один параметр с этим значением, иначе задание падает
// "Недостаточно фактических параметров". Поле "Ключ" заполняется тем же текстом для консоли.
Функция КлючОтправкиОчереди() Экспорт
	Возврат "ЭДО_ОтправкаОчереди";
КонецФункции

// Ключи всех регламентов ЭДО: Соответствие "ключ параметра задания" -> "что делает".
// Список один на все носители. Наименование экземпляра задания начинается с "ЭДО: ",
// чтобы свои задания были видны в консоли одним взглядом.
Функция КлючиРегламентов() Экспорт
	Ключи = Новый Соответствие;
	Ключи.Вставить("ЭДО_ОтправкаОчереди",   "отправка очереди");
	Ключи.Вставить("ЭДО_СторожЗависаний",   "сторож зависших регламентов");
	Ключи.Вставить("ЭДО_СверкаСтатусов",    "сверка статусов у оператора");
	Ключи.Вставить("ЭДО_ТочечнаяСверка",    "точечная сверка статусов");
	Ключи.Вставить("ЭДО_ОбновлениеСвязей",  "обновление связей и адресов");
	Ключи.Вставить("ЭДО_СторожНеПринятых",  "сторож «доставлено, но не принято»");
	Ключи.Вставить("ЭДО_СторожПаузы",       "сторож паузы по контрагентам");
	Ключи.Вставить("ЭДО_СторожГИСМТ",       "обход ГИС МТ");
	Ключи.Вставить("ЭДО_СторожБрошенных",   "сторож брошенных отметок отправки");
	Ключи.Вставить("ЭДО_СторожРасхождений", "сторож расхождений с отправленным");
	Ключи.Вставить("ЭДО_СторожЗапросовАннулирования", "входящие запросы на аннулирование");
	Ключи.Вставить("ЭДО_СторожАдресовПолучателя", "сторож адреса получателя");
	Ключи.Вставить("ЭДО_АвтоматическоеПринятиеУПД", "автоматическое принятие УПД");
	Ключи.Вставить("ЭДО_СогласиеНаАннулированиеВходящих", "согласие на аннулирование входящих от доверенных");
	Ключи.Вставить("ЭДО_ПриглашенияНовымКонтрагентам", "приглашения новым контрагентам");
	Ключи.Вставить("ЭДО_АннулированиеЛишнихЭкземпляров", "аннулирование лишних экземпляров");
	Ключи.Вставить("ЭДО_АннулированиеЛишнихЭкземпляровПроверка", "лишние экземпляры, только журнал");
	Возврат Ключи;
КонецФункции

// сторож зависших регламентов.
// Задание, застрявшее во внешнем вызове (сеть, криптография), не обрывается тайм-аутом и висит
// часами, а платформа не запускает регламентное задание, пока жив прошлый экземпляр: отправка
// стоит молча до утра. Сторож стоит в начале каждого нашего регламента
// и отдельным регламентом ЭДО_СторожЗависаний (без внешних обращений): наш экземпляр старше
// МинутДоЗависания минут он отменяет и, если живого свежего экземпляра того же регламента нет,
// запускает регламент отдельным фоновым заданием. В журнал регистрации - одна запись на зависший
// экземпляр. Отмена и запуск чужих заданий - административное действие: только в фоновом задании
// (регламент, перезапуск) или у пользователя с правом администрирования.
Функция МинутДоЗависания()
	Возврат 60;
КонецФункции

// Ключ регламента: верхний регистр, старый префикс ПЭДО_ - как ЭДО_. Задание со старым ключом иначе
// уходит в типовой путь и молча ничего не делает. Убрать, когда ключи заданий в базах переедут на ЭДО_.
Функция НормализованныйКлюч(Знач Ключ)
	Ключ = ВРег(СокрЛП(Строка(Ключ)));
	Если Лев(Ключ, 5) = "ПЭДО_" Тогда
		Ключ = "ЭДО_" + Сред(Ключ, 6);
	КонецЕсли;
	Возврат Ключ;
КонецФункции

Функция КлючиРегламентовВРег()
	Итог = Новый Соответствие;
	Для Каждого Пара Из КлючиРегламентов() Цикл
		Итог.Вставить(ВРег(Пара.Ключ), Пара.Ключ);
	КонецЦикла;
	Возврат Итог;
КонецФункции

// Основа ключа фонового задания: нормализованный ключ регламента без суффикса перезапуска.
Функция ОсноваКлючаЗадания(Знач КлючЗадания)
	Позиция = СтрНайти(КлючЗадания, "_Перезапуск");
	Возврат НормализованныйКлюч(?(Позиция > 0, Лев(КлючЗадания, Позиция - 1), КлючЗадания));
КонецФункции

// Задание - наш регламент: и ключ, и обработчик. Одного ключа мало - его может носить чужое задание.
Функция ЭтоНашеЗадание(Задание, Наши)
	Если Наши.Получить(ОсноваКлючаЗадания(Задание.Ключ)) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Метод = ВРег(Задание.ИмяМетода);
	// носители расписания - перехваты типовых заданий: УТ (ЗаданиеОбменЭлектроннымиДокументами)
	// и КА (ЗаданиеАвтономноеРешение, см. МодульРегламентныхЗаданий профиля КА).
	Возврат Метод = ВРег("МодульРегламентныхЗаданий.ВыполнитьОбменДаннымиЭлектроннымиДокументами")
		ИЛИ Метод = ВРег("МодульРегламентныхЗаданий.ВыполнитьОбменДаннымиДляНастройкиОбмена")
		ИЛИ Метод = ВРег("ЭДО_Регламенты.ВыполнитьРегламентФоном")
		ИЛИ Метод = ВРег("ЭДО_Регламенты.ВыполнитьОбменФоном");
КонецФункции

// Сторожу можно отменять и запускать задания: экземпляр РЕГЛАМЕНТНОГО задания (его запускает платформа
// по расписанию, пользователь его не создаст) или пользователь с правом администрирования. Факт фонового
// выполнения разрешением не считается: «Обмен сейчас» создает фоновое задание с правами пользователя.
Функция СторожуРазрешено()
	Если ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат Истина;
	КонецЕсли;
	Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Возврат Задание <> Неопределено И Задание.РегламентноеЗадание <> Неопределено;
КонецФункции

// Исключительная блокировка решения сторожа: два регламента, стартовавшие одновременно, иначе оба
// отметили бы и перезапустили одно зависание. Ключ - несуществующая запись регистра свойств.
Процедура ЗаблокироватьРешениеСторожа()
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
	Элемент.УстановитьЗначение("Объект", Справочники.Организации.ПустаяСсылка());
	Элемент.УстановитьЗначение("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка());
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
КонецПроцедуры

// Замена не запустилась - снять свою метку перезапуска (только свою: по времени), иначе следующий
// сторож час не стал бы перезапускать регламент, хотя замены нет.
Процедура СнятьРезервПерезапуска(Знач Основа, Знач Когда)
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьРешениеСторожа();
			Учет = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ЗависшиеРегламенты", , "");
			Метка = "перезапуск:" + Основа;
			Если ТипЗнч(Учет) = Тип("Соответствие") И Учет.Получить(Метка) = Когда Тогда
				Учет.Удалить(Метка);
				ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "ЗависшиеРегламенты", Учет, , "");
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.ЗависаниеРегламента", УровеньЖурналаРегистрации.Ошибка, , ,
			"Не снята метка перезапуска " + Основа + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Процедура ПроверитьЗависшиеРегламенты()

	Если НЕ СторожуРазрешено() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Наши = КлючиРегламентовВРег();
		Порог = МинутДоЗависания() * 60;
		Сейчас = ТекущаяУниверсальнаяДата();

		// Решение - под блокировкой и по снимку, снятому уже после нее: что отметить в журнале
		// и что перезапустить. Учет: Ид зависшего -> Истина, "перезапуск:<основа>" -> когда.
		НовыеЗависшие = Новый Массив;
		ВсеЗависшие = Новый Массив;
		Перезапустить = Новый Массив;
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьРешениеСторожа();
			ЖивыеСвежие = Новый Соответствие;   // основа -> Истина: есть живой экземпляр моложе порога (и текущий)
			Активные = Новый Соответствие;
			Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно)) Цикл
				Если НЕ ЭтоНашеЗадание(Задание, Наши) Тогда
					Продолжить;
				КонецЕсли;
				Активные.Вставить(Строка(Задание.УникальныйИдентификатор), Истина);
				Если Сейчас - УниверсальноеВремя(Задание.Начало) >= Порог Тогда
					ВсеЗависшие.Добавить(Задание);
				Иначе
					ЖивыеСвежие.Вставить(ОсноваКлючаЗадания(Задание.Ключ), Истина);
				КонецЕсли;
			КонецЦикла;
			Учет = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ЗависшиеРегламенты", , "");
			Если ТипЗнч(Учет) <> Тип("Соответствие") Тогда
				Учет = Новый Соответствие;
			КонецЕсли;
			НовыйУчет = Новый Соответствие;   // только живые зависшие и свежие метки перезапуска - запись не растет
			Для Каждого Пара Из Учет Цикл
				Если Активные.Получить(Пара.Ключ) <> Неопределено
					ИЛИ СтрНачинаетсяС(Пара.Ключ, "перезапуск:") И ТипЗнч(Пара.Значение) = Тип("Дата") И Сейчас - Пара.Значение < Порог Тогда
					НовыйУчет.Вставить(Пара.Ключ, Пара.Значение);
				КонецЕсли;
			КонецЦикла;
			Для Каждого Задание Из ВсеЗависшие Цикл
				Ид = Строка(Задание.УникальныйИдентификатор);
				Если НовыйУчет.Получить(Ид) = Неопределено Тогда
					НовыеЗависшие.Добавить(Задание);
					НовыйУчет.Вставить(Ид, Истина);
				КонецЕсли;
				Основа = ОсноваКлючаЗадания(Задание.Ключ);
				Метка = "перезапуск:" + Основа;
				Если ЖивыеСвежие.Получить(Основа) = Неопределено И НовыйУчет.Получить(Метка) = Неопределено
					И ПерезапускатьПослеОтмены(Основа) Тогда
					Перезапустить.Добавить(Основа);
					НовыйУчет.Вставить(Метка, Сейчас);
				КонецЕсли;
			КонецЦикла;
			ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "ЗависшиеРегламенты", НовыйУчет, , "");
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

		Для Каждого Задание Из НовыеЗависшие Цикл
			Основа = ОсноваКлючаЗадания(Задание.Ключ);
			Текст = "Регламент " + Наши.Получить(Основа) + " (задание " + Задание.Ключ + ", начато "
				+ Формат(Задание.Начало, "ДФ='dd.MM.yyyy HH:mm:ss'") + ") выполняется дольше "
				+ МинутДоЗависания() + " мин. - отменяется, регламент перезапускается отдельным заданием.";
			Если Основа = ВРег(КлючОтправкиОчереди()) Тогда
				Шаг = ЭДО_Сервер.ПоследнийШагОтправки();
				Если Шаг <> Неопределено И Шаг.Свойство("Задание") И Шаг.Задание = Строка(Задание.УникальныйИдентификатор) Тогда
					Текст = Текст + " Последний шаг отправки: " + Шаг.Шаг + ", документ " + Шаг.Документ
						+ ", с " + Формат(Шаг.Когда, "ДФ='dd.MM.yyyy HH:mm:ss'") + ".";
				Иначе
					Текст = Текст + " Шаг отправки этого экземпляра неизвестен.";
				КонецЕсли;
			КонецЕсли;
			ЗаписьЖурналаРегистрации("ЭДО.ЗависаниеРегламента", УровеньЖурналаРегистрации.Предупреждение, , , Текст);
		КонецЦикла;

		Для Каждого Задание Из ВсеЗависшие Цикл
			Попытка
				Задание.Отменить();
			Исключение
				ЗаписьЖурналаРегистрации("ЭДО.ЗависаниеРегламента", УровеньЖурналаРегистрации.Предупреждение, , ,
					"Не отменено задание " + Задание.Ключ + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;

		Для Каждого Основа Из Перезапустить Цикл
			Попытка
				Параметры = Новый Массив;
				Параметры.Добавить(Наши.Получить(Основа));
				ФоновыеЗадания.Выполнить("ЭДО_Регламенты.ВыполнитьРегламентФоном", Параметры,
					Наши.Получить(Основа) + "_Перезапуск_" + Формат(Сейчас, "ДФ=yyyyMMddHHmmss"),
					"ЭДО: перезапуск зависшего регламента " + Наши.Получить(Основа));
			Исключение
				ЗаписьЖурналаРегистрации("ЭДО.ЗависаниеРегламента", УровеньЖурналаРегистрации.Ошибка, , ,
					"Перезапуск " + Наши.Получить(Основа) + " не удался: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				СнятьРезервПерезапуска(Основа, Сейчас);
			КонецПопытки;
		КонецЦикла;
	Исключение
		// сторож не должен ронять регламент, в начале которого стоит
		ЗаписьЖурналаРегистрации("ЭДО.ЗависаниеРегламента", УровеньЖурналаРегистрации.Ошибка, , ,
			"Сторож зависших регламентов: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// после отмены отдельным заданием перезапускается только регламент с замком от
// параллельного прогона - отправка очереди (ЗанятьПрогонОтправки). Остальные поднимет расписание, как
// только завершится отмененный экземпляр; перезапуск нужен лишь когда отмена не сработала, а тогда он
// идет рядом с живым экземпляром и расписанием. Без замка это опасно: автоприемка подписывает входящие,
// аннулирование лишних экземпляров подписывает и шлет ПОА, приглашения уходят повторно, сторож запросов
// аннулирования отвечает дважды. Сверки и сторожа идемпотентны - им перезапуск ничего не дает.
Функция ПерезапускатьПослеОтмены(Знач Основа)
	Возврат Основа = ВРег(КлючОтправкиОчереди());
КонецФункции

// Точка входа фонового задания перезапуска: тот же регламент по ключу.
Процедура ВыполнитьРегламентФоном(Знач Ключ) Экспорт
	ВыполнитьРегламентПоКлючу(Ключ);
КонецПроцедуры

// Строка «Обмен» и кнопка «Обмен сейчас» Центра управления. Итоги прогонов лежат по одной записи
// хранилища на регламент и перезаписываются: ни журнал, ни база от них не растут.
Процедура ЗапомнитьИтогОбмена(Знач Имя, Знач Итог)
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", Имя, Итог, , "");
	Исключение
		// итог - для показа: его сбой не должен ронять регламент
		ЗаписатьВЖурнал("Не записан итог обмена " + Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			Истина, "ЭДО.Регламент");
	КонецПопытки;
КонецПроцедуры

Функция МинутДоКрасногоОбмена()
	Возврат 30;
КонецФункции

// время последнего успешного обмена с оператором. Строка «Обмен» показывает,
// сколько обмена уже нет (прецедент: оператор с ночи отвечал 401, а строка выглядела нормальной).
// отмечается только по ответу оператора - HTTP 200 в сверках и в списке входящих
// автоприемки, либо отправка, в которой оператор принял хотя бы один документ.
Процедура ОтметитьУспешныйОбмен() Экспорт
	ЗапомнитьИтогОбмена("ПоследнийУспешныйОбмен", ТекущаяДатаСеанса());
КонецПроцедуры

// Сколько минут без успешного обмена с оператором допустимо: сверка статусов и автоприемка идут чаще.
Функция МинутБезОбменаСОператором()
	Возврат 60;
КонецФункции

// «7 ч 40 мин», «25 мин», «2 дн 3 ч» - для строки «Обмен».
Функция ДлительностьТекстом(Знач Минут)
	Если Минут < 60 Тогда
		Возврат Формат(Минут, "ЧН=0; ЧГ=0") + " мин";
	ИначеЕсли Минут < 1440 Тогда
		Возврат Формат(Цел(Минут / 60), "ЧГ=0") + " ч " + Формат(Минут % 60, "ЧН=0; ЧГ=0") + " мин";
	КонецЕсли;
	Возврат Формат(Цел(Минут / 1440), "ЧГ=0") + " дн " + Формат(Цел((Минут % 1440) / 60), "ЧН=0; ЧГ=0") + " ч";
КонецФункции

// Активные экземпляры отправки очереди (регламент, перезапуски, ручной обмен): самое раннее начало.
// Возврат: Дата (местное время сервера) или Неопределено.
Функция НачалоИдущейОтправки()
	Возврат НачалоИдущегоРегламента(КлючОтправкиОчереди());
КонецФункции

// Активные экземпляры регламента: самое раннее начало. Привилегированный режим - только на чтение
// списка заданий: без него пользователь видит лишь свои задания, а регламентные - нет. Ничего не
// отменяет и не запускает.
Функция НачалоИдущегоРегламента(Знач Ключ)
	УстановитьПривилегированныйРежим(Истина);
	Наши = КлючиРегламентовВРег();
	Основа = НормализованныйКлюч(Ключ);
	Раннее = Неопределено;
	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно)) Цикл
		Если ЭтоНашеЗадание(Задание, Наши) И ОсноваКлючаЗадания(Задание.Ключ) = Основа
			И (Раннее = Неопределено ИЛИ Задание.Начало < Раннее) Тогда
			Раннее = Задание.Начало;
		КонецЕсли;
	КонецЦикла;
	Возврат Раннее;
КонецФункции

// есть ли в базе включенный экземпляр регламентного задания с этим ключом ЭДО
// (параметр или ключ экземпляра). Привилегированный режим - только на чтение списка заданий.
Функция ЕстьРегламентПоРасписанию(Знач Ключ)
	УстановитьПривилегированныйРежим(Истина);
	Основа = НормализованныйКлюч(Ключ);
	Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания(Новый Структура("Использование", Истина)) Цикл
		Если НормализованныйКлюч(Задание.Ключ) = Основа
			ИЛИ Задание.Параметры.Количество() > 0 И НормализованныйКлюч(Задание.Параметры[0]) = Основа Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ВремяОбмена(Знач Момент, Знач Сейчас)
	Если НачалоДня(Момент) = НачалоДня(Сейчас) Тогда
		Возврат Формат(Момент, "ДФ=HH:mm");
	КонецЕсли;
	Возврат Формат(Момент, "ДФ='dd.MM HH:mm'");
КонецФункции

// Состояние обмена базы для Центра управления. Обмен у базы общий, от отбора организации не зависит.
// Возврат: Структура (Текст, Красный): красный - отправка не проходила дольше МинутДоКрасногоОбмена
// или висит.
Функция СостояниеОбмена() Экспорт
	// Общие настройки лежат под пользователем "": для обычного пользователя это чужой слот, без привилегий - «Нарушение прав доступа».
	УстановитьПривилегированныйРежим(Истина);

	// Вердикт - первое слово строки «Обмен» по состоянию регламентов,
	// а не по цвету: «не настроен» / «стоит» / «нужна проверка» / «работает».
	Итог = Новый Структура("Текст, Красный, Вердикт", "", Ложь, "");
	Сейчас = ТекущаяДатаСеанса();
	Части = Новый Массив;

	// база без отправки по расписанию (КА - только принимает) не горит красным
	// «отправка еще не записана»; там обмен - это автоприемка, ее итог и показывается.
	ЕстьОтправка = ЕстьРегламентПоРасписанию(КлючОтправкиОчереди());
	Отправка = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ПоследнийПрогонОтправки", , "");
	Если ТипЗнч(Отправка) = Тип("Структура") И Отправка.Свойство("Конец") Тогда
		Минут = Цел((Сейчас - Отправка.Конец) / 60);
		Части.Добавить("отправка " + ВремяОбмена(Отправка.Конец, Сейчас) + " (" + Минут + " мин назад) - отправлено "
			+ Отправка.Отправлено + ", ошибок " + Отправка.Ошибок
			+ ?(Отправка.Свойство("Осталось") И Отправка.Осталось > 0, ", осталось в очереди " + Отправка.Осталось, ""));
		КраснаяОтправка = ЕстьОтправка И Минут > МинутДоКрасногоОбмена();
	ИначеЕсли ЕстьОтправка Тогда
		Части.Добавить("отправка еще не записана");
		КраснаяОтправка = Истина;
	Иначе
		КраснаяОтправка = Ложь;
	КонецЕсли;

	Сверка = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ПоследняяСверкаСтатусов", , "");
	Если ТипЗнч(Сверка) = Тип("Структура") И Сверка.Свойство("Конец") Тогда
		Части.Добавить("статусы " + ВремяОбмена(Сверка.Конец, Сейчас)
			+ ?(Сверка.Свойство("Ошибка") И Сверка.Ошибка = Истина, " - С ОШИБКОЙ", ""));
	КонецЕсли;

	Идет = НачалоИдущейОтправки();
	Если Идет <> Неопределено Тогда
		Если ТекущаяУниверсальнаяДата() - УниверсальноеВремя(Идет) >= МинутДоЗависания() * 60 Тогда
			Части.Добавить("ВИСИТ с " + ВремяОбмена(Идет, Сейчас));
			КраснаяОтправка = Истина;
		Иначе
			Части.Добавить("идет с " + ВремяОбмена(Идет, Сейчас));
			КраснаяОтправка = Ложь;   // отправка в работе - строка не тревожная
		КонецЕсли;
	КонецЕсли;

	// автоприемка по расписанию - ее последний прогон и зависание.
	КраснаяПриемка = Ложь;
	КлючПриемки = "ЭДО_АвтоматическоеПринятиеУПД";
	ЕстьПриемка = ЕстьРегламентПоРасписанию(КлючПриемки);
	Если ЕстьПриемка Тогда
		Приемка = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ПоследнийПрогонПриемки", , "");
		Если ТипЗнч(Приемка) = Тип("Структура") И Приемка.Свойство("Конец") Тогда
			Минут = Цел((Сейчас - Приемка.Конец) / 60);
			Части.Добавить("автоприемка " + ВремяОбмена(Приемка.Конец, Сейчас) + " (" + Минут + " мин назад)"
				+ ?(Приемка.Ошибка, " - С ОШИБКОЙ, см. журнал регистрации", ""));
			КраснаяПриемка = Приемка.Ошибка ИЛИ Минут > МинутДоКрасногоОбмена();
		Иначе
			// включенная автоприемка без единого итога - тревога, если
			//    так дольше МинутДоКрасногоОбмена с первого раза, когда строка увидела ее без итога (иначе
			//    состояние «расписание есть, прогонов нет» висело бы «Обмен работает» бессрочно). Момент
			//    наблюдения - одна запись хранилища (привилегированный режим включен на всю функцию).
			НаблюдениеС = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ПриемкаБезИтогаС", , "");
			Если ТипЗнч(НаблюдениеС) <> Тип("Дата") Тогда
				НаблюдениеС = Сейчас;
				Попытка
					ХранилищеОбщихНастроек.Сохранить("ОФД_ЭДО_НастройкиОбработки", "ПриемкаБезИтогаС", НаблюдениеС, , "");
				Исключение
					ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "СостояниеОбмена: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
					НаблюдениеС = Сейчас;   // строка - для показа, сбой записи ее не роняет
				КонецПопытки;
			КонецЕсли;
			Минут = Цел((Сейчас - НаблюдениеС) / 60);
			Части.Добавить("автоприемка еще не записана" + ?(Минут > 0, " (ждем " + Минут + " мин)", ""));
			КраснаяПриемка = Минут > МинутДоКрасногоОбмена();
		КонецЕсли;
		ИдетПриемка = НачалоИдущегоРегламента(КлючПриемки);
		Если ИдетПриемка <> Неопределено Тогда
			Если ТекущаяУниверсальнаяДата() - УниверсальноеВремя(ИдетПриемка) >= МинутДоЗависания() * 60 Тогда
				Части.Добавить("автоприемка ВИСИТ с " + ВремяОбмена(ИдетПриемка, Сейчас));
				КраснаяПриемка = Истина;
			Иначе
				Части.Добавить("автоприемка идет с " + ВремяОбмена(ИдетПриемка, Сейчас));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// последний успешный обмен с оператором. Записи еще нет (версия только встала) -
	// отсчет от первого раза, когда строка ее не нашла, чтобы идущий сбой был виден сразу, а не после восстановления.
	КраснаяСвязь = Ложь;
	Если ЕстьОтправка ИЛИ ЕстьПриемка Тогда   // в базе без регламентов обмена сравнивать не с чем
		Успех = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "ПоследнийУспешныйОбмен", , "");
		Если ТипЗнч(Успех) = Тип("Дата") И ЗначениеЗаполнено(Успех) Тогда
			МинутБезОбмена = Цел((Сейчас - Успех) / 60);
			ТекстУспеха = "последний успешный обмен с оператором " + ВремяОбмена(Успех, Сейчас)
				+ " (" + ДлительностьТекстом(МинутБезОбмена) + " назад)";
		Иначе
			НаблюдениеС = ХранилищеОбщихНастроек.Загрузить("ОФД_ЭДО_НастройкиОбработки", "УспешныйОбменНеЗаписанС", , "");
			Если ТипЗнч(НаблюдениеС) <> Тип("Дата") Тогда
				НаблюдениеС = Сейчас;
				ЗапомнитьИтогОбмена("УспешныйОбменНеЗаписанС", НаблюдениеС);
			КонецЕсли;
			МинутБезОбмена = Цел((Сейчас - НаблюдениеС) / 60);
			ТекстУспеха = "успешного обмена с оператором не было с " + ВремяОбмена(НаблюдениеС, Сейчас)
				+ " (" + ДлительностьТекстом(МинутБезОбмена) + ")";
		КонецЕсли;
		КраснаяСвязь = МинутБезОбмена > МинутБезОбменаСОператором();
		// Сбой - в начало строки, сразу после вердикта; в норме - последним пунктом.
		Если КраснаяСвязь Тогда
			Части.Вставить(0, ТекстУспеха);
		Иначе
			Части.Добавить(ТекстУспеха);
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЕстьОтправка И НЕ ЕстьПриемка Тогда
		Части.Добавить("регламенты отправки и автоприемки по расписанию не настроены");
	КонецЕсли;
	Итог.Красный = КраснаяОтправка ИЛИ КраснаяПриемка ИЛИ КраснаяСвязь;
	Если НЕ ЕстьОтправка И НЕ ЕстьПриемка Тогда
		Итог.Вердикт = "Обмен не настроен";
	ИначеЕсли КраснаяСвязь Тогда
		Итог.Вердикт = "Нет обмена с оператором";
	ИначеЕсли КраснаяОтправка Тогда
		Итог.Вердикт = "Обмен стоит";
	ИначеЕсли КраснаяПриемка Тогда
		Итог.Вердикт = "Нужна проверка";
	Иначе
		Итог.Вердикт = "Обмен работает";
	КонецЕсли;

	Итог.Текст = "Обмен: " + СтрСоединить(Части, " · ");
	Возврат Итог;

КонецФункции

// Кнопка «Обмен сейчас»: отправка очереди, затем сверка статусов - отдельным фоновым заданием
// с правами нажавшего пользователя (как отправка из карточки). Зависшую отправку администратору снимает
// сторож, остальным - регламентный сторож в пределах МинутДоЗависания. Идущую отправку не дублирует:
// тогда запускается только сверка статусов (если и она не идет).
// Возврат: Строка - что сделано, для пользователя.
Функция ЗапуститьОбменСейчас() Экспорт

	ПроверитьЗависшиеРегламенты();   // без права администрирования сторож сам ничего не сделает
	Сейчас = ТекущаяДатаСеанса();
	// база без отправки по расписанию (КА) - кнопке запускать нечего. Автоприемку
	// вручную не запускаем: замка от параллельного прогона у нее нет, а рядом с регламентом два прогона
	// подписали бы одни и те же входящие; расписание поднимает ее само.
	Если НЕ ЕстьРегламентПоРасписанию(КлючОтправкиОчереди()) Тогда
		Возврат "В этой базе нет отправки документов по расписанию - запускать нечего."
			+ ?(ЕстьРегламентПоРасписанию("ЭДО_АвтоматическоеПринятиеУПД"),
				" Автоприемка идет по своему расписанию; вручную ее не запускаем, чтобы два прогона не подписали одно и то же.", "");
	КонецЕсли;
	Идет = НачалоИдущейОтправки();
	Если Идет <> Неопределено Тогда
		Если ТекущаяУниверсальнаяДата() - УниверсальноеВремя(Идет) >= МинутДоЗависания() * 60 Тогда
			ТекстОтправки = "Отправка висит с " + ВремяОбмена(Идет, Сейчас) + " - ее снимет регламентный сторож.";
		Иначе
			ТекстОтправки = "Отправка уже идет с " + ВремяОбмена(Идет, Сейчас) + ".";
		КонецЕсли;
		Если НачалоИдущегоРегламента("ЭДО_СверкаСтатусов") <> Неопределено Тогда
			Возврат ТекстОтправки + " Сверка статусов тоже уже идет. Нажмите «Обновить» позже.";
		КонецЕсли;
		Параметры = Новый Массив;
		Параметры.Добавить("ЭДО_СверкаСтатусов");
		ФоновыеЗадания.Выполнить("ЭДО_Регламенты.ВыполнитьРегламентФоном", Параметры,
			"ЭДО_СверкаСтатусов_Перезапуск_Вручную_" + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMddHHmmss"),
			"ЭДО: сверка статусов вручную");
		Возврат ТекстОтправки + " Запущена сверка статусов. Нажмите «Обновить» через минуту-две.";
	КонецЕсли;
	ФоновыеЗадания.Выполнить("ЭДО_Регламенты.ВыполнитьОбменФоном", ,
		КлючОтправкиОчереди() + "_Перезапуск_Вручную_" + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMddHHmmss"),
		"ЭДО: обмен вручную");
	Возврат "Обмен запущен: отправка очереди, затем сверка статусов. Нажмите «Обновить» через минуту-две.";

КонецФункции

Процедура ВыполнитьОбменФоном() Экспорт
	ВыполнитьРегламентПоКлючу(КлючОтправкиОчереди());
	ВыполнитьРегламентПоКлючу("ЭДО_СверкаСтатусов");
КонецПроцедуры

// Регламент отправки очереди. Прогон пишет в журнал регистрации свод с числами, а не факт
// запуска, и отличает "очередь пуста" от "отбор сломан" (ПризнакиСломанногоОтбора).
Процедура ОтправитьОчередь() Экспорт

	ВыполнитьПрогонОтправки();

КонецПроцедуры

// Прогон отправки очереди. Возврат: Строка - свод для журнала и для ручного запуска.
Функция ВыполнитьПрогонОтправки() Экспорт

	Детали = Новый Массив;
	Свод = "";

	Попытка
		// Параметры отбора живут в НАСТРОЙКАХ БАЗЫ, а не в тексте: правятся формой настроек,
		// одинаково видны отправке и регламенту, переживают выкатку расширения.
		ЛимитДокументов = Число(ЭДО_Сервер.НастройкаЭДО("ЛимитДокументовЗаПрогон"));
		НижняяГраница = ЭДО_Сервер.НижняяГраницаОтбора();

		// Замок прогона берем явно: свой цикл по ОтправитьПоЭДО идет мимо защит фасада
		// ОтправитьМассивПоЭДО, а параллельные прогоны задваивают отправку.
		// СнятьБрошенныеЗанятия() здесь НЕ звать: отметка ставится до POST, и снятие без сверки
		// с оператором плодит дубли. Брошенные отметки разбирает сторож со сверкой.
		ЗамокНаш = ЭДО_Сервер.ЗанятьПрогонОтправки();
		ЗамокДержим = ЗамокНаш;

		// Выкатка версии с новым обязательным свойством иначе держит всю очередь,
		// пока свойство не заведут руками.
		Самопочинка = "";
		Если ЗамокНаш Тогда
			Самопочинка = ЭДО_Сервер.ЗавестиНедостающиеСвойстваОбъектов();
		КонецЕсли;

		// Отсчет паузы перед автоотправкой УКД ставится ДО отбора: сам отбор только читает,
		// его зовет и сверка гейтов. Сбой здесь задерживает УКД, но не отправку реализаций.
		ОтмеченоУКД = 0;
		ОшибкаОтметкиУКД = "";
		Если ЗамокНаш Тогда
			Попытка
				ОтмеченоУКД = ЭДО_Сервер.ОтметитьКорректировкиНаПроверке();
			Исключение
				ОшибкаОтметкиУКД = Лев(ОписаниеОшибки(), 160);
			КонецПопытки;
		КонецЕсли;

		// Отбор целиком в ядре: типовые условия знает ядро, нетиповой признак готовности
		// добавляет профиль базы (точка ПриОтбореДокументовКОтправке).
		Т = ЭДО_Сервер.ДокументыКОтправке();
		Всего = Т.Количество();

		// чужой прогон идет - ничего не берем, но сводку по очереди все равно печатаем
		// Документы, которые держит гейт «нет кодов маркировки», место в лимите не занимают: они
		// старше остальных и всегда стоят первыми, и при их числе не меньше лимита прогон брал бы
		// одни и те же, а готовые за ними не уходили бы никогда.
		// То же ожидание счет-фактуры: старые реализации с НДС стоят первыми.
		// Обработать - сколько документов прогон может отправить, а не просмотреть.
		Обработать = ?(ЗамокНаш, Мин(ЛимитДокументов, Всего), 0);
		Взято = 0;
		ЖдутКодов = 0;
		ЖдутСчетаФактуры = 0;
		Просмотрено = 0;
		Успешно = 0;
		Ошибок = 0;
		Отсеяно = 0;   // «не требуется» (ушел через Диадок, розница) - не ошибка
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

		Для Инд = 0 По ?(ЗамокНаш, Всего, 0) - 1 Цикл
			Если Взято >= Обработать Тогда
				Прервать;
			КонецЕсли;
			// замок живет 30 минут, а прогон при аварии оператора идет почти столько же - продлеваем.
			// В начале цикла, а не в конце: пропуск «ждут кодов» уходит в Продолжить и не должен терять продление.
			// Не продлился - замок уже не наш: дальше не шлем, освобождать тоже нечего.
			Если Инд > 0 И Инд % 25 = 0 И НЕ ЭДО_Сервер.ЗанятьПрогонОтправки() Тогда
				ЗамокДержим = Ложь;
				Детали.Добавить("замок прогона не продлился - отправка остановлена");
				Прервать;
			КонецЕсли;
			Стр = Т[Инд];
			Просмотрено = Просмотрено + 1;
			Попытка
				Рез = ЭДО_Сервер.ОтправитьПоЭДО(Стр.Ссылка);
				Если Рез.КодПричины = "НетКодовМаркировки" Тогда
					// ждет сканирования кодов - не ошибка прогона и не место в лимите
					ЖдутКодов = ЖдутКодов + 1;
					Продолжить;
				КонецЕсли;
				Если Рез.КодПричины = "НетСчетаФактуры" Тогда
					ЖдутСчетаФактуры = ЖдутСчетаФактуры + 1;
					Продолжить;
				КонецЕсли;
				Взято = Взято + 1;
				Если ЗначениеЗаполнено(Рез.ИдДокумента) Тогда
					Успешно = Успешно + 1;
				ИначеЕсли Рез.Статус = "Отсеян" И СнятСОчереди(Стр.Ссылка) Тогда
					// документ помечен «Отправка не требуется» и ушел из очереди -
					// считать его ошибкой значило красить строку «Обмен» волной уже отправленных через Диадок.
					// Отсев XML-движка так не помечается: документ вернется в очередь,
					// поэтому он, как раньше, - ошибка с причиной в подробностях.
					Отсеяно = Отсеяно + 1;
				Иначе
					Ошибок = Ошибок + 1;
					Детали.Добавить("ERR " + СокрЛП(Стр.Номер) + " -> " + Строка(Рез.Статус)
						+ ": " + Лев(Строка(Рез.Сообщение), 600));
				КонецЕсли;
			Исключение
				Взято = Взято + 1;
				Ошибок = Ошибок + 1;
				Детали.Добавить("EXC " + СокрЛП(Стр.Номер) + ": " + Лев(ОписаниеОшибки(), 160));
			КонецПопытки;
		КонецЦикла;

		Секунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1);
		// отправка закончена - замок дальше не нужен, остальное только читает
		Если ЗамокДержим Тогда
			ЭДО_Сервер.ОсвободитьПрогонОтправки();
			ЗамокДержим = Ложь;
		КонецЕсли;

		Свод = "ЭДО, отправка: в очереди " + Всего + ", взято " + Взято
			+ ", отправлено " + Успешно + ", ошибок " + Ошибок
			+ ?(Отсеяно > 0, ", не требуется " + Отсеяно, "")
			+ ?(ЖдутКодов > 0, ", ждут кодов маркировки " + ЖдутКодов, "")
			+ ?(ЖдутСчетаФактуры > 0, ", ждут счет-фактуру " + ЖдутСчетаФактуры, "") + "; " + Секунд + " c"
			+ "; окно с " + Формат(НижняяГраница, "ДФ=dd.MM.yyyy");
		Если НЕ ЗамокНаш Тогда
			Свод = Свод + "; ПРОПУЩЕН: прогон уже идёт в другом сеансе";
		КонецЕсли;
		Если ЗначениеЗаполнено(Самопочинка) Тогда
			Свод = Свод + "; " + Самопочинка;
		КонецЕсли;
		Если ОтмеченоУКД > 0 Тогда
			Свод = Свод + "; УКД поставлено на паузу перед отправкой: " + ОтмеченоУКД;
		КонецЕсли;
		Если ЗначениеЗаполнено(ОшибкаОтметкиУКД) Тогда
			Свод = Свод + "; ОШИБКА: пауза УКД не поставлена - " + ОшибкаОтметкиУКД;
		КонецЕсли;
		// итог прогона для строки «Обмен» Центра управления.
		Если ЗамокНаш Тогда
			ЗапомнитьИтогОбмена("ПоследнийПрогонОтправки", Новый Структура("Конец, Всего, Отправлено, Ошибок, Осталось",
				ТекущаяДатаСеанса(), Всего, Успешно, Ошибок, Макс(0, Всего - Успешно - Отсеяно)));
			Если Успешно > 0 Тогда
				ОтметитьУспешныйОбмен();   // документ принят оператором
			КонецЕсли;
		КонецЕсли;
		Если Всего > Просмотрено Тогда
			Свод = Свод + " (остаток " + (Всего - Просмотрено) + " уйдёт следующим прогоном)";
		КонецЕсли;

		// Пустая очередь: "пусто" или "отбор сломан"? Сломанный отбор тоже дает ноль строк без ошибок.
		Если Всего = 0 Тогда
			Поломки = ПризнакиСломанногоОтбора();
			Если Поломки.Количество() > 0 Тогда
				Свод = Свод + "; ОШИБКА: очередь пуста, но отбор сломан — "
					+ СтрСоединить(Поломки, "; ");
			Иначе
				Свод = Свод + "; очередь пуста штатно (отбор исправен)";
			КонецЕсли;
		КонецЕсли;

		// Расхождение гейтов отбора и проверки. Под Попытка: страховка не должна уронить прогон.
		Попытка
			Сверка = ЭДО_Сервер.СверитьГейтыОтбораИПроверки();
			Если Сверка.Расхождений > 0 Тогда
				Свод = Свод + "; ОШИБКА: гейты разошлись у " + Сверка.Расхождений
					+ " из " + Сверка.Проверено + " (отбор берёт, проверка держит)";
				Для Каждого С Из Сверка.Строки Цикл
					Детали.Добавить(С);
				КонецЦикла;
			КонецЕсли;
		Исключение
			Детали.Добавить("сверка гейтов не отработала: " + Лев(ОписаниеОшибки(), 120));
		КонецПопытки;

		// Причина неотправки в колонку "ЭДО": без нее не отличить "еще не ушло" от "не уйдет никогда".
		Попытка
			Причины = ЭДО_Сервер.ОбновитьПричиныНеотправки();
			Если Причины.Записано > 0 Тогда
				Свод = Свод + "; колонка ЭДО: обновлено " + Причины.Записано
					+ " (" + Причины.Сводка + ")";
			КонецЕсли;
		Исключение
			Детали.Добавить("причины неотправки не проставлены: " + Лев(ОписаниеОшибки(), 120));
		КонецПопытки;

		Детали.Вставить(0, Свод);
		Результат = СтрСоединить(Детали, Символы.ПС);
		ЗаписатьВЖурнал(Результат, СтрНайти(Свод, "ОШИБКА") > 0, "ЭДО.Регламент.Отправка");

	Исключение
		// замок не должен пережить падение прогона: иначе следующий запуск пропущен целиком.
		// Снимаем только если держим его сами: замок другого сеанса трогать нельзя.
		Попытка
			Если ЗамокДержим = Истина Тогда
				ЭДО_Сервер.ОсвободитьПрогонОтправки();
			КонецЕсли;
		Исключение
			// Своя защищенная запись: недоступный журнал не должен сорвать формирование сводки ниже.
			ЗаписатьВЖурнал("Не снят замок прогона отправки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
				Истина, "ЭДО.Отправка");
		КонецПопытки;
		Результат = "ЭДО, отправка — ОШИБКА: " + ОписаниеОшибки();
		ЗаписатьВЖурнал(Результат, Истина, "ЭДО.Регламент.Отправка");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// отсеянный документ снят с очереди окончательно, только если
// отправка записала ему «Отправка не требуется» - этот текст исключает его из отбора.
Функция СнятСОчереди(Знач Ссылка)
	Значение = ЭДО_Сервер.ЗначениеСвойстваОбъекта(Ссылка, ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние"));
	Возврат СокрЛП(Строка(Значение)) = ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется();
КонецФункции

// Почему отбор мог отдать ноль строк не потому, что отправлять нечего. Свойства отбора ищутся
// по наименованию: переименованное или незаведенное свойство дает пустую ссылку, и запрос
// без единой ошибки возвращает ноль - как будто сегодня нет отгрузок.
// Возврат: Массив строк-претензий (пустой - отбор исправен).
Функция ПризнакиСломанногоОтбора() Экспорт

	Претензии = Новый Массив;

	// 1. Свойства, без которых отбор пуст по построению.
	Обязательные = "ЭДО_АдресКонтрагента,ЭДО_СтатусСвязи,ЭДО_ИдентификаторДокумента,"
		+ "ЭДО_Состояние,ЭДО_РазрешенаОтправка";
	Отсутствуют = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Обязательные, ",") Цикл
		Свойство = ЭДО_Сервер.СвойствоОбъектов(СокрЛП(Имя));
		Если Свойство = Неопределено ИЛИ Свойство.Пустая() Тогда
			Отсутствуют.Добавить(СокрЛП(Имя));
		КонецЕсли;
	КонецЦикла;
	Если Отсутствуют.Количество() > 0 Тогда
		Претензии.Добавить("не заведены свойства: " + СтрСоединить(Отсутствуют, ", "));
	КонецЕсли;

	// 2. Настройки, без которых отправка невозможна вовсе.
	Недостающее = ЭДО_Сервер.НедостающиеНастройкиЭДО();
	Если Недостающее.Количество() > 0 Тогда
		Претензии.Добавить("расширение не настроено: " + СтрСоединить(Недостающее, ", "));
	КонецЕсли;

	// 3. Ни одной разрешенной организации - отбор пуст при любом количестве отгрузок.
	// По умолчанию ЭДО_РазрешенаОтправка - запрет, и забытый флаг у новой базы дает пустую очередь.
	СвРазр = ЭДО_Сервер.СвойствоОбъектов("ЭДО_РазрешенаОтправка");
	Если СвРазр <> Неопределено И НЕ СвРазр.Пустая() Тогда
		З = Новый Запрос;
		З.Текст =
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Сколько
			|ИЗ РегистрСведений.ЗначенияСвойствОбъектов КАК Р
			|ГДЕ Р.Свойство = &Св
			|	И (ВЫРАЗИТЬ(Р.Значение КАК БУЛЕВО) = ИСТИНА
			|		ИЛИ ВЫРАЗИТЬ(Р.Значение КАК СТРОКА(50)) В (""Да"", ""Истина"", ""1""))";
		З.УстановитьПараметр("Св", СвРазр);
		В = З.Выполнить().Выбрать();
		Если В.Следующий() И В.Сколько = 0 Тогда
			Претензии.Добавить("ни одной организации не разрешена отправка"
				+ " (свойство «ЭДО_РазрешенаОтправка» не проставлено никому)");
		КонецЕсли;
	КонецЕсли;

	// 4. Отгрузки за окно есть, а очередь пуста - это еще не поломка, но повод сказать вслух.
	Нижняя = ЭДО_Сервер.НижняяГраницаОтбора();
	ЗД = Новый Запрос;
	ЗД.Текст =
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Сколько
		|ИЗ Документ.РеализацияТоваровУслуг КАК РТУ
		|ГДЕ РТУ.Проведен И РТУ.Дата >= &Дата И РТУ.ОтражатьВБухгалтерскомУчете";
	ЗД.УстановитьПараметр("Дата", Нижняя);
	ВД = ЗД.Выполнить().Выбрать();
	Если ВД.Следующий() И ВД.Сколько > 0 И Претензии.Количество() > 0 Тогда
		Претензии.Добавить("при этом проведённых реализаций за окно: " + ВД.Сколько);
	КонецЕсли;

	Возврат Претензии;

КонецФункции

// Свод прогона в журнал регистрации. Результат регламента судят по этой строке (свежесть
// и уровень), а не по коду возврата: код возврата не доказывает, что работа сделана.
Процедура ЗаписатьВЖурнал(Знач Текст, Знач ЭтоОшибка = Ложь,
	Знач Событие = "ЭДО.Регламент") Экспорт

	Попытка
		ЗаписьЖурналаРегистрации(Событие,
			?(ЭтоОшибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация),
			, , Лев(Текст, 5000));
	Исключение
		// Перехват обоснован: это сама запись в журнал; если журнал недоступен, записать отказ некуда,
		// а прогон ронять нельзя. ПредставлениеОшибки здесь писать некуда.
		Возврат;
	КонецПопытки;

КонецПроцедуры

// Есть ли в своде сверки сбой прогона. Строки с отступом - перечень документов, и слово «Ошибка» в них обычно
// текст статуса документа («Ошибка отправки у оператора: ...»); сбой в перечне пишется строкой с «ОШИБКА:» в начале.
Функция ЕстьОшибкаВСводе(Знач Свод) Экспорт

	Для Каждого СтрокаСвода Из СтрРазделить(Строка(Свод), Символы.ПС, Ложь) Цикл
		ТекстСтроки = ВРег(СокрЛ(СтрокаСвода));
		СтрокаПеречня = СтрНачинаетсяС(СтрокаСвода, " ") ИЛИ СтрНачинаетсяС(СтрокаСвода, Символы.Таб);
		Если СтрокаПеречня И СтрНачинаетсяС(ТекстСтроки, "ОШИБКА:") Тогда
			Возврат Истина;
		ИначеЕсли НЕ СтрокаПеречня И СтрНайти(ТекстСтроки, "ОШИБК") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Карта статусов Платформы -> текст колонки "ЭДО": в поле либо состояние, либо "Ошибка: ...",
// не длиннее 50 символов. Карта одна на полную и точечную сверку и карточку документа:
// механизмы узнают свои строки точным сравнением, и две карты разошлись бы.
Функция КартаСтатусовПлатформы() Экспорт

	Карта = Новый Соответствие;
	Карта.Вставить("NEW",                     "Отправляется");
	Карта.Вставить("AWAIT_PAYMENT",           "Отправляется");
	Карта.Вставить("SENT_TO_OPERATOR",        "Отправляется");
	// тексты - в ЭДО_Сервер.
	Карта.Вставить("SENT",                    ЭДО_Сервер.ТекстОтправлен());
	Карта.Вставить("DELIVERED",               ЭДО_Сервер.ТекстДоставлен());
	Карта.Вставить("ACCEPTED",                ЭДО_Сервер.ТекстПодписанКонтрагентом());
	Карта.Вставить("REJECTED",                ЭДО_Сервер.ТекстОтклоненКонтрагентом());
	Карта.Вставить("SENDING_FAILED",          ЭДО_Сервер.ТекстОшибкаОтправкиУОператора());
	Карта.Вставить("FIXATION_FAILED",         ЭДО_Сервер.ТекстОшибкаФиксацииЧЗ());
	Карта.Вставить("AWAIT_FIXATION",          ЭДО_Сервер.ТекстЖдетФиксацииЧЗ());
	Карта.Вставить("CANCELLED",               ЭДО_Сервер.ТекстАннулирован());
	Карта.Вставить("CANCELLATION_REQUESTED",  ЭДО_Сервер.ТекстАннулированиеЖдемОтвета());
	// Карточку удалил отправитель: так уходят только неподписанные черновики (NEW),
	// контрагенту документ не доставлялся.
	Карта.Вставить("DELETED",                 ЭДО_Сервер.ТекстКарточкаУдалена());
	Возврат Карта;

КонецФункции

// Состояния, после которых документ дальше сам не двигается. Точечная сверка их не
// опрашивает: аннулирование принятого документа и переход отказа в другое состояние
// бывают, но редко, и их подбирает часовой полный обход.
Функция ФинальныеСостоянияКолонки() Экспорт

	Тексты = Новый Массив;
	// с прежними формулировками - до их переписывания документы не должны попасть в опрос.
	Для Каждого Текст Из ЭДО_Сервер.ТекстыСтатусаСПрежними(ЭДО_Сервер.ТекстПодписанКонтрагентом()) Цикл
		Тексты.Добавить(Текст);
	КонецЦикла;
	Для Каждого Текст Из ЭДО_Сервер.ТекстыСтатусаСПрежними(ЭДО_Сервер.ТекстОтклоненКонтрагентом()) Цикл
		Тексты.Добавить(Текст);
	КонецЦикла;
	Тексты.Добавить(ЭДО_Сервер.ТекстАннулирован());
	Тексты.Добавить(ЭДО_Сервер.ТекстАннулированиеОтклонено());
	Тексты.Добавить(ЭДО_Сервер.ТекстКарточкаУдалена());   // удаленная карточка не оживает
	Тексты.Добавить(ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется());
	Возврат Тексты;

КонецФункции

// Какой из экземпляров одной накладной актуален: принятый контрагентом важнее более поздней копии
// (дубль отправки контрагент отклоняет, а документ уже подписан), иначе - самый свежий.
Функция ЭкземплярАктуальнее(Знач СтатусКандидата, Знач СозданКандидата, Знач СтатусТекущего, Знач СозданТекущего) Экспорт

	КандидатПринят = (ВРег(СокрЛП(СтатусКандидата)) = "ACCEPTED");
	ТекущийПринят = (ВРег(СокрЛП(СтатусТекущего)) = "ACCEPTED");
	Если КандидатПринят <> ТекущийПринят Тогда
		Возврат КандидатПринят;
	КонецЕсли;
	Возврат СозданКандидата > СозданТекущего;

КонецФункции

// Вес экземпляра для выбора того, на который указывает ЭДО_ИдентификаторДокумента:
// 3 - подписан, 1 - у контрагента не действует, 2 - остальные. Идущее аннулирование - 2: ПОА шлют
// и на лишний дубль, и такой дубль не должен перетягивать ид на себя.
Функция РангЭкземпляра(Знач Статус) Экспорт

	Статус = ВРег(СокрЛП(Статус));
	Если Статус = "ACCEPTED" Тогда
		Возврат 3;
	КонецЕсли;
	Если СтрНайти(",SENDING_FAILED,REJECTED,DELETED,CANCELLED,FIXATION_FAILED,", "," + Статус + ",") > 0 Тогда
		Возврат 1;
	КонецЕсли;
	Возврат 2;

КонецФункции

// Живой экземпляр - в пути или у контрагента: запрещает вернуть документ в очередь. Мертвыми считаются только
// известные недействующие статусы (РангЭкземпляра = 1), а не живыми - только известные действующие: SIGNED,
// SENDING, AWAIT_FIXATION и новый статус оператора тоже в пути, и повтор при них дал бы контрагенту дубль.
Функция ЭкземплярЖивой(Знач Статус) Экспорт
	Возврат РангЭкземпляра(Статус) <> 1;
КонецФункции

// Выбор экземпляра для колонки "ЭДО" и записанного ид: действующий важнее недействующего,
// дальше - ЭкземплярАктуальнее. Без первого шага неудачная переотправка закрывала бы доставленный экземпляр.
Функция ЭкземплярПредпочтительнее(Знач СтатусКандидата, Знач СозданКандидата,
	Знач СтатусТекущего, Знач СозданТекущего) Экспорт

	РангКандидата = РангЭкземпляра(СтатусКандидата);
	РангТекущего = РангЭкземпляра(СтатусТекущего);
	Если РангКандидата <> РангТекущего Тогда
		Возврат РангКандидата > РангТекущего;
	КонецЕсли;
	Возврат ЭкземплярАктуальнее(СтатусКандидата, СозданКандидата, СтатусТекущего, СозданТекущего);

КонецФункции

// Пересаживать ли записанный ид документа на выбранный экземпляр. Только на экземпляр строго большего
// ранга: при равном ид остается на последней отправке, а по ид ведут колонку точечная сверка
// и аннулирование (ПОА на лишний экземпляр не трогает колонку основного).
Функция ПересадитьИдНаЭкземпляр(Знач ИдЗаписанного, Знач СтатусЗаписанного,
	Знач ИдВыбранного, Знач СтатусВыбранного) Экспорт

	ИдЗаписанного = СокрЛП(ИдЗаписанного);
	ИдВыбранного = СокрЛП(ИдВыбранного);
	Если НЕ ЗначениеЗаполнено(ИдЗаписанного) ИЛИ НЕ ЗначениеЗаполнено(ИдВыбранного)
		ИЛИ ИдЗаписанного = ИдВыбранного Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат РангЭкземпляра(СтатусВыбранного) > РангЭкземпляра(СтатусЗаписанного);

КонецФункции

// Идентификатор документа у оператора - строкой, годной для сравнения. JSON отдает id числом,
// а Строка(<число>) вставляет неразрывные пробелы между группами, и сравнение молча не совпадает.
Функция ИдентификаторСтрокой(Знач Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Точечная сверка статусов - дешевый частый прогон: спрашивает у оператора ровно документы
// с нефинальным статусом формой "documents?id=<a>&id=<b>", без интервала дат.
// Полный обход (ВыполнитьСверкуСтатусов) остается: только он видит карточки без пары в базе
// и изменения документов старше окна и уже финальных.
// Возврат: Строка - свод для журнала и для ручного запуска.
Функция ВыполнитьТочечнуюСверку(Знач ОкноДней = 7, Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьТочечнуюСверку(ОкноДней, УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	// прежние формулировки колонки переписываются сами, порциями по 3000 записей
	// за прогон, после обновления расширения; дальше вызов только читает отметку выполнения.
	Попытка
		Переписано = ЭДО_Сервер.ПереписатьПрежниеТекстыКолонки(3000);
		Если Переписано.Переписано > 0 Тогда
			ЗаписатьВЖурнал("ЭДО, тексты колонки: переписано " + Переписано.Переписано + ", осталось "
				+ Переписано.Осталось, Ложь, "ЭДО.Регламент.ТочечнаяСверка");
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("ЭДО, тексты колонки: ОШИБКА " + ОписаниеОшибки(), Истина, "ЭДО.Регламент.ТочечнаяСверка");
	КонецПопытки;

	Свод = "";
	Метка = ?(Организация = Неопределено, "", " [" + Строка(Организация) + "]");

	Попытка
		РазмерПачки = 100;   // 100 идентификаторов дают URL около 1,4 КБ - в лимиты укладывается
		ПоказатьМакс = 30;

		СвойствоСтатус = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
		СвойствоИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
		Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая()
			ИЛИ СвойствоИд = Неопределено ИЛИ СвойствоИд.Пустая() Тогда
			ВызватьИсключение "Не заведены свойства ЭДО_Состояние или ЭДО_ИдентификаторДокумента";
		КонецЕсли;

		// Берем документы с карточкой у оператора и нефинальным состоянием. Пустое состояние
		// тоже берем: это документ, отправленный только что, и он как раз интереснее всех.
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Реализация.Ссылка КАК Ссылка,
			|	Реализация.Номер КАК Номер,
			|	ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)) КАК ИдЭДО,
			|	ЕСТЬNULL(ВЫРАЗИТЬ(Статусы.Значение КАК СТРОКА(50)), """") КАК ТекущийСтатус
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК Реализация
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
			|		ПО Ид.Объект = Реализация.Ссылка
			|			И Ид.Свойство = &СвойствоИд
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Статусы
			|		ПО Статусы.Объект = Реализация.Ссылка
			|			И Статусы.Свойство = &СвойствоСтатус
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗапросАн
			|		ПО ЗапросАн.Объект = Реализация.Ссылка
			|			И ЗапросАн.Свойство = &СвойствоЗапросАн
			|ГДЕ
			|	Реализация.Проведен
			|	И (&ВсеОрганизации ИЛИ Реализация.Организация.ИНН = &ИННОрганизации)
			|	И (Реализация.Дата >= &Граница
			|			И НЕ ЕСТЬNULL(ВЫРАЗИТЬ(Статусы.Значение КАК СТРОКА(50)), """") В (&Финальные)
			|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(ЗапросАн.Значение КАК СТРОКА(50)), """") <> """"
			|		ИЛИ ЕСТЬNULL(ВЫРАЗИТЬ(Статусы.Значение КАК СТРОКА(50)), """") = &ТекстЗапросаАн)";
		Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
		Запрос.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
		Запрос.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
		Запрос.УстановитьПараметр("СвойствоСтатус", СвойствоСтатус);
		Запрос.УстановитьПараметр("Граница", НачалоДня(ТекущаяДатаСеанса()) - ОкноДней * 86400);   // дата сеанса
		Запрос.УстановитьПараметр("Финальные", ФинальныеСостоянияКолонки());
		// Запрос контрагента на аннулирование приходит и по старым документам: их берем без оглядки
		// на окно, пока запрос открыт, и еще раз после закрытия, чтобы колонка вернулась к статусу.
		СвойствоЗапросАн = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ЗапросАннулирования");
		Запрос.УстановитьПараметр("СвойствоЗапросАн", ?(СвойствоЗапросАн = Неопределено,
			ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка(), СвойствоЗапросАн));
		Запрос.УстановитьПараметр("ТекстЗапросаАн", ЭДО_Сервер.ТекстЗапросаАннулирования());

		// ОкноДней = 0 - сверка без окна: все документы любого вида с карточкой у оператора
		// и нефинальным состоянием. Сверки с окном теряют подписи и отказы, пришедшие позже окна,
		// а акты сверки и корректировки не сверяют вовсе.
		// Идем от регистра, а не от документа: видов документов несколько. Отбор по организации
		// через составной Объект дал бы соединение со всеми типами, поэтому он ниже, в коде.
		Если ОкноДней = 0 Тогда
			Запрос.Текст =
				"ВЫБРАТЬ
				|	Ид.Объект КАК Ссылка,
				|	ПРЕДСТАВЛЕНИЕ(Ид.Объект) КАК Номер,
				|	ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)) КАК ИдЭДО,
				|	ЕСТЬNULL(ВЫРАЗИТЬ(Статусы.Значение КАК СТРОКА(50)), """") КАК ТекущийСтатус
				|ИЗ
				|	РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Статусы
				|		ПО Статусы.Объект = Ид.Объект
				|			И Статусы.Свойство = &СвойствоСтатус
				|ГДЕ
				|	Ид.Свойство = &СвойствоИд
				|	И НЕ ЕСТЬNULL(ВЫРАЗИТЬ(Статусы.Значение КАК СТРОКА(50)), """") В (&Финальные)";
		КонецЕсли;
		Таблица = Запрос.Выполнить().Выгрузить();
		Если ОкноДней = 0 И Организация <> Неопределено Тогда
			ИННОтбора = СокрЛП(Организация.ИНН);
			Чужие = Новый Массив;
			Для Каждого Строчка Из Таблица Цикл
				ИННДокумента = "";
				Попытка
					ИННДокумента = СокрЛП(Строчка.Ссылка.Организация.ИНН);
				Исключение
					ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ВыполнитьТочечнуюСверку: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
					ИННДокумента = ""; // организацию не прочитать - документ считается чужим
				КонецПопытки;
				Если ИННДокумента <> ИННОтбора Тогда
					Чужие.Добавить(Строчка);
				КонецЕсли;
			КонецЦикла;
			Для Каждого Строчка Из Чужие Цикл
				Таблица.Удалить(Строчка);
			КонецЦикла;
		КонецЕсли;
		ОписаниеОкна = ?(ОкноДней = 0, "без окна", "окно " + ОкноДней + " дн.");

		Если Таблица.Количество() = 0 Тогда
			Свод = "ЭДО, точечная сверка" + Метка + ": нечего спрашивать (" + ОписаниеОкна + ")";
			ЗаписатьВЖурнал(Свод, Ложь, "ЭДО.Регламент.ТочечнаяСверка");
			Возврат Свод;
		КонецЕсли;

		КартаИд = Новый Соответствие;   // идентификатор у оператора -> Структура(Ссылка, ТекущийСтатус)
		Идентификаторы = Новый Массив;
		Для Каждого Строчка Из Таблица Цикл
			Ид = СокрЛП(Строка(Строчка.ИдЭДО));
			Если НЕ ЗначениеЗаполнено(Ид) ИЛИ КартаИд.Получить(Ид) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			КартаИд.Вставить(Ид, Новый Структура("Ссылка, ТекущийСтатус, Номер",
				Строчка.Ссылка, СокрЛП(Строка(Строчка.ТекущийСтатус)), СокрЛП(Строка(Строчка.Номер))));
			Идентификаторы.Добавить(Ид);
		КонецЦикла;

		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
			ВызватьИсключение "Не удалось получить токен Платформы";
		КонецЕсли;
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		Соед = ЭДО_Сервер.СоединениеСОператором();
		КартаСтатусов = КартаСтатусовПлатформы();
		ЗапросыАннулирования = ЭДО_Сервер.ДокументыСЗапросомАннулирования();
		ОтклоненныеАннулирования = ЭДО_Сервер.ДокументыСОтклоненнымАннулированием();

		Запросов = 0;
		Отвечено = 0;
		ОтветилОператор = Ложь;
		ЧерезЦепочки = Ложь;   // список /documents ответил 401 - дальше через document-flows
		ТокенПеревыпущен = Ложь;   // 401 пачки: сначала новый токен и повтор, переход в поштучный режим - со второго
		Гид = ЭДО_Сервер.ГидОрганизации(Организация);
		ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();   // поштучный обход дольше жизни токена
		Записано = 0;
		Ошибки = "";
		Изменения = Новый Массив;
		СтрокиОтказов = Новый Соответствие;

		// спрашиваем только документы, изменившиеся у оператора (лента), и те, чей текст
		// колонки меняется без события оператора: черновик стареет («Отправляется» -> «неподписан»), пусто, запрос
		// аннулирования. Лента недоступна или первый прогон - спрашиваем все, как раньше.
		Лента = ИзмененныеПоЛенте(Организация, ОкноДней, Соед, Заголовки, Гид);
		Получены = Новый Соответствие;   // id, по которым карточка пришла и разобрана
		Упавшие = Новый Массив;          // реализации, чей текущий экземпляр оператор не отправил (SENDING_FAILED)
		ВсегоКСверке = Идентификаторы.Количество();
		Если Лента.Изменения <> Неопределено Тогда
			ТекстЧерновика = КартаСтатусов.Получить("NEW");
			ПоЛенте = Новый Массив;
			Для Каждого Ид Из Идентификаторы Цикл
				Данные = КартаИд.Получить(Ид);
				Если Лента.Изменения.Получить(Ид) <> Неопределено
					ИЛИ НЕ ЗначениеЗаполнено(Данные.ТекущийСтатус)
					ИЛИ Данные.ТекущийСтатус = ТекстЧерновика
					ИЛИ Данные.ТекущийСтатус = ЭДО_Сервер.ТекстЗапросаАннулирования()
					ИЛИ ЗапросыАннулирования.Получить(Данные.Ссылка) <> Неопределено
					ИЛИ ОтклоненныеАннулирования.Получить(Данные.Ссылка) <> Неопределено Тогда
					ПоЛенте.Добавить(Ид);
				КонецЕсли;
			КонецЦикла;
			Идентификаторы = ПоЛенте;
		КонецЕсли;

		Индекс = 0;
		Пока Индекс < Идентификаторы.Количество() Цикл
			Пачка = Новый Массив;
			ИдПачки = Новый Массив;
			Пока Индекс < Идентификаторы.Количество() И Пачка.Количество() < РазмерПачки Цикл
				Пачка.Добавить("id=" + Идентификаторы[Индекс]);
				ИдПачки.Добавить(Идентификаторы[Индекс]);
				Индекс = Индекс + 1;
			КонецЦикла;

			Если ЧерезЦепочки Тогда
				// запасной путь - по одному идентификатору за запрос.
				ОтветовЦепочек = 0;
				МассивОтвета = КарточкиПоИдЧерезЦепочки(Соед, Заголовки, Гид, ИдПачки, Организация, ТокенПолучен,
					Ошибки, ОтветовЦепочек, Запросов);
				Если ОтветовЦепочек = 0 Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				// page_size обязателен и при запросе по идентификаторам: без него выдача молча режется
				// до 20 записей (HTTP 200, без ошибок).
				Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?"
					+ СтрСоединить(Пачка, "&") + "&page_size=" + РазмерПачки;
				Ответ = Неопределено;
				Попытка
					Ответ = Соед.Получить(Новый HTTPЗапрос(Путь, Заголовки));
				Исключение
					// таймаут прилетает исключением - пачку пропускаем, ее возьмет следующий прогон
					Ошибки = Ошибки + "пачка не отвечена: " + Лев(ОписаниеОшибки(), 80) + "; ";
					Продолжить;
				КонецПопытки;
				Запросов = Запросов + 1;
				Если Ответ.КодСостояния = 401 И НЕ ТокенПеревыпущен Тогда
					// обычное протухание токена - перевыпуск и повтор
					// этой же пачки; поштучный режим не включаем. Токен не выдан - останавливаемся с причиной (исключение -
					// в свод и журнал, указатель ленты не сдвигается), а не идем поштучно со старым.
					Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
						ВызватьИсключение "Не удалось обновить токен Платформы (список /documents ответил 401)";
					КонецЕсли;
					Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
					ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
					ТокенПеревыпущен = Истина;
					Индекс = Индекс - ИдПачки.Количество();
					Продолжить;
				КонецЕсли;
				Если Ответ.КодСостояния = 401 Тогда
					// и со свежим токеном список отвечает 401 «Can't get EDM authorization details» -
					// сбой оператора на /documents. Эту же пачку и остальные - поштучно (v4/documents/{id}).
					ЧерезЦепочки = Истина;
					Индекс = Индекс - ИдПачки.Количество();
					Продолжить;
				КонецЕсли;
				ТокенПеревыпущен = Ложь;   // пачка прошла - следующий 401 снова сначала перевыпуском
				Если Ответ.КодСостояния <> 200 Тогда
					Ошибки = Ошибки + "HTTP " + Ответ.КодСостояния + "; ";
					Продолжить;
				КонецЕсли;

				Чтение = Новый ЧтениеJSON;
				Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
				МассивОтвета = ПрочитатьJSON(Чтение, Ложь);
				Чтение.Закрыть();
				Если ТипЗнч(МассивОтвета) <> Тип("Массив") Тогда
					Ошибки = Ошибки + "пачка: неожиданный ответ оператора; ";   // указатель ленты не сдвигать
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Если НЕ ОтветилОператор Тогда
				ОтветилОператор = Истина;
				ОтметитьУспешныйОбмен();   // успешный обмен - ответ оператора, а не свод без ошибки
			КонецЕсли;

			Для Каждого Карточка Из МассивОтвета Цикл
				Отвечено = Отвечено + 1;
				Данные = КартаИд.Получить(ИдентификаторСтрокой(Карточка.id));
				Если Данные = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Получены.Вставить(ИдентификаторСтрокой(Карточка.id), Истина);   // см. хвост ленты
				Если ЭДО_Сервер.СтатусКарточкиОператора(Карточка) = "SENDING_FAILED"
					И ТипЗнч(Данные.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
					Упавшие.Добавить(Данные.Ссылка);   // возврат в очередь - после обхода
				КонецЕсли;
				СтатусAPI = ЭДО_Сервер.СтатусКарточкиОператора(Карточка);   // с учетом newStatus
				НовыйСтатус = КартаСтатусов.Получить(СтатусAPI);
				Если НовыйСтатус = Неопределено Тогда
					НовыйСтатус = СтатусAPI;   // незнакомый статус показываем как есть
				КонецЕсли;
				// черновик NEW старше часа - не «Отправляется», а неподписанный.
				НовыйСтатус = ЭДО_Сервер.ТекстКолонкиЧерновика(НовыйСтатус, СтатусAPI,
					ЭДО_Сервер.ПолеКарточкиОператора(Карточка, "created"));
				НовыйСтатус = ЭДО_Сервер.ТекстКолонкиСУчетомЗапросаАннулирования(Данные.Ссылка,
					Лев(НовыйСтатус, 50), ЗапросыАннулирования, ОтклоненныеАннулирования,
					ИдентификаторСтрокой(Карточка.id));
				// сумма, с которой экземпляр ушел, - Центр управления сравнивает ее с документом.
				Попытка
					ЭДО_Сервер.ЗапомнитьСуммуВЭДО(Данные.Ссылка, ИдентификаторСтрокой(Карточка.id),
						ЭДО_Сервер.СуммаКарточкиОператора(Карточка));
				Исключение
					ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ВыполнитьТочечнуюСверку: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
					Ошибки = Ошибки + Данные.Номер + ": сумма в ЭДО не записана; ";
				КонецПопытки;
				НовыйСтатус = ЭДО_Сервер.ТекстКолонкиСУчетомПричиныОтказа(НовыйСтатус, Данные.ТекущийСтатус);
				Если НовыйСтатус = Данные.ТекущийСтатус Тогда
					Продолжить;
				КонецЕсли;
				Попытка
					ЭДО_Сервер.ЗаписатьЧитаемыйСтатус(Данные.Ссылка, НовыйСтатус);
					Записано = Записано + 1;
					Если Изменения.Количество() < ПоказатьМакс Тогда
						Изменения.Добавить(Данные.Номер + ": " + ?(ЗначениеЗаполнено(Данные.ТекущийСтатус),
							Данные.ТекущийСтатус, "(пусто)") + " -> " + НовыйСтатус);
						Если СтатусAPI = "REJECTED" ИЛИ СтатусAPI = "SENDING_FAILED" Тогда
							СтрокиОтказов.Вставить(ИдентификаторСтрокой(Карточка.id), Изменения.ВГраница());
						КонецЕсли;
					КонецЕсли;
				Исключение
					Ошибки = Ошибки + Данные.Номер + ": " + Лев(ОписаниеОшибки(), 80) + "; ";
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
		ДописатьПричиныОтказов(Изменения, СтрокиОтказов, Организация);

		// упавший экземпляр - в очередь сразу, а не на следующей полной сверке (блок 5).
		// Решение - по всем экземплярам документа у оператора (поиск по номеру с черновиками): живой есть или набор
		// не прочитан целиком - не трогаем.
		Возвращено = 0;
		Если Упавшие.Количество() > 0 Тогда
			СвойствоОтправки = ЭДО_Сервер.СвойствоОбъектов("ЭДО_КодСостояния");
			НерабочиеПрефиксы = НерабочиеПрефиксыЭДО();
			Для Каждого Ссылка Из Упавшие Цикл
				Если СвойствоОтправки = Неопределено ИЛИ СвойствоОтправки.Пустая()
					ИЛИ СокрЛП(Строка(ЭДО_Сервер.ЗначениеСвойстваОбъекта(Ссылка, СвойствоОтправки))) <> "40" Тогда
					Продолжить;
				КонецЕсли;
				Попытка
					Экз = ЭкземплярыПоНомеру(Соед, Заголовки, Гид, СокрЛП(Ссылка.Номер), Ссылка.Дата, Запросов);
				Исключение
					// таймаут поиска - ошибка в своде, указатель ленты стоит: документ спросится снова
					Ошибки = Ошибки + Ссылка.Номер + ": поиск экземпляров не ответил; ";
					Продолжить;
				КонецПопытки;
				Если НЕ Экз.Прочитано Тогда
					// набор не прочитан - решать нельзя; ошибка держит указатель ленты
					Ошибки = Ошибки + Ссылка.Номер + ": экземпляры не прочитаны (" + Экз.Причина + "); ";
					Продолжить;
				КонецЕсли;
				Если Экз.ЕстьЖивой ИЛИ Экз.Последний = Неопределено
					ИЛИ Экз.Последний.Статус <> "SENDING_FAILED" Тогда
					Продолжить;
				КонецЕсли;
				Экземпляр = Новый Структура("Ид, Создан, Получатель, Падений",
					Экз.Последний.Ид, Экз.Последний.Создан, Экз.Последний.Получатель, Экз.Падений);
				Возврат5 = ВернутьУпавшийВОчередь(Ссылка, Экземпляр, НерабочиеПрефиксы, ПорогСвежестиОтказаДней(),
					СвойствоОтправки, СвойствоИд);
				Если СтрНачинаетсяС(Возврат5, "сброшен") Тогда
					Возвращено = Возвращено + 1;
					Изменения.Добавить(Строка(Ссылка) + ": возвращён в очередь (был ид " + Экземпляр.Ид + ")"
						+ Сред(Возврат5, СтрДлина("сброшен") + 1));
				ИначеЕсли Возврат5 <> "" И Возврат5 <> "занят" Тогда
					Изменения.Добавить(Строка(Ссылка) + ": " + Возврат5);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// указатель ленты - только после сверки без ошибок, иначе пропущенное не вернется.
		Если Ошибки = "" Тогда
			Неполученные = Новый Массив;
			Для Каждого Ид Из Идентификаторы Цикл
				Если Получены.Получить(Ид) = Неопределено Тогда
					Неполученные.Добавить(Ид);
				КонецЕсли;
			КонецЦикла;
			ЗапомнитьСмещениеЛенты(Лента, Неполученные);
		КонецЕсли;
		Свод = "ЭДО, точечная сверка" + Метка + ": " + ОписаниеОкна + ", спрошено " + Идентификаторы.Количество()
			+ ?(Идентификаторы.Количество() <> ВсегоКСверке, " из " + ВсегоКСверке, "") + " (" + Лента.Описание + ")"
			+ ", запросов " + Запросов + ", отвечено " + Отвечено + ", обновлено " + Записано
			+ ?(Возвращено > 0, ", возвращено в очередь " + Возвращено, "")
			+ ?(ЧерезЦепочки, " (через document-flows: список /documents ответил 401)", "");
		Если Ошибки <> "" Тогда
			Свод = Свод + " | ОШИБКА: " + Лев(Ошибки, 400);
		КонецЕсли;
		Для Каждого Строчка Из Изменения Цикл
			Свод = Свод + Символы.ПС + "  " + Строчка;
		КонецЦикла;

		// В журнал пишем только когда что-то изменилось или сломалось: прогон раз в пять минут
		// иначе забьет журнал регистрации сотней пустых строк в сутки.
		Если Записано > 0 ИЛИ Ошибки <> "" ИЛИ Упавшие.Количество() > 0 Тогда
			ЗаписатьВЖурнал(Свод, Ошибки <> "", "ЭДО.Регламент.ТочечнаяСверка");
		КонецЕсли;

	Исключение
		Свод = "ЭДО, точечная сверка" + Метка + " — ОШИБКА: " + ОписаниеОшибки();
		ЗаписатьВЖурнал(Свод, Истина, "ЭДО.Регламент.ТочечнаяСверка");
	КонецПопытки;

	Возврат Свод;

КонецФункции

// Дописывает к строкам журнала причину отказа контрагента или падения отправки.
// Причина лежит не в карточке, а в цепочке документа, поэтому без отдельного запроса журнал
// сообщает, что отказали, но не почему.
// Параметры:
//   Строки - Массив - строки журнала, дополняются на месте.
//   СтрокиОтказов - Соответствие - идентификатор карточки строкой -> индекс строки в Строки.
//   Организация - СправочникСсылка.Организации, Неопределено - чья учетная запись спрашивает.
Процедура ДописатьПричиныОтказов(Строки, Знач СтрокиОтказов, Знач Организация)

	Если СтрокиОтказов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Для Каждого Пара Из СтрокиОтказов Цикл
		Идентификаторы.Добавить(Пара.Ключ);
	КонецЦикла;

	// Причина - подсказка к строке: не получили ее - сверка все равно состоялась.
	Попытка
		Причины = ЭДО_Сервер.ПричиныОтказаПоИдентификаторам(Идентификаторы, Организация);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ДописатьПричиныОтказов: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
		Возврат;
	КонецПопытки;

	Для Каждого Пара Из СтрокиОтказов Цикл
		Причина = Причины.Получить(Пара.Ключ);
		Если ЗначениеЗаполнено(Причина) Тогда
			Строки[Пара.Значение] = Строки[Пара.Значение] + ": "
				+ Лев(СтрЗаменить(Причина, Символы.ПС, " "), 200);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Сверка статусов у оператора: пишет колонку "ЭДО" документам с карточкой у оператора
// и возвращает в очередь документы, до контрагента не дошедшие.
// У документа у оператора бывает несколько экземпляров: переотправка создает новый, старый
// остается в своем статусе. Актуальный экземпляр выбирает ЭкземплярАктуальнее.
// Сопоставление с базой - по номеру и дате карточки (extra, раньше invoice): номер накладной повторяется по годам.
// Акты сверки сверяет блок 6 (СверитьСтатусыАктовСверки) по номеру без даты.
// ЭДО_КодСостояния = 40 означает "отправляли", а не "дошло"; не путать с ЭДО_Состояние
// (текст колонки). Пока отметка 40 стоит, документ не переотправить, поэтому блок 5 снимает
// ее у упавших документов без живого экземпляра.
// Здоровый API отвечает за доли секунды; прогон на минуты - признак аварии оператора,
// смотри счетчик таймаутов в своде.
Функция ВыполнитьСверкуСтатусов(Знач Организация = Неопределено) Экспорт

	Если Организация = Неопределено И ЭДО_Сервер.НесколькоУчетныхЗаписейЭДО() Тогда
		Своды = Новый Массив;
		Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
			Своды.Добавить(ВыполнитьСверкуСтатусов(УчетнаяЗапись.Организация));
		КонецЦикла;
		Возврат СтрСоединить(Своды, Символы.ПС);
	КонецЕсли;

	Попытка
		// окно обхода по дате создания карточки - настройка расширения
		ГлубинаДней = ЭДО_Сервер.НастройкаЭДО("ГлубинаДнейСинхронизацииСтатусов");
		ПоказатьМакс = 30;     // потолок списка проблемных в логе
		ПорогСвежестиДней = ПорогСвежестиОтказаДней();   // общий с точечной сверкой
		НерабочиеПрефиксы = НерабочиеПрефиксыЭДО();

		СвойствоСтатус = ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние");
		Если СвойствоСтатус = Неопределено ИЛИ СвойствоСтатус.Пустая() Тогда
			ВызватьИсключение "Не заведено свойство ЭДО_Состояние в ПВХ СвойстваОбъектов";
		КонецЕсли;
		// отметка отправки расширения - ее снимаем у документов, до контрагента не дошедших
		СвойствоОтправки = ЭДО_Сервер.СвойствоОбъектов("ЭДО_КодСостояния");
		// Снять одну отметку 40 недостаточно: очередь берет только документы без идентификатора
		// оператора, поэтому снимаем и его. Упавший экземпляр находится по номеру накладной,
		// его идентификатор пишется в журнал.
		СвойствоИдПлатформы = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");

		// Хотя бы один живой экземпляр (ЭкземплярЖивой) запрещает переотправку, даже если самый свежий -
		// отказной: контрагент мог отклонить лишний дубль и подписать нужный.

		КартаСтатусов = КартаСтатусовПлатформы();
		ЗапросыАннулирования = ЭДО_Сервер.ДокументыСЗапросомАннулирования();
		ОтклоненныеАннулирования = ЭДО_Сервер.ДокументыСОтклоненнымАннулированием();

		// -- 1. Токен и соединение -------------------------------------------------------------
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация) Тогда
			ВызватьИсключение "Не удалось получить токен Платформы";
		КонецЕсли;
		Токен = ЭДО_Сервер.ТекущийТокен(Организация);
		ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Гид = ЭДО_Сервер.ГидОрганизации(Организация);
		// Таймаут - настройка расширения "Таймаут HTTP, секунд". Держать небольшим: при аварии
		// оператора он умножается на повторы и вешает прогон.
		Соед = ЭДО_Сервер.СоединениеСОператором();

		// -- 2. Карта базы: "номер|дата" -> ссылка на реализацию --------------------------------
		// Запас в 3 дня: карточка Платформы может быть создана позже даты самой накладной.
		ГраницаДок = НачалоДня(ТекущаяДатаСеанса()) - (ГлубинаДней + 3) * 86400;   // дата сеанса
		ЗапросБаза = Новый Запрос(
			"ВЫБРАТЬ
			|	Реализация.Ссылка КАК Ссылка,
			|	Реализация.Номер КАК Номер,
			|	Реализация.Дата КАК Дата,
			|	ЕСТЬNULL(Статусы.Значение, """") КАК ТекущийСтатус,
			|	ЕСТЬNULL(Отправки.Значение, """") КАК ОтметкаОтправки
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК Реализация
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Статусы
			|		ПО Реализация.Ссылка = Статусы.Объект
			|			И Статусы.Свойство = &СвойствоСтатус
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Отправки
			|		ПО Реализация.Ссылка = Отправки.Объект
			|			И Отправки.Свойство = &СвойствоОтправки
			|ГДЕ
			|	Реализация.Дата >= &Граница
			|	И Реализация.Проведен
			|	И (&ВсеОрганизации ИЛИ Реализация.Организация.ИНН = &ИННОрганизации)");
		ЗапросБаза.УстановитьПараметр("СвойствоСтатус", СвойствоСтатус);
		ЗапросБаза.УстановитьПараметр("СвойствоОтправки", СвойствоОтправки);
		ЗапросБаза.УстановитьПараметр("Граница", ГраницаДок);
		ЗапросБаза.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
		ЗапросБаза.УстановитьПараметр("ИННОрганизации", ?(Организация = Неопределено, "", СокрЛП(Организация.ИНН)));
		ВыборкаБаза = ЗапросБаза.Выполнить().Выбрать();
		КартаБазы = Новый Соответствие;      // "номер|дд.ММ.гггг" -> Структура(Ссылка, ТекущийСтатус)
		Пока ВыборкаБаза.Следующий() Цикл
			КлючБазы = СокрЛП(ВыборкаБаза.Номер) + "|" + Формат(ВыборкаБаза.Дата, "ДФ=dd.MM.yyyy");
			КартаБазы.Вставить(КлючБазы, Новый Структура("Ссылка, ТекущийСтатус, ОтметкаОтправки",
				ВыборкаБаза.Ссылка, СокрЛП(Строка(ВыборкаБаза.ТекущийСтатус)),
				СокрЛП(Строка(ВыборкаБаза.ОтметкаОтправки))));
		КонецЦикла;

		// -- 3. Обход исходящих карточек интервалами --------------------------------------------
		// У выдачи два потолка: page_size = 100 и page = 9 (page=10 - HTTP 400), из интервала видно
		// не больше 1000 карточек, остальные теряются молча. Интервал, упершийся в потолок, делится
		// пополам и обходится заново; повтор безопасен - экземпляры складываются по ключу "номер|дата".
		Экземпляры = Новый Соответствие;     // "номер|дата" -> Структура(Ид, Создан, Статус, Получатель)
		ЭкземплярыАктов = Новый Соответствие; // номер акта сверки -> Соответствие(ид -> Структура), см. блок 6
		Запросов = 0;
		ОтветилОператор = Ложь;
		ВсегоКарточек = 0;
		Ошибки = "";
		Таймаутов = 0;
		Разбиений = 0;
		// страницы идут через ЭДО_Сервер.ПолучитьСписокОператора - document-flows/outgoing
		// с черновиками (drafts), /documents - резерв. Черновики не прочитаны - отметки отправки не сбрасываются
		// (блок 5): без них живой экземпляр NEW не виден, и сброс вернул бы документ в очередь при живом черновике.
		ЧерезЦепочки = Ложь;
		БезЧерновиков = Ложь;
		// страница интервала не получена или выдача обрезана потолком - карточки интервала
		// неполные, и «нет живого экземпляра» доказать нельзя: блок 5 в этом прогоне отметки не сбрасывает.
		ВыдачаНеполная = Ложь;
		Финиш = НачалоДня(ТекущаяУниверсальнаяДата());
		Интервалы = Новый Массив;            // очередь: Структура(Нач, Кон) в универсальном времени
		День = Финиш - (ГлубинаДней - 1) * 86400;
		Пока День <= Финиш Цикл
			Интервалы.Добавить(Новый Структура("Нач, Кон", День, День + 86399));
			День = День + 86400;
		КонецЦикла;
		// потолок на случай аварии выдачи: без него деление могло бы плодить интервалы бесконечно
		МаксИнтервалов = ГлубинаДней * 32;
		ИндексИнтервала = 0;
		Пока ИндексИнтервала < Интервалы.Количество() Цикл
			Интервал = Интервалы[ИндексИнтервала];
			ИндексИнтервала = ИндексИнтервала + 1;
			ОтДата = Формат(Интервал.Нач, "ДФ=yyyy-MM-dd") + "T" + Формат(Интервал.Нач, "ДФ=HH:mm:ss") + ".000Z";
			ДоДата = Формат(Интервал.Кон, "ДФ=yyyy-MM-dd") + "T" + Формат(Интервал.Кон, "ДФ=HH:mm:ss") + ".000Z";
			ИнтервалПереполнен = Ложь;
			ИсточникИнтервала = "";   // страницы интервала - одним источником (ПолучитьСписокОператора)
			Для Страница = 0 По 9 Цикл
				// Токен Keycloak живет 15 минут; перевыпуск - по времени, а не по числу запросов:
				// при таймаутах запросы растягиваются дольше жизни токена.
				Если ТекущаяУниверсальнаяДатаВМиллисекундах() - ТокенПолучен > 600000 Тогда
					ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
					Токен = ЭДО_Сервер.ТекущийТокен(Организация);
					ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
				КонецЕсли;
				Путь = ЭДО_Сервер.ПутьСервиса("document") + "/public/api/v3/documents?created_from=" + ОтДата + "&created_till=" + ДоДата
					+ "&sender_id=" + Гид + "&page=" + Страница + "&page_size=100";
				// Одиночный таймаут не должен убивать прогон: при аварии оператора виснет часть запросов,
				// остальные отвечают быстро. Попыток пять: три таймаута подряд на одной странице бывали.
				МассивКарточек = Неопределено;
				Для НомерПопытки = 1 По 5 Цикл
					ЗаголовкиПлатформы = Новый Соответствие;
					ЗаголовкиПлатформы.Вставить("Authorization", "Bearer " + Токен);
					ЗаголовкиПлатформы.Вставить("accept", "application/json;charset=UTF-8");
					Запросов = Запросов + 1;
					Попытка
						// цепочки с черновиками, /documents - резерв
						ОтветHTTP = ЭДО_Сервер.ПолучитьСписокОператора(Соед, Путь, ЗаголовкиПлатформы, Организация, Страница = 0,
							ИсточникИнтервала);
					Исключение
						ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , , "ВыполнитьСверкуСтатусов: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));   // не маскировать
						Таймаутов = Таймаутов + 1;
						Если НомерПопытки = 5 Тогда
							Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + " стр." + Страница + ": таймаут x5; ";
						КонецЕсли;
						Продолжить;
					КонецПопытки;
					Если ОтветHTTP.КодСостояния = 401 Тогда
						// токен протух между попытками - перевыпустить и повторить ЭТУ ЖЕ страницу,
						// иначе день молча выпадает из обхода целиком
						ЭДО_Сервер.ОбеспечитьТокен(Истина, Организация);
						Токен = ЭДО_Сервер.ТекущийТокен(Организация);
						ТокенПолучен = ТекущаяУниверсальнаяДатаВМиллисекундах();
						Если НомерПопытки = 5 Тогда
							Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + " стр." + Страница + ": 401 x5; ";
						КонецЕсли;
						Продолжить;
					КонецЕсли;
					Если ОтветHTTP.КодСостояния <> 200 Тогда
						Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + " стр." + Страница + ": HTTP " + ОтветHTTP.КодСостояния + "; ";
						Прервать;
					КонецЕсли;
					Если НЕ ОтветилОператор Тогда
						ОтветилОператор = Истина;
						ОтметитьУспешныйОбмен();   // успешный обмен - ответ оператора, а не свод без ошибки
					КонецЕсли;
					Если ОтветHTTP.ЧерезЦепочки Тогда
						ЧерезЦепочки = Истина;
						БезЧерновиков = БезЧерновиков ИЛИ НЕ ОтветHTTP.ЧерновикиПрочитаны;
					КонецЕсли;
					Чтение = Новый ЧтениеJSON;
					Чтение.УстановитьСтроку(ОтветHTTP.Тело);
					МассивКарточек = ПрочитатьJSON(Чтение, Ложь);
					Чтение.Закрыть();
					Прервать;
				КонецЦикла;
				Если МассивКарточек = Неопределено Тогда
					// страницу взять не удалось - день считаем неполным и идем дальше
					ВыдачаНеполная = Истина;
					Прервать;
				КонецЕсли;
				Для Каждого Карточка Из МассивКарточек Цикл
					ВсегоКарточек = ВсегоКарточек + 1;
					КлючКарт = "";
					РеквизитыКарт = ЭДО_Сервер.РеквизитыКарточкиОператора(Карточка);   // extra вместо invoice
					Если РеквизитыКарт <> Неопределено Тогда
						Если РеквизитыКарт.Свойство("num") И РеквизитыКарт.Свойство("date") Тогда
							КлючКарт = СокрЛП(Строка(РеквизитыКарт.num)) + "|" + СокрЛП(Строка(РеквизитыКарт.date));
						КонецЕсли;
					КонецЕсли;
					Если КлючКарт = "" Тогда
						Продолжить;
					КонецЕсли;
					Получатель = "";
					Если Карточка.Свойство("recipient") И Карточка.recipient <> Неопределено Тогда
						Получатель = Строка(Карточка.recipient.id);
					КонецЕсли;
					// живой экземпляр запоминаем ОТДЕЛЬНО от актуального: для колонки нужен
					// самый свежий статус, а для решения "можно ли слать заново" - есть ли
					// ХОТЯ БЫ ОДИН экземпляр в пути или у контрагента.
					// по итоговому состоянию (newStatus): аннулированный экземпляр не живой.
					СтатусЭкземпляра = ЭДО_Сервер.СтатусКарточкиОператора(Карточка);
					ЭтотЖивой = ЭкземплярЖивой(СтатусЭкземпляра);
					ЭтотУпал = (СтатусЭкземпляра = "SENDING_FAILED");
					НакопитьЭкземплярАктаСверки(ЭкземплярыАктов, Карточка, СтатусЭкземпляра, Получатель);
					Текущий = Экземпляры.Получить(КлючКарт);
					// Итоговые состояния (newStatus) с обеих сторон: Текущий.Статус хранит именно его, а по status
					// аннулированный принятый экземпляр перебил бы новую отправку.
					Если Текущий = Неопределено ИЛИ ЭкземплярАктуальнее(СтатусЭкземпляра, Строка(Карточка.created),
						Текущий.Статус, Текущий.Создан) Тогда
						БылЖивой = ?(Текущий = Неопределено, Ложь, Текущий.ЕстьЖивой);
						БылоПадений = ?(Текущий = Неопределено, 0, Текущий.Падений);
						Экземпляры.Вставить(КлючКарт, Новый Структура("Ид, Создан, Статус, Получатель, ЕстьЖивой, Падений",
							ИдентификаторСтрокой(Карточка.id), Строка(Карточка.created), СтатусЭкземпляра, Получатель,
							БылЖивой ИЛИ ЭтотЖивой, БылоПадений + ?(ЭтотУпал, 1, 0)));
					Иначе
						Если ЭтотЖивой Тогда
							Текущий.ЕстьЖивой = Истина;
						КонецЕсли;
						Если ЭтотУпал Тогда
							Текущий.Падений = Текущий.Падений + 1;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Если МассивКарточек.Количество() < 100 Тогда
					Прервать;
				КонецЕсли;
				Если Страница = 9 Тогда
					// последняя доступная страница пришла ПОЛНОЙ - выдача обрезана потолком
					ИнтервалПереполнен = Истина;
				КонецЕсли;
			КонецЦикла;
			Если ИнтервалПереполнен Тогда
				Длительность = Интервал.Кон - Интервал.Нач;
				Если Длительность <= 59 ИЛИ Интервалы.Количество() >= МаксИнтервалов Тогда
					// минута с 1000+ карточек либо разросшаяся очередь - дальше не дробим, но пишем в свод
					Ошибки = Ошибки + Формат(Интервал.Нач, "ДФ=dd.MM HH:mm") + "–"
						+ Формат(Интервал.Кон, "ДФ=HH:mm") + ": выдача обрезана потолком; ";
					ВыдачаНеполная = Истина;
				Иначе
					Середина = Интервал.Нач + Цел(Длительность / 2);
					Интервалы.Добавить(Новый Структура("Нач, Кон", Интервал.Нач, Середина));
					Интервалы.Добавить(Новый Структура("Нач, Кон", Середина + 1, Интервал.Кон));
					Разбиений = Разбиений + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		// -- 4. Запись статуса --------------------------------------------------------------------
		Обновлено = 0;
		Записано = 0;
		БезПары = 0;
		Сброшено = 0;
		КандидатыОтказа = Новый Массив;   // REJECTED - решает человек, автосброса нет (см. блок 5)
		Проблемные = Новый Массив;
		СтрокиОтказов = Новый Соответствие;
		Для Каждого Пара Из Экземпляры Цикл
			ДанныеБазы = КартаБазы.Получить(Пара.Ключ);
			Если ДанныеБазы = Неопределено Тогда
				БезПары = БезПары + 1;
				Продолжить;
			КонецЕсли;
			СтатусAPI = Пара.Значение.Статус;
			НовыйСтатус = КартаСтатусов.Получить(СтатусAPI);
			Если НовыйСтатус = Неопределено Тогда
				НовыйСтатус = СтатусAPI;   // незнакомый статус показываем как есть, а не прячем
			КонецЕсли;
			// черновик NEW старше часа - не «Отправляется», а неподписанный.
			НовыйСтатус = ЭДО_Сервер.ТекстКолонкиЧерновика(НовыйСтатус, СтатусAPI, Пара.Значение.Создан);
			НовыйСтатус = Лев(НовыйСтатус, 50);   // ресурс Значение - Строка(50), как у СБИС
			НовыйСтатус = ЭДО_Сервер.ТекстКолонкиСУчетомЗапросаАннулирования(ДанныеБазы.Ссылка,
				НовыйСтатус, ЗапросыАннулирования, ОтклоненныеАннулирования, Пара.Значение.Ид);
			// Блок 5 (сброс отметки) идет и тогда, когда текст статуса не изменился: документ мог
			// со вчера висеть в "Ошибка: не отправлен", а вернуть в очередь его все равно надо.
			// Писатели колонки разделены: ядро (ОбновитьПричиныНеотправки) ведет документы без карточки
			// у оператора и считает своими только тексты причин, сверка - документы с карточкой.
			Если НовыйСтатус <> ДанныеБазы.ТекущийСтатус Тогда
				Обновлено = Обновлено + 1;
				// "Отправка не требуется" не трогаем никогда: этот текст служит фильтром отбора
				// очереди, и его перезапись вернула бы документ в отправку.
				Если ДанныеБазы.ТекущийСтатус <> ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется() Тогда
					Попытка
						ЭДО_Сервер.ЗаписатьЧитаемыйСтатус(ДанныеБазы.Ссылка, НовыйСтатус);
						Записано = Записано + 1;
					Исключение
						Если Проблемные.Количество() < ПоказатьМакс Тогда
							Проблемные.Добавить("ОШИБКА: не записан статус " + Пара.Ключ + ": "
								+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
						КонецЕсли;
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;

			// -- 5. Сброс отметки отправки у документов, до контрагента НЕ дошедших --------------
			// Пока ЭДО_КодСостояния = 40, документ не переотправить ничем, кроме правки регистра.
			Если СвойствоОтправки <> Неопределено И НЕ СвойствоОтправки.Пустая()
				И СокрЛП(ДанныеБазы.ОтметкаОтправки) = "40"
				И НЕ Пара.Значение.ЕстьЖивой
				И НЕ БезЧерновиков   // черновики не прочитаны - живой NEW не виден
				И НЕ ВыдачаНеполная Тогда   // выдача интервала неполная

				Если СтатусAPI = "SENDING_FAILED" Тогда
					// решение и снятие отметок - ВернутьУпавшийВОчередь (то же зовет точечная по ленте);
					// смена адреса после падения (ЭДО Лайт) - внутри нее.
					Возврат5 = ВернутьУпавшийВОчередь(ДанныеБазы.Ссылка, Пара.Значение, НерабочиеПрефиксы, ПорогСвежестиДней,
						СвойствоОтправки, СвойствоИдПлатформы);
					Если Возврат5 = "" ИЛИ Возврат5 = "занят" Тогда
						Продолжить;   // молча: закрытый канал или документ уже вернули и отправили заново
					ИначеЕсли НЕ СтрНачинаетсяС(Возврат5, "сброшен") Тогда
						Если КандидатыОтказа.Количество() < ПоказатьМакс Тогда
							КандидатыОтказа.Добавить(СтрЗаменить(Возврат5, "не возвращён", "не возвращён в очередь") + ": " + Пара.Ключ);
						КонецЕсли;
						Продолжить;
					КонецЕсли;
					Сброшено = Сброшено + 1;
					Если Проблемные.Количество() < ПоказатьМакс Тогда
						Проблемные.Добавить("возвращён в очередь: " + Пара.Ключ + " (был ид " + Пара.Значение.Ид + ")"
							+ Сред(Возврат5, СтрДлина("сброшен") + 1));
					КонецЕсли;

				ИначеЕсли СтатусAPI = "REJECTED" Тогда
					// Отказ контрагента автоматически не сбрасываем: то же самое он отклонит снова, а признака
					// "документ исправлен" у реализации нет (сверка суммы с invoice.sum не годится - маппинг
					// округляет количество и сам расходится с базой). Только список в журнал, решает человек.
					Если КандидатыОтказа.Количество() < ПоказатьМакс Тогда
						КандидатыОтказа.Добавить(Пара.Ключ + " (ид " + Пара.Значение.Ид + ")");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			Если НовыйСтатус = ДанныеБазы.ТекущийСтатус Тогда
				Продолжить;   // текст колонки не менялся - в списки проблемных не добавляем
			КонецЕсли;
			Если СтатусAPI = "REJECTED" ИЛИ СтатусAPI = "SENDING_FAILED" Тогда
				Если Проблемные.Количество() < ПоказатьМакс Тогда
					Проблемные.Добавить(Пара.Ключ + " -> " + СтатусAPI + " (ид " + Пара.Значение.Ид + ")");
					СтрокиОтказов.Вставить(Пара.Значение.Ид, Проблемные.ВГраница());
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ДописатьПричиныОтказов(Проблемные, СтрокиОтказов, Организация);

		// -- 6. Акты сверки -------------------------------------------------------------------------
		// Своя попытка: сбой ветки актов не должен отменять свод по реализациям.
		ИтогАктов = Неопределено;
		Попытка
			КонтекстАктов = Новый Структура("Организация, Граница, КартаСтатусов, ЗапросыАннулирования, "
				+ "ОтклоненныеАннулирования, ПоказатьМакс", Организация, ГраницаДок - 366 * 86400, КартаСтатусов,
				ЗапросыАннулирования, ОтклоненныеАннулирования, ПоказатьМакс);
			ИтогАктов = СверитьСтатусыАктовСверки(ЭкземплярыАктов, КонтекстАктов);
		Исключение
			Ошибки = Ошибки + "акты сверки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "; ";
		КонецПопытки;

		Свод = "PEDO-StatusSync: окно " + ГлубинаДней + " дн., интервалов " + Интервалы.Количество()
			+ " (разбиений " + Разбиений + "), запросов " + Запросов
			+ ", карточек " + ВсегоКарточек + ", документов " + Экземпляры.Количество()
			+ ", расхождений с колонкой " + Обновлено + " (записано " + Записано + ")"
			+ ", сброшено отметок " + Сброшено
			+ ", без пары в базе " + БезПары + ", таймаутов " + Таймаутов
			+ ?(ЧерезЦепочки, " (document-flows" + ?(БезЧерновиков, "; черновики не прочитаны - отметки отправки не сбрасывались", "")
				+ ")", " (резерв /documents)")
			+ ?(ВыдачаНеполная, " (выдача неполная - отметки отправки не сбрасывались)", "");
		Если ИтогАктов <> Неопределено Тогда
			Свод = Свод + "; акты сверки: номеров у оператора " + ЭкземплярыАктов.Количество()
				+ ", сверено " + ИтогАктов.Сверено + ", колонка записана " + ИтогАктов.Записано
				+ ", ид пересажен " + ИтогАктов.Пересажено + ", отметка 40 восстановлена " + ИтогАктов.Отмечено
				+ ", записанный экземпляр вне окна " + ИтогАктов.ВнеОкна;
			Для Каждого Строчка Из ИтогАктов.Изменения Цикл
				Проблемные.Добавить(Строчка);
			КонецЦикла;
		КонецЕсли;
		Если Ошибки <> "" Тогда
			Свод = Свод + " | ОШИБКИ: " + Ошибки;
		КонецЕсли;
		Для Каждого Строчка Из Проблемные Цикл
			Свод = Свод + Символы.ПС + "  " + Строчка;
		КонецЦикла;
		Если КандидатыОтказа.Количество() > 0 Тогда
			Свод = Свод + Символы.ПС + "  отказ контрагента, ждут решения человека:";
			Для Каждого Строчка Из КандидатыОтказа Цикл
				Свод = Свод + Символы.ПС + "    " + Строчка;
			КонецЦикла;
		КонецЕсли;
		Результат = Свод;
	Исключение
		Результат = "PEDO-StatusSync ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = ?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + Результат;
	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, ЕстьОшибкаВСводе(Результат),
		"ЭДО.Регламент.СверкаСтатусов");

	// Фиксация пива в ГИС МТ - отдельная часть сверки: ее сбой не должен портить основной свод,
	// поэтому свой журнал и своя Попытка.
	Попытка
		СводГИСМТ = ЭДО_Сервер.ОбновитьСтатусыФиксацииГИСМТ(Организация);
		ЗаписатьВЖурнал(?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + СводГИСМТ, Ложь,
			"ЭДО.Регламент.ФиксацияГИСМТ");
	Исключение
		ЗаписатьВЖурнал("ГИС МТ, фиксация: сбой обновления: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Истина, "ЭДО.Регламент.ФиксацияГИСМТ");
	КонецПопытки;

	// обработка подписанных УПД без фиксации и УКД в ЧЗ - отдельная часть сверки
	// со своим журналом: сбой не портит основной свод, но пишется полностью.
	Попытка
		СводЧЗ = ЭДО_Сервер.ОбновитьОбработкуВЧЗ(Организация);
		ЗаписатьВЖурнал(?(Организация = Неопределено, "", "[" + Строка(Организация) + "] ") + СводЧЗ,
			СтрНайти(СводЧЗ, "ОШИБКА") > 0, "ЭДО.Регламент.ОбработкаЧЗ");
	Исключение
		ЗаписатьВЖурнал("ЧЗ, обработка документов: сбой: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Истина, "ЭДО.Регламент.ОбработкаЧЗ");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Сложить карточку акта сверки (формализованного или PDF) в накопитель по номеру. Ключ второго
// уровня - ид: переполненный интервал обходится заново половинами, и карточки приходят повторно.
Процедура НакопитьЭкземплярАктаСверки(ЭкземплярыАктов, Знач Карточка, Знач СтатусЭкземпляра, Знач Получатель)

	ТипКарточки = "";
	Если Карточка.Свойство("type") И Карточка.type <> Неопределено Тогда
		ТипКарточки = ВРег(СокрЛП(Строка(Карточка.type)));
	КонецЕсли;
	Если ТипКарточки <> "ON_AKTSVEROTP" И ТипКарточки <> "UNFORMALIZED" Тогда
		Возврат;
	КонецЕсли;

	НомерАкта = ВРег(СокрЛП(Строка(Карточка.invoice.num)));
	ЭкземплярыНомера = ЭкземплярыАктов.Получить(НомерАкта);
	Если ЭкземплярыНомера = Неопределено Тогда
		ЭкземплярыНомера = Новый Соответствие;
		ЭкземплярыАктов.Вставить(НомерАкта, ЭкземплярыНомера);
	КонецЕсли;
	ИдКарточки = ИдентификаторСтрокой(Карточка.id);
	ЭкземплярыНомера.Вставить(ИдКарточки, Новый Структура("Ид, Создан, Статус, Получатель",
		ИдКарточки, Строка(Карточка.created), СтатусЭкземпляра, СокрЛП(Получатель)));

КонецПроцедуры

// Колонка "ЭДО", записанный ид и отметка отправки актов сверки по карточкам полного обхода.
// Акт сопоставляется по номеру без даты: у формализованного акта в карточке дата формирования
// файла. Экземпляры берутся только того же получателя - адреса записанного экземпляра или текущего
// адреса контрагента. Записанного экземпляра в окне обхода нет - акт пропускается: выбор из одних
// дублей увел бы ид с подписанного экземпляра.
// Контекст - Структура (Организация, Граница, КартаСтатусов, ЗапросыАннулирования,
// ОтклоненныеАннулирования, ПоказатьМакс).
// Возврат: Структура (Сверено, Записано, Пересажено, Отмечено, ВнеОкна, Изменения - Массив строк свода).
Функция СверитьСтатусыАктовСверки(Знач ЭкземплярыАктов, Знач Контекст)

	Итог = Новый Структура("Сверено, Записано, Пересажено, Отмечено, ВнеОкна, Изменения",
		0, 0, 0, 0, 0, Новый Массив);
	СвойствоИд = ЭДО_Сервер.СвойствоОбъектов("ЭДО_ИдентификаторДокумента");
	Если ЭкземплярыАктов.Количество() = 0 ИЛИ СвойствоИд.Пустая() Тогда
		Возврат Итог;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Акт.Ссылка КАК Ссылка,
		|	Акт.Номер КАК Номер,
		|	ВЫРАЗИТЬ(Ид.Значение КАК СТРОКА(50)) КАК ИдЭДО,
		|	ЕСТЬNULL(Статусы.Значение, """") КАК ТекущийСтатус,
		|	ЕСТЬNULL(Отправки.Значение, """") КАК ОтметкаОтправки,
		|	ЕСТЬNULL(Адреса.Значение, """") КАК АдресКонтрагента
		|ИЗ
		|	Документ.АктСверкиВзаиморасчетов КАК Акт
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Ид
		|		ПО Ид.Объект = Акт.Ссылка
		|			И Ид.Свойство = &СвойствоИд
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Статусы
		|		ПО Статусы.Объект = Акт.Ссылка
		|			И Статусы.Свойство = &СвойствоСтатус
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Отправки
		|		ПО Отправки.Объект = Акт.Ссылка
		|			И Отправки.Свойство = &СвойствоОтправки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК Адреса
		|		ПО Адреса.Объект = Акт.Контрагент
		|			И Адреса.Свойство = &СвойствоАдреса
		|ГДЕ
		|	Акт.Дата >= &Граница
		|	И (&ВсеОрганизации ИЛИ Акт.Организация.ИНН = &ИННОрганизации)");
	Запрос.УстановитьПараметр("СвойствоИд", СвойствоИд);
	Запрос.УстановитьПараметр("СвойствоСтатус", ЭДО_Сервер.СвойствоОбъектов("ЭДО_Состояние"));
	Запрос.УстановитьПараметр("СвойствоОтправки", ЭДО_Сервер.СвойствоОбъектов("ЭДО_КодСостояния"));
	Запрос.УстановитьПараметр("СвойствоАдреса", ЭДО_Сервер.СвойствоОбъектов("ЭДО_АдресКонтрагента"));
	Запрос.УстановитьПараметр("Граница", Контекст.Граница);
	Запрос.УстановитьПараметр("ВсеОрганизации", Контекст.Организация = Неопределено);
	Запрос.УстановитьПараметр("ИННОрганизации", ?(Контекст.Организация = Неопределено, "",
		СокрЛП(Контекст.Организация.ИНН)));
	ОтметкаХранится = НЕ ЭДО_Сервер.СвойствоОбъектов("ЭДО_КодСостояния").Пустая();
	ТекстНеТребуется = ЭДО_Сервер.ТекстСтатусаОтправкаНеТребуется();
	ОтказыОтправки = Новый Массив;

	Для Каждого СтрокаАкта Из Запрос.Выполнить().Выгрузить() Цикл
		ЭкземплярыНомера = ЭкземплярыАктов.Получить(ВРег(СокрЛП(СтрокаАкта.Номер)));
		ИдЗаписанного = СокрЛП(Строка(СтрокаАкта.ИдЭДО));
		Если ЭкземплярыНомера = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ИдЗаписанного) Тогда
			Продолжить;
		КонецЕсли;
		Записанный = ЭкземплярыНомера.Получить(ИдЗаписанного);
		Если Записанный = Неопределено Тогда
			Итог.ВнеОкна = Итог.ВнеОкна + 1;
			Продолжить;
		КонецЕсли;
		Итог.Сверено = Итог.Сверено + 1;

		АдресЗаписанного = ВРег(Записанный.Получатель);
		ТекущийАдрес = ВРег(СокрЛП(Строка(СтрокаАкта.АдресКонтрагента)));
		Выбранный = Записанный;
		Для Каждого ПараЭкземпляра Из ЭкземплярыНомера Цикл
			Экземпляр = ПараЭкземпляра.Значение;
			АдресЭкземпляра = ВРег(Экземпляр.Получатель);
			Если АдресЭкземпляра <> АдресЗаписанного
				И (НЕ ЗначениеЗаполнено(ТекущийАдрес) ИЛИ АдресЭкземпляра <> ТекущийАдрес) Тогда
				Продолжить;   // тот же номер у акта другого контрагента
			КонецЕсли;
			Если ЭкземплярПредпочтительнее(Экземпляр.Статус, Экземпляр.Создан, Выбранный.Статус, Выбранный.Создан) Тогда
				Выбранный = Экземпляр;
			КонецЕсли;
		КонецЦикла;

		НомерАкта = СокрЛП(СтрокаАкта.Номер);
		Попытка
			Показываемый = Записанный;
			Если ПересадитьИдНаЭкземпляр(ИдЗаписанного, Записанный.Статус, Выбранный.Ид, Выбранный.Статус) Тогда
				ЭДО_Сервер.ЗакрепитьЭкземплярДокумента(СтрокаАкта.Ссылка, Выбранный.Ид,
					ИдЗаписанного + " (" + Записанный.Статус + ")", "сверка статусов");
				Показываемый = Выбранный;
				Итог.Пересажено = Итог.Пересажено + 1;
				ДобавитьСтрокуСвода(Итог.Изменения, НомерАкта + ": ид " + ИдЗаписанного + " (" + Записанный.Статус
					+ ") -> " + Выбранный.Ид + " (" + Выбранный.Статус + ")", Контекст.ПоказатьМакс);
			КонецЕсли;

			// Отметку отправки снимает ручная переотправка; без нее акт с действующим экземпляром
			// выглядит для отправки неотправленным.
			Отметка = СокрЛП(Строка(СтрокаАкта.ОтметкаОтправки));
			УшелКонтрагенту = РангЭкземпляра(Показываемый.Статус) > 1 И Показываемый.Статус <> "NEW"
				И Лев(Показываемый.Статус, 6) <> "AWAIT_";
			Если ОтметкаХранится И (Отметка = "" ИЛИ Отметка = "20") И УшелКонтрагенту Тогда
				ЭДО_Сервер.ЗаписатьСтатусЭДО(СтрокаАкта.Ссылка, 40, "");
				Итог.Отмечено = Итог.Отмечено + 1;
			КонецЕсли;

			ТекстСтатуса = Контекст.КартаСтатусов.Получить(Показываемый.Статус);
			Если ТекстСтатуса = Неопределено Тогда
				ТекстСтатуса = Показываемый.Статус;   // незнакомый статус показываем как есть
			КонецЕсли;
			ТекстСтатуса = ЭДО_Сервер.ТекстКолонкиСУчетомЗапросаАннулирования(СтрокаАкта.Ссылка,
				Лев(ТекстСтатуса, 50), Контекст.ЗапросыАннулирования, Контекст.ОтклоненныеАннулирования,
				Показываемый.Ид);
			ТекущийСтатус = СокрЛП(Строка(СтрокаАкта.ТекущийСтатус));
			ТекстСтатуса = ЭДО_Сервер.ТекстКолонкиСУчетомПричиныОтказа(ТекстСтатуса, ТекущийСтатус);
			// Подписанный акт неподписанным не становится: записан может быть дубль, а подписанный
			// экземпляр - старше окна обхода.
			ПонижениеПодписанного = ЭДО_Сервер.ПодписанПоТекстуКолонки(ТекущийСтатус)
				И РангЭкземпляра(Показываемый.Статус) = 2 И Показываемый.Статус <> "CANCELLATION_REQUESTED";
			ОтказОтправки = (ТекстСтатуса = ЭДО_Сервер.ТекстОшибкаОтправкиУОператора());
			Если ОтказОтправки И ТекущийСтатус <> ТекстНеТребуется И НЕ ПонижениеПодписанного Тогда
				// Текст колонки зависит от причины отказа, а она в цепочке документа: спросим пачкой после обхода.
				ОтказыОтправки.Добавить(Новый Структура("Ссылка, Ид, Номер, ТекущийСтатус, ТекстСтатуса",
					СтрокаАкта.Ссылка, Показываемый.Ид, НомерАкта, ТекущийСтатус, ТекстСтатуса));
			ИначеЕсли ТекстСтатуса <> ТекущийСтатус И ТекущийСтатус <> ТекстНеТребуется
				И НЕ ПонижениеПодписанного Тогда
				ЭДО_Сервер.ЗаписатьЧитаемыйСтатус(СтрокаАкта.Ссылка, ТекстСтатуса);
				Итог.Записано = Итог.Записано + 1;
				ДобавитьСтрокуСвода(Итог.Изменения, НомерАкта + ": " + ?(ЗначениеЗаполнено(ТекущийСтатус),
					ТекущийСтатус, "(пусто)") + " -> " + ТекстСтатуса, Контекст.ПоказатьМакс);
			КонецЕсли;
		Исключение
			ДобавитьСтрокуСвода(Итог.Изменения, "ОШИБКА: акт " + НомерАкта + " не записан: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Контекст.ПоказатьМакс);
		КонецПопытки;
	КонецЦикла;

	ЗаписатьКолонкуАктовСОтказомОтправки(ОтказыОтправки, Контекст, Итог);

	Возврат Итог;

КонецФункции

// Колонка актов, которые оператор не отправил (SENDING_FAILED): по причине из цепочки документа -
// отдельный текст, когда получатель не принимает акты сверки, иначе общий текст ошибки отправки.
// Причину не получили - пишется общий текст, как до уточнения.
Процедура ЗаписатьКолонкуАктовСОтказомОтправки(Знач ОтказыОтправки, Знач Контекст, Итог)

	Если ОтказыОтправки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Для Каждого Отказ Из ОтказыОтправки Цикл
		Идентификаторы.Добавить(Отказ.Ид);
	КонецЦикла;
	Попытка
		Причины = ЭДО_Сервер.ПричиныОтказаПоИдентификаторам(Идентификаторы, Контекст.Организация);
	Исключение
		Причины = Новый Соответствие;
	КонецПопытки;

	Для Каждого Отказ Из ОтказыОтправки Цикл
		Причина = Причины.Получить(Отказ.Ид);
		ТекстСтатуса = ЭДО_Сервер.ТекстКолонкиСУчетомПричиныОтказа(Отказ.ТекстСтатуса, Отказ.ТекущийСтатус, Причина);
		Если ТекстСтатуса = Отказ.ТекущийСтатус Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЭДО_Сервер.ЗаписатьЧитаемыйСтатус(Отказ.Ссылка, ТекстСтатуса);
			Итог.Записано = Итог.Записано + 1;
			ДобавитьСтрокуСвода(Итог.Изменения, Отказ.Номер + ": " + ?(ЗначениеЗаполнено(Отказ.ТекущийСтатус),
				Отказ.ТекущийСтатус, "(пусто)") + " -> " + ТекстСтатуса
				+ ?(ЗначениеЗаполнено(Причина), ": " + Лев(СтрЗаменить(Причина, Символы.ПС, " "), 200), ""),
				Контекст.ПоказатьМакс);
		Исключение
			ДобавитьСтрокуСвода(Итог.Изменения, "ОШИБКА: акт " + Отказ.Номер + " не записан: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Контекст.ПоказатьМакс);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтрокуСвода(Строки, Знач Текст, Знач Потолок)

	Если Строки.Количество() < Потолок Тогда
		Строки.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

// Обновление связей ЭДО: адреса контрагентов и статусы приглашений.
Функция ВыполнитьОбновлениеСвязей() Экспорт

	Попытка
		Результат = ЭДО_Сервер.ОбновитьСвязиЭДО(0);
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.ОбновлениеСвязей");
	Возврат Результат;

КонецФункции

// Приглашения к обмену контрагентам, которым есть что отправить, а адреса ЭДО нет.
Функция ВыполнитьПриглашенияНовымКонтрагентам() Экспорт

	Попытка
		Результат = ЭДО_Сервер.ПригласитьНовыхКонтрагентов();
	Исключение
		Результат = "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	ЭДО_Регламенты.ЗаписатьВЖурнал(Результат, СтрНайти(ВРег(Строка(Результат)), "ОШИБКА") > 0,
		"ЭДО.Регламент.ПриглашенияНовымКонтрагентам");
	Возврат Результат;

КонецФункции
