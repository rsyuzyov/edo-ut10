// Входящие документы оператора Платформа ЭДО. Модуль каждого оператора входящих дает один набор функций:
// ВходящиеЗаПериод(Ящики, Начало, Конец, НомерДокумента, Состояния) - Массив строк входящих;
// СодержимоеВходящего(Ид, Организация) - XML титула продавца;
// СодержимоеВходящегоДоСрока(Ид, Организация, Срок) - XML титула продавца с общим сроком или Неопределено;
// СтатусВходящего(Ид, Организация) - код статуса у оператора или Неопределено;
// ПечатнаяФормаВходящего(Ид, Организация) - Структура (Успех, Данные, Текст).
// Ид - идентификатор у оператора без префикса; поля Оператор и Ключ строки дописывает ЭДО_Сервер.

#Область ПрограммныйИнтерфейс

// Входящие УПД и УКД за период по ящикам Платформы (ящик - учетная запись организации).
// Берутся карточки титула продавца, где покупатель - организация ящика; выдача отбирается по получателю
// (recipient_id), окно до 30 дней (оператор принимает не больше 31), при 1000 карточках в окне оно делится.
// НомерДокумента - только входящие с этим номером, одним окном на весь период.
// Ящики - Массив Структура (Оператор, Организация, Представление).
// Состояния - Массив, в него по каждому опрошенному ящику: Структура (Оператор, Организация, Ошибка, Документов).
// Ошибка ящика не обрывает обход остальных.
// Возврат: Массив Структура (Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Статус, Функция,
// Организация, Документ, ЭтоУКД, Вид, Версия, ГидПродавца).
Функция ВходящиеЗаПериод(Знач Ящики, Знач Начало, Знач Конец, Знач НомерДокумента, Состояния) Экспорт

	Итог = Новый Массив;
	ОбщийЯщик = ВРег(СокрЛП(Строка(ЭДО_Сервер.НастройкаЭДО("ОбщийЯщикВходящих")))) = "ДА";

	// у организаций базы бывает общий ящик оператора: выдача по любой учетной записи содержит карточки всех.
	// Если это подтверждено настройкой ОбщийЯщикВходящих, список берется один раз и раздается по ИНН
	// покупателя; без настройки каждая запись опрашивается сама. Карточки организаций с одним ИНН
	// (разные КПП) раздаются только своему запросу.
	ОрганизацииПоИНН = Новый Соответствие;   // ИНН -> Массив организаций базы
	Для Каждого Ящик Из Ящики Цикл
		ИНН = СокрЛП(Ящик.Организация.ИНН);
		Кандидаты = ОрганизацииПоИНН.Получить(ИНН);
		Если Кандидаты = Неопределено Тогда
			Кандидаты = Новый Массив;
			ОрганизацииПоИНН.Вставить(ИНН, Кандидаты);
		КонецЕсли;
		Если Кандидаты.Найти(Ящик.Организация) = Неопределено Тогда
			Кандидаты.Добавить(Ящик.Организация);
		КонецЕсли;
	КонецЦикла;

	Пройдены = Новый Соответствие;
	Видимые = Новый Соответствие;   // Ид карточки и организация -> Истина: без повторов из общего ящика
	Покрытые = Новый Соответствие;   // ИНН организаций (единственных с этим ИНН), чьи карточки пришли полностью
	Для Каждого Ящик Из Ящики Цикл
		Если Пройдены.Получить(Ящик.Организация) <> Неопределено
			ИЛИ Покрытые.Получить(СокрЛП(Ящик.Организация.ИНН)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Пройдены.Вставить(Ящик.Организация, Истина);
		Состояние = Новый Структура("Оператор, Организация, Ошибка, Документов", Ящик.Оператор, Ящик.Организация, "", 0);
		БылоСтрок = Итог.Количество();
		// Перехват обоснован: недоступный ящик одной организации не должен оставлять без списка остальные.
		Попытка
			ДобавитьВходящиеЗаПериод(Итог, Начало, Конец, Ящик.Организация, ОрганизацииПоИНН, Видимые, Покрытые, ОбщийЯщик,
				НомерДокумента);
		Исключение
			Состояние.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Состояние.Документов = Итог.Количество() - БылоСтрок;
		Состояния.Добавить(Состояние);
	КонецЦикла;

	Возврат Итог;

КонецФункции

// XML титула продавца входящего документа. Ошибка оператора - исключение.
Функция СодержимоеВходящего(Знач Ид, Знач Организация) Экспорт

	Ответ = ЭДО_Сервер.ПрочитатьУОператораЭДО("/public/api/v3/documents/" + Ид + "/content", Организация);
	Если Ответ.Код <> 200 Тогда
		ВызватьИсключение "XML входящего документа не получен, HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 200);
	КонецЕсли;
	Возврат Ответ.Данные;

КонецФункции

// XML титула продавца с общим сроком - для сумм списка входящих, которых ждет форма.
// Неопределено - нет токена, срок вышел или ответ не 200: суммы придут при следующем обновлении.
Функция СодержимоеВходящегоДоСрока(Знач Ид, Знач Организация, Знач Срок) Экспорт

	Ответ = ЭДО_Сервер.ПрочитатьУОператораЭДОДоСрока("/public/api/v3/documents/" + Ид + "/content", Организация, Срок);
	Если Ответ = Неопределено Тогда
		Возврат Неопределено;   // причина уже в журнале
	КонецЕсли;
	Если Ответ.Код <> 200 Тогда
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Сумма входящего " + Ид + ": HTTP " + Ответ.Код + ?(Ответ.Код = 401,
				" - сохраненный токен устарел; здесь он не обновляется (общий срок), его обновит ближайший"
				+ " обычный запрос к оператору", ""));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ответ.Данные;

КонецФункции

// Статус входящего у оператора сейчас. Неопределено - не прочитан.
Функция СтатусВходящего(Знач Ид, Знач Организация) Экспорт

	Карточка = ЭДО_Сервер.КарточкаОператораПоИд(Ид, Организация);
	Возврат ?(Карточка.Найдена, Карточка.Статус, Неопределено);

КонецФункции

// Печатная форма входящего у оператора: PDF с отметками ЭДО. Оператор не ответил или ответил ошибкой -
// Успех = Ложь и текст для пользователя; подробности - в ЖР «ЭДО.Входящие».
// Возврат: Структура (Успех, Данные - ДвоичныеДанные, Текст).
Функция ПечатнаяФормаВходящего(Знач Ид, Знач Организация) Экспорт

	Итог = Новый Структура("Успех, Данные, Текст", Ложь, Неопределено, "");
	// Перехват обоснован: оператор не отвечает (таймаут, сбой сервиса) - для пользователя это штатное
	// сообщение в карточке, а не ошибка программы; полный текст - в ЖР.
	Попытка
		Ответ = ЭДО_Сервер.ПрочитатьУОператораЭДО("/public/api/v4/documents/" + СокрЛП(Ид) + "/watermarked-content",
			Организация, "*/*");
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Печатная форма входящего " + Ид + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Итог.Текст = "Загрузка печатной формы не удалась: оператор не ответил ("
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "). Попробуйте позже.";
		Возврат Итог;
	КонецПопытки;
	Если Ответ.Код <> 200 ИЛИ Ответ.Данные = Неопределено ИЛИ Ответ.Данные.Размер() = 0 Тогда
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Печатная форма входящего " + Ид + ": HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 500));
		Итог.Текст = "Загрузка печатной формы не удалась: оператор ответил HTTP " + Ответ.Код
			+ ?(ЗначениеЗаполнено(Ответ.Текст), " " + Лев(Ответ.Текст, 200), "") + ".";
		Возврат Итог;
	КонецЕсли;
	Итог.Успех = Истина;
	Итог.Данные = Ответ.Данные;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ОрганизацииПоИНН - организации базы, между которыми раздаются карточки общего ящика (ИНН -> Массив);
// Видимые - уже добавленные карточки (Ид и организация); Покрытые - ИНН организаций, чьи карточки
// пришли в полностью прочитанной выдаче: дополняется только после чтения всего периода без ошибки.
// ОбщийЯщик - Ложь: карточки других организаций не берутся и Покрытые не пополняется.
Процедура ДобавитьВходящиеЗаПериод(Итог, Знач Начало, Знач Конец, Знач Организация, Знач ОрганизацииПоИНН,
	Видимые, Покрытые, Знач ОбщийЯщик, Знач НомерДокумента = "")

	ПокрытыеЗдесь = Новый Соответствие;
	ИННОрганизации = СокрЛП(Организация.ИНН);
	// ящик оператора бывает общим для нескольких организаций: без отбора по получателю выдача несет
	// чужие карточки, упирается в потолок 1000 и срезает свои. С recipient_id приходят только свои,
	// и окно можно брать до 30 дней. Без идентификатора организации у оператора - окно в сутки без отбора.
	ГидПолучателя = СокрЛП(ЭДО_Сервер.ГидОрганизации(Организация));
	ОтборПолучателя = ?(ЗначениеЗаполнено(ГидПолучателя), "&recipient_id=" + ГидПолучателя, "");
	ДлинаОкна = ?(ЗначениеЗаполнено(ОтборПолучателя), 30, 1) * 86400;
	// поиск по номеру - одним окном на весь период: выдача по номеру мала, а окна по 30 дней
	// на каждый тип списка и организацию делали бы поиск из поля «Документ №» многосекундным.
	ОтборНомера = "";
	Если ЗначениеЗаполнено(НомерДокумента) И ЗначениеЗаполнено(ОтборПолучателя) Тогда
		ОтборНомера = "&doc_num=" + КодироватьСтроку(СокрЛП(НомерДокумента), СпособКодированияСтроки.КодировкаURL);
		ДлинаОкна = НачалоДня(Конец) + 86400 - НачалоДня(Начало);
	КонецЕсли;

	// кроме УПД - и корректировки (УКД), у них свой тип списка.
	ДлинаОкнаТипа = ДлинаОкна;
	Для Каждого ТипСписка Из СтрРазделить("NEW_SELLER_TITLE,NEW_COR_SELLER_TITLE", ",") Цикл
		ЭтоУКД = (ТипСписка = "NEW_COR_SELLER_TITLE");
		ДлинаОкна = ДлинаОкнаТипа;
		Граница = НачалоДня(Конец) + 86400;
		Пока Граница > НачалоДня(Начало) Цикл
			НачалоОкна = Макс(НачалоДня(Начало), Граница - ДлинаОкна);
			// оператор отдает не больше 1000 карточек на запрос (страница 10 при размере 100 - ответ 400).
			// Десять полных страниц - окно переполнено: делим его и читаем заново, повторы отсекает Видимые.
			Переполнено = Ложь;
			ИсточникОкна = "";   // страницы окна - одним источником (ПолучитьСписокОператора)
			Для Страница = 0 По 9 Цикл
				Путь = "/public/api/v3/documents?type=" + ТипСписка
					+ "&created_from=" + Формат(НачалоОкна, "ДФ=yyyy-MM-ddTHH:mm:ss.000Z")
					+ "&created_till=" + Формат(Граница, "ДФ=yyyy-MM-ddTHH:mm:ss.000Z")
					+ ОтборПолучателя + ОтборНомера
					+ "&page=" + Формат(Страница, "ЧН=0; ЧГ=0") + "&page_size=100";
				Ответ = ЭДО_Сервер.ПолучитьСписокОператора(Неопределено, Путь, , Организация, , ИсточникОкна);
				Если Ответ.Код <> 200 Тогда
					ВызватьИсключение Строка(Организация) + ": список входящих не получен, HTTP " + Ответ.Код + " "
						+ Лев(Ответ.Текст, 200);
				КонецЕсли;
				Карточки = ЭДО_Сервер.ПрочитатьОтветJSON(Ответ.Текст);
				// не массив - неверный ответ, а не конец выдачи: иначе неполный список засчитался бы
				// прочитанным и другие учетные записи не опросились бы.
				Если ТипЗнч(Карточки) <> Тип("Массив") Тогда
					ВызватьИсключение Строка(Организация) + ": неверный ответ оператора на список входящих - "
						+ Лев(Ответ.Текст, 200);
				КонецЕсли;
				Для Каждого Карточка Из Карточки Цикл
					Входящий = ВходящийИзКарточки(Карточка, Организация, ОрганизацииПоИНН, ОбщийЯщик, ЭтоУКД,
						ПокрытыеЗдесь);
					Если Входящий = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					КлючКарточки = Входящий.Ид + "|" + XMLСтрока(Входящий.Организация);
					Если Видимые.Получить(КлючКарточки) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Видимые.Вставить(КлючКарточки, Истина);
					// номер сверяется и у нас: резервный /documents отбор doc_num может не знать.
					Если ЗначениеЗаполнено(НомерДокумента) И СтрНайти(ВРег(Входящий.Номер), ВРег(СокрЛП(НомерДокумента))) = 0 Тогда
						Продолжить;
					КонецЕсли;
					Итог.Добавить(Входящий);
				КонецЦикла;
				Если Карточки.Количество() < 100 Тогда
					Прервать;
				КонецЕсли;
				Переполнено = (Страница = 9);
			КонецЦикла;
			Если Переполнено Тогда
				Если Граница - НачалоОкна <= 3600 Тогда
					ВызватьИсключение Строка(Организация) + ": больше 1000 входящих за час с "
						+ Формат(НачалоОкна, "ДФ='dd.MM.yyyy HH:mm'") + " - список неполный";
				КонецЕсли;
				ДлинаОкна = Макс(3600, Цел((Граница - НачалоОкна) / 2));
				Продолжить;
			КонецЕсли;
			Граница = НачалоОкна;
		КонецЦикла;
	КонецЦикла;

	// период прочитан целиком: организации, чьи карточки пришли, второй раз не опрашиваются;
	// своя - если она единственная с этим ИНН.
	Кандидаты = ОрганизацииПоИНН.Получить(ИННОрганизации);
	Если Кандидаты <> Неопределено И Кандидаты.Количество() = 1 Тогда
		ПокрытыеЗдесь.Вставить(ИННОрганизации, Истина);
	КонецЕсли;
	Если ОбщийЯщик Тогда
		Для Каждого ПокрытыйИНН Из ПокрытыеЗдесь Цикл
			Покрытые.Вставить(ПокрытыйИНН.Ключ, Истина);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Строка входящего из карточки списка оператора. Неопределено - карточка не нашей организации
// или без реквизитов счета. Организация карточки в общем ящике - по ИНН покупателя, если организация
// с этим ИНН одна; при нескольких - только своему запросу.
Функция ВходящийИзКарточки(Знач Карточка, Знач Организация, Знач ОрганизацииПоИНН, Знач ОбщийЯщик, Знач ЭтоУКД,
	ПокрытыеЗдесь)

	Счет = ЭДО_Сервер.РеквизитыКарточкиОператора(Карточка);   // extra вместо устаревшего invoice
	Если ТипЗнч(Счет) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Продавец = Счет.Получить("seller");
	Покупатель = Счет.Получить("buyer");
	ИННПокупателя = ?(ТипЗнч(Покупатель) = Тип("Соответствие"), СокрЛП(Строка(Покупатель.Получить("inn"))), "");
	Кандидаты = ?(ЗначениеЗаполнено(ИННПокупателя), ОрганизацииПоИНН.Получить(ИННПокупателя), Неопределено);
	Если НЕ ЗначениеЗаполнено(ИННПокупателя) Тогда
		ОрганизацияКарточки = Организация;
	ИначеЕсли Кандидаты = Неопределено Тогда
		Возврат Неопределено;   // покупатель - не организация из списка
	ИначеЕсли Кандидаты.Количество() = 1 И (ОбщийЯщик ИЛИ Кандидаты[0] = Организация) Тогда
		ОрганизацияКарточки = Кандидаты[0];
		ПокрытыеЗдесь.Вставить(ИННПокупателя, Истина);
	ИначеЕсли Кандидаты.Найти(Организация) <> Неопределено Тогда
		ОрганизацияКарточки = Организация;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Статус = Карточка.Получить("newStatus");
	Если Статус = Неопределено Тогда
		Статус = Карточка.Получить("status");
	КонецЕсли;
	Входящий = Новый Структура("Ид, Номер, Дата, ИННПродавца, Продавец, ИННПокупателя, Статус, Функция, Организация, Документ",
		ЭДО_Регламенты.ИдентификаторСтрокой(Карточка.Получить("id")),
		СокрЛП(Строка(Счет.Получить("num"))),
		ЭДО_Сервер.ДатаИзСтрокиУПД(СокрЛП(Строка(Счет.Получить("date")))),
		?(ТипЗнч(Продавец) = Тип("Соответствие"), СокрЛП(Строка(Продавец.Получить("inn"))), ""),
		ЭДО_Сервер.ПредставлениеСтороныСчета(Продавец),
		ИННПокупателя,
		ВРег(СокрЛП(Строка(Статус))),
		СокрЛП(Строка(Счет.Получить("function"))),
		ОрганизацияКарточки,
		Неопределено);
	// для карточки входящего - вид, версия формата и гид продавца (ответы ему).
	Отправитель = Карточка.Получить("sender");
	Входящий.Вставить("ЭтоУКД", ЭтоУКД);
	Входящий.Вставить("Вид", ЭДО_Сервер.ВидВходящегоДокумента(Входящий.Функция, ЭтоУКД));
	Входящий.Вставить("Версия", СокрЛП(Строка(Карточка.Получить("version"))));
	Входящий.Вставить("ГидПродавца", ?(ТипЗнч(Отправитель) = Тип("Соответствие"), СокрЛП(Строка(Отправитель.Получить("id"))), ""));
	Возврат Входящий;

КонецФункции

#КонецОбласти
