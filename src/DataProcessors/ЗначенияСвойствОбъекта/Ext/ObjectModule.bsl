// Типовая ЗаписатьЗначенияСвойств записывает набор только из строк формы.
// На форме лежат свойства, привязанные к типу этого объекта. Остальные значения
// того же объекта (чужое назначение или пустое) при записи пропадали.
// Здесь чужие строки набора сохраняются. Пустое значение на форме по-прежнему
// удаляет своё свойство: так пользователь очищает поле, которое видит.
// ПродолжитьВызов не вызывается: типовой метод как раз затирает набор целиком.
//
// Строки формы, которые пользователь не менял с чтения, тоже не перезаписываются значением на момент
// открытия: свойства ЭДО реализаций и контрагентов на форме видны, а регламент мог записать их, пока форма
// открыта. Чтение и запись набора - в одной транзакции с исключительной блокировкой по объекту, как
// запись свойств в ЭДО_Сервер: иначе запись регламента между ними терялась бы.
// Реквизиты обработки не заимствованы - обращение через ЭтотОбъект, иначе модуль расширения не компилируется.

// Значения строк формы на момент чтения (ПрочитатьЗаполнитьСвойстваИЗначения): Свойство -> Структура (Значение).
// Неопределено - форма заполнена другим путем: тогда все строки формы пишутся, как раньше.
Перем ЭДО_ПрочитанныеЗначения;

&После("ПрочитатьЗаполнитьСвойстваИЗначения")
Процедура ЭДО_ПрочитатьЗаполнитьСвойстваИЗначения()

	ЭДО_ЗапомнитьПрочитанныеЗначения();

КонецПроцедуры

&Вместо("ЗаписатьЗначенияСвойств")
Функция ЭДО_ЗаписатьЗначенияСвойств()

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		Элемент.УстановитьЗначение("Объект", ЭтотОбъект.ОбъектОтбораЗначений);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		Прежние = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
		Прежние.Отбор.Объект.Установить(ЭтотОбъект.ОбъектОтбораЗначений);
		Прежние.Прочитать();
		ПрежниеПоСвойству = Новый Соответствие;
		Для Каждого Старая Из Прежние Цикл
			ПрежниеПоСвойству.Вставить(Старая.Свойство, Старая.Значение);
		КонецЦикла;

		НаФорме = Новый Соответствие;
		Для Каждого СтрокаФормы Из ЭтотОбъект.СвойстваИЗначения Цикл
			НаФорме.Вставить(СтрокаФормы.Свойство, Истина);
		КонецЦикла;

		Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(ЭтотОбъект.ОбъектОтбораЗначений);

		Для Каждого Старая Из Прежние Цикл
			Если НаФорме.Получить(Старая.Свойство) = Неопределено Тогда
				Запись = Набор.Добавить();
				Запись.Объект = Старая.Объект;
				Запись.Свойство = Старая.Свойство;
				Запись.Значение = Старая.Значение;
			КонецЕсли;
		КонецЦикла;

		Для Каждого СтрокаФормы Из ЭтотОбъект.СвойстваИЗначения Цикл
			Значение = СтрокаФормы.Значение;
			Если ЭДО_СтрокаНеМенялась(СтрокаФормы) Тогда
				// пользователь не трогал - остается то, что в базе сейчас (могло прийти после открытия формы).
				Значение = ПрежниеПоСвойству.Получить(СтрокаФормы.Свойство);
			КонецЕсли;
			Если ЗначениеЗаполнено(Значение) Тогда
				Запись = Набор.Добавить();
				Запись.Объект = ЭтотОбъект.ОбъектОтбораЗначений;
				Запись.Свойство = СтрокаФормы.Свойство;
				Запись.Значение = Значение;
			КонецЕсли;
		КонецЦикла;

		Набор.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		#Если Клиент Тогда
			Предупреждение("Не удалось записать значения свойств:" + Символы.ПС + ОписаниеОшибки());
		#КонецЕсли
		Возврат Ложь;
	КонецПопытки;

	// Записанное - новая точка отсчета: возврат строки к прежнему значению после этой записи - тоже правка.
	ЭДО_ЗапомнитьПрочитанныеЗначения();
	Возврат Истина;

КонецФункции

Процедура ЭДО_ЗапомнитьПрочитанныеЗначения()

	ЭДО_ПрочитанныеЗначения = Новый Соответствие;
	Для Каждого СтрокаФормы Из ЭтотОбъект.СвойстваИЗначения Цикл
		// в структуре: Получить по отсутствующему ключу и по пустому значению иначе неотличимы.
		ЭДО_ПрочитанныеЗначения.Вставить(СтрокаФормы.Свойство, Новый Структура("Значение", СтрокаФормы.Значение));
	КонецЦикла;

КонецПроцедуры

// Строка формы с тем же значением, что при чтении. Свойства не было при чтении (добавлено на форме) или
// чтения не было - строка считается измененной.
Функция ЭДО_СтрокаНеМенялась(Знач СтрокаФормы)

	Если ТипЗнч(ЭДО_ПрочитанныеЗначения) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	Прочитано = ЭДО_ПрочитанныеЗначения.Получить(СтрокаФормы.Свойство);
	Если Прочитано = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрокаФормы.Значение = Прочитано.Значение;

КонецФункции
