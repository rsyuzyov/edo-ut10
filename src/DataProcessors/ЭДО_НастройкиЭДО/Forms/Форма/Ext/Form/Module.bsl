
// Настройки ЭДО: закладка общих настроек расширения и закладка флагов ЭДО контрагентов.
// Общие настройки идут от реестра ЭДО_Сервер.ОписаниеНастроекЭДО и пишутся в общее хранилище,
// учетные записи организаций правятся в карточке УчетнаяЗапись.
// Флаги контрагентов форма только показывает и собирает; чтение, проверка прав, запись и история -
// в ЭДО_НастройкиКонтрагентов. Без права менять закладка контрагентов открывается на просмотр.
// Без права менять настройки ЭДО (ЭДО_Сервер.МожноМенятьНастройкиЭДО) на просмотр открывается закладка общих настроек.

&НаКлиенте
Перем ЗакрытиеПодтверждено;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	МесяцевОтгрузок = 3;
	МожноМенять = ЭДО_НастройкиКонтрагентов.МожноМенять();
	МожноМенятьОбщиеНастройки = ЭДО_Сервер.МожноМенятьНастройкиЭДО();
	НастроитьДоступность();
	НастроитьУсловноеОформление();
	ЗаполнитьСписок();
	ПрочитатьНастройкиВФорму();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗакрытиеПодтверждено = Истина Тогда
		Возврат;
	КонецЕсли;

	// При завершении работы сервер не вызывается, поэтому проверяются только флаги контрагентов.
	Если ЗавершениеРаботы Тогда
		Если ЕстьИзменения() Тогда
			Отказ = Истина;
			ТекстПредупреждения = "Изменения настроек ЭДО не записаны.";
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ОбщиеНастройкиИзменены = МожноМенятьОбщиеНастройки И ЕстьНезаписанныеИзменения();
	Если НЕ ЕстьИзменения() И НЕ ОбщиеНастройкиИзменены Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект, ОбщиеНастройкиИзменены),
		"Изменения настроек ЭДО не записаны. Записать?", РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ОбщиеНастройкиИзменены) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;

	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если ОбщиеНастройкиИзменены Тогда
			ЗаписатьНастройкиНаСервере();
			Оповестить("ЭДО_НастройкиИзменены");
		КонецЕсли;
		Если ЕстьИзменения() И НЕ ЗаписатьИзмененияНаКлиенте() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ЗакрытиеПодтверждено = Истина;
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ЭДО_УчетнаяЗаписьИзменена" Тогда
		ЗаполнитьУчетныеЗаписиНаСервере();
		ЗаполнитьСостояниеГотовности();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	Если ЕстьИзменения() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбновитьЗавершение", ЭтотОбъект),
			"Изменения не записаны и пропадут при обновлении списка. Обновить?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	ЗаполнитьСписок();

КонецПроцедуры

&НаКлиенте
Процедура ФлагПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Контрагенты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Изменен = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПаузаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Контрагенты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.Изменен = Истина;
	Если НЕ ТекущиеДанные.Пауза Тогда
		ТекущиеДанные.ПричинаПаузы = "";
		Возврат;
	КонецЕсли;
	// Причину паузы увидит бухгалтерия в колонке «ЭДО», по ней же решают, когда снимать.
	Строки = Новый Массив;
	Строки.Добавить(Элементы.Контрагенты.ТекущаяСтрока);
	ЗапроситьПричинуПаузы(Строки);

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыПриАктивизацииСтроки(Элемент)

	ОтключитьОбработчикОжидания("ПоказатьИсториюТекущего");
	ПодключитьОбработчикОжидания("ПоказатьИсториюТекущего", 0.3, Истина);

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Галочки переключаются по щелчку; карточку контрагента открывает двойной щелчок по прочим колонкам.
	Если Поле = Элементы.КонтрагентыКонтрагент ИЛИ Поле = Элементы.КонтрагентыИНН
		ИЛИ Поле = Элементы.КонтрагентыАдресЭДО ИЛИ Поле = Элементы.КонтрагентыПричинаПаузы Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьСостояниеЭДОВыполнить(Неопределено);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьВыполнить(Команда)

	// У команды Ctrl+S: на закладке общих настроек записываются они.
	Если Элементы.ГруппаЗакладки.ТекущаяСтраница = Элементы.СтраницаОбщиеНастройки Тогда
		ЗаписатьНастройки(Команда);
		Возврат;
	КонецЕсли;
	ЗаписатьИзмененияНаКлиенте();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВыполнить(Команда)

	ОтборПриИзменении(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗавершение(Ответ, Параметр) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСписок();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВыделенныеВыполнить(Команда)

	Если НЕ МожноМенять Тогда
		Возврат;
	КонецЕсли;
	Если Элементы.Контрагенты.ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите контрагентов в списке.");
		Возврат;
	КонецЕсли;
	Варианты = Новый СписокЗначений;
	Для Каждого ОписаниеФлага Из ОписаниеФлаговНаСервере() Цикл
		Варианты.Добавить(ОписаниеФлага.Колонка + "|1", ОписаниеФлага.Представление + ": включить");
		Варианты.Добавить(ОписаниеФлага.Колонка + "|0", ОписаниеФлага.Представление + ": выключить");
	КонецЦикла;
	Варианты.Добавить("Пауза|1", "Пауза: поставить");
	Варианты.Добавить("Пауза|0", "Пауза: снять");
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ИзменитьВыделенныеЗавершение", ЭтотОбъект), Варианты);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВыделенныеЗавершение(Выбор, Параметр) Экспорт

	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Части = СтрРазделить(Выбор.Значение, "|");
	Колонка = Части[0];
	Включить = (Части[1] = "1");
	Строки = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Контрагенты.ВыделенныеСтроки Цикл
		СтрокаСписка = Контрагенты.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаСписка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаСписка[Колонка] <> Включить Тогда
			СтрокаСписка[Колонка] = Включить;
			СтрокаСписка.Изменен = Истина;
			Если Колонка = "Пауза" И НЕ Включить Тогда
				СтрокаСписка.ПричинаПаузы = "";
			КонецЕсли;
			Строки.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Если Колонка = "Пауза" И Включить И Строки.Количество() > 0 Тогда
		ЗапроситьПричинуПаузы(Строки);
		Возврат;
	КонецЕсли;
	ПоказатьОповещениеПользователя("Настройки ЭДО", , "Изменено строк: " + Строки.Количество()
		+ ". Не забудьте записать изменения.");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСостояниеЭДОВыполнить(Команда)

	ТекущиеДанные = Элементы.Контрагенты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЭДО_Клиент.ОткрытьКарточкуКонтрагентаЭДО(ТекущиеДанные.Контрагент, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапроситьПричинуПаузы(Строки)

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ЗапроситьПричинуПаузыЗавершение", ЭтотОбъект, Строки),
		"", "Причина паузы (ее увидит бухгалтерия)", 150, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьПричинуПаузыЗавершение(Причина, Строки) Экспорт

	// Без причины паузу не ставим: строки возвращаются в прежнее состояние.
	Для Каждого Идентификатор Из Строки Цикл
		СтрокаСписка = Контрагенты.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаСписка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Причина) Тогда
			СтрокаСписка.ПричинаПаузы = СокрЛП(Причина);
		Иначе
			СтрокаСписка.Пауза = Ложь;
			СтрокаСписка.ПричинаПаузы = "";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ЕстьИзменения()

	Возврат Контрагенты.НайтиСтроки(Новый Структура("Изменен", Истина)).Количество() > 0;

КонецФункции

&НаКлиенте
Функция ЗаписатьИзмененияНаКлиенте()

	Если НЕ ЕстьИзменения() Тогда
		ПоказатьОповещениеПользователя("Настройки ЭДО", , "Изменений нет.");
		Возврат Истина;
	КонецЕсли;
	Итог = ЗаписатьИзмененияНаСервере();
	Если Итог.Ошибки.Количество() > 0 Тогда
		ПоказатьПредупреждение(, "Записано изменений: " + Итог.Записано + "." + Символы.ПС
			+ "Не удалось:" + Символы.ПС + СтрСоединить(Итог.Ошибки, Символы.ПС));
		Возврат Ложь;
	КонецЕсли;
	ПоказатьОповещениеПользователя("Настройки ЭДО", , "Записано изменений: " + Итог.Записано);
	ПоказатьИсториюТекущего();
	Возврат Истина;

КонецФункции

&НаСервере
Функция ЗаписатьИзмененияНаСервере()

	// На сервер уходят только поля, которые пользователь поменял, и то, что он видел до правки:
	// сервер не перезапишет чужое изменение, сделанное после чтения списка.
	Изменения = Новый Массив;
	Для Каждого СтрокаСписка Из Контрагенты.НайтиСтроки(Новый Структура("Изменен", Истина)) Цикл
		Исходные = ЗначениеИзСтрокиВнутр(СтрокаСписка.Исходные);
		Было = Новый Структура;
		Стало = Новый Структура;
		Для Каждого Поле Из Исходные Цикл
			Если СтрокаСписка[Поле.Ключ] <> Поле.Значение Тогда
				Было.Вставить(Поле.Ключ, Поле.Значение);
				Стало.Вставить(Поле.Ключ, СтрокаСписка[Поле.Ключ]);
			КонецЕсли;
		КонецЦикла;
		Если Стало.Свойство("Пауза") Тогда
			Стало.Вставить("ПричинаПаузы", СтрокаСписка.ПричинаПаузы);
		КонецЕсли;
		Если Стало.Количество() > 0 Тогда
			Изменения.Добавить(Новый Структура("Контрагент, Было, Стало", СтрокаСписка.Контрагент, Было, Стало));
		КонецЕсли;
	КонецЦикла;
	Итог = ЭДО_НастройкиКонтрагентов.ЗаписатьИзменения(Изменения);

	// Незаписанные строки (конфликт, ошибка) сохраняют правку пользователя и то, что он видел до нее;
	// остальное перечитывается из базы - в строках то, что записалось.
	Незаписанные = Новый Массив;
	Для Каждого Контрагент Из Итог.НеЗаписаны Цикл
		Для Каждого СтрокаСписка Из Контрагенты.НайтиСтроки(Новый Структура("Контрагент", Контрагент)) Цикл
			Правка = Новый Структура("Контрагент, ИНН, АдресЭДО, АдресЗакреплен, Автоотправка, ПриемУПД, ПриемУКД,
				|СверкаУПД, Пауза, ПричинаПаузы, Исходные");
			ЗаполнитьЗначенияСвойств(Правка, СтрокаСписка);
			Незаписанные.Добавить(Правка);
		КонецЦикла;
	КонецЦикла;
	ЗаполнитьСписок();
	Для Каждого Правка Из Незаписанные Цикл
		Найденные = Контрагенты.НайтиСтроки(Новый Структура("Контрагент", Правка.Контрагент));
		СтрокаСписка = ?(Найденные.Количество() > 0, Найденные[0], Контрагенты.Вставить(0));
		ЗаполнитьЗначенияСвойств(СтрокаСписка, Правка);
		СтрокаСписка.Изменен = Истина;
	КонецЦикла;
	Возврат Итог;

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеФлаговНаСервере()

	Возврат ЭДО_НастройкиКонтрагентов.ОписаниеФлагов();

КонецФункции

&НаСервере
Процедура ЗаполнитьСписок()

	ТекущийКонтрагент = Неопределено;
	Если Элементы.Контрагенты.ТекущаяСтрока <> Неопределено Тогда
		ТекущаяСтрокаСписка = Контрагенты.НайтиПоИдентификатору(Элементы.Контрагенты.ТекущаяСтрока);
		Если ТекущаяСтрокаСписка <> Неопределено Тогда
			ТекущийКонтрагент = ТекущаяСтрокаСписка.Контрагент;
		КонецЕсли;
	КонецЕсли;

	Контрагенты.Очистить();
	Список = ЭДО_НастройкиКонтрагентов.СписокКонтрагентов(Поиск, МесяцевОтгрузок, ТолькоСНастройками);
	Для Каждого Данные Из Список.Строки Цикл
		СтрокаСписка = Контрагенты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписка, Данные);
		// Что пользователь видел до правки: по этому сервер узнает чужое изменение при записи.
		СтрокаСписка.Исходные = ЗначениеВСтрокуВнутр(Новый Структура("Автоотправка, ПриемУПД, ПриемУКД, СверкаУПД, Пауза",
			Данные.Автоотправка, Данные.ПриемУПД, Данные.ПриемУКД, Данные.СверкаУПД, Данные.Пауза));
	КонецЦикла;

	Если ТекущийКонтрагент <> Неопределено Тогда
		Найденные = Контрагенты.НайтиСтроки(Новый Структура("Контрагент", ТекущийКонтрагент));
		Если Найденные.Количество() > 0 Тогда
			Элементы.Контрагенты.ТекущаяСтрока = Найденные[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	Элементы.Контрагенты.Заголовок = "Контрагенты (" + Контрагенты.Количество()
		+ ?(Список.Обрезан, "+, уточните отбор", "") + ")";

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИсториюТекущего() Экспорт

	ТекущиеДанные = Элементы.Контрагенты.ТекущиеДанные;
	ЗаполнитьИсторию(?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.Контрагент));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИсторию(Знач Контрагент)

	История.Очистить();
	Для Каждого Запись Из ЭДО_НастройкиКонтрагентов.ИсторияКонтрагента(Контрагент) Цикл
		ЗаполнитьЗначенияСвойств(История.Добавить(), Запись);
	КонецЦикла;
	Элементы.ГруппаИстория.Заголовок = "История изменений в этой базе" + ?(ЗначениеЗаполнено(Контрагент),
		": " + Строка(Контрагент), "");

КонецПроцедуры

// Без права менять - только просмотр: галочки недоступны, команды изменения скрыты.
&НаСервере
Процедура НастроитьДоступность()

	Элементы.НадписьТолькоПросмотр.Видимость = НЕ МожноМенять;
	Для Каждого ИмяЭлемента Из СтрРазделить("КонтрагентыАвтоотправка,КонтрагентыПриемУПД,КонтрагентыПриемУКД,"
		+ "КонтрагентыСверкаУПД,КонтрагентыПауза", ",") Цикл
		Элементы[ИмяЭлемента].ТолькоПросмотр = НЕ МожноМенять;
	КонецЦикла;
	// Свойство не заведено в базе - колонку не изменить, иначе запись строки отказала бы.
	Для Каждого Колонка Из ЭДО_НастройкиКонтрагентов.НезаведенныеФлаги() Цикл
		ЭлементКолонки = Элементы["Контрагенты" + Колонка];
		ЭлементКолонки.ТолькоПросмотр = Истина;
		ЭлементКолонки.Подсказка = "Свойство не заведено в базе: заведите свойства в настройках ЭДО.";
	КонецЦикла;
	Элементы.КнопкаЗаписать.Видимость = МожноМенять;
	Элементы.КнопкаИзменитьВыделенные.Видимость = МожноМенять;

	Если МожноМенятьОбщиеНастройки Тогда
		Возврат;
	КонецЕсли;
	УстановитьТолькоПросмотрПолей(Элементы.СтраницаОбщиеНастройки);
	Для Каждого ИмяКнопки Из СтрРазделить("ЗаписатьИЗакрыть,КнопкаЗаписатьНастройки,ЗавестиСвойства,ПеренестиВОбщие,"
		+ "СброситьНастройкиПоУмолчанию,ДобавитьУчетнуюЗапись,ИзменитьУчетнуюЗапись,УдалитьУчетнуюЗапись,"
		+ "ПроверитьЯщикОператора", ",") Цикл
		Элементы[ИмяКнопки].Доступность = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьТолькоПросмотрПолей(ГруппаЭлементов)

	Для Каждого ПодчиненныйЭлемент Из ГруппаЭлементов.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ПолеФормы") ИЛИ ТипЗнч(ПодчиненныйЭлемент) = Тип("ТаблицаФормы") Тогда
			ПодчиненныйЭлемент.ТолькоПросмотр = Истина;
		ИначеЕсли ТипЗнч(ПодчиненныйЭлемент) = Тип("ГруппаФормы") Тогда
			УстановитьТолькоПросмотрПолей(ПодчиненныйЭлемент);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Измененные, но не записанные строки - светло-желтым фоном; контрагент на паузе - цветом особого текста.
&НаСервере
Процедура НастроитьУсловноеОформление()

	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагенты.Изменен");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СветлоЖелтый);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Контрагенты");

	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагенты.Пауза");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("КонтрагентыПричинаПаузы");

КонецПроцедуры

#КонецОбласти

#Область ОбщиеНастройкиОбработчикиКоманд

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)

	Если НЕ МожноМенятьОбщиеНастройки Тогда
		ПоказатьПредупреждение(, ТекстНетПраваМенятьОбщиеНастройки());
		Возврат;
	КонецЕсли;
	ЗаписатьНастройкиНаСервере();
	Оповестить("ЭДО_НастройкиИзменены");

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если НЕ МожноМенятьОбщиеНастройки Тогда
		ПоказатьПредупреждение(, ТекстНетПраваМенятьОбщиеНастройки());
		Возврат;
	КонецЕсли;
	ЗаписатьНастройкиНаСервере();
	Оповестить("ЭДО_НастройкиИзменены");
	Закрыть();

КонецПроцедуры

// Проверить можно только записанное, поэтому при незаписанных изменениях спрашиваем.
// Незаписанное ищется сравнением полей с хранилищем: флаг Модифицированность у этой формы при вводе не ставится.
&НаКлиенте
Процедура ПроверитьГотовность(Команда)

	Если ЕстьНезаписанныеИзменения() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПроверитьГотовностьЗавершение", ЭтотОбъект),
			"Есть незаписанные изменения. Проверяется только то, что записано." + Символы.ПС
			+ "Записать настройки и проверить?", РежимДиалогаВопрос.ДаНетОтмена);
		Возврат;
	КонецЕсли;
	ПрочитатьНастройкиВФорму();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьГотовностьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаписатьНастройкиНаСервере();
		Оповестить("ЭДО_НастройкиИзменены");
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		// проверяем записанное, введенное в полях не трогаем
		ЗаполнитьСостояниеГотовности();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗавестиСвойства(Команда)

	ТекстВопроса = "Завести недостающие свойства объектов? Существующие не изменяются.";
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗавестиСвойстваЗавершение", ЭтотОбъект),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗавестиСвойстваЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ЗавестиСвойстваНаСервере());

КонецПроцедуры

// Разовая операция для ранее настроенных баз: поднимает персональные значения в общие.
&НаКлиенте
Процедура ПеренестиВОбщие(Команда)

	ПоказатьПредупреждение(, ПеренестиВОбщиеНаСервере());

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстНетПраваМенятьОбщиеНастройки()

	Возврат "Общие настройки ЭДО открыты только для просмотра: нужно право «Администрирование»"
		+ " или роль «НастройкаПараметровЭД».";

КонецФункции

// Сбрасываются настройки из ЭДО_Сервер.ИменаНастроекСбросаПоУмолчанию и таблица операторов.
// Прочие поля формы, в том числе незаписанные, не трогаются.
&НаКлиенте
Процедура СброситьНастройкиПоУмолчанию(Команда)

	ИзмененияПриСбросе = ИзмененияПриСбросеНастроекНаСервере();
	Если ИзмененияПриСбросе.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Настройки и так по умолчанию, сбрасывать нечего.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Вернуть настройки ЭДО к значениям по умолчанию?" + Символы.ПС + Символы.ПС
		+ "- " + СтрСоединить(ИзмененияПриСбросе, Символы.ПС + "- ") + Символы.ПС + Символы.ПС
		+ "Записанные значения будут удалены, начнут действовать умолчания расширения. "
		+ "Учетные записи, сертификаты, МЧД, адреса и даты не изменятся.";
	ПоказатьВопрос(Новый ОписаниеОповещения("СброситьНастройкиПоУмолчаниюЗавершение", ЭтотОбъект),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СброситьНастройкиПоУмолчаниюЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Сброшено = СброситьНастройкиПоУмолчаниюНаСервере();
	Если Сброшено.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Настройки и так по умолчанию, сбрасывать нечего.");
		Возврат;
	КонецЕсли;
	Оповестить("ЭДО_НастройкиИзменены");
	ПоказатьПредупреждение(, "Настройки ЭДО возвращены к значениям по умолчанию:" + Символы.ПС
		+ "- " + СтрСоединить(Сброшено, Символы.ПС + "- "));

КонецПроцедуры

// Учетные записи организаций: таблица только показывает, все правится в карточке.

&НаКлиенте
Процедура ДобавитьУчетнуюЗапись(Команда)

	ОткрытьКарточкуУчетнойЗаписи(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьУчетнуюЗапись(Команда)

	ТекущаяУчетнаяЗапись = Элементы.УчетныеЗаписи.ТекущиеДанные;
	Если ТекущаяУчетнаяЗапись = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку таблицы.");
		Возврат;
	КонецЕсли;
	ОткрытьКарточкуУчетнойЗаписи(ТекущаяУчетнаяЗапись.Организация);

КонецПроцедуры

// Двойной щелчок и Enter по строке - то же, что кнопка «Изменить».
// Второй параметр события - идентификатор строки, а не ее данные.
&НаКлиенте
Процедура УчетныеЗаписиВыбор(Элемент, ВыбраннаяСтрока, ПоляСтроки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если НЕ МожноМенятьОбщиеНастройки Тогда
		Возврат;
	КонецЕсли;
	ВыбраннаяУчетнаяЗапись = УчетныеЗаписи.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ВыбраннаяУчетнаяЗапись = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьКарточкуУчетнойЗаписи(ВыбраннаяУчетнаяЗапись.Организация);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуУчетнойЗаписи(Организация)

	// Имя «Параметры» занято свойством формы, присваивать его нельзя.
	ПараметрыКарточки = Новый Структура("Организация", Организация);
	ОткрытьФорму("Обработка.ЭДО_НастройкиЭДО.Форма.УчетнаяЗапись", ПараметрыКарточки, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьУчетнуюЗапись(Команда)

	ТекущаяУчетнаяЗапись = Элементы.УчетныеЗаписи.ТекущиеДанные;
	Если ТекущаяУчетнаяЗапись = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку таблицы.");
		Возврат;
	КонецЕсли;
	ТекстВопроса = "Удалить учетную запись организации «" + ТекущаяУчетнаяЗапись.Организация + "»?";
	ПараметрыУдаления = Новый Структура("Организация", ТекущаяУчетнаяЗапись.Организация);
	ПоказатьВопрос(Новый ОписаниеОповещения("УдалитьУчетнуюЗаписьЗавершение", ЭтотОбъект, ПараметрыУдаления),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьУчетнуюЗаписьЗавершение(Ответ, ПараметрыУдаления) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	УдалитьУчетнуюЗаписьНаСервере(ПараметрыУдаления.Организация);
	ЗаполнитьУчетныеЗаписиНаСервере();
	ЗаполнитьСостояниеГотовности();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьГотовностьУчетнойЗаписи(Команда)

	ТекущаяУчетнаяЗапись = Элементы.УчетныеЗаписи.ТекущиеДанные;
	Если ТекущаяУчетнаяЗапись = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку таблицы.");
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ГотовностьУчетнойЗаписиНаСервере(ТекущаяУчетнаяЗапись.Организация));

КонецПроцедуры

// Ящики других операторов (СБИС, Диадок): таблица правится прямо в форме и пишется кнопкой «Записать».
// Записанный пароль на клиент не приходит, новый вводится в колонку «Новый пароль».

&НаКлиенте
Процедура ЯщикиОператоровПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока И НЕ Копирование Тогда
		Элемент.ТекущиеДанные.Оператор = "sbis";
		Элемент.ТекущиеДанные.Включен = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЯщикОператора(Команда)

	ТекущийЯщик = Элементы.ЯщикиОператоров.ТекущиеДанные;
	Если ТекущийЯщик = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите ящик в таблице.");
		Возврат;
	КонецЕсли;
	Если ЕстьНезаписанныеИзменения() Тогда
		ПоказатьПредупреждение(, "Есть незаписанные изменения. Проверяется только записанный ящик - сначала запишите настройки.");
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ПроверитьЯщикОператораНаСервере(ТекущийЯщик.Организация, ТекущийЯщик.Оператор));

КонецПроцедуры

#КонецОбласти

#Область ОбщиеНастройкиСлужебные

&НаСервереБезКонтекста
Функция ПроверитьЯщикОператораНаСервере(Знач Организация, Знач Оператор)

	Возврат ЭДО_Сервер.ПроверитьЯщикОператора(Организация, Оператор);

КонецФункции

&НаСервере
Процедура ПрочитатьНастройкиВФорму()

	Для Каждого ОписаниеНастройки Из НастройкиНаФорме() Цикл
		ЭтотОбъект[ОписаниеНастройки.Имя] = ЗаписанноеЗначениеДляФормы(ОписаниеНастройки);
	КонецЦикла;
	НастройкиОператоров = ЭДО_Сервер.НастройкиОператоровЭДОТекстом();

	ЗаполнитьДействующееОкно();
	ЗаполнитьУчетныеЗаписи();
	ЗаполнитьЯщикиОператоров();
	ЗаполнитьСостояниеГотовности();

КонецПроцедуры

// Настройки реестра ЭДО_Сервер.ОписаниеНастроекЭДО, у которых на форме есть реквизит с тем же именем.
// Новая настройка реестра правится формой, как только на форму добавлены реквизит и поле.
&НаСервере
Функция НастройкиНаФорме()

	ИменаРеквизитов = Новый Соответствие;
	Для Каждого РеквизитФормы Из ПолучитьРеквизиты() Цикл
		ИменаРеквизитов.Вставить(РеквизитФормы.Имя, Истина);
	КонецЦикла;

	ОписанияНастроек = Новый Массив;
	Для Каждого ОписаниеНастройки Из ЭДО_Сервер.ОписаниеНастроекЭДО() Цикл
		Если ИменаРеквизитов.Получить(ОписаниеНастройки.Имя) = Истина Тогда
			ОписанияНастроек.Добавить(ОписаниеНастройки);
		КонецЕсли;
	КонецЦикла;
	Возврат ОписанияНастроек;

КонецФункции

// Записанное значение настройки в том виде, в каком его держит реквизит формы: флаг - булево.
&НаСервере
Функция ЗаписанноеЗначениеДляФормы(ОписаниеНастройки)

	ЗначениеНастройки = ЭДО_Сервер.НастройкаЭДО(ОписаниеНастройки.Имя);
	Если ОписаниеНастройки.Флаг = Истина Тогда
		Если ОписаниеНастройки.Тип = "Число" Тогда
			Возврат ТипЗнч(ЗначениеНастройки) = Тип("Число") И ЗначениеНастройки <> 0;
		КонецЕсли;
		Возврат ВРег(СокрЛП(Строка(ЗначениеНастройки))) = "ДА";
	КонецЕсли;
	Возврат ЗначениеРеквизитаДляСравнения(ОписаниеНастройки, ЗначениеНастройки);

КонецФункции

// Строка без краевых пробелов, дата без времени: так значения пишутся и так сравниваются.
&НаСервере
Функция ЗначениеРеквизитаДляСравнения(ОписаниеНастройки, ЗначениеНастройки)

	Если ОписаниеНастройки.Флаг = Истина Тогда
		Возврат ЗначениеНастройки = Истина;
	ИначеЕсли ОписаниеНастройки.Тип = "Строка" Тогда
		Возврат СокрЛП(Строка(ЗначениеНастройки));
	ИначеЕсли ОписаниеНастройки.Тип = "Дата" Тогда
		Возврат ?(ТипЗнч(ЗначениеНастройки) = Тип("Дата"), НачалоДня(ЗначениеНастройки), Дата(1, 1, 1));
	КонецЕсли;
	Возврат ЗначениеНастройки;

КонецФункции

// Значение реквизита формы для записи в хранилище: флаг уходит числом 1/0 или строкой "Да"/пусто.
&НаСервере
Функция ЗначениеДляЗаписи(ОписаниеНастройки)

	ЗначениеРеквизита = ЗначениеРеквизитаДляСравнения(ОписаниеНастройки, ЭтотОбъект[ОписаниеНастройки.Имя]);
	Если ОписаниеНастройки.Флаг = Истина Тогда
		Если ОписаниеНастройки.Тип = "Число" Тогда
			Возврат ?(ЗначениеРеквизита, 1, 0);
		КонецЕсли;
		Возврат ?(ЗначениеРеквизита, "Да", "");
	КонецЕсли;
	Возврат ЗначениеРеквизита;

КонецФункции

// Числовая настройка без НольДопустим нулем не пишется: записанный 0 читался бы как умолчание.
&НаСервере
Функция НольНедопустим(ОписаниеНастройки)

	Возврат ОписаниеНастройки.Тип = "Число" И НЕ ОписаниеНастройки.НольДопустим
		И ЭтотОбъект[ОписаниеНастройки.Имя] = 0;

КонецФункции

&НаСервере
Функция НастройкаИзменена(ОписаниеНастройки)

	Возврат ЗначениеРеквизитаДляСравнения(ОписаниеНастройки, ЭтотОбъект[ОписаниеНастройки.Имя])
		<> ЗаписанноеЗначениеДляФормы(ОписаниеНастройки);

КонецФункции

// Окно отбора из двух ограничений. Дата начала у каждой организации своя, здесь - самая ранняя.
&НаСервере
Процедура ЗаполнитьДействующееОкно()

	ДатаНачалаРанняя = ЭДО_Сервер.РанняяДатаНачалаОтправки();
	НижняяГраница = ЭДО_Сервер.НижняяГраницаОтбора();
	ДействующееОкно = "с " + Формат(НижняяГраница, "ДФ=dd.MM.yyyy")
		+ ?(ЗначениеЗаполнено(ДатаНачалаРанняя) И НижняяГраница = НачалоДня(ДатаНачалаРанняя),
			" (по дате начала организации)", " (по глубине в днях)");

КонецПроцедуры

// Отличается ли хоть одно общее поле формы от записанного. Учетные записи не сравниваются:
// они пишутся сразу из карточки.
&НаСервере
Функция ЕстьНезаписанныеИзменения()

	Для Каждого ОписаниеНастройки Из НастройкиНаФорме() Цикл
		Если НастройкаИзменена(ОписаниеНастройки) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат СокрЛП(НастройкиОператоров) <> ЭДО_Сервер.НастройкиОператоровЭДОТекстом()
		ИЛИ ЯщикиОператоровИзменены();

КонецФункции

&НаСервере
Процедура ЗаполнитьСостояниеГотовности()

	Недостающее = ЭДО_Сервер.НедостающиеНастройкиЭДО();
	Если Недостающее.Количество() = 0 Тогда
		СостояниеГотовности = "Все настроено - отправка работать может.";
	Иначе
		СостояниеГотовности = "Отправка НЕ РАБОТАЕТ, пока не устранено:" + Символы.ПС
			+ "- " + СтрСоединить(Недостающее, Символы.ПС + "- ");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиНаСервере()

	// Право проверяется до первой записи: иначе часть настроек записалась бы до исключения.
	ЭДО_Сервер.ПроверитьПравоМенятьНастройкиЭДО();

	// Пишутся только измененные поля: незатронутая настройка остается на умолчании расширения.
	Для Каждого ОписаниеНастройки Из НастройкиНаФорме() Цикл
		Если НЕ НастройкаИзменена(ОписаниеНастройки) Тогда
			Продолжить;
		КонецЕсли;
		Если НольНедопустим(ОписаниеНастройки) Тогда
			СообщениеОНуле = Новый СообщениеПользователю;
			СообщениеОНуле.Текст = "«" + ОписаниеНастройки.Представление + "»: 0 недопустим, оставлено прежнее значение";
			СообщениеОНуле.Поле = ОписаниеНастройки.Имя;
			СообщениеОНуле.Сообщить();
		Иначе
			ЭДО_Сервер.УстановитьНастройкуЭДО(ОписаниеНастройки.Имя, ЗначениеДляЗаписи(ОписаниеНастройки));
		КонецЕсли;
	КонецЦикла;

	// Таблицу операторов пишем, только когда ее меняли: иначе умолчания закрепились бы в хранилище.
	Если СокрЛП(НастройкиОператоров) <> ЭДО_Сервер.НастройкиОператоровЭДОТекстом() Тогда
		ЭДО_Сервер.ЗаписатьНастройкиОператоровЭДОИзТекста(НастройкиОператоров);
	КонецЕсли;
	Если ЯщикиОператоровИзменены() Тогда
		ЭДО_Сервер.ЗаписатьЯщикиОператоров(СтрокиЯщиковОператоров());
	КонецЕсли;

	ПрочитатьНастройкиВФорму();

КонецПроцедуры

&НаСервере
Функция ЗавестиСвойстваНаСервере()

	ИтогЗаведения = ЭДО_Сервер.ОбеспечитьСвойстваОбъектов();
	ЗаполнитьСостояниеГотовности();
	Возврат СтрСоединить(ИтогЗаведения, Символы.ПС);

КонецФункции

&НаСервере
Функция ПеренестиВОбщиеНаСервере()

	ИтогПереноса = ЭДО_Сервер.ПеренестиНастройкиВОбщие();
	ПрочитатьНастройкиВФорму();
	Возврат СтрСоединить(ИтогПереноса, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция ИзмененияПриСбросеНастроекНаСервере()

	Возврат ЭДО_Сервер.ИзмененияПриСбросеНастроекЭДО();

КонецФункции

// Перечитываются только сброшенные поля.
&НаСервере
Функция СброситьНастройкиПоУмолчаниюНаСервере()

	Сброшено = ЭДО_Сервер.СброситьНастройкиЭДОПоУмолчанию();

	ИменаСброса = ЭДО_Сервер.ИменаНастроекСбросаПоУмолчанию();
	Для Каждого ОписаниеНастройки Из НастройкиНаФорме() Цикл
		Если ИменаСброса.Найти(ОписаниеНастройки.Имя) <> Неопределено Тогда
			ЭтотОбъект[ОписаниеНастройки.Имя] = ЗаписанноеЗначениеДляФормы(ОписаниеНастройки);
		КонецЕсли;
	КонецЦикла;
	НастройкиОператоров = ЭДО_Сервер.НастройкиОператоровЭДОТекстом();
	ЗаполнитьДействующееОкно();
	ЗаполнитьСостояниеГотовности();

	Возврат Сброшено;

КонецФункции

&НаСервере
Процедура ЗаполнитьУчетныеЗаписиНаСервере()

	ЗаполнитьУчетныеЗаписи();

КонецПроцедуры

// Таблица строится из ЭДО_Сервер.УчетныеЗаписиЭДО - той же функции, которой пользуется отправка.
&НаСервере
Процедура ЗаполнитьУчетныеЗаписи()

	УчетныеЗаписи.Очистить();

	Для Каждого ОписаниеУчетнойЗаписи Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
		СтрокаУчетнойЗаписи = УчетныеЗаписи.Добавить();
		СтрокаУчетнойЗаписи.Организация            = ОписаниеУчетнойЗаписи.Организация;
		СтрокаУчетнойЗаписи.Оператор               = ОписаниеУчетнойЗаписи.Оператор;
		СтрокаУчетнойЗаписи.Сертификат             = ПредставлениеСертификатаКратко(ОписаниеУчетнойЗаписи.Отпечаток);
		СтрокаУчетнойЗаписи.Подписант              = ПредставлениеТипаПодписанта(ОписаниеУчетнойЗаписи.ТипПодписанта);
		СтрокаУчетнойЗаписи.НомерМЧД               = ОписаниеУчетнойЗаписи.НомерМЧД;
		СтрокаУчетнойЗаписи.ОтправлятьСДаты        = ОписаниеУчетнойЗаписи.ДатаНачалаОтправки;
		СтрокаУчетнойЗаписи.ИдентификаторУчастника = ОписаниеУчетнойЗаписи.ИдентификаторУчастника;

		Претензии = ЭДО_Сервер.НедостаткиУчетнойЗаписиЭДО(ОписаниеУчетнойЗаписи);
		Если Претензии.Количество() = 0 Тогда
			СтрокаУчетнойЗаписи.Готовность = "готова";
		Иначе
			СтрокаУчетнойЗаписи.Готовность = СтрСоединить(Претензии, "; ");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЯщикиОператоров()

	ЯщикиОператоров.Очистить();
	Для Каждого ЗаписанныйЯщик Из ЭДО_Сервер.ЯщикиОператоровДляНастройки() Цикл
		ЗаполнитьЗначенияСвойств(ЯщикиОператоров.Добавить(), ЗаписанныйЯщик);
	КонецЦикла;

КонецПроцедуры

// Изменена ли таблица ящиков против записанной: состав, поля строк или введен новый пароль.
&НаСервере
Функция ЯщикиОператоровИзменены()

	ЗаписанныеЯщики = ЭДО_Сервер.ЯщикиОператоровДляНастройки();
	Если ЗаписанныеЯщики.Количество() <> ЯщикиОператоров.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	Для Индекс = 0 По ЗаписанныеЯщики.Количество() - 1 Цикл
		ЗаписанныйЯщик = ЗаписанныеЯщики[Индекс];
		СтрокаЯщика = ЯщикиОператоров[Индекс];
		Если ЗначениеЗаполнено(СтрокаЯщика.НовыйПароль)
			ИЛИ СтрокаЯщика.Организация <> ЗаписанныйЯщик.Организация
			ИЛИ НРег(СокрЛП(СтрокаЯщика.Оператор)) <> ЗаписанныйЯщик.Оператор
			ИЛИ СокрЛП(СтрокаЯщика.Логин) <> ЗаписанныйЯщик.Логин
			ИЛИ СтрокаЯщика.Включен <> ЗаписанныйЯщик.Включен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервере
Функция СтрокиЯщиковОператоров()

	СтрокиЯщиков = Новый Массив;
	Для Каждого СтрокаЯщика Из ЯщикиОператоров Цикл
		СтрокиЯщиков.Добавить(Новый Структура("Организация, Оператор, Логин, НовыйПароль, Включен", СтрокаЯщика.Организация,
			СтрокаЯщика.Оператор, СтрокаЯщика.Логин, СтрокаЯщика.НовыйПароль, СтрокаЯщика.Включен));
	КонецЦикла;
	Возврат СтрокиЯщиков;

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеСертификатаКратко(Знач Отпечаток)

	СостояниеСертификата = ЭДО_Сервер.СостояниеСертификатаПоОтпечатку(Отпечаток, Ложь);
	Если НЕ СостояниеСертификата.Задан Тогда
		Возврат "не задан";
	ИначеЕсли НЕ СостояниеСертификата.Найден Тогда
		Возврат "не установлен у сервера";
	ИначеЕсли СостояниеСертификата.Просрочен Тогда
		Возврат СостояниеСертификата.Субъект + " (ПРОСРОЧЕН)";
	КонецЕсли;
	Возврат СостояниеСертификата.Субъект + " - до " + Формат(СостояниеСертификата.ДействителенПо, "ДФ=dd.MM.yyyy");

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеТипаПодписанта(Знач ТипПодписанта)

	Если ТипПодписанта = "ЮЛ" Тогда
		Возврат "Юридическое лицо";
	ИначеЕсли ТипПодписанта = "ИП" Тогда
		Возврат "Индивидуальный предприниматель";
	ИначеЕсли ТипПодписанта = "ФЛ" Тогда
		Возврат "Физическое лицо по МЧД";
	КонецЕсли;
	Возврат ТипПодписанта;

КонецФункции

&НаСервере
Процедура УдалитьУчетнуюЗаписьНаСервере(Организация)

	ОставшиесяЗаписи = Новый Массив;
	Для Каждого СохраненнаяЗапись Из ЭДО_Сервер.СохраненныеУчетныеЗаписиЭДО() Цикл
		Если СохраненнаяЗапись.Организация <> Организация Тогда
			ОставшиесяЗаписи.Добавить(СохраненнаяЗапись);
		КонецЕсли;
	КонецЦикла;
	ЭДО_Сервер.ЗаписатьУчетныеЗаписиЭДО(ОставшиесяЗаписи);

КонецПроцедуры

&НаСервере
Функция ГотовностьУчетнойЗаписиНаСервере(Организация)

	НайденнаяЗапись = ЭДО_Сервер.УчетнаяЗаписьЭДО(Организация);
	Если НайденнаяЗапись = Неопределено Тогда
		Возврат "Учетная запись не найдена.";
	КонецЕсли;
	Претензии = ЭДО_Сервер.НедостаткиУчетнойЗаписиЭДО(НайденнаяЗапись);
	Если Претензии.Количество() = 0 Тогда
		Возврат "Учетная запись организации «" + Строка(Организация) + "» готова к отправке.";
	КонецЕсли;
	Возврат "Не готова:" + Символы.ПС + "- " + СтрСоединить(Претензии, Символы.ПС + "- ");

КонецФункции

#КонецОбласти
