// карточка входящего неформализованного документа (Центр управления ->
// Входящие -> двойной щелчок по строке-файлу). Титула у файла нет: просмотр - печатная форма
// оператора (PDF), ответы человека - подписать (подпись присоединяется к самому документу),
// отказать, запросить уточнение. Односторонний файл (oneWay) подписи не ждет - кнопки скрыты.
// Каждое действие с подписью - только после подтверждения пользователя.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры,
		"Ид, Организация, Вид, Номер, Дата, Продавец, ИННПродавца, ГидПродавца, Статус, Тема, Односторонний");
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Вид) Тогда
		Вид = "Неформализованный";
	КонецЕсли;
	Заголовок = Вид + " № " + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy") + " - " + Продавец;
	Просмотр = "<html><body style=""font-family:Arial;color:#555;padding:20px"">"
		+ "Неформализованный документ: файл хранится у оператора."
		+ "<br>Кнопка ""Открыть документ"" скачает его с отметками ЭДО.</body></html>";
	ОбновитьСостояние();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Ход и статус читаются у оператора после открытия: форма появляется сразу.
	ПодключитьОбработчикОжидания("ЗагрузитьИзПлатформы", 0.1, Истина);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьВыполнить(Команда)
	ЗагрузитьИзПлатформы();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументВыполнить(Команда)

	Состояние("Входящий файл", , "Запрашиваю документ у оператора…");
	Ответ = ПечатнаяФормаНаСервере();
	Состояние();
	Если НЕ Ответ.Успех Тогда
		ПоказатьПредупреждение(, Ответ.Текст);
		Возврат;
	КонецЕсли;
	// Перехват обоснован: файл получен, а открыть его не дала рабочая станция (нет программы для PDF
	// и т.п.) - говорим пользователю, где он лежит.
	ИмяФайла = КаталогВременныхФайлов() + "ЭДО_" + ИмяБезЗапрещенныхСимволов(Номер) + "_"
		+ СокрЛП(Ид) + "." + Ответ.Расширение;
	Попытка
		ПолучитьИзВременногоХранилища(Ответ.Адрес).Записать(ИмяФайла);
		ЗапуститьПриложение(ИмяФайла);
	Исключение
		ПоказатьПредупреждение(, "Документ " + Номер + " получен, но не открылся: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС + "Файл: " + ИмяФайла);
		Возврат;
	КонецПопытки;
	ОткрытьПротоколПодписи(Ответ.АдресПротокола, ИмяФайла);
	Если ЗначениеЗаполнено(Ответ.Пояснение) Тогда
		ПоказатьОповещениеПользователя("Файл без отметок оператора", , Ответ.Пояснение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодписатьВыполнить(Команда)
	ПоказатьВопрос(Новый ОписаниеОповещения("ПодписатьЗавершение", ЭтотОбъект),
		"Подписать " + Вид + " № " + Номер + " от " + Продавец + " подписью " + Организация + "?",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьЗавершение(Ответ, Параметр) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние("Входящий файл", , "Подписываю…");
	ПоказатьИтог(ПодписатьНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура ОтказатьВПодписиВыполнить(Команда)
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ОтказатьВПодписиЗавершение", ЭтотОбъект), "",
		"Причина отказа в подписи (её прочитает отправитель)", 500, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОтказатьВПодписиЗавершение(Причина, Параметр) Экспорт
	Если НЕ ЗначениеЗаполнено(Причина) Тогда
		Возврат;
	КонецЕсли;
	Состояние("Входящий файл", , "Отправляю отказ…");
	ПоказатьИтог(ОтказатьНаСервере(Причина));
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьУточнениеВыполнить(Команда)
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ЗапроситьУточнениеЗавершение", ЭтотОбъект), "",
		"Что нужно уточнить или исправить (текст прочитает отправитель)", 1000, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьУточнениеЗавершение(ТекстУточнения, Параметр) Экспорт
	Если НЕ ЗначениеЗаполнено(ТекстУточнения) Тогда
		Возврат;
	КонецЕсли;
	Состояние("Входящий файл", , "Отправляю запрос уточнения…");
	ПоказатьИтог(УточнениеНаСервере(ТекстУточнения));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗагрузитьИзПлатформы()
	Состояние("Входящий файл", , "Читаю состояние у оператора…");
	ЗагрузитьИзПлатформыНаСервере();
	Состояние();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзПлатформыНаСервере()

	Ход.Очистить();
	Сообщения = Новый Массив;
	// Перехват обоснован: ход документа - справка; оператор не ответил - строка в карточке, подробно - в ЖР.
	Попытка
		ХодДокумента = ЭДО_Сервер.ХодДокументаОператора(Ид, Организация);
		Для Каждого Шаг Из ХодДокумента.Шаги Цикл
			ЗаполнитьЗначенияСвойств(Ход.Добавить(), Шаг, "Время, Шаг, Статус");
		КонецЦикла;
		Если ЗначениеЗаполнено(ХодДокумента.Ошибка) Тогда
			Сообщения.Добавить("Ход документа: " + ХодДокумента.Ошибка);
		КонецЕсли;
		НовыйСтатус = ЭДО_Сервер.СтатусВходящегоУОператора(Ид, Организация);
		Если НовыйСтатус <> Неопределено Тогда
			Статус = НовыйСтатус;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Входящие", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Ход входящего файла " + Ид + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сообщения.Добавить("Ход документа не загружен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ОбновитьСостояние(СтрСоединить(Сообщения, Символы.ПС));

КонецПроцедуры

// Доступность команд по статусу у оператора: подписать, отказать и запросить уточнение можно, пока
// документ ждет ответа (SENT, DELIVERED). Подпись и отказ - только двустороннему (НЕ oneWay).
&НаСервере
Процедура ОбновитьСостояние(Знач ТекстСообщения = "")
	СостояниеЭДО = ЭДО_Сервер.ТекстСтатусаВходящего(Статус);
	ЖдетОтвета = (ВРег(Статус) = "SENT" ИЛИ ВРег(Статус) = "DELIVERED");
	Элементы.КнопкаПодписать.Доступность = ЖдетОтвета И НЕ Односторонний;
	Элементы.КнопкаОтказать.Доступность = ЖдетОтвета И НЕ Односторонний;
	Элементы.КнопкаУточнение.Доступность = ЖдетОтвета;
	Элементы.НадписьСообщение.Заголовок = ТекстСообщения;
	Элементы.НадписьСообщение.Видимость = ЗначениеЗаполнено(ТекстСообщения);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИтог(Знач Итог)
	Состояние();
	ПоказатьПредупреждение(, Итог.Текст);
	ЗагрузитьИзПлатформы();
	Оповестить("ЭДО_ВходящийИзменен", Ид);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПротоколПодписи(Знач АдресПротокола, Знач ИмяФайла)
	Если НЕ ЗначениеЗаполнено(АдресПротокола) Тогда
		Возврат;
	КонецЕсли;
	ПозицияТочки = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	ИмяПротокола = Лев(ИмяФайла, ПозицияТочки - 1) + "_протокол.pdf";
	Попытка
		ПолучитьИзВременногоХранилища(АдресПротокола).Записать(ИмяПротокола);
		ЗапуститьПриложение(ИмяПротокола);
	Исключение
		ПоказатьОповещениеПользователя("Протокол подписи не открылся", ,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ИмяПротокола);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ИмяБезЗапрещенныхСимволов(Знач Имя)
	Имя = СокрЛП(Имя);
	Запрещенные = "\/:*?""<>|";
	Для НомерСимвола = 1 По СтрДлина(Запрещенные) Цикл
		Имя = СтрЗаменить(Имя, Сред(Запрещенные, НомерСимвола, 1), "-");
	КонецЦикла;
	Возврат Имя;
КонецФункции

&НаСервере
Функция ПечатнаяФормаНаСервере()
	Ответ = ЭДО_Сервер.ПечатнаяФормаВходящего(Ид, Организация);
	Итог = Новый Структура("Успех, Текст, Адрес, Расширение, Пояснение, АдресПротокола",
		Ответ.Успех, Ответ.Текст, "", Ответ.Расширение, Ответ.Пояснение, "");
	Если Ответ.Успех Тогда
		Итог.Адрес = ПоместитьВоВременноеХранилище(Ответ.Данные, УникальныйИдентификатор);
		Если Ответ.Протокол <> Неопределено Тогда
			Итог.АдресПротокола = ПоместитьВоВременноеХранилище(Ответ.Протокол, УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	Возврат Итог;
КонецФункции

&НаСервере
Функция ПодписатьНаСервере()
	Возврат ЭДО_Сервер.ПодписатьВходящийФайл(Ид, Организация, Односторонний);
КонецФункции

&НаСервере
Функция ОтказатьНаСервере(Знач Причина)
	Возврат ЭДО_Сервер.ОтказатьВПодписиВходящего(Ид, Организация, Причина);
КонецФункции

&НаСервере
Функция УточнениеНаСервере(Знач ТекстУточнения)
	Возврат ЭДО_Сервер.ЗапроситьУточнениеВходящего(Ид, Организация, ТекстУточнения, ГидПродавца);
КонецФункции

#КонецОбласти
