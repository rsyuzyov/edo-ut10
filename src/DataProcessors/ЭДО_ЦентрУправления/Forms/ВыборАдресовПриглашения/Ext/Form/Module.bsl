// ++ ЩА 27.10.2026 [yan]: окно «Куда отправить приглашение» для кнопки «Пригласить выделенных» Центра управления.
// Приглашение уходило на рабочий адрес строки - обычно Диадок, - а контрагента бывает нужно позвать в другой ящик
// (СБИС). Окно показывает все ящики выделенных контрагентов (ЭДО_Витрина.ЯщикиКонтрагента: кэш реестра ФНС,
// реестр - только для тех, кого в кэше нет) и возвращает отмеченные адреса. Отправка и защита от повторного
// приглашения - прежние: ЭДО_Сервер.ПригласитьПоСписку в форме-владельце.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Контрагенты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ЭлементСписка Из Параметры.Контрагенты Цикл
		Контрагент = ЭлементСписка.Значение;
		Для Каждого Ящик Из ЭДО_Витрина.ЯщикиКонтрагента(Контрагент, Параметры.Организация) Цикл
			СтрокаЯщика = Ящики.Добавить();
			СтрокаЯщика.Контрагент = Контрагент;
			СтрокаЯщика.Оператор = Ящик.Оператор;
			СтрокаЯщика.Адрес = Ящик.Адрес;
			СтрокаЯщика.Состояние = Ящик.Состояние;
			СтрокаЯщика.ДатаПриглашения = Ящик.ДатаПриглашения;
			СтрокаЯщика.Можно = МожноПригласить(Ящик.Состояние);
			// По умолчанию - рабочий ящик, как раньше; каналы вне автовыбора (ЭДО Лайт и т.п.) - только руками.
			СтрокаЯщика.Пометка = Ящик.Рабочий И СтрокаЯщика.Можно
				И НЕ ЭДО_Сервер.АдресЭДОВнеАвтовыбора(Ящик.Адрес);
		КонецЦикла;
	КонецЦикла;
	Итог = ТекстИтога(ОтмеченныеАдреса(Ящики).Количество());

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЯщики

&НаКлиенте
Процедура ЯщикиПометкаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Ящики.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Пометка И НЕ ТекущиеДанные.Можно Тогда
		ТекущиеДанные.Пометка = Ложь;
		ПоказатьПредупреждение(, "Звать в этот ящик нельзя: " + НРег(ТекущиеДанные.Состояние)
			+ ". Повторное приглашение не двигает ожидание, а живую связь рвет.");
	КонецЕсли;
	ОбновитьИтог();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПригласитьВыполнить(Команда)

	Адреса = ОтмеченныеАдреса(Ящики);
	Если Адреса.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечено ни одного ящика");
		Возврат;
	КонецЕсли;
	Закрыть(Адреса);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Звать можно туда, где не звали или контрагент отказал. Ждущее приглашение повтор не двигает, живую
// связь рвет (у КОРУС - необратимо); ту же проверку по ответу оператора делает ПригласитьПоАдресам.
&НаСервереБезКонтекста
Функция МожноПригласить(Знач Состояние)

	Возврат Состояние = "Не звали" ИЛИ Состояние = "Отказ";

КонецФункции

// Отмеченные адреса без повторов - так же, как их нормализует ЭДО_Сервер.ПригласитьПоСписку (ВРег, СокрЛП):
// счетчик в окне обязан совпасть с тем, сколько уйдет на самом деле (ревью Codex 1158).
&НаКлиентеНаСервереБезКонтекста
Функция ОтмеченныеАдреса(Знач Строки)

	Уникальные = Новый Соответствие;
	Адреса = Новый Массив;
	Для Каждого СтрокаЯщика Из Строки Цикл
		Ключ = ВРег(СокрЛП(СтрокаЯщика.Адрес));
		Если СтрокаЯщика.Пометка И ЗначениеЗаполнено(Ключ) И Уникальные[Ключ] = Неопределено Тогда
			Уникальные.Вставить(Ключ, Истина);
			Адреса.Добавить(СокрЛП(СтрокаЯщика.Адрес));
		КонецЕсли;
	КонецЦикла;
	Возврат Адреса;

КонецФункции

// Тот же потолок одного вызова, что у ЭДО_Сервер.МаксАдресовПриглашенийЗаРаз и основной формы - менять вместе.
&НаКлиентеНаСервереБезКонтекста
Функция МаксАдресовПриглашенийЗаРаз()

	Возврат 300;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстИтога(Знач Отмечено)

	Если Отмечено = 0 Тогда
		Возврат "Ничего не отмечено";
	КонецЕсли;
	Потолок = МаксАдресовПриглашенийЗаРаз();
	Текст = "Будет отправлено приглашений: " + Мин(Отмечено, Потолок);
	Если Отмечено > Потолок Тогда
		Текст = Текст + ", останется " + (Отмечено - Потолок) + " - вызовите действие еще раз для остатка";
	КонецЕсли;
	Возврат Текст + ". Действие уходит наружу, к оператору ЭДО.";

КонецФункции

&НаКлиенте
Процедура ОбновитьИтог()

	Итог = ТекстИтога(ОтмеченныеАдреса(Ящики).Количество());

КонецПроцедуры

#КонецОбласти
// -- ЩА 27.10.2026 [yan].
