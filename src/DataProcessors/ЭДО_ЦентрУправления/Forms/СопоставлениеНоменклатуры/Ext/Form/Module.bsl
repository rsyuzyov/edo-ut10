// Окно сопоставления номенклатуры входящего УПД: показывает строки поставщика, дает выбрать
// номенклатуру 1С или создать новую и пишет соответствия в регистр НоменклатураКонтрагентов.
// После сохранения повторяет создание поступления тем же путем, что и кнопка Центра.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗначениеКлюча = "";
	Параметры.Свойство("КлючВходящего", ЗначениеКлюча);
	КлючВходящего = ЗначениеКлюча;
	ЗначениеОрганизации = Справочники.Организации.ПустаяСсылка();
	Параметры.Свойство("Организация", ЗначениеОрганизации);
	Организация = ЗначениеОрганизации;
	ВидНоменклатурыПоУмолчанию = ВидНоменклатурыПоУмолчаниюНаСервере();

	Если НЕ ЗначениеЗаполнено(КлючВходящего) ИЛИ НЕ ЗначениеЗаполнено(Организация) Тогда
		Итог = "Не передан входящий документ или организация";
		Возврат;
	КонецЕсли;

	Попытка
		ДанныеДокумента = ЭДО_Сервер.СодержимоеВходящегоДокумента(КлючВходящего, Организация);
		Разбор = ЭДО_ВходящиеДокументы.РазобратьУПД(ДанныеДокумента);
	Исключение
		Итог = "Не удалось прочитать XML входящего: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Если Разбор.Продавец = Неопределено Тогда
		Итог = "В документе не найден продавец";
		Возврат;
	КонецЕсли;

	Сообщения = Новый Массив;
	Контрагент = ЭДО_ВходящиеДокументы.КонтрагентПоИНН(Разбор.Продавец.ИНН, Разбор.Продавец.КПП, Сообщения);
	Если Контрагент = Неопределено Тогда
		Итог = "Контрагент не найден: " + СтрСоединить(Сообщения, "; ");
		Возврат;
	КонецЕсли;

	Сопоставление = ЭДО_ВходящиеДокументы.СопоставитьНоменклатуру(Разбор.Строки, Контрагент, Ложь);

	Для Каждого СтрокаУПД Из Разбор.Строки Цикл
		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.НомерСтроки = СтрокаУПД.НомерСтроки;
		НоваяСтрока.Наименование = СтрокаУПД.Наименование;
		НоваяСтрока.КодТовара = СтрокаУПД.КодТовара;
		НоваяСтрока.Артикул = СтрокаУПД.Артикул;
		НоваяСтрока.GTIN = СтрокаУПД.GTIN;
		НоваяСтрока.Единица = СтрокаУПД.ЕдиницаИзмерения;
		НоваяСтрока.Количество = СтрокаУПД.Количество;
		НоваяСтрока.Цена = СтрокаУПД.Цена;
		НоваяСтрока.Сумма = СтрокаУПД.СуммаСНДС;
		НоваяСтрока.Номенклатура = Сопоставление.Получить(СтрокаУПД.НомерСтроки);
		НоваяСтрока.ВидНоменклатуры = ВидНоменклатурыПоУмолчанию;
		НоваяСтрока.ЕдиницаИзмерения = ЕдиницаПоКоду(СтрокаУПД.КодОКЕИ);
	КонецЦикла;

	Итог = "Строк: " + Строки.Количество() + "; не сопоставлено: " + НеСопоставленоСтрок();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьВыполнить(Команда)

	ТекстИтога = СохранитьНаСервере();
	ПоказатьПредупреждение(, ТекстИтога);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуруВыполнить(Команда)

	ИндексСтроки = Элементы.Строки.ТекущаяСтрока;
	Если ИндексСтроки < 0 Тогда
		ПоказатьПредупреждение(, "Выберите строку документа");
		Возврат;
	КонецЕсли;

	Результат = СоздатьНоменклатуруНаСервере(ИндексСтроки);
	Если НЕ Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Текст);
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Значение", Результат.Номенклатура);
	ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СохранитьНаСервере()

	Итог = ЗаписатьСоответствия();
	Попытка
		Результат = ЭДО_Сервер.СоздатьДокументПоВходящему(КлючВходящего, Организация, "");
		Итог = Итог + Символы.ПС + Результат.Текст;
	Исключение
		Итог = Итог + Символы.ПС + "Создание поступления: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Итог;

КонецФункции

&НаСервере
Функция ЗаписатьСоответствия()

	Если Контрагент = Неопределено ИЛИ Контрагент.Пустая() Тогда
		Возврат "Контрагент не определен - соответствия не записаны";
	КонецЕсли;

	Сохранено = 0;
	Ошибки = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Запись = РегистрыСведений.НоменклатураКонтрагентов.СоздатьМенеджерЗаписи();
			Запись.Контрагент = Контрагент;
			Запись.Номенклатура = Строка.Номенклатура;
			Запись.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			Запись.КодНоменклатурыКонтрагента = Строка.КодТовара;
			Запись.АртикулНоменклатурыКонтрагента = Строка.Артикул;
			Запись.НаименованиеНоменклатурыКонтрагента = Строка.Наименование;
			Запись.ШтрихКодНоменклатурыКонтрагента = Строка.GTIN;
			Запись.Идентификатор = ИдентификаторСтроки(Строка);
			Запись.ЕдиницаНоменклатурыКонтрагента = Строка.ЕдиницаИзмерения;
			Запись.Записать();
			Сохранено = Сохранено + 1;
		Исключение
			Ошибки.Добавить("Строка " + Строка.НомерСтроки + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Текст = "Сохранено соответствий: " + Сохранено + "; не сопоставлено: " + НеСопоставленоСтрок();
	Если Ошибки.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	Возврат Текст;

КонецФункции

&НаСервере
Функция СоздатьНоменклатуруНаСервере(Знач ИндексСтроки)

	Если ИндексСтроки < 0 ИЛИ ИндексСтроки >= Строки.Количество() Тогда
		Возврат Новый Структура("Успех, Номенклатура, Текст", Ложь, Неопределено, "Строка не найдена");
	КонецЕсли;
	Строка = Строки[ИндексСтроки];

	НовыйТовар = Справочники.Номенклатура.Создать();
	НаименованиеКратко = Лев(СокрЛП(Строка.Наименование), 100);
	Если НЕ ЗначениеЗаполнено(НаименованиеКратко) Тогда
		НаименованиеКратко = "Товар поставщика";
	КонецЕсли;
	НовыйТовар.Наименование = НаименованиеКратко;
	НовыйТовар.НаименованиеПолное = СокрЛП(Строка.Наименование);
	НовыйТовар.Артикул = Лев(СокрЛП(Строка.Артикул), 25);
	Если ЗначениеЗаполнено(Строка.ВидНоменклатуры) Тогда
		НовыйТовар.ВидНоменклатуры = Строка.ВидНоменклатуры;
	Иначе
		НовыйТовар.ВидНоменклатуры = ВидНоменклатурыПоУмолчанию;
	КонецЕсли;
	Если ЗначениеЗаполнено(Строка.ЕдиницаИзмерения) Тогда
		НовыйТовар.БазоваяЕдиницаИзмерения = Строка.ЕдиницаИзмерения;
	КонецЕсли;

	Попытка
		НовыйТовар.Записать(Ложь);
	Исключение
		Возврат Новый Структура("Успех, Номенклатура, Текст", Ложь, Неопределено,
			"Не удалось создать номенклатуру: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Строка.Номенклатура = НовыйТовар.Ссылка;
	Возврат Новый Структура("Успех, Номенклатура, Текст", Истина, НовыйТовар.Ссылка,
		"Номенклатура создана");

КонецФункции

&НаСервере
Функция ВидНоменклатурыПоУмолчаниюНаСервере()

	Вид = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товар", Истина);
	Если Вид <> Неопределено Тогда
		Возврат Вид;
	КонецЕсли;
	Выборка = Справочники.ВидыНоменклатуры.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ВидыНоменклатуры.ПустаяСсылка();

КонецФункции

&НаСервере
Функция ЕдиницаПоКоду(Знач КодОКЕИ)

	Если НЕ ЗначениеЗаполнено(КодОКЕИ) Тогда
		Возврат Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
	КонецЕсли;
	Возврат Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(СокрЛП(КодОКЕИ));

КонецФункции

&НаСервере
Функция ИдентификаторСтроки(Строка)

	// Идентификатор в том же виде, в каком его ищет СопоставитьНоменклатуру: наименование
	// заглавными без пробелов, затем код поставщика.
	Если НЕ ЗначениеЗаполнено(Строка.КодТовара) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ВРег(СтрЗаменить(Строка.Наименование, " ", "")) + "##" + Строка.КодТовара + "#";

КонецФункции

&НаСервере
Функция НеСопоставленоСтрок()

	Количество = 0;
	Для Каждого Строка Из Строки Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

#КонецОбласти
