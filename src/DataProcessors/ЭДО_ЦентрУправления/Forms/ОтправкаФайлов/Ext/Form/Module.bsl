// окно «Отправка документов в ЭДО» - файлы с диска (договоры, счета, письма) контрагенту
// неформализованными документами. У каждого файла свой тип, номер, дата и признак
// «запросить подпись контрагента»; подписант один на отправку: ключ организации на сервере (как у УПД) или
// сертификат с этого компьютера - директора (только с ИНН организации) или физлица по МЧД.
// Отправка - ЭДО_Сервер: ОтправитьФайлПоЭДО (ключ на сервере) или Подготовить/ОтправитьПодписанныйФайлЭДО
// (подпись здесь, на клиенте). Документа 1С за файлом нет, итог - в колонке «Результат» и журнале «ЭДО.ОтправкаФайла».

&НаКлиенте
Перем СертификатыЮЛ;   // Соответствие: ключ подписанта (Base64 отпечатка) - Истина, если сертификат юрлица
&НаКлиенте
Перем ПараМЧД;         // «организация|подписант», к которой относится введенный номер МЧД

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.Организация.РежимВыбораИзСписка = Истина;
	Для Каждого УчетнаяЗапись Из ЭДО_Сервер.УчетныеЗаписиЭДО() Цикл
		Элементы.Организация.СписокВыбора.Добавить(УчетнаяЗапись.Организация);
	КонецЦикла;
	Организация = Параметры.Организация;
	Если НЕ ЗначениеЗаполнено(Организация) И Элементы.Организация.СписокВыбора.Количество() = 1 Тогда
		Организация = Элементы.Организация.СписокВыбора[0].Значение;
	КонецЕсли;
	Контрагент = Параметры.Контрагент;

	Для Каждого ТипДокумента Из ЭДО_Сервер.ТипыНеформализованныхДокументов() Цикл
		Элементы.ФайлыТип.СписокВыбора.Добавить(ТипДокумента.Значение, ТипДокумента.Представление);
	КонецЦикла;

	ЗаполнитьЯщики(Параметры.Адрес);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗаполнитьПодписантов();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	ЗаполнитьЯщики("");
	ЗаполнитьПодписантов();

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	ЗаполнитьЯщики("");

КонецПроцедуры

&НаКлиенте
Процедура ПодписантПриИзменении(Элемент)

	ОбновитьПолеМЧД();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыФайлы

&НаКлиенте
Процедура ФайлыТипПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Файлы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ЗапроситьПодпись = ПодписьКонтрагентаПоУмолчанию(ТекущиеДанные.Тип);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьФайлыВыполнить(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.МножественныйВыбор = Истина;
	Диалог.Заголовок = "Файлы для отправки в ЭДО";
	Диалог.Показать(Новый ОписаниеОповещения("ДобавитьФайлыЗавершение", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлыЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Путь Из ВыбранныеФайлы Цикл
		СтрокаФайла = Файлы.Добавить();
		СтрокаФайла.Путь = Путь;
		ФайлНаДиске = Новый Файл(Путь);
		СтрокаФайла.ИмяФайла = ФайлНаДиске.Имя;
		СтрокаФайла.Тип = "Неформализованный";
		СтрокаФайла.ЗапроситьПодпись = ПодписьКонтрагентаПоУмолчанию(СтрокаФайла.Тип);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВыполнить(Команда)

	Ошибки = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Ошибки.Добавить("не выбрана организация");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Ящик) Тогда
		Ошибки.Добавить("не выбран ящик контрагента");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Подписант) Тогда
		Ошибки.Добавить("не выбрано, чем подписать");
	ИначеЕсли ПодписантФизлицо() И НЕ ЗначениеЗаполнено(НомерМЧД) Тогда
		Ошибки.Добавить("для сертификата физлица нужен номер МЧД");
	КонецЕсли;
	КОтправке = 0;
	Для Каждого СтрокаФайла Из Файлы Цикл
		Если НЕ СтрокаФайла.Отправлен Тогда
			КОтправке = КОтправке + 1;
		КонецЕсли;
	КонецЦикла;
	Если КОтправке = 0 Тогда
		Ошибки.Добавить("нет файлов к отправке");
	КонецЕсли;
	Если Ошибки.Количество() > 0 Тогда
		ПоказатьПредупреждение(, "Отправить нельзя: " + СтрСоединить(Ошибки, "; ") + ".");
		Возврат;
	КонецЕсли;

	ЭлементПодписанта = Элементы.Подписант.СписокВыбора.НайтиПоЗначению(Подписант);
	Текст = "Подписать и отправить документов: " + КОтправке + "?" + Символы.ПС + Символы.ПС
		+ "Подпись: " + ?(ЭлементПодписанта = Неопределено, Подписант, ЭлементПодписанта.Представление)
		+ ?(ПодписантФизлицо(), Символы.ПС + "МЧД: " + НомерМЧД, "") + Символы.ПС
		+ "Кому: " + Контрагент + ", ящик " + Ящик;
	ПоказатьВопрос(Новый ОписаниеОповещения("ОтправитьЗавершение", ЭтотОбъект), Текст, РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Отправлено = 0;
	Всего = 0;
	Для Каждого СтрокаФайла Из Файлы Цикл
		Если СтрокаФайла.Отправлен Тогда
			Продолжить;
		КонецЕсли;
		Всего = Всего + 1;
		Состояние("Отправка в ЭДО", , СтрокаФайла.ИмяФайла);
		Итог = ОтправитьСтроку(СтрокаФайла);
		СтрокаФайла.Отправлен = Итог.Успех;
		// Id документа у оператора остается в строке: повтор сначала смотрит его состояние.
		// Организация и ящик пишутся только к новому id - прежний id остается со своей парой.
		Если ЗначениеЗаполнено(Итог.ИдДокумента) И Итог.ИдДокумента <> СтрокаФайла.ИдДокумента Тогда
			СтрокаФайла.ОрганизацияОтправки = Организация;
			СтрокаФайла.ЯщикОтправки = Ящик;
		КонецЕсли;
		СтрокаФайла.ИдДокумента = Итог.ИдДокумента;
		СтрокаФайла.Результат = Итог.Сообщение
			+ ?(ЗначениеЗаполнено(Итог.ИдДокумента), " (id " + Итог.ИдДокумента + ")", "");
		Если Итог.Успех Тогда
			Отправлено = Отправлено + 1;
		КонецЕсли;
	КонецЦикла;
	Состояние();
	ПоказатьПредупреждение(, "Отправлено: " + Отправлено + " из " + Всего
		+ ?(Отправлено < Всего, ". Причины - в колонке «Результат».", "."));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Одна строка: файл читается здесь, на компьютере пользователя; подпись - на сервере или здесь же.
// Возврат: Структура (Успех, ИдДокумента, Сообщение).
&НаКлиенте
Функция ОтправитьСтроку(СтрокаФайла)

	Итог = Новый Структура("Успех, ИдДокумента, Сообщение", Ложь, "", "");
	Если ЗначениеЗаполнено(СтрокаФайла.ИдДокумента) Тогда
		Итог = РазобратьПрежнююОтправку(СтрокаФайла);
		Если Итог.Успех ИЛИ ЗначениеЗаполнено(Итог.ИдДокумента) Тогда
			Возврат Итог;   // уже отправлен или прежний документ не разобран - новый не создаем
		КонецЕсли;
	КонецЕсли;
	// Попытка: файл могли переместить или удалить после выбора - причина в строку, остальные файлы уходят.
	Попытка
		Данные = Новый ДвоичныеДанные(СтрокаФайла.Путь);
	Исключение
		Итог.Сообщение = "файл не прочитан: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;
	Файл = ЭДО_Сервер.НовыйФайлДляЭДО();
	Файл.ИмяФайла = СтрокаФайла.ИмяФайла;
	Файл.Данные = Данные;
	Файл.Тип = СтрокаФайла.Тип;
	Файл.Номер = СтрокаФайла.Номер;
	Файл.Дата = СтрокаФайла.Дата;
	Файл.ЗапроситьПодпись = СтрокаФайла.ЗапроситьПодпись;
	Файл.Комментарий = СтрокаФайла.Комментарий;

	Если Подписант = КлючПодписиНаСервере() Тогда
		Возврат ЭДО_Сервер.ОтправитьФайлПоЭДО(Организация, Ящик, Файл);
	КонецЕсли;

	Итог = ЭДО_Сервер.ПодготовитьФайлКПодписиЭДО(Организация, Ящик, Файл);
	Если НЕ Итог.Подготовлен Тогда
		Возврат Итог;   // файл не загружен: подписывать нечего, причина и id черновика - в итоге
	КонецЕсли;
	Подпись = ПодписатьНаКлиенте(Данные);
	Если ТипЗнч(Подпись) <> Тип("ДвоичныеДанные") Тогда
		Возврат ЭДО_Сервер.ОтменитьПодготовленныйФайлЭДО(Организация, Итог.ИдДокумента,
			"файл не подписан на этом компьютере: " + Подпись, СтрокаФайла.ИмяФайла, СтрокаФайла.Тип);
	КонецЕсли;
	Возврат ЭДО_Сервер.ОтправитьПодписанныйФайлЭДО(Организация, Итог.ИдДокумента, Подпись,
		?(ПодписантФизлицо(), НомерМЧД, ""), СтрокаФайла.ИмяФайла, СтрокаФайла.Тип);

КонецФункции

// Строка уже создавала документ у оператора (прежнее нажатие оборвалось или подпись не прошла). Новый документ
// создается, только если прежний точно не ушел: его нет у оператора или это неподписанный черновик, и он удален.
// Возврат: как у ОтправитьСтроку; ИдДокумента пустой и Успех Ложь - можно отправлять заново.
&НаКлиенте
Функция РазобратьПрежнююОтправку(СтрокаФайла)

	Итог = Новый Структура("Успех, ИдДокумента, Сообщение", Ложь, СтрокаФайла.ИдДокумента, "");
	Если СтрокаФайла.ОрганизацияОтправки <> Организация ИЛИ СтрокаФайла.ЯщикОтправки <> Ящик Тогда
		Итог.Сообщение = "файл уже отправлялся от " + СтрокаФайла.ОрганизацияОтправки + " в ящик " + СтрокаФайла.ЯщикОтправки
			+ "; другому получателю - удалите строку и добавьте файл заново";
		Возврат Итог;
	КонецЕсли;
	СостояниеУОператора = ЭДО_Сервер.СостояниеФайлаЭДО(Организация, СтрокаФайла.ИдДокумента);
	Если НЕ СостояниеУОператора.Опрошено Тогда
		Итог.Сообщение = "состояние прежнего документа у оператора неизвестно (" + СостояниеУОператора.Сообщение
			+ "), повторная отправка отложена";
		Возврат Итог;
	КонецЕсли;
	Если СостояниеУОператора.Вид = "Нет" Тогда
		Итог.ИдДокумента = "";
		Возврат Итог;
	КонецЕсли;
	Если СостояниеУОператора.Вид = "Отправлен" Тогда
		Итог.Успех = Истина;
		Итог.Сообщение = "уже отправлен: " + НРег(СостояниеУОператора.Сообщение);
		Возврат Итог;
	КонецЕсли;
	Если СостояниеУОператора.Вид <> "Черновик" Тогда
		Итог.Сообщение = "прежний документ у оператора: " + НРег(СостояниеУОператора.Сообщение)
			+ " - автоматически не переотправляется; разберитесь в кабинете, для новой отправки удалите строку и добавьте файл заново";
		Возврат Итог;
	КонецЕсли;
	// Неподписанный черновик никуда не ушел: удаляем и отправляем заново; не удалился - новый не создаем.
	Возврат ЭДО_Сервер.ОтменитьПодготовленныйФайлЭДО(Организация, СтрокаФайла.ИдДокумента,
		"прежний черновик не подписан", СтрокаФайла.ИмяФайла, СтрокаФайла.Тип);

КонецФункции

// Подпись выбранным сертификатом этого компьютера. Возврат: ДвоичныеДанные подписи или Строка - причина отказа.
&НаКлиенте
Функция ПодписатьНаКлиенте(Данные)

	// Попытка: отказ от ввода ПИН-кода, извлеченный токен, сбой КриптоПро - причина уходит в строку файла,
	// а черновик у оператора удаляет вызывающий.
	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80);   // ГОСТ-2012-256, как подпись на сервере
		Хранилище = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Сертификат = Хранилище.НайтиПоОтпечатку(Base64Значение(Подписант));
		Если Сертификат = Неопределено Тогда
			Возврат "сертификат не найден в личном хранилище";
		КонецЕсли;
		Возврат МенеджерКриптографии.Подписать(Данные, Сертификат);
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Список «Подписать»: ключ организации на сервере и действующие сертификаты этого компьютера. Сертификат юрлица
// (директор) - только с ИНН организации-отправителя; физлица показываются все, подписывают по МЧД.
&НаКлиенте
Процедура ЗаполнитьПодписантов()

	СертификатыЮЛ = Новый Соответствие;
	Список = Элементы.Подписант.СписокВыбора;
	Список.Очистить();
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Подписант = "";
		ОбновитьПолеМЧД();
		Возврат;
	КонецЕсли;
	Сведения = СведенияОрганизации(Организация);
	Список.Добавить(КлючПодписиНаСервере(), "На сервере: " + Сведения.КлючНаСервере);

	// Попытка: на компьютере может не быть КриптоПро или доступа к хранилищу - тогда остается ключ на сервере.
	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии("", "", 80);
		Хранилище = МенеджерКриптографии.ПолучитьХранилищеСертификатов(
			ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
		Сертификаты = Хранилище.ПолучитьВсе();
	Исключение
		Сообщить("Сертификаты этого компьютера не прочитаны: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сертификаты = Новый Массив;
	КонецПопытки;
	// ТекущаяДатаСеанса на клиенте в режиме совместимости конфигурации недоступна (CheckModules), срок
	// сертификата сверяем с часами этого компьютера - того же, где сертификат и будет подписывать.
	Сейчас = ТекущаяДата();
	Для Каждого Сертификат Из Сертификаты Цикл
		Если Сертификат.ДатаОкончания < Сейчас Тогда
			Продолжить;
		КонецЕсли;
		Юрлицо = ЮрлицоСертификата(Сертификат.Субъект);
		Если Юрлицо.ЭтоЮЛ И НЕ ЮрлицоЭтойОрганизации(Юрлицо, Сведения) Тогда
			Продолжить;   // директор другой фирмы
		КонецЕсли;
		Ключ = Base64Строка(Сертификат.Отпечаток);
		ЭтоЮЛ = Юрлицо.ЭтоЮЛ;
		СертификатыЮЛ.Вставить(Ключ, ЭтоЮЛ);
		Должность = ПолеСубъекта(Сертификат.Субъект, "T");
		Список.Добавить(Ключ, ВладелецСертификата(Сертификат.Субъект)
			+ ?(ЭтоЮЛ, ", " + ?(ЗначениеЗаполнено(Должность), НРег(Должность), "сертификат организации"), ", физлицо по МЧД")
			+ ", до " + Формат(Сертификат.ДатаОкончания, "ДФ=dd.MM.yyyy") + " - с этого компьютера");
	КонецЦикла;

	Если Список.НайтиПоЗначению(Подписант) = Неопределено Тогда
		Подписант = КлючПодписиНаСервере();
	КонецЕсли;
	ОбновитьПолеМЧД();

КонецПроцедуры

// Номер МЧД принадлежит паре «организация, сертификат»: при смене любой из них прежний номер сбрасывается и
// подставляется номер новой пары; ручной ввод живет, пока пара та же.
&НаКлиенте
Процедура ОбновитьПолеМЧД()

	Физлицо = ПодписантФизлицо();
	Элементы.НомерМЧД.Видимость = Физлицо;
	Пара = Строка(Организация) + "|" + Подписант;
	Если НЕ Физлицо Тогда
		НомерМЧД = "";
	ИначеЕсли Пара <> ПараМЧД Тогда
		НомерМЧД = ЭДО_Сервер.НомерМЧДСертификатаЭДО(Организация, Подписант);
	КонецЕсли;
	ПараМЧД = Пара;

КонецПроцедуры

// Подпись сертификатом физлица с этого компьютера - нужен номер МЧД.
&НаКлиенте
Функция ПодписантФизлицо()

	Если НЕ ЗначениеЗаполнено(Подписант) ИЛИ Подписант = КлючПодписиНаСервере() ИЛИ СертификатыЮЛ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СертификатыЮЛ.Получить(Подписант) = Ложь;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КлючПодписиНаСервере()

	Возврат "СЕРВЕР";

КонецФункции

// Договор и акт сверки по умолчанию с запросом подписи контрагента, прочие - без.
&НаКлиентеНаСервереБезКонтекста
Функция ПодписьКонтрагентаПоУмолчанию(Знач Тип)

	Возврат Тип = "Договор" ИЛИ Тип = "АктСверки";

КонецФункции

&НаСервереБезКонтекста
Функция СведенияОрганизации(Знач Организация)

	// ключ на сервере - сертификат подписанта учетной записи ЭДО, обычно бухгалтера-физлица
	// по МЧД, а не «ключ организации». Кто он и по какой доверенности - из учетной записи.
	Сертификат = ЭДО_Сервер.СостояниеСертификатаПодписанта(Ложь, Организация);
	Запись = ЭДО_Сервер.УчетнаяЗаписьЭДО(Организация);
	Физлицо = Запись <> Неопределено И Запись.ТипПодписанта = "ФЛ";
	Кто = ?(Физлицо, "физлицо по МЧД" + ?(ЗначениеЗаполнено(Запись.НомерМЧД), " № " + СокрЛП(Запись.НомерМЧД), ""),
		"сертификат организации");
	ОГРН = ?(Метаданные.Справочники.Организации.Реквизиты.Найти("ОГРН") = Неопределено, "",
		СокрЛП(Строка(Организация.ОГРН)));
	Возврат Новый Структура("ИНН, ОГРН, КлючНаСервере", ЭДО_Сервер.ИННОрганизацииЭДО(Организация), ОГРН,
		?(Сертификат.Найден, Сертификат.Субъект + ", " + Кто + ", " + Сертификат.Описание, Сертификат.Описание));

КонецФункции

// Ящики контрагента из реестра ФНС с состоянием связи с выбранной организацией; по умолчанию - переданный адрес
// или рабочий ящик (тот, куда уходят УПД).
&НаСервере
Процедура ЗаполнитьЯщики(Знач Адрес)

	Элементы.Ящик.СписокВыбора.Очистить();
	Ящик = "";
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	Рабочий = "";
	Ящики = ЭДО_Витрина.ЯщикиКонтрагента(Контрагент, Организация);
	Связи = СвязиЯщиков(Ящики.ВыгрузитьКолонку("Адрес"));
	Для Каждого СтрокаЯщика Из Ящики Цикл
		// в строке - связь с ящиком (как колонка «Связь» окна «Состояние ЭДО»), а не только
		// приглашение: «не звали» стояло и у ящиков с живой связью.
		Приглашение = НРег(СтрокаЯщика.Состояние);
		Элементы.Ящик.СписокВыбора.Добавить(СтрокаЯщика.Адрес,
			СтрокаЯщика.Оператор + " " + СтрокаЯщика.Адрес + " - связь: " + ТекстСвязиЯщика(Связи, СтрокаЯщика.Адрес)
			+ ?(Приглашение = "не звали" ИЛИ НЕ ЗначениеЗаполнено(Приглашение), "", ", приглашение: " + Приглашение));
		Если СтрокаЯщика.Рабочий Тогда
			Рабочий = СтрокаЯщика.Адрес;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Адрес) И Элементы.Ящик.СписокВыбора.НайтиПоЗначению(Адрес) <> Неопределено Тогда
		Ящик = Адрес;
	Иначе
		Ящик = Рабочий;
	КонецЕсли;

КонецПроцедуры

// Связи нашей организации с ящиками у оператора - тот же обход, что у окна «Состояние ЭДО»
// (ЭДО_Сервер.СтатусыСвязейПолно). Неопределено - не узнали (нет токена, сбой, неполный обход).
&НаСервере
Функция СвязиЯщиков(Знач Адреса)

	Если Адреса.Количество() = 0 ИЛИ НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Попытка: сбой связи с оператором не должен закрывать окно - ящики показываются со связью «?», причина в ЖР.
	Попытка
		Если НЕ ЭДО_Сервер.ОбеспечитьТокен(Ложь, Организация) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + ЭДО_Сервер.ТекущийТокен(Организация));
		Заголовки.Вставить("accept", "application/json;charset=UTF-8");
		Обход = ЭДО_Сервер.СтатусыСвязейПолно(ЭДО_Сервер.СоединениеСОператором(20), Заголовки,
			СокрЛП(Строка(ЭДО_Сервер.ГидОрганизации(Организация))), Адреса);
	Исключение
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , Организация,
			"Отправка документов, связи ящиков: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	Если Обход.Неудач > 0 Тогда
		// отказы оператора обход обрабатывает сам и исключения не бросает - коды и первая
		// причина в журнал, иначе «связь: ?» без объяснения.
		ЗаписьЖурналаРегистрации("ЭДО.Перехват", УровеньЖурналаРегистрации.Ошибка, , Организация,
			"Отправка документов, связи ящиков не получены: " + ЭДО_Сервер.ОтказыОбходаСтрокой(Обход));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Обход.Связи;

КонецФункции

// Как колонка «Связь» окна «Состояние ЭДО»: нет записи у ящика нашего же оператора - «внутри Платформы»
// (пара абонентов одного оператора роуминговой связи не имеет), иначе «нет».
&НаСервере
Функция ТекстСвязиЯщика(Знач Связи, Знач Адрес)

	Если Связи = Неопределено Тогда
		Возврат "?";
	КонецЕсли;
	Связь = ЭДО_Сервер.СостояниеСвязи(Связи, Адрес);
	Статус = ?(Связь = Неопределено, "", ВРег(СокрЛП(Строка(Связь.Статус))));
	Если Статус = "ESTABLISHED" ИЛИ Статус = "DIRECT" Тогда
		Возврат "есть";
	ИначеЕсли Статус = "AWAIT_APPROVAL" Тогда
		Возврат "ждет ответа на приглашение";
	ИначеЕсли ЗначениеЗаполнено(Статус) Тогда
		Возврат Статус;
	КонецЕсли;
	НашГид = ВРег(СокрЛП(Строка(ЭДО_Сервер.ГидОрганизации(Организация))));
	Если СтрДлина(НашГид) >= 3 И Лев(ВРег(СокрЛП(Адрес)), 3) = Лев(НашГид, 3) Тогда
		Возврат "внутри Платформы";
	КонецЕсли;
	Возврат "нет";

КонецФункции

// юрлицо ли владелец сертификата - по значениям субъекта, а не по именам полей: на компьютере
// пользователя сертификаты директоров по имени OID1_2_643_100_4 не нашлись, и все показались физлицами по МЧД.
// ИНН ЮЛ - 10 цифр (у старых сертификатов 12 с «00» впереди), ОГРН - 13 цифр; у физлица
// ИНН 12 цифр, СНИЛС 11, ОГРНИП 15 - такие значения юрлица не дают.
// Возврат: Структура (ЭтоЮЛ Булево, ИНН Строка, ОГРН Строка).
&НаКлиенте
Функция ЮрлицоСертификата(Субъект)

	Итог = Новый Структура("ЭтоЮЛ, ИНН, ОГРН", Ложь, "", "");
	Для Каждого Элемент Из Субъект Цикл
		Значение = СокрЛП(Строка(Элемент.Значение));
		Если НЕ ТолькоЦифры(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Длина = СтрДлина(Значение);
		Если Длина = 10 Тогда
			Итог.ИНН = Значение;
		ИначеЕсли Длина = 12 И Лев(Значение, 2) = "00" Тогда
			Итог.ИНН = Сред(Значение, 3);
		ИначеЕсли Длина = 13 Тогда
			Итог.ОГРН = Значение;
		КонецЕсли;
	КонецЦикла;
	Итог.ЭтоЮЛ = ЗначениеЗаполнено(Итог.ИНН) ИЛИ ЗначениеЗаполнено(Итог.ОГРН);
	Возврат Итог;

КонецФункции

// Сертификат юрлица выдан этой организации: по ИНН, а если ИНН в сертификате нет - по ОГРН.
&НаКлиенте
Функция ЮрлицоЭтойОрганизации(Юрлицо, Сведения)

	Если ЗначениеЗаполнено(Юрлицо.ИНН) Тогда
		Возврат Юрлицо.ИНН = Сведения.ИНН;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Сведения.ОГРН) И Юрлицо.ОГРН = Сведения.ОГРН;

КонецФункции

&НаКлиенте
Функция ТолькоЦифры(Значение)

	Если Значение = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ВладелецСертификата(Субъект)

	ФИО = СокрЛП(ПолеСубъекта(Субъект, "SN") + " " + ПолеСубъекта(Субъект, "G"));
	Если НЕ ЗначениеЗаполнено(ФИО) Тогда
		ФИО = ПолеСубъекта(Субъект, "CN");
	КонецЕсли;
	Возврат ФИО;

КонецФункции

// Поле субъекта сертификата без учета регистра: Субъект бывает Структурой, ФиксированнойСтруктурой и
// Соответствием - обход циклом работает у всех (см. ЭДО_Сервер.ПолеСубъектаСертификата).
&НаКлиенте
Функция ПолеСубъекта(Субъект, Имя)

	Для Каждого Элемент Из Субъект Цикл
		Если ВРег(Строка(Элемент.Ключ)) = ВРег(Имя) Тогда
			Возврат СокрЛП(Строка(Элемент.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти
