
&Перед("ПередЗаписью")
Процедура ЭДО_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Отправленный контрагенту акт не перезаписывается: причина и что делать - в ЭДО_Сервер.ПричинаЗапретаПравкиАкта.
	// Загрузку обменом не трогаем: она переносит уже записанное, а не правит его.
	Если ОбменДанными.Загрузка ИЛИ ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	ПричинаЗапрета = ЭДО_Сервер.ПричинаЗапретаПравкиАкта(Ссылка);
	Если ЗначениеЗаполнено(ПричинаЗапрета) Тогда
		Отказ = Истина;
		Сообщить(ПричинаЗапрета, СтатусСообщения.Важное);
	КонецЕсли;

КонецПроцедуры
